<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Спайк (одноразовый тест связи с локальным ИИ): анализаторы не применяем. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- TargetFramework/Nullable/ImplicitUsings — из корневого Directory.Build.props.
       Версии пакетов — из Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

</Project>
