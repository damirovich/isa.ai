@using System.Security.Claims
@using ISC.AI.Web.Security
@implements IDisposable
@inject NavigationManager Navigation

@* Принуждение к смене временного пароля (Э4-35 §6.5). Пока пароль временный, он известен ТРЕТЬЕМУ
   лицу — администратору, который его выдал, либо всем, кто видел конфигурацию (учётка по умолчанию).
   Поэтому до смены оболочка никуда не пускает.

   Компонент ставится в MainLayout: он оборачивает все страницы, и добавлять проверку в каждую не
   нужно. Это УДОБСТВО, а не защита: сервер и без него не выдаст данные без допуска (ТБ-012/021) —
   здесь мы лишь не даём человеку работать с системой, оставив за собой известный посторонним пароль. *@

@code {
    /// <summary>Куда ведём и что при этом разрешено открывать.</summary>
    private const string PasswordPage = "/account/password";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await EnforceAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e) => await EnforceAsync();

    private async Task EnforceAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (state.User.FindFirst(AuthClaims.MustChangePassword)?.Value != "1")
        {
            return;
        }

        // Сама страница смены пароля и выход — единственное, что остаётся доступным: иначе
        // получился бы цикл переходов, а выйти человек обязан мочь всегда.
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (path.StartsWith("account/password", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("auth/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo(PasswordPage);
    }

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
