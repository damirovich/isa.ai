@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ISC.AI.Web.styles.css"]" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <ImportMap />
    @* Рендер-режим — ЕДИНОЙ точкой здесь, не на отдельных страницах (Э3-08): LayoutComponentBase
       (MainLayout) не может сам объявить @rendermode (та же причина, что и с RenderFragment-параметром —
       см. learn.microsoft.com/aspnet/core/blazor/components/render-modes, «Render mode inheritance» +
       предупреждение про layout); если раскидать режим по страницам, кнопки в самом MainLayout (шапка,
       переключатель темы) остаются статичными и не реагируют на клик, хотя содержимое страницы работает.
       Анонимные страницы (/login, /access-denied, /Error, /not-found) — статичны намеренно: интерактивный
       circuit для них заблокирован фолбэк-политикой «только аутентифицированные» (анонимный SignalR-
       негошиейт получает 401 бесконечно) — паттерн «static SSR pages in an interactive app» из той же
       документации. *@
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/download.js"]"></script>
</body>

</html>

@code {
    // Доступен только на этапе первичного (статического) запроса — до открытия circuit'а; этого
    // достаточно, чтобы решить режим ОДИН раз для всего дерева ниже (Routes/HeadOutlet).
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Ровно 4 анонимные страницы (Э3-08, ADR-0016 п.9) — остальное дерево интерактивно единым узлом,
    // включая MainLayout (шапку, переключатель темы, боковое меню).
    private static readonly string[] StaticSsrPaths = ["/login", "/access-denied", "/error", "/not-found"];

    private IComponentRenderMode? RenderModeForPage =>
        StaticSsrPaths.Any(path => HttpContext.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase))
            ? null
            : InteractiveServer;
}
