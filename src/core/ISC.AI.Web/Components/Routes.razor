@inject ISC.AI.Abstractions.Profiles.IProfile Profile

<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="ModuleAssemblies"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* Авторизующий рендер (Э3-08, ТБ-010): неаутентифицированный переход — на форму входа.
           HTTP-уровень дополнительно закрыт фолбэк-политикой «только аутентифицированные». *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Маршруты страниц модулей профиля собираются из реестра модулей (ТС-007, ТО-прог-05).
    private IEnumerable<System.Reflection.Assembly> ModuleAssemblies =>
        Profile.Modules.Select(m => m.ComponentType.Assembly).Distinct();
}
