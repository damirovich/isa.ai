@inject NavigationManager Navigation

@* Неаутентифицированный доступ к странице — уводим на форму входа с возвратом (ТБ-010).
   forceLoad: вход выполняется полным HTTP-циклом (установка cookie вне circuit'а). *@

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
