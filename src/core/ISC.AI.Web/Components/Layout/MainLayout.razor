@inherits LayoutComponentBase
@inject IProfile Profile
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using ISC.AI.Web.Common

@* Оболочка хоста: тема, шапка, боковое меню. Доменно-нейтральна — название, подзаголовок и состав
   меню берутся из манифеста профиля (ТС-003, ТС-007). Хост не знает слова «инспекция». *@

@* Временный пароль известен посторонним (администратору, выдавшему его, либо всем, кто видел
   конфигурацию учётки по умолчанию) — до смены работать в системе нельзя. *@
<RequirePasswordChange />

<MudThemeProvider Theme="IscTheme.Default" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Шапка ЗАКРЕПЛЕНА сверху, контент прокручивается под ней — фон обязан быть непрозрачным,
       иначе текст страницы просвечивает сквозь метки шапки (ДЕМО/контур/дата). Color.Default берёт
       AppbarBackground темы (#0b1220) — тот же тон, что и фон страницы: визуально плоско, но плотно. *@
    <MudAppBar Elevation="0" Dense="true" Color="Color.Default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Меню" />
        <MudSpacer />

        @* Демо-режим: на экране показательные данные, а не реальные. Метка обязана быть видна всегда. *@
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                 Icon="@Icons.Material.Filled.Science" Class="mr-2">ДЕМО</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                 Icon="@Icons.Material.Filled.Lock" Class="mr-3 d-none d-sm-flex">изолированный контур</MudChip>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mr-2 d-none d-sm-flex">@DateTime.Now.ToString("dd.MM.yyyy")</MudText>

        @* Виджеты шапки объявляет ПРОФИЛЬ (ТС-003): хост знает про «слот» и «тип компонента», но не
           про их содержимое. Только аутентифицированному — как и состав меню (ТБ-010). *@
        <AuthorizeView>
            <Authorized>
                @foreach (var widget in Profile.ShellWidgets
                    .Where(w => w.Slot == ShellWidgetSlot.AppBarRight)
                    .OrderBy(w => w.Order))
                {
                    <DynamicComponent Type="widget.ComponentType" @key="widget.Id" />
                }
            </Authorized>
        </AuthorizeView>

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleTheme" aria-label="Переключить тему" />

        @* Текущий субъект и выход (Э3-08, ТБ-010/014). Выход — обычный POST вне circuit'а. *@
        <AuthorizeView>
            <Authorized>
                @if (context.User.Identity?.AuthenticationType != "Dev")
                {
                    <MudText Typo="Typo.body2" Class="ml-2 mr-1 d-none d-sm-flex">
                        @(context.User.FindFirst(ISC.AI.Web.Security.AuthClaims.DisplayName)?.Value
                            ?? context.User.Identity?.Name)
                    </MudText>
                    <form method="post" action="/auth/logout" class="d-flex ma-0">
                        <AntiforgeryToken />
                        <MudIconButton Icon="@Icons.Material.Filled.Logout" ButtonType="ButtonType.Submit"
                                       Color="Color.Inherit" aria-label="Выйти" />
                    </form>
                }
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Never">
        <MudDrawerHeader Class="pb-1">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Medium" />
                <div>
                    <MudText Typo="Typo.h6" Style="line-height:1.15;">ISC.AI</MudText>
                </div>
            </div>
        </MudDrawerHeader>

        @* Состав модулей и наименование профиля — раскрываются ТОЛЬКО аутентифицированному (ТБ-010):
           анонимные страницы (/not-found, /access-denied, /Error используют этот же layout как
           DefaultLayout) не должны выдавать структуру режимной системы до входа. *@
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.caption" Class="mud-text-secondary px-4 d-block mb-2">
                    @Profile.DisplayName
                    @if (!string.IsNullOrWhiteSpace(Profile.Subtitle))
                    {
                        <text> · @Profile.Subtitle</text>
                    }
                </MudText>

                <NavMenu />

                <MudSpacer />
                <div class="pa-3">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.AutoAwesome" Class="ma-0">ДЕМО · ИИ активен</MudChip>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudSpacer />
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    @* НЕ ставить pt-* на MudMainContent: утилита отступа идёт с !important и перебивает правило
       MudBlazor «.mud-appbar-dense ~ .mud-main-content { padding-top: высота шапки }», из-за чего
       контент уезжает ПОД закреплённую шапку. Отступ под шапку оставляем MudBlazor; «воздух» сверху
       задаём на внутреннем контейнере — он не main-content и клиренс шапки не ломает. *@
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Произошла необработанная ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>
    /// Читает запомненную тему ПОСЛЕ первого рендера.
    /// </summary>
    /// <remarks>
    /// Не в OnInitialized: при предрендере браузерного хранилища ещё нет, и обращение к нему на
    /// этом этапе бросает. Отсутствие запомненного выбора — не ошибка: остаётся тёмная по умолчанию.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<bool?>("iscaiTheme.read");
            if (stored is { } isDark && isDark != _isDarkMode)
            {
                _isDarkMode = isDark;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Скрипт не загрузился — оболочка обязана работать и без запоминания темы.
        }
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await JS.InvokeVoidAsync("iscaiTheme.write", _isDarkMode);
        }
        catch (JSException)
        {
            // Невозможность запомнить выбор не должна отменять само переключение.
        }
    }
}
