@inject IProfile Profile
@inject ISC.AI.Web.Common.ModuleAccess ModuleAccess

@* Навигация строится из реестра модулей профиля (ТС-007). Хост не знает имён модулей заранее и не
   хардкодит секции: названия групп объявляет сам профиль (IModule.MenuGroup) — здесь только группировка. *@

<MudNavMenu Class="pb-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Главная</MudNavLink>

    @* Пункты, которые роль пользователя не использует, не показываются (ТП-004, IModuleVisibility профиля):
       секция без видимых пунктов не выводится вовсе. До ответа профиля — только «Главная», без мигания
       лишних пунктов. Права на действия всё равно проверяет сервер (ТБ-012). *@
    @foreach (var group in VisibleModules.GroupBy(m => m.MenuGroup))
    {
        @if (!string.IsNullOrWhiteSpace(group.Key))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary px-4 pt-4 pb-1 d-block"
                     Style="letter-spacing:.08em; text-transform:uppercase; font-weight:600;">
                @group.Key
            </MudText>
        }

        @foreach (var module in group)
        {
            <MudNavLink Href="@module.Route" Match="NavLinkMatch.Prefix" Icon="@module.MenuIcon">
                @module.MenuTitle
            </MudNavLink>
        }
    }
</MudNavMenu>

@code {
    private IReadOnlySet<string>? _visibleIds;

    private IEnumerable<ISC.AI.Abstractions.Modules.IModule> VisibleModules =>
        _visibleIds is { } ids ? Profile.Modules.Where(m => ids.Contains(m.Id)) : [];

    protected override async Task OnInitializedAsync() => _visibleIds = await ModuleAccess.GetVisibleIdsAsync();
}
