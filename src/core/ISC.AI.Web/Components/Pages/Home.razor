@page "/"
@rendermode InteractiveServer
@inject IProfile Profile

@* Главная хоста — доменно-НЕЙТРАЛЬНА: герб, название и подзаголовок берутся из манифеста профиля
   (ТС-003, ТС-007). При смене профиля (напр. на «АИС ЕРП») экран меняется сам, без правок хоста. *@

<PageTitle>@Profile.DisplayName</PageTitle>

<div class="d-flex flex-column align-center text-center my-8">
    @if (Profile.EmblemUrl is { } emblemUrl)
    {
        @* Герб ведомства по центру — путь объявляет профиль; хост конкретного герба не знает. *@
        <img src="@emblemUrl" alt="Герб" style="height:160px; max-width:100%;" class="mb-4" />
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
    }
    <MudText Typo="Typo.h3" GutterBottom="true">@Profile.DisplayName</MudText>
    @if (!string.IsNullOrWhiteSpace(Profile.Subtitle))
    {
        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">@Profile.Subtitle</MudText>
    }
    <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:680px;">
        Интеллектуальная платформа ведомственного контроля на локальных моделях. Работает on-premise
        в изолированном контуре. Любой результат ИИ — <b>черновик</b>: проверка, решение и ответственность
        остаются за сотрудником.
    </MudText>
</div>

@* Плитки-карточки модулей убраны (решение заказчика 2026-08-25): навигация — меню слева,
   дашборд — отдельный экран (/dashboard). Главная — строгая визитка с гербом. *@
