<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ISC.AI.Abstractions\ISC.AI.Abstractions.csproj" />
  </ItemGroup>

  <!-- Инфраструктура данных ядра: CoreDbContext (схема core), pgvector, аудит, миграции. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Argon2id для локальной идентичности (Э4-35 §6.5). Sodium.Core — MIT, нативный libsodium —
         ISC (пермиссивная). Та же библиотека, которой хеширует СКИД: формат PHC совпадает, поэтому
         перенесённые учётки входят без смены пароля. -->
    <PackageReference Include="Sodium.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- PMC-командлеты Update-Database / Add-Migration (dev-only; включает …Design как зависимость). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
