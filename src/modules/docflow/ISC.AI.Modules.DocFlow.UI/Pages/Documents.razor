@namespace ISC.AI.Modules.DocFlow.UI
@* Реестр документов (ТЗ СКИД §3.2/§3.4): список с фильтрами, регистрация, переход в карточку.
   Э4-35 этап 5.1 — перенос списка документов СКИД. Компоненты профиля не используются (ADR-0017). *@
@page "/docflow/documents"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using ISC.AI.Abstractions.Application
@using ISC.AI.Modules.DocFlow.Application.Features.Documents
@using ISC.AI.Modules.DocFlow.Application.Features.Assignments
@using ISC.AI.Modules.DocFlow.Application.Features.Comments
@using ISC.AI.Modules.DocFlow.Application.Features.Directory
@using ISC.AI.Modules.DocFlow.Application.Features.DocumentTypes
@using ISC.AI.Modules.DocFlow.Domain.Enums
@using ISC.AI.Modules.DocFlow.Domain.Services

<div class="d-flex align-center justify-space-between flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h5">Документы</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Реестр документооборота · «Исполнение» раздаётся назначениями по подразделениям
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
               OnClick="@(() => Navigation.NavigateTo("/docflow/documents/new"))">
        Зарегистрировать
    </MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@* --- Фильтры (§3.4) --- *@
<MudPaper Outlined="true" Class="pa-3 my-4">
    <div class="d-flex gap-3 align-end flex-wrap">
        <MudTextField @bind-Value="_filterText" Label="Рег. номер или ключевые слова" Variant="Variant.Outlined"
                      Immediate="true" Style="min-width:260px;" Class="flex-grow-1"
                      OnKeyDown="@(async e => { if (e.Key == "Enter") { await SearchAsync(); } })" />
        <MudSelect T="int?" @bind-Value="_filterTypeId" Label="Тип" Variant="Variant.Outlined" Clearable="true"
                   Style="width:220px;">
            @foreach (var type in VisibleTypes)
            {
                <MudSelectItem T="int?" Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="DocumentAggregatedStatus?" @bind-Value="_filterStatus" Label="Статус" Variant="Variant.Outlined"
                   Clearable="true" Style="width:220px;">
            @foreach (var status in Enum.GetValues<DocumentAggregatedStatus>())
            {
                <MudSelectItem T="DocumentAggregatedStatus?" Value="@status">@status.Label()</MudSelectItem>
            }
        </MudSelect>
    </div>

    <div class="d-flex gap-3 align-end flex-wrap mt-3">
        <MudSelect T="DocumentGroup?" @bind-Value="_filterGroup" Label="Группа" Variant="Variant.Outlined"
                   Clearable="true" Style="width:180px;">
            @foreach (var group in Enum.GetValues<DocumentGroup>())
            {
                <MudSelectItem T="DocumentGroup?" Value="@group">@group.Label()</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="DocumentPriority?" @bind-Value="_filterPriority" Label="Приоритет" Variant="Variant.Outlined"
                   Clearable="true" Style="width:180px;">
            @foreach (var priority in Enum.GetValues<DocumentPriority>())
            {
                <MudSelectItem T="DocumentPriority?" Value="@priority">@priority.Label()</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_filterDivisionId" Label="Подразделение" Variant="Variant.Outlined"
                   Clearable="true" Style="width:220px;">
            @foreach (var division in _divisions)
            {
                <MudSelectItem T="int?" Value="@division.Id">@division.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_filterInspectorId" Label="Инспектор" Variant="Variant.Outlined"
                   Clearable="true" Style="width:220px;">
            @foreach (var user in _users)
            {
                <MudSelectItem T="int?" Value="@user.Id">@user.Name</MudSelectItem>
            }
        </MudSelect>
        @* Ширина календарей — ОБЁРТКОЙ, не Style: MudBlazor копирует Style пикера на раскрытый
           календарь, и попап сжимался до ширины поля (дата в шапке обрезалась до года). *@
        <div style="width:180px;">
            <MudDatePicker @bind-Date="_filterFrom" Label="Зарегистрирован с" Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy" Clearable="true" />
        </div>
        <div style="width:180px;">
            <MudDatePicker @bind-Date="_filterTo" Label="по" Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy" Clearable="true" />
        </div>

        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search"
                   OnClick="SearchAsync" Disabled="_busy">Найти</MudButton>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff"
                   OnClick="@(async () => { ResetFilters(); await SearchAsync(); })" Disabled="_busy">
            Сбросить
        </MudButton>
    </div>
</MudPaper>

<MudTable T="DocumentListItem" Items="_items" Hover="true" Dense="true" Outlined="true" Loading="_busy"
          LoadingProgressColor="Color.Primary" OnRowClick="@(row => OpenCard(row.Item!))" RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>Рег. №</MudTh>
        <MudTh>Дата</MudTh>
        <MudTh>Тип</MudTh>
        <MudTh>Краткое содержание</MudTh>
        <MudTh>Приоритет</MudTh>
        <MudTh>Статус</MudTh>
        <MudTh>Назнач.</MudTh>
        <MudTh>Гриф</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Рег. №">@(context.RegNumber ?? "—")</MudTd>
        <MudTd DataLabel="Дата">@context.RegDate.ToString("dd.MM.yyyy")</MudTd>
        <MudTd DataLabel="Тип">
            @context.TypeName
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Group.Label()</MudText>
        </MudTd>
        <MudTd DataLabel="Содержание" Style="max-width:340px;">
            <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                @context.ShortContent
            </MudText>
        </MudTd>
        <MudTd DataLabel="Приоритет">@(context.Priority?.Label() ?? "—")</MudTd>
        <MudTd DataLabel="Статус">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@context.AggregatedStatus.ChipColor()">
                @context.AggregatedStatus.Label()
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Назнач.">@context.AssignmentsCount</MudTd>
        <MudTd DataLabel="Гриф">
            @if (context.Classification > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@context.Classification</MudChip>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @* Пустая выдача может значить И «документов нет», И «вам их не видно» — сервер эти случаи
           намеренно не различает (недоступное неотличимо от несуществующего, ТБ-020/021). Поэтому
           текст не утверждает, что реестр пуст: прежняя формулировка «Документов нет» вводила в
           заблуждение, когда причина была в неназначенной роли (найдено заказчиком, 6.4.1). *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
            Здесь пусто. Либо документов ещё нет — зарегистрируйте первый кнопкой выше, либо они вне
            вашего доступа: показываются только документы в пределах вашего допуска (гриф и
            подразделение) и вашей роли (§2.1 ТЗ). Роль назначается в разделе «Администрирование».
        </MudText>
    </NoRecordsContent>
</MudTable>

@* Навигация показывается, только когда есть что листать: на пустой выдаче она бессмысленна. *@
@if (_total > 0)
{
    <div class="d-flex align-center justify-space-between mt-3 flex-wrap gap-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Документов: @_total · страница @_page из @PageCount
        </MudText>
        <MudPagination Count="@PageCount" Selected="_page" SelectedChanged="GoToPageAsync"
                       Color="Color.Primary" Size="Size.Small" />
    </div>
}

@code {
    /// <summary>Размер страницы реестра. 25 — столько помещается на экран без прокрутки шапки.</summary>
    private const int PageSize = 25;

    private readonly List<DocumentListItem> _items = [];
    private readonly List<DocumentTypeItem> _types = [];
    private IReadOnlyList<DivisionItem> _divisions = [];
    private IReadOnlyList<UserItem> _users = [];

    private string? _filterText;
    private DocumentGroup? _filterGroup;
    private int? _filterTypeId;
    private DocumentAggregatedStatus? _filterStatus;
    private DocumentPriority? _filterPriority;
    private int? _filterInspectorId;
    private int? _filterDivisionId;
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    private int _page = 1;
    private int _total;
    private bool _busy;
    private string? _error;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    // Типы сужаются выбранной группой: «Исполнение» и «Хранение» — разные наборы, и предлагать
    // тип чужой группы значит предлагать заведомо пустую выдачу.
    private IEnumerable<DocumentTypeItem> VisibleTypes =>
        _filterGroup is { } group ? _types.Where(t => t.Group == group) : _types;

    protected override async Task OnInitializedAsync()
    {
        var typesResponse = await Dispatcher.Send(new ListDocumentTypesQuery());
        if (typesResponse is { Status: true, Data: { } types })
        {
            _types.AddRange(types);
        }

        var divisions = await Dispatcher.Send(new ListDivisionsQuery());
        if (divisions is { Status: true, Data: { } divisionList })
        {
            _divisions = divisionList;
        }

        var users = await Dispatcher.Send(new ListUsersQuery());
        if (users is { Status: true, Data: { } userList })
        {
            _users = userList;
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Применить отбор. ВСЕГДА возвращает на первую страницу: после сужения фильтра пользователь
    /// иначе остаётся на странице, которой в новой выборке уже нет, и видит пустоту вместо результатов.
    /// </summary>
    private Task SearchAsync()
    {
        _page = 1;
        return ReloadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return ReloadAsync();
    }

    private void ResetFilters()
    {
        _filterText = null;
        _filterGroup = null;
        _filterTypeId = null;
        _filterStatus = null;
        _filterPriority = null;
        _filterInspectorId = null;
        _filterDivisionId = null;
        _filterFrom = null;
        _filterTo = null;
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new ListDocumentsQuery(
                _filterText,
                _filterGroup,
                _filterTypeId,
                _filterStatus,
                _filterPriority,
                _filterInspectorId,
                _filterDivisionId,
                _filterFrom is { } from ? DateOnly.FromDateTime(from) : null,
                _filterTo is { } to ? DateOnly.FromDateTime(to) : null,
                _page,
                PageSize));

            _items.Clear();
            if (response is { Status: true, Data: { } data })
            {
                _items.AddRange(data.Rows);
                _total = data.TotalCount;
            }
            else if (response is { Status: false })
            {
                _error = response.StatusMessage;
                _total = 0;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenCard(DocumentListItem item) =>
        Navigation.NavigateTo($"/docflow/documents/{item.Id}");
}
