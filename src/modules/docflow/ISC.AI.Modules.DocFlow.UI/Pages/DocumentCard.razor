@namespace ISC.AI.Modules.DocFlow.UI
@* Карточка документа (ТЗ СКИД §3.2, §4.1–4.6): атрибуты, назначения со статусами, смена статуса по
   матрице §4.5 и продление срока §4.6. Файлы и таймлайн истории — этап 4/3.x Э4-35. *@
@page "/docflow/documents/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISC.AI.Abstractions.Security.IAccessContextProvider AccessProvider
@using ISC.AI.Abstractions.Application
@using ISC.AI.Modules.DocFlow.Application.Documents
@using ISC.AI.Modules.DocFlow.Domain.Enums
@using ISC.AI.Modules.DocFlow.Domain.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@if (_details is null)
{
    <MudText Typo="Typo.h5">Документ</MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3">@_error</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
}
else
{
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <div>
            <MudText Typo="Typo.h5">
                @(_details.RegNumber is { } number ? $"Документ {number}" : "Документ (без номера)")
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @_details.TypeName · @_details.Group.Label() · @_details.Direction.Label() ·
                зарегистрирован @_details.RegDate.ToString("dd.MM.yyyy")
            </MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudChip T="string" Variant="Variant.Text" Color="@_details.AggregatedStatus.ChipColor()">
                @_details.AggregatedStatus.Label()
            </MudChip>
            @if (_details.Classification > 0)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Text">гриф @_details.Classification</MudChip>
            }
            @* Этап 7 Э4-35: документ в корпусе ИИ — чат может отвечать по нему (грунтованный режим). *@
            @if (_details.IndexedAt is { } indexedAt)
            {
                <MudTooltip Text="@($"Проиндексирован {indexedAt.ToLocalTime():dd.MM.yyyy HH:mm} — доступен ИИ-ассистенту")">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.AutoAwesome">в корпусе ИИ</MudChip>
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="Индексация выполняется фоном после регистрации; можно запустить вручную">
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Text">не в корпусе</MudChip>
                </MudTooltip>
            }
            @* Правка реквизитов — отдельной страницей (§3.2). Проверку «кому можно» делает сценарий:
               кнопку видно всем, но недоступный документ и сохранить нельзя. *@
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/docflow/documents/{Id}/edit"))">
                Изменить
            </MudButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                <MudMenuItem OnClick="ReindexAsync">Переиндексировать в корпусе ИИ</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("/docflow/documents"))">К списку</MudButton>
        </div>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 my-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Содержание</MudText>
        <MudText Typo="Typo.body1" Style="white-space:pre-wrap;">@_details.ShortContent</MudText>
        @if (!string.IsNullOrWhiteSpace(_details.FullText))
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_details.FullText</MudText>
        }
        <div class="d-flex gap-4 flex-wrap mt-3">
            @if (_details.Source is { } source)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Источник: @source</MudText>
            }
            @if (_details.Priority is { } priority)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Приоритет: @priority.Label()</MudText>
            }
            @if (_details.InspectorUserId is { } inspector)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Инспектор: @UserName(inspector)</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Подразделение: @DivisionName(_details.DivisionId)</MudText>
            @if (_details.Notes is { } notes)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Примечания: @notes</MudText>
            }
        </div>
    </MudPaper>

    @* --- Файлы (§3.3): версионируемый файл документа + сопутствующие; просмотр — этап 4.3 --- *@
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.subtitle1">Файлы документа (§3.3 — замена создаёт новую версию)</MudText>
            <div class="d-flex align-center gap-2">
                <MudSelect T="DocumentLanguage" @bind-Value="_uploadLanguage" Dense="true" Style="width:150px;"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Russian">Русский</MudSelectItem>
                    <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Kyrgyz">Кыргызский</MudSelectItem>
                    <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Unspecified">Без языка</MudSelectItem>
                </MudSelect>
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadDocumentFileAsync">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.UploadFile">Загрузить файл</MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            </div>
        </div>
        @if (_details.Files.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Файлов пока нет.</MudText>
        }
        else
        {
            @foreach (var file in _details.Files)
            {
                <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small"
                             Color="@(file.IsLatest ? Color.Primary : Color.Default)" />
                    <MudText Typo="Typo.body2">@file.FileName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(file.IsLatest ? Color.Primary : Color.Default)">v@(file.Version)</MudChip>
                    @if (!file.IsLatest)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">(прежняя версия)</MudText>
                    }
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @FormatSize(file.FileSize) · @file.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                    @if (HasInlinePreview(file.FileName))
                    {
                        <MudLink Typo="Typo.caption" Style="cursor:pointer;"
                                 OnClick="@(() => OpenFilePreview(FileCategories.Documents, file.StoredFileName, file.FileName))">Просмотр</MudLink>
                    }
                    else
                    {
                        <MudLink Href="@FileUrl(FileCategories.Documents, file.StoredFileName)"
                                 Target="_blank" Typo="Typo.caption">Просмотр</MudLink>
                    }
                    <MudLink Href="@FileUrl(FileCategories.Documents, file.StoredFileName, download: true)"
                             Typo="Typo.caption">Скачать</MudLink>
                </div>
            }
        }

        <MudDivider Class="my-2" />
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-1">
            <MudText Typo="Typo.subtitle2">Сопутствующие файлы</MudText>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadAttachmentAsync">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AttachFile">Прикрепить</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>
        @if (_details.Attachments.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Вложений нет.</MudText>
        }
        else
        {
            @foreach (var attachment in _details.Attachments)
            {
                <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@attachment.FileName</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatSize(attachment.FileSize)</MudText>
                    @if (HasInlinePreview(attachment.FileName))
                    {
                        <MudLink Typo="Typo.caption" Style="cursor:pointer;"
                                 OnClick="@(() => OpenFilePreview(FileCategories.Attachments, attachment.StoredFileName, attachment.FileName))">Просмотр</MudLink>
                    }
                    else
                    {
                        <MudLink Href="@FileUrl(FileCategories.Attachments, attachment.StoredFileName)"
                                 Target="_blank" Typo="Typo.caption">Просмотр</MudLink>
                    }
                    <MudLink Href="@FileUrl(FileCategories.Attachments, attachment.StoredFileName, download: true)"
                             Typo="Typo.caption">Скачать</MudLink>
                </div>
            }
        }
    </MudPaper>

    @if (_details.Group == DocumentGroup.Execution)
    {
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.subtitle1">Назначения (§4.1) — каждое исполняется независимо</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAddAssignmentDialog">Добавить назначение</MudButton>
        </div>
        <MudTable T="AssignmentDetails" Items="_details.Assignments" Dense="true" Outlined="true" Hover="true">
            <HeaderContent>
                <MudTh>Подразделение</MudTh>
                <MudTh>Исполнитель</MudTh>
                <MudTh>Срок</MudTh>
                <MudTh>Статус</MudTh>
                <MudTh Style="width:1%;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Подразделение">@DivisionName(context.DivisionId)</MudTd>
                <MudTd DataLabel="Исполнитель">@(context.AssigneeUserId is { } assignee ? UserName(assignee) : "—")</MudTd>
                <MudTd DataLabel="Срок">@(context.Deadline?.ToString("dd.MM.yyyy") ?? "—")</MudTd>
                <MudTd DataLabel="Статус">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@context.Status.ChipColor()">
                        @context.Status.Label()
                    </MudChip>
                    @if (context.Status == AssignmentStatus.InControl && context.ControllerUserId is { } controller)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">контролёр: @UserName(controller)</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                        @foreach (var next in StatusTransitionMatrix.AllowedFrom(context.Status))
                        {
                            <MudMenuItem OnClick="@(() => OpenStatusDialog(context, next))">→ @next.Label()</MudMenuItem>
                        }
                        @if (context.Status != AssignmentStatus.Closed && context.Deadline is not null)
                        {
                            <MudMenuItem OnClick="@(() => OpenExtendDialog(context))">Продлить срок (§4.6)</MudMenuItem>
                        }
                        @* §4.7: исполненное и снятое переназначать нельзя — кнопку не рисуем, но
                           решает всё равно сервер (на «кнопку не покажем» не полагаемся). *@
                        @if (context.Status is not (AssignmentStatus.Done or AssignmentStatus.Closed))
                        {
                            <MudMenuItem OnClick="@(() => OpenReassignDialog(context))">
                                Переназначить исполнителя (§4.7)
                            </MudMenuItem>
                        }
                        <MudMenuItem OnClick="@(() => OpenTimelineAsync(context))">История назначения (§4.8)</MudMenuItem>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* --- Комментарии (§4.8): обсуждение с ответами, упоминаниями и файлами --- *@
    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Комментарии (§4.8)</MudText>

        @if (_comments.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Комментариев пока нет.</MudText>
        }
        else
        {
            @* Корневые по порядку, ответы — под своим родителем (лента уже отсортирована сервером). *@
            @foreach (var root in _comments.Where(c => c.ParentCommentId is null))
            {
                @RenderComment(root, 0)
                @foreach (var reply in _comments.Where(c => c.ParentCommentId == root.Id))
                {
                    @RenderComment(reply, 1)
                }
            }
        }

        <MudDivider Class="my-3" />
        @if (_replyTo is { } replyTarget)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                Ответ на комментарий @UserName(replyTarget.AuthorUserId)
                <MudLink Typo="Typo.caption" Class="ml-2" OnClick="@(() => _replyTo = null)">отменить</MudLink>
            </MudText>
        }
        <MudTextField @bind-Value="_commentText" Label="@(_editingCommentId is null ? "Новый комментарий" : "Изменение комментария")"
                      Variant="Variant.Outlined" Lines="2" AutoGrow="true" MaxLines="10"
                      MaxLength="AddCommentValidator.MaxContentLength" Class="mb-2" />
        <div class="d-flex align-center gap-2 flex-wrap">
            @* Вид и файлы — только у НОВОГО комментария: при правке меняется лишь текст (как в СКИД). *@
            @if (_editingCommentId is null)
            {
                <MudSelect T="CommentType" @bind-Value="_commentType" Label="Вид" Variant="Variant.Outlined"
                           Dense="true" Margin="Margin.Dense" Style="width:180px;">
                    @foreach (var type in Enum.GetValues<CommentType>())
                    {
                        <MudSelectItem T="CommentType" Value="@type">@type.Label()</MudSelectItem>
                    }
                </MudSelect>
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="@(files => _commentFiles = files)">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile">
                            Файлы@(_commentFiles is { Count: > 0 } cf ? $" — {cf.Count}" : "")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                       Disabled="@(_commentBusy || string.IsNullOrWhiteSpace(_commentText))" OnClick="SubmitCommentAsync">
                @(_editingCommentId is null ? "Отправить" : "Сохранить")
            </MudButton>
            @if (_editingCommentId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">Отмена</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
            Упоминание участника — токеном <code>@@[Имя](user:ID)</code>; сохраняются только реально
            упомянутые в тексте существующие пользователи. Файлы: PDF, DOCX, PNG, JPEG, до 10 МБ, не больше 5.
        </MudText>
    </MudPaper>
}

@* --- Диалог смены статуса (§4.2: комментарий на переходе) --- *@
<MudDialog @bind-Visible="_statusDialogOpen" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Переход: @(_statusTarget?.Status.Label()) → @(_statusNext?.Label())</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_statusComment" Label="Комментарий к переходу (опц.)" Variant="Variant.Outlined"
                      MaxLength="2000" Lines="2" AutoGrow="true" AutoFocus="true" Class="mb-2" />
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="@(files => _statusFiles = files)">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile">
                    Файлы к переходу (§4.2)@(_statusFiles is { Count: > 0 } sf ? $" — {sf.Count}" : "")
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _statusDialogOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmStatusAsync">Сменить статус</MudButton>
    </DialogActions>
</MudDialog>

@* --- Диалог продления срока (§4.6: основание обязательно) --- *@
<MudDialog @bind-Visible="_extendDialogOpen" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Продление срока назначения</MudText>
    </TitleContent>
    <DialogContent>
        <MudDatePicker @bind-Date="_extendDate" Label="Новый срок *" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField @bind-Value="_extendReason" Label="Основание продления *" Variant="Variant.Outlined"
                      MaxLength="2000" Lines="2" AutoGrow="true" Class="mb-2" />
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="@(files => _extendFiles = files)">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile">
                    Файлы-обоснования (§4.6)@(_extendFiles is { Count: > 0 } ef ? $" — {ef.Count}" : "")
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _extendDialogOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_extendDate is null || string.IsNullOrWhiteSpace(_extendReason))"
                   OnClick="ConfirmExtendAsync">Продлить</MudButton>
    </DialogActions>
</MudDialog>

@* --- Добавление назначения к уже зарегистрированному документу (§4.1). Список подразделений
   ПОЛНЫЙ: назначение — «кому поручено исполнить», а не поле видимости. Срок здесь всегда
   индивидуальный — «единый срок» действует только на назначения, созданные при регистрации. --- *@
<MudDialog @bind-Visible="_addAssignmentOpen" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Добавить назначение</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="int?" @bind-Value="_addDivisionId" Label="Подразделение *" Variant="Variant.Outlined"
                   Class="mb-2">
            @foreach (var division in _divisionNames)
            {
                <MudSelectItem T="int?" Value="@division.Key">@division.Value</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_addAssigneeUserId" Label="Исполнитель (необязательно)"
                   Variant="Variant.Outlined" Clearable="true" Class="mb-2">
            @foreach (var user in _userNames)
            {
                <MudSelectItem T="int?" Value="@user.Key">@user.Value</MudSelectItem>
            }
        </MudSelect>
        <MudDatePicker @bind-Date="_addDeadline" Label="Срок (необязательно)" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
            Исполнителю должно быть разрешено это подразделение — иначе он не увидит порученный документ.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addAssignmentOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_addDivisionId is null)"
                   OnClick="ConfirmAddAssignmentAsync">Добавить</MudButton>
    </DialogActions>
</MudDialog>

@* --- Переназначение исполнителя (§4.7): срок и статус сохраняются, основание необязательно. --- *@
<MudDialog @bind-Visible="_reassignOpen" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Переназначить исполнителя</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="int?" @bind-Value="_reassignUserId" Label="Новый исполнитель *" Variant="Variant.Outlined"
                   Class="mb-2">
            @* Текущий исполнитель из списка исключён: переназначение на него самого — не изменение
               (в СКИД он оставался в списке, и такой выбор порождал ложное уведомление). *@
            @foreach (var user in _userNames.Where(u => u.Key != _reassignTarget?.AssigneeUserId))
            {
                <MudSelectItem T="int?" Value="@user.Key">@user.Value</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_reassignReason" Label="Основание (необязательно)" Variant="Variant.Outlined"
                      MaxLength="2000" Lines="2" AutoGrow="true" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
            Срок и статус назначения не меняются: новый исполнитель наследует срок прежнего.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _reassignOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_reassignUserId is null)"
                   OnClick="ConfirmReassignAsync">Переназначить</MudButton>
    </DialogActions>
</MudDialog>

@* --- История назначения (§4.8): переходы статусов и продления сроков ОДНОЙ хронологией. Данные
   писались с этапа 3.1, но показать их было негде. Системные переходы («Просрочено» ставит фоновая
   проверка) помечаются явно — у них нет пользователя-автора. --- *@
<MudDialog @bind-Visible="_timelineOpen" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">История назначения</MudText>
    </TitleContent>
    <DialogContent>
        @if (_timelineBusy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_timeline.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Событий пока нет.</MudText>
        }
        else
        {
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @foreach (var item in _timeline)
                {
                    <MudTimelineItem Color="@TimelineColor(item)" Size="Size.Small">
                        <MudText Typo="Typo.body2"><b>@TimelineTitle(item)</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @item.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm",
                                System.Globalization.CultureInfo.InvariantCulture)
                            ·
                            @(item.ActorUserId is { } actor ? UserName(actor) : "система")
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">@item.Comment</MudText>
                        }
                        @foreach (var file in item.Files)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.AttachFile" Class="mt-1"
                                       OnClick="@(() => OpenTimelineFile(file))">
                                @file.FileName
                            </MudButton>
                        }
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _timelineOpen = false)">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@* --- Предпросмотр файла в диалоге (§3.3 «просмотр без скачивания», этап 4.3): DOCX — клиентский
   рендер docx-preview (JS-интероп в OnAfterRenderAsync), PDF — встроенный просмотрщик браузера
   (iframe на тот же защищённый URL — допуск проверяет сервер, ТБ-020/021). --- *@
<MudDialog @bind-Visible="_filePreviewOpen" Options="FilePreviewDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@_filePreviewFileName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_filePreviewStatus == FilePreviewStatus.Unavailable)
        {
            @* Единое сообщение без различения причин (ТБ-020/021, решение «404, не 403»): требуемый
               гриф/подразделение НЕ называются — иначе сообщение само раскрывало бы режимные атрибуты. *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                Файл недоступен: он не существует либо находится вне вашего допуска (гриф/подразделение).
            </MudAlert>
        }
        else if (_filePreviewStatus == FilePreviewStatus.LegacyDoc)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Это файл старого формата Word (.doc) — предпросмотр в браузере для него недоступен.
                Нажмите «Скачать» и откройте его в текстовом редакторе.
            </MudAlert>
        }
        else if (_filePreviewStatus == FilePreviewStatus.Error)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                Не удалось отобразить предпросмотр. Попробуйте «Скачать».
                @if (_filePreviewError is { } detail)
                {
                    <MudText Typo="Typo.caption" Class="d-block mt-1">Причина: @detail</MudText>
                }
            </MudAlert>
        }
        else if (_filePreviewKind == FilePreviewKind.Pdf)
        {
            @if (_filePreviewObjectUrl is { } pdfUrl)
            {
                <iframe src="@pdfUrl" class="docflow-pdf-frame" title="@_filePreviewFileName"></iframe>
            }
        }
        else if (_filePreviewKind == FilePreviewKind.Image)
        {
            @if (_filePreviewObjectUrl is { } imageUrl)
            {
                @* <img> скрипты не исполняет (в отличие от открытия того же SVG вкладкой) — безопаснее прежнего. *@
                <img src="@imageUrl" class="docflow-image-preview" alt="@_filePreviewFileName" />
            }
        }
        else
        {
            <div class="docflow-docx-container" id="@_docxPreviewContainerId"></div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _filePreviewOpen = false)">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@* Один комментарий ленты; level=1 — ответ (визуальный отступ). Текст выводится ТОЛЬКО как текст
   (MudText), без разметки: рендер Markdown в HTML сознательно не переносится — это прямой канал
   stored-XSS (в этой же сессии такие уже находили в предпросмотре файлов), а вводит текст пользователь. *@
@code {
    private RenderFragment RenderComment(CommentItem comment, int level) =>
        @<div class="@(level > 0 ? "ml-8 mb-2" : "mb-2")">
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudText Typo="Typo.body2"><b>@comment.AuthorName</b></MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@comment.CommentType.ChipColor()">
                    @comment.CommentType.Label()
                </MudChip>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </MudText>
                @if (comment.IsEdited && !comment.IsDeleted)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">(изменено)</MudText>
                }
                @if (comment.IsResolved)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">закрыто</MudChip>
                }
            </div>

            @if (comment.IsDeleted)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary"><i>Комментарий удалён</i></MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@comment.Content</MudText>

                @if (comment.Mentions.Count > 0)
                {
                    <div class="d-flex align-center gap-1 flex-wrap mt-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Упомянуты:</MudText>
                        @foreach (var mention in comment.Mentions)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@mention.Name</MudChip>
                        }
                    </div>
                }

                @foreach (var file in comment.Files)
                {
                    <div class="d-flex align-center gap-2 mt-1 flex-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                        <MudText Typo="Typo.caption">@file.FileName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatSize(file.FileSize)</MudText>
                        <MudLink Href="@FileUrl(CommentsCategory, file.StoredFileName, download: true)"
                                 Typo="Typo.caption">Скачать</MudLink>
                    </div>
                }

                <div class="d-flex align-center gap-2 mt-1">
                    @* Ответ — только на корневой: ветка одноуровневая (в СКИД глубина не ограничена,
                       но и смысла в ветках глубже одной нет — упрощение зафиксировано в Э4-35). *@
                    @if (comment.ParentCommentId is null)
                    {
                        <MudLink Typo="Typo.caption" OnClick="@(() => StartReply(comment))">Ответить</MudLink>
                        <MudLink Typo="Typo.caption"
                                 OnClick="@(() => SetResolvedAsync(comment, !comment.IsResolved))">
                            @(comment.IsResolved ? "Открыть заново" : "Закрыть обсуждение")
                        </MudLink>
                    }
                    @if (comment.AuthorUserId == _currentUserId)
                    {
                        <MudLink Typo="Typo.caption" OnClick="@(() => StartEdit(comment))">Изменить</MudLink>
                        <MudLink Typo="Typo.caption" OnClick="@(() => DeleteCommentAsync(comment))">Удалить</MudLink>
                    }
                </div>
            }
        </div>;

    /// <summary>Идентификатор документа из маршрута.</summary>
    [Parameter]
    public int Id { get; set; }

    private static readonly DialogOptions DialogOptions =
        new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

    private static readonly DialogOptions FilePreviewDialogOptions =
        new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };

    private DocumentDetails? _details;
    private readonly Dictionary<int, string> _divisionNames = [];
    private readonly Dictionary<int, string> _userNames = [];
    private string? _error;

    private bool _statusDialogOpen;
    private AssignmentDetails? _statusTarget;
    private AssignmentStatus? _statusNext;
    private string? _statusComment;
    private IReadOnlyList<IBrowserFile>? _statusFiles;

    private bool _extendDialogOpen;
    private AssignmentDetails? _extendTarget;

    // Добавление назначения (§4.1) и переназначение исполнителя (§4.7).
    private bool _addAssignmentOpen;
    private int? _addDivisionId;
    private int? _addAssigneeUserId;
    private DateTime? _addDeadline;

    private bool _reassignOpen;
    private AssignmentDetails? _reassignTarget;
    private int? _reassignUserId;
    private string? _reassignReason;

    // Лента событий назначения (§4.8): идентификатор нужен и для загрузки, и для ссылок на файлы —
    // у файлов переходов/продлений родитель в маршруте раздачи именно назначение.
    private IReadOnlyList<AssignmentTimelineEvent> _timeline = [];
    private int _timelineAssignmentId;
    private bool _timelineOpen;
    private bool _timelineBusy;
    private DateTime? _extendDate;
    private string? _extendReason;
    private IReadOnlyList<IBrowserFile>? _extendFiles;

    private const string DocxPreviewModulePath = "./_content/ISC.AI.Modules.DocFlow.UI/js/docxPreview.js";

    private enum FilePreviewKind { Docx, Pdf, Image }

    private enum FilePreviewStatus { Ok, LegacyDoc, Error, Unavailable }

    /// <summary>Итог рендера DOCX от JS-модуля (<c>ok</c> | <c>legacy-doc</c> | <c>unavailable</c> | <c>error</c>).</summary>
    private sealed record DocxPreviewResult(string Status, string? Message);

    /// <summary>Итог выкачивания файла в blob-URL для iframe/img (<c>fetchFileToObjectUrl</c>).</summary>
    private sealed record FilePreviewFetchResult(string Status, string? ObjectUrl, string? Message);

    // Общее состояние диалога предпросмотра (DOCX/PDF/изображения).
    private bool _filePreviewOpen;
    private bool _filePreviewPending;
    private FilePreviewKind _filePreviewKind;
    private FilePreviewStatus _filePreviewStatus;
    private string? _filePreviewFileName;
    private string? _filePreviewUrl;
    // PDF/картинки показываются НЕ по прямому URL, а по blob-URL после fetch: иначе 404 эндпоинта
    // отрисовался бы в iframe страницей «Not Found» всей системы вместо аккуратного сообщения.
    private string? _filePreviewObjectUrl;
    private string? _filePreviewError;

    // Состояние ветки DOCX (JS-рендер в контейнер). Идентификатор контейнера уникален на каждое
    // открытие: узел прошлого диалога уже удалён, но по прежнему id его можно было бы подхватить —
    // с уникальным это исключено (см. docxPreview.js). Тот же счётчик — "поколение" предпросмотра:
    // защищает от гонки (открыли файл A, закрыли, открыли B — поздний ответ по A не должен
    // перезаписать уже показанный B, если он завершился позже).
    private string _docxPreviewContainerId = "docflow-docx-preview";
    private int _previewGeneration;
    private IJSObjectReference? _docxPreviewModule;

    private DocumentLanguage _uploadLanguage = DocumentLanguage.Russian;

    // --- Комментарии (§4.8) ---
    private const string CommentsCategory = "comments";
    private readonly List<CommentItem> _comments = [];
    private string _commentText = string.Empty;
    private CommentType _commentType = CommentType.Question;
    private IReadOnlyList<IBrowserFile>? _commentFiles;
    private CommentItem? _replyTo;
    private int? _editingCommentId;
    private bool _commentBusy;
    private int? _currentUserId;

    private const long MaxFileBytes = 25L * 1024 * 1024;

    // FileCategories не публичен из Domain (живёт в Data) — строки здесь ТОЛЬКО отражают маршрут
    // раздачи ("documents"/"attachments"), не завязаны на реализацию хранилища. parentId для ОБЕИХ
    // категорий — Id документа (карточки): и файл документа, и вложение хранятся под ним (этап 4.2).
    /// <summary>
    /// Ссылка раздачи файла. <paramref name="parentId"/> по умолчанию — идентификатор ДОКУМЕНТА, но
    /// у файлов переходов и продлений родитель в маршруте — НАЗНАЧЕНИЕ (см. DocumentFileAccessResolver):
    /// подставить документ значило бы получить единый 404 «файла нет».
    /// </summary>
    private string FileUrl(string category, string storedFileName, bool download = false, int? parentId = null)
    {
        var url = $"/docflow/files/{category}/{parentId ?? Id}/{storedFileName}";
        return download ? url + "?download=true" : url;
    }

    private static class FileCategories
    {
        public const string Documents = "documents";
        public const string Attachments = "attachments";
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.#} МБ",
        >= 1024 => $"{bytes / 1024.0:0.#} КБ",
        _ => $"{bytes} Б",
    };

    // .doc тоже ведём в предпросмотр: расширение не гарантирует формат — переименованный OOXML
    // отрисуется, настоящий двоичный OLE2 распознается по сигнатуре и даст точное сообщение (JS-модуль).
    private static bool IsWordDocument(string fileName) =>
        fileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase)
        || fileName.EndsWith(".doc", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdf(string fileName) => fileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    // Растровые/векторные форматы, которые браузер отображает в <img> (tiff намеренно нет — не умеет).
    private static readonly string[] ImageExtensions = [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp", ".svg"];

    private static bool IsImage(string fileName) =>
        ImageExtensions.Any(extension => fileName.EndsWith(extension, StringComparison.OrdinalIgnoreCase));

    // Форматы, открываемые в диалоге; остальные («иное») — прежней ссылкой в новой вкладке.
    private static bool HasInlinePreview(string fileName) =>
        IsWordDocument(fileName) || IsPdf(fileName) || IsImage(fileName);

    // БЕЗОПАСНОСТЬ (аудит 2026-08-06): MIME для blob'а предпросмотра выбираем САМИ, по формату, под
    // который рендерим ветку UI, — НЕ доверяем Content-Type, вернувшемуся с сервера (для вложений он
    // равен тому, что назвал загрузивший файл, см. FileRules — вложения намеренно без ограничения
    // типа). Если реальные байты не совпадают с объявленным типом, браузер не сможет их выполнить как
    // HTML — максимум не отрисует как PDF/картинку.
    private static string ResolvePreviewMimeType(FilePreviewKind kind, string fileName) => kind switch
    {
        FilePreviewKind.Pdf => "application/pdf",
        FilePreviewKind.Image => Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".bmp" => "image/bmp",
            ".webp" => "image/webp",
            ".svg" => "image/svg+xml",
            _ => "application/octet-stream",
        },
        _ => "application/octet-stream",
    };

    // Открывает диалог; содержимое готовится на следующем OnAfterRenderAsync (для DOCX появление
    // контейнера ждёт JS-сторона — диалог рисует ДРУГОЙ компонент, провайдер, его рендер с нашим
    // не синхронен; для PDF/картинок сперва выкачивается blob и лишь потом появляется iframe/img).
    private void OpenFilePreview(string category, string storedFileName, string fileName, int? parentId = null)
    {
        _filePreviewFileName = fileName;
        _filePreviewUrl = FileUrl(category, storedFileName, download: false, parentId);
        _filePreviewKind = IsPdf(fileName) ? FilePreviewKind.Pdf
            : IsImage(fileName) ? FilePreviewKind.Image
            : FilePreviewKind.Docx;
        _filePreviewStatus = FilePreviewStatus.Ok;
        _filePreviewError = null;
        _filePreviewObjectUrl = null;

        var generation = ++_previewGeneration;
        if (_filePreviewKind == FilePreviewKind.Docx)
        {
            _docxPreviewContainerId = $"docflow-docx-preview-{generation}";
        }

        _filePreviewOpen = true;
        _filePreviewPending = true;
    }

    // Байты браузерных файлов → UploadedFile (лимит на файл — как в валидаторе; итог проверит сервер).
    private static async Task<List<UploadedFile>> ReadFilesAsync(IEnumerable<IBrowserFile> files)
    {
        var result = new List<UploadedFile>();
        foreach (var file in files)
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxFileBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            result.Add(new UploadedFile(file.Name, file.ContentType, buffer.ToArray()));
        }

        return result;
    }

    private async Task UploadDocumentFileAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        try
        {
            var uploaded = (await ReadFilesAsync([file]))[0];
            var response = await Dispatcher.Send(new UploadDocumentFileCommand(
                Id, uploaded.FileName, uploaded.ContentType, uploaded.Content, _uploadLanguage));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
        }

        await ReloadAsync();
    }

    private async Task UploadAttachmentAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        try
        {
            var uploaded = (await ReadFilesAsync([file]))[0];
            var response = await Dispatcher.Send(new UploadAttachmentCommand(
                Id, uploaded.FileName, uploaded.ContentType, uploaded.Content));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
        }

        await ReloadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var divisions = await Dispatcher.Send(new ListDivisionsQuery());
        if (divisions is { Status: true, Data: { } divisionList })
        {
            foreach (var division in divisionList)
            {
                _divisionNames[division.Id] = division.Name;
            }
        }

        var users = await Dispatcher.Send(new ListUsersQuery());
        if (users is { Status: true, Data: { } userList })
        {
            foreach (var user in userList)
            {
                _userNames[user.Id] = user.Name;
            }
        }

        // Свой идентификатор — чтобы показать «Изменить»/«Удалить» только у своих комментариев.
        // Право на само действие проверяет СЕРВЕР (ICommentStore) — это лишь удобство UI.
        _currentUserId = (await AccessProvider.GetCurrentAsync()).NumericSubjectId;

        await ReloadAsync();
        await ReloadCommentsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_filePreviewPending || _filePreviewUrl is null)
        {
            return;
        }

        _filePreviewPending = false;

        // Снимок на момент запуска: пока ждём JS (await ниже), пользователь мог закрыть диалог и
        // открыть ДРУГОЙ файл — тогда поля компонента уже указывают на новый файл, а не на тот,
        // который мы сейчас обрабатываем. Работаем с локальными копиями, не с живыми полями.
        var generation = _previewGeneration;
        var containerId = _docxPreviewContainerId;
        var url = _filePreviewUrl;
        var kind = _filePreviewKind;
        var fileName = _filePreviewFileName ?? string.Empty;

        // Сбой JS-интеропа НЕЛЬЗЯ выпускать из OnAfterRenderAsync: необработанное исключение в методе
        // жизненного цикла рвёт circuit Blazor Server — страница перестаёт отвечать целиком, а не только
        // предпросмотр (лечится лишь перезагрузкой). Границу с браузером закрываем здесь.
        FilePreviewStatus status;
        string? error = null;
        string? objectUrl = null;
        try
        {
            _docxPreviewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DocxPreviewModulePath);

            if (kind == FilePreviewKind.Docx)
            {
                var result = await _docxPreviewModule.InvokeAsync<DocxPreviewResult>(
                    "renderDocxPreview", containerId, url);
                status = MapPreviewStatus(result?.Status);
                error = result?.Message;
            }
            else
            {
                var fetched = await _docxPreviewModule.InvokeAsync<FilePreviewFetchResult>(
                    "fetchFileToObjectUrl", url, ResolvePreviewMimeType(kind, fileName));
                status = MapPreviewStatus(fetched?.Status);
                error = fetched?.Message;

                if (status == FilePreviewStatus.Ok && fetched?.ObjectUrl is { } fetchedUrl)
                {
                    // Фрагмент управления просмотрщиком PDF (закрытая панель миниатюр: navpanes=0 —
                    // Adobe/Edge, pagemode=none — pdf.js; незнающие игнорируют) применим и к blob-URL.
                    objectUrl = kind == FilePreviewKind.Pdf
                        ? fetchedUrl + "#navpanes=0&pagemode=none"
                        : fetchedUrl;
                }
                else if (status == FilePreviewStatus.Ok)
                {
                    status = FilePreviewStatus.Error;
                }
            }
        }
        catch (JSException ex)
        {
            status = FilePreviewStatus.Error;
            error = ex.Message;
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт — показывать пользователю нечего и негде.
            return;
        }

        // Поколение сменилось, пока мы ждали ответ, — результат устарел (относится к прежнему файлу
        // или прежнему открытию того же файла); применять его к текущему состоянию нельзя.
        if (generation != _previewGeneration)
        {
            return;
        }

        _filePreviewStatus = status;
        _filePreviewError = error;
        if (objectUrl is not null)
        {
            _filePreviewObjectUrl = objectUrl;
        }

        StateHasChanged();
    }

    private static FilePreviewStatus MapPreviewStatus(string? status) => status switch
    {
        "ok" => FilePreviewStatus.Ok,
        "legacy-doc" => FilePreviewStatus.LegacyDoc,
        "unavailable" => FilePreviewStatus.Unavailable,
        _ => FilePreviewStatus.Error,
    };

    public async ValueTask DisposeAsync()
    {
        if (_docxPreviewModule is not null)
        {
            try
            {
                // Отзыв blob-URL предпросмотров (иначе содержимое последнего файла живёт в памяти
                // вкладки до закрытия страницы), затем сам модуль.
                await _docxPreviewModule.InvokeVoidAsync("cleanup");
                await _docxPreviewModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт (навигация/разрыв соединения) — освобождать на клиенте нечего.
            }
            catch (JSException)
            {
                // Сбой очистки не должен ронять уход со страницы.
            }
        }
    }

    private async Task ReloadAsync()
    {
        var response = await Dispatcher.Send(new GetDocumentQuery(Id));
        if (response is { Status: true, Data: { } details })
        {
            _details = details;
