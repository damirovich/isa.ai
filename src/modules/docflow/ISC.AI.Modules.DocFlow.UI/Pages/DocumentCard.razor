    /// <summary>Заголовок события ленты — человеческим языком, а не именем перечисления.</summary>
    private string TimelineTitle(AssignmentTimelineEvent item) => item.Kind switch
    {
        AssignmentEventKind.Created => "Назначение создано",
        AssignmentEventKind.DeadlineExtended =>
            $"Срок продлён: {item.OldDeadline:dd.MM.yyyy} → {item.NewDeadline:dd.MM.yyyy}",
        AssignmentEventKind.Reassigned =>
            $"Исполнитель: {(item.FromUserId is { } from ? UserName(from) : "не назначен")} → "
            + $"{(item.ToUserId is { } to ? UserName(to) : "—")}",
        _ => item.FromStatus is { } from
            ? $"{from.Label()} → {item.ToStatus?.Label()}"
            : item.ToStatus?.Label() ?? "Смена статуса",
    };

    // Просрочка выделяется цветом: это единственное событие, которое ставит система, и именно его
    // ищут глазами при разборе «почему сорвали срок».
    private static Color TimelineColor(AssignmentTimelineEvent item) => item switch
    {
        { ToStatus: AssignmentStatus.Overdue } => Color.Error,
        { Kind: AssignmentEventKind.DeadlineExtended } => Color.Warning,
        { ToStatus: AssignmentStatus.Done or AssignmentStatus.Closed } => Color.Success,
        _ => Color.Primary,
    };

    /// <summary>
    /// Открывает файл события ленты. Лента ЗАКРЫВАЕТСЯ: диалог поверх диалога — источник ровно тех
    /// гонок рендера, которые уже чинились в предпросмотре (контейнер рисует другой компонент).
    /// Родитель в ссылке — НАЗНАЧЕНИЕ, а не документ (см. FileUrl).
    /// </summary>
    private void OpenTimelineFile(AssignmentTimelineFile file)
    {
        _timelineOpen = false;

        if (HasInlinePreview(file.FileName))
        {
            OpenFilePreview(file.Category, file.StoredFileName, file.FileName, _timelineAssignmentId);
        }
        else
        {
            // Формат без встроенного просмотра — отдаём на скачивание тем же защищённым маршрутом.
            Navigation.NavigateTo(
                FileUrl(file.Category, file.StoredFileName, download: true, _timelineAssignmentId),
                forceLoad: true);
        }
    }

