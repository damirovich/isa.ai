@namespace ISC.AI.Modules.DocFlow.UI
@* Файлы документа (§3.3): версионируемый файл + сопутствующие вложения. Секция выделена из
   DocumentCard при разрезе страницы (2026-08-10): владеет загрузкой, удалением вложений и своими
   ошибками; предпросмотр отдаёт наверх готовой ссылкой — диалог один на карточку. *@
@using ISC.AI.Abstractions.Application
@using ISC.AI.Modules.DocFlow.Application.Documents
@using ISC.AI.Modules.DocFlow.Domain.Enums
@using ISC.AI.Modules.DocFlow.Domain.Services
@using Microsoft.AspNetCore.Components.Forms

<MudPaper Outlined="true" Class="pa-4 mb-4">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }

    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
        <MudText Typo="Typo.subtitle1">Файлы документа (§3.3 — замена создаёт новую версию)</MudText>
        <div class="d-flex align-center gap-2">
            <MudSelect T="DocumentLanguage" @bind-Value="_uploadLanguage" Dense="true" Style="width:150px;"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Russian">Русский</MudSelectItem>
                <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Kyrgyz">Кыргызский</MudSelectItem>
                <MudSelectItem T="DocumentLanguage" Value="DocumentLanguage.Unspecified">Без языка</MudSelectItem>
            </MudSelect>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadDocumentFileAsync">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.UploadFile">Загрузить файл</MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>
    </div>
    @if (Files.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Файлов пока нет.</MudText>
    }
    else
    {
        @foreach (var file in Files)
        {
            <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small"
                         Color="@(file.IsLatest ? Color.Primary : Color.Default)" />
                <MudText Typo="Typo.body2">@file.FileName</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(file.IsLatest ? Color.Primary : Color.Default)">v@(file.Version)</MudChip>
                @if (!file.IsLatest)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">(прежняя версия)</MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @FileDisplay.FormatSize(file.FileSize) · @file.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </MudText>
                @if (FilePreviewDialog.SupportsInline(file.FileName))
                {
                    <MudLink Typo="Typo.caption" Style="cursor:pointer;"
                             OnClick="@(() => PreviewAsync(FileDisplay.Categories.Documents, file.StoredFileName, file.FileName))">Просмотр</MudLink>
                }
                else
                {
                    <MudLink Href="@Url(FileDisplay.Categories.Documents, file.StoredFileName)"
                             Target="_blank" Typo="Typo.caption">Просмотр</MudLink>
                }
                <MudLink Href="@Url(FileDisplay.Categories.Documents, file.StoredFileName, download: true)"
                         Typo="Typo.caption">Скачать</MudLink>
            </div>
        }
    }

    <MudDivider Class="my-2" />
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-1">
        <MudText Typo="Typo.subtitle2">Сопутствующие файлы</MudText>
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAttachmentAsync">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AttachFile">Прикрепить</MudButton>
            </ActivatorContent>
        </MudFileUpload>
    </div>
    @if (Attachments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Вложений нет.</MudText>
    }
    else
    {
        @foreach (var attachment in Attachments)
        {
            <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                <MudText Typo="Typo.body2">@attachment.FileName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@FileDisplay.FormatSize(attachment.FileSize)</MudText>
                @if (FilePreviewDialog.SupportsInline(attachment.FileName))
                {
                    <MudLink Typo="Typo.caption" Style="cursor:pointer;"
                             OnClick="@(() => PreviewAsync(FileDisplay.Categories.Attachments, attachment.StoredFileName, attachment.FileName))">Просмотр</MudLink>
                }
                else
                {
                    <MudLink Href="@Url(FileDisplay.Categories.Attachments, attachment.StoredFileName)"
                             Target="_blank" Typo="Typo.caption">Просмотр</MudLink>
                }
                <MudLink Href="@Url(FileDisplay.Categories.Attachments, attachment.StoredFileName, download: true)"
                         Typo="Typo.caption">Скачать</MudLink>
                @* Вложение — черновик или справочный материал, его удаление обратимо только
                   повторной загрузкой; версионируемые файлы документа так не удаляются. *@
                <MudLink Typo="Typo.caption" Color="Color.Error"
                         OnClick="@(() => DeleteAttachmentAsync(attachment))">Удалить</MudLink>
            </div>
        }
    }
</MudPaper>

@code {
    /// <summary>Идентификатор документа — родитель в маршруте раздачи файлов.</summary>
    [Parameter]
    public int DocumentId { get; set; }

    /// <summary>Версионируемые файлы документа (§3.3).</summary>
    [Parameter]
    public IReadOnlyList<DocumentFileItem> Files { get; set; } = [];

    /// <summary>Сопутствующие вложения (§3.3.1).</summary>
    [Parameter]
    public IReadOnlyList<AttachmentItem> Attachments { get; set; } = [];

    /// <summary>Списки изменились — родитель перечитывает карточку.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Запрос предпросмотра — диалог держит родитель (он один на карточку).</summary>
    [Parameter]
    public EventCallback<FilePreviewRequest> OnPreview { get; set; }

    private DocumentLanguage _uploadLanguage = DocumentLanguage.Russian;
    private string? _error;

    private string Url(string category, string storedFileName, bool download = false) =>
        FileDisplay.Url(category, DocumentId, storedFileName, download);

    private Task PreviewAsync(string category, string storedFileName, string fileName) =>
        OnPreview.InvokeAsync(new FilePreviewRequest(Url(category, storedFileName), fileName));

    private async Task UploadDocumentFileAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        try
        {
            var uploaded = (await BrowserFileReader.ReadAsync([file]))[0];
            var response = await Dispatcher.Send(new UploadDocumentFileCommand(
                DocumentId, uploaded.FileName, uploaded.ContentType, uploaded.Content, _uploadLanguage));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
        }

        await OnChanged.InvokeAsync();
    }

    private async Task UploadAttachmentAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        try
        {
            var uploaded = (await BrowserFileReader.ReadAsync([file]))[0];
            var response = await Dispatcher.Send(new UploadAttachmentCommand(
                DocumentId, uploaded.FileName, uploaded.ContentType, uploaded.Content));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
        }

        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAttachmentAsync(AttachmentItem attachment)
    {
        _error = null;
        var response = await Dispatcher.Send(new DeleteAttachmentCommand(attachment.Id));
        if (!response.Status)
        {
            _error = response.StatusMessage;
        }

        await OnChanged.InvokeAsync();
    }
}
