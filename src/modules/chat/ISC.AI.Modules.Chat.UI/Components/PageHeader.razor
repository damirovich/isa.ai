@namespace ISC.AI.Modules.Chat.UI
@inject ISC.AI.Abstractions.Profiles.IProfile Profile

@* Шапка страницы пакета: значок, заголовок, подзаголовок. Заголовок вкладки браузера — «<Title> — <наименование
   профиля>»; имя профиля — из IProfile.DisplayName, а не строкой: пакет подключают разные профили (ADR-0052). *@

<PageTitle>@Title — @Profile.DisplayName</PageTitle>

<div class="@($"d-flex align-center gap-3 {Class}")">
    <MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Large" />
    <div class="flex-grow-1">
        <MudText Typo="Typo.h4">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
        }
    </div>
</div>

@code {
    /// <summary>Заголовок страницы (он же — заголовок вкладки браузера).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Подзаголовок; <c>null</c> — не показывать.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Значок (константа MudBlazor).</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>CSS-классы контейнера шапки (по умолчанию отступ снизу).</summary>
    [Parameter] public string Class { get; set; } = "mb-4";
}
