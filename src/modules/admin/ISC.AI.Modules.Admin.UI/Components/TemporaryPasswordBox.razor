@namespace ISC.AI.Modules.Admin.UI
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@* Временный пароль (ТБ-043): показывается ОДИН раз — в базе только хеш. Кнопка «Скопировать» — единственный
   браузерный вызов экранов пакета; если буфер обмена недоступен (политика браузера), пароль остаётся на экране
   крупно и моноширинно — его можно переписать. *@

<div class="d-flex align-center gap-3 flex-wrap pa-3 mud-border-lines-default rounded"
     style="border:1px dashed var(--mud-palette-lines-default); background:var(--mud-palette-background-gray);">
    <MudText Typo="Typo.h5" Style="font-family:'Roboto Mono',ui-monospace,Menlo,Consolas,monospace; letter-spacing:.06em;">@Password</MudText>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">
        Скопировать
    </MudButton>
</div>
<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
    Показывается один раз: в базе хранится только хеш. Передайте лично — при первом входе сотрудник обязан сменить пароль.
</MudAlert>

@code {
    /// <summary>Временный пароль.</summary>
    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Snackbar.Add("Пароль скопирован", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Буфер обмена недоступен — перепишите пароль с экрана", Severity.Warning);
        }
    }
}
