@namespace ISC.AI.Modules.Admin.UI
@using ISC.AI.Abstractions.Application
@using ISC.AI.Modules.Admin.Application.Features.Accounts

@* Форма смены СВОЕГО пароля (Э4-35 §6.5) — ОБЩАЯ для диалога в шапке (обычный путь) и страницы
   /account/password (принудительная смена временного пароля: хост запирает туда RequirePasswordChange,
   диалог там неуместен). Логика одна, чтобы правила не разъехались. *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@if (_done)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">
        <MudText Typo="Typo.body2"><b>Пароль изменён.</b></MudText>
        <MudText Typo="Typo.body2">
            Все ваши сессии завершены — это защита на случай, если пароль меняли из-за утечки.
            Войдите заново с новым паролем.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Href="/login">
            Ко входу
        </MudButton>
    </MudAlert>
}
else
{
    <MudTextField @bind-Value="_current" Immediate="true" Label="Текущий пароль *" Variant="Variant.Outlined"
                  InputType="InputType.Password" Class="mb-3" />
    <MudTextField @bind-Value="_next" Immediate="true" Label="Новый пароль *" Variant="Variant.Outlined"
                  InputType="InputType.Password" Class="mb-1"
                  HelperText="@($"Не короче {ChangeOwnPasswordValidator.MinPasswordLength} символов")" />
    <MudTextField @bind-Value="_confirm" Immediate="true" Label="Новый пароль ещё раз *" Variant="Variant.Outlined"
                  InputType="InputType.Password" Class="mb-3" />

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Требований к составу пароля нет: длина защищает лучше, чем обязательная цифра со
        спецсимволом. Не используйте пароль, который применяете в других системах.
    </MudText>

    @if (!_busy && SubmitHint is { } submitHint)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mb-2">@submitHint</MudText>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
               Disabled="@(_busy || !CanSubmit)" OnClick="SubmitAsync">
        @(_busy ? "Меняю…" : "Сменить пароль")
    </MudButton>
}

@code {
    private string _current = string.Empty;
    private string _next = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;
    private bool _done;
    private string? _error;

    private bool CanSubmit => SubmitHint is null;

    // Почему «Сменить пароль» неактивна — по первому невыполненному условию.
    private string? SubmitHint =>
        string.IsNullOrEmpty(_current) ? "Введите текущий пароль"
        : _next.Length < ChangeOwnPasswordValidator.MinPasswordLength
            ? $"Новый пароль — не короче {ChangeOwnPasswordValidator.MinPasswordLength} символов (сейчас {_next.Length})"
        : _next != _confirm ? "Новый пароль и повтор не совпадают"
        : null;

    private async Task SubmitAsync()
    {
        _error = null;

        // Совпадение повтора проверяется ТОЛЬКО здесь: это защита от опечатки, а не правило
        // безопасности, и гонять второй пароль на сервер незачем.
        if (_next != _confirm)
        {
            _error = "Новый пароль и его повтор не совпадают.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new ChangeOwnPasswordCommand(_current, _next));
            if (response.Status)
            {
                _done = true;

                // Введённое НЕ остаётся в памяти компонента дольше необходимого: circuit Blazor
                // живёт до закрытия вкладки, и держать в нём пароль незачем.
                _current = _next = _confirm = string.Empty;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
