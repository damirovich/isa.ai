@namespace ISC.AI.Modules.Admin.UI
@* «Пользователи» (Э4-35 §6.5, ТП-004/007, ТБ-011/020): учётная запись, роль и допуск сотрудника на одном экране —
   вместо прежних трёх («Учётные записи», «Роли пользователей», «Допуски пользователей»). Список с поиском и
   отбором; щелчок по строке открывает карточку сотрудника (/admin/users/{id}), где всё и правится. Кнопка «Новый
   сотрудник» — мастер из трёх шагов. Право на каждое действие проверяет обработчик (IPlatformAdministration —
   ТБ-012): отказ виден текстом, на «кнопку не покажем» не полагаемся — запрос можно отправить и без кнопки. *@
@page "/admin/users"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ISC.AI.Modules.Admin.Domain.Services.IUserRoleCatalog RoleCatalog
@using ISC.AI.Abstractions.Security
@using ISC.AI.Modules.Admin.Application.Features.Accounts
@using ISC.AI.Modules.Admin.Application.Features.Clearances
@using ISC.AI.Modules.Admin.Domain.Services

<PageHeader Title="Пользователи" Subtitle="Учётная запись, роль и допуск сотрудника в одном месте · ведёт администратор"
            Icon="@Icons.Material.Filled.People">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => _newOpen = true)">Новый сотрудник</MudButton>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@* Признак режима первичной настройки приходит С СЕРВЕРА — баннер и правило права не разъедутся. *@
@if (_isInitialSetup)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
        <MudText Typo="Typo.body2"><b>Режим первичной настройки: Администратор не назначен.</b></MudText>
        <MudText Typo="Typo.body2">
            Пока в системе нет ни одного Администратора, этот раздел открыт любому вошедшему — иначе назначить первого
            Администратора было бы некому. Откройте свою карточку, назначьте себе роль <b>Администратор</b> и выдайте
            допуск — после этого раздел будет доступен только Администратору.
        </MudText>
    </MudAlert>
}

<div class="d-flex gap-3 align-end flex-wrap mb-3">
    <MudTextField T="string" Value="_filterText" ValueChanged="OnTextChanged" Placeholder="ФИО, имя входа или должность"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="350"
                  Clearable="true" Style="min-width:260px;" Class="flex-grow-1" />
    @* Перечень ролей даёт ПРОФИЛЬ: пакет не знает ни их состава, ни смысла ключей. *@
    <MudSelect T="string" Value="_filterRoleKey" ValueChanged="OnRoleChanged" Label="Роль" Variant="Variant.Outlined"
               Margin="Margin.Dense" Clearable="true" Placeholder="Все роли" Style="width:220px;">
        @foreach (var role in _roles)
        {
            <MudSelectItem T="string" Value="@role.Key">@role.Label</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="bool?" Value="_filterActive" ValueChanged="OnActiveChanged" Label="Состояние" Variant="Variant.Outlined"
               Margin="Margin.Dense" Clearable="true" Placeholder="Любое" Style="width:200px;">
        <MudSelectItem T="bool?" Value="@(true)">Действующие</MudSelectItem>
        <MudSelectItem T="bool?" Value="@(false)">Отключённые</MudSelectItem>
    </MudSelect>
</div>

<MudTable T="UserAccountView" Items="_rows" Hover="true" Outlined="true" Loading="_busy" LoadingProgressColor="Color.Primary"
          OnRowClick="@(e => Navigation.NavigateTo($"/admin/users/{e.Item!.Account.UserId}"))" RowStyle="cursor:pointer;">
    <HeaderContent>
        <MudTh>Сотрудник</MudTh>
        <MudTh>Роль</MudTh>
        <MudTh>Допуск</MudTh>
        <MudTh>Состояние</MudTh>
        <MudTh Style="width:1%;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Сотрудник">
            <div class="d-flex align-center gap-3">
                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@AdminUi.Initials(context.Account)</MudAvatar>
                <div style="min-width:0;">
                    <MudText Typo="Typo.body2" Style="font-weight:500;">@AdminUi.NameOf(context.Account)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Account.UserName@(string.IsNullOrWhiteSpace(context.Account.Position) ? string.Empty : $" · {context.Account.Position}")
                    </MudText>
                </div>
            </div>
        </MudTd>
        <MudTd DataLabel="Роль">
            @* Если профиль перестал объявлять ключ, показываем сам ключ: о назначенном праве молчать нельзя. *@
            @if (context.RoleKey is null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ma-0">роль не назначена</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ma-0">@(context.RoleLabel ?? context.RoleKey)</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Допуск">
            @if (AdminUi.Clearance(context.Account) is { } clearance)
            {
                <MudText Typo="Typo.body2">@clearance</MudText>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ma-0">без допуска</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Состояние">
            @{ var (label, color) = AdminUi.Status(context.Account); }
            <MudChip T="string" Size="Size.Small" Color="@color" Variant="Variant.Text" Class="ma-0">@label</MudChip>
            @if (!context.Account.IsActive && !string.IsNullOrWhiteSpace(context.Account.DeactivationReason))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Account.DeactivationReason</MudText>
            }
        </MudTd>
        <MudTd><MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="mud-text-secondary" /></MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @* Пустая выдача НЕ утверждает отсутствия: отбор мог ничего не найти, а мог и упереться в право. *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
            По этому отбору сотрудников нет. Измените условия поиска или заведите нового сотрудника.
        </MudText>
    </NoRecordsContent>
</MudTable>

@if (_total > 0)
{
    <div class="d-flex align-center justify-space-between mt-3 flex-wrap gap-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Сотрудников: @_total · страница @_page из @PageCount</MudText>
        <MudPagination Count="@PageCount" Selected="_page" SelectedChanged="GoToPageAsync" Color="Color.Primary" Size="Size.Small" />
    </div>
}

<NewUserDialog @bind-Visible="_newOpen" Roles="_roles" Divisions="_divisions" Completed="OnCreatedAsync" />

@code {
    private const int PageSize = 25;

    private readonly List<UserAccountView> _rows = [];
    private readonly List<RoleOption> _roles = [];
    private readonly List<ClearanceDivision> _divisions = [];
    private bool _busy = true; // «загрузка…» до первой интерактивной загрузки
    private string? _error;
    private bool _isInitialSetup;
    private bool _newOpen;

    private string? _filterText;
    private string? _filterRoleKey;
    private bool? _filterActive;
    private int _page = 1;
    private int _total;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // ТБ-030: Blazor выполняет инициализацию дважды (предрендер и интерактив) — без этого каждое открытие
        // давало бы двойные обращения.
        if (!RendererInfo.IsInteractive) { return; }

        _roles.AddRange(await RoleCatalog.ListRolesAsync());
        if (await Dispatcher.Send(new ListClearanceDivisionsQuery()) is { Status: true, Data: { } divisions })
        {
            _divisions.AddRange(divisions);
        }

        await ReloadAsync();
    }

    private Task OnTextChanged(string? text)
    {
        _filterText = text;
        _page = 1;
        return ReloadAsync();
    }

    private Task OnRoleChanged(string? roleKey)
    {
        _filterRoleKey = roleKey;
        _page = 1;
        return ReloadAsync();
    }

    private Task OnActiveChanged(bool? active)
    {
        _filterActive = active;
        _page = 1;
        return ReloadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return ReloadAsync();
    }

    private async Task OnCreatedAsync((int UserId, bool Open) created)
    {
        if (created.Open)
        {
            Navigation.NavigateTo($"/admin/users/{created.UserId}");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new SearchUserAccountsQuery(
                string.IsNullOrWhiteSpace(_filterText) ? null : _filterText.Trim(), _filterRoleKey, DivisionId: null,
                _filterActive, _page, PageSize));

            _rows.Clear();
            if (response is { Status: true, Data: { } data })
            {
                _rows.AddRange(data.Rows);
                _total = data.TotalCount;
                _isInitialSetup = data.IsInitialSetup;
                _error = null;
            }
            else
            {
                // Отказ обработчика (нет права) показываем текстом, а не пустой таблицей.
                _error = response.StatusMessage;
                _total = 0;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
