@namespace ISC.AI.Modules.Admin.UI
@* Журнал аудита (ТБ-030/032): неизменяемая история действий в пределах допуска смотрящего.
   Отбор — период одной кнопкой, сотрудник по имени, действие, исход и текст (в том числе IP-адрес); строка открывается
   целиком — с исходом, IP-адресом и сеансом входа (ТБ-080, ADR-0066), откуда можно перейти ко всем действиям сеанса;
   отбор можно выгрузить в .csv (выгрузка сама пишется в журнал). Право читать журнал решает обработчик
   (IPlatformAdministration.CanViewAuditAsync — у «Следствия» и «Инспектора» это строка матрицы доступа), отказ
   показывается текстом. Что именно видно — решает решётка гриф/подразделение в порту журнала (ТБ-032). *@
@page "/admin/audit"
@rendermode InteractiveServer
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ISnackbar Snackbar
@using System.Globalization
@using Microsoft.JSInterop
@using ISC.AI.Abstractions.Audit
@using ISC.AI.Abstractions.Security
@using ISC.AI.Modules.Admin.Application.Features.Audit

<PageHeader Title="Журнал аудита"
            Subtitle="Неизменяемая история действий · показаны записи в пределах вашего допуска"
            Icon="@Icons.Material.Filled.History">
    <div class="d-flex flex-column align-end">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@(_busy || _exporting || _total == 0)" OnClick="ExportAsync">
            @(_exporting ? "Готовлю файл…" : "Выгрузить .csv")
        </MudButton>
        @if (!_busy && !_exporting && _total == 0 && _error is null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Нечего выгружать: по отбору нет записей</MudText>
        }
    </div>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="d-flex gap-2 align-center flex-wrap mb-3">
        <MudText Typo="Typo.body2" Class="mr-1">Период:</MudText>
        @foreach (var (period, label) in Periods)
        {
            <MudChip T="string" Size="Size.Small" Class="ma-0"
                     Color="@(_period == period ? Color.Primary : Color.Default)"
                     Variant="@(_period == period ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => SelectPeriodAsync(period))">@label</MudChip>
        }
        @if (_period == Period.Custom)
        {
            @* Ширина календарей — ОБЁРТКОЙ, не Style: MudBlazor копирует Style пикера на раскрытый календарь. *@
            <div style="width:160px;">
                <MudDatePicker Date="_from" DateChanged="OnFromChangedAsync" Label="С" Variant="Variant.Outlined"
                               Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Clearable="true" />
            </div>
            <div style="width:160px;">
                <MudDatePicker Date="_to" DateChanged="OnToChangedAsync" Label="По" Variant="Variant.Outlined"
                               Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Clearable="true" />
            </div>
        }
    </div>
    <div class="d-flex gap-3 align-end flex-wrap">
        @* Сотрудник — по имени или имени входа, а не по номеру. Отключённые тоже здесь: их действия в журнале остаются. *@
        <MudAutocomplete T="AuditSubject" Value="_subject" ValueChanged="OnSubjectChangedAsync" Label="Кто"
                         Variant="Variant.Outlined" Margin="Margin.Dense" SearchFunc="SearchSubjectsAsync"
                         ToStringFunc="@(s => s is null ? string.Empty : $"{s.Name} ({s.UserName})")"
                         Clearable="true" ResetValueOnEmptyText="true" MaxItems="30" Placeholder="Все сотрудники"
                         Style="min-width:280px;">
            <ItemTemplate Context="subject">
                <MudText Typo="Typo.body2">@subject.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @subject.UserName@(subject.IsActive ? string.Empty : " · отключён")
                </MudText>
            </ItemTemplate>
        </MudAutocomplete>
        <MudSelect T="AuditAction?" Value="_action" ValueChanged="OnActionChangedAsync" Label="Действие"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="Любое" Style="width:200px;">
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <MudSelectItem T="AuditAction?" Value="@action">@AuditText.Label(action)</MudSelectItem>
            }
        </MudSelect>
        @* Исход операции (ТБ-080): найти отказы и сбои. Записи до ADR-0066 исхода не несут и в отбор по исходу не попадают. *@
        <MudSelect T="AuditOutcome?" Value="_outcome" ValueChanged="OnOutcomeChangedAsync" Label="Исход"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="Любой" Style="width:160px;">
            @foreach (var outcome in Enum.GetValues<AuditOutcome>())
            {
                <MudSelectItem T="AuditOutcome?" Value="@outcome">@AuditText.OutcomeLabel(outcome)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" @bind-Value="_text" Label="Что искать" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="дело, фигурант, роль, номер…" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Style="min-width:240px;" Class="flex-grow-1"
                      OnKeyDown="@(async e => { if (e.Key == "Enter") { await SearchAsync(); } })" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" Disabled="_busy">Показать</MudButton>
    </div>
    @if (_sessionId is { } session)
    {
        <div class="d-flex align-center gap-2 flex-wrap mt-2">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ma-0"
                     Icon="@Icons.Material.Filled.Link" OnClose="@(() => ClearSessionAsync())">
                Сеанс @AuditText.ShortSession(session)…
            </MudChip>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">показаны только действия этого сеанса входа</MudText>
        </div>
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        «Что искать» ищет по сводке действия, например «дело:4», «role», «access-matrix», и по IP-адресу. Нажмите на строку,
        чтобы открыть запись целиком.
    </MudText>
</MudPaper>

<MudTable T="AuditJournalRow" Items="_rows" Dense="true" Hover="true" Outlined="true" Loading="_busy"
          LoadingProgressColor="Color.Primary" OnRowClick="@(e => _selected = e.Item)" RowStyle="cursor:pointer;">
    <HeaderContent>
        <MudTh Style="width:150px;">Время</MudTh>
        <MudTh>Кто</MudTh>
        <MudTh>Действие</MudTh>
        <MudTh>Что произошло</MudTh>
        <MudTh>Исход</MudTh>
        <MudTh>Гриф</MudTh>
        <MudTh>Подразделение</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Время">@Time(context.Record.OccurredAt)</MudTd>
        <MudTd DataLabel="Кто">
            <MudText Typo="Typo.body2">@Who(context.Record)</MudText>
            @* Имя входа и IP-адрес клиента (ТБ-080) — мелко, одной строкой. *@
            @if (LoginAndAddress(context) is { } secondary)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@secondary</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Действие">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ActionColor(context.Record.Action)"
                     Class="ma-0">@AuditText.Label(context.Record.Action)</MudChip>
        </MudTd>
        <MudTd DataLabel="Что произошло" Style="max-width:420px;">
            <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@context.What</MudText>
            @if (Code(context.Record) is { } raw)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary"
                         Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;font-family:monospace;">@raw</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Исход">
            @* Успех — спокойным текстом, отказ, ошибка и отмена — цветом: их и ищут глазами. Запись до ADR-0066 — «—». *@
            @if (context.Record.Outcome is { } outcome && outcome != AuditOutcome.Success)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@OutcomeColor(outcome)"
                         Class="ma-0">@AuditText.OutcomeLabel(outcome)</MudChip>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(context.Record.Outcome is null ? "—" : AuditText.OutcomeLabel(context.Record.Outcome))
                </MudText>
            }
        </MudTd>
        <MudTd DataLabel="Гриф">@ClassificationLevels.Label(context.Record.Classification)</MudTd>
        <MudTd DataLabel="Подразделение">@(context.DivisionName ?? "—")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @* Пустая выдача НЕ утверждает отсутствия: записи могли не прийти из-за отбора или грифа. *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
            Записей по этому отбору нет либо они вне вашего допуска. Попробуйте расширить период.
        </MudText>
    </NoRecordsContent>
</MudTable>

@if (_total > 0)
{
    <div class="d-flex align-center justify-space-between mt-3 flex-wrap gap-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Записей: @_total · страница @_page из @PageCount</MudText>
        <MudPagination Count="@PageCount" Selected="_page" SelectedChanged="GoToPageAsync" Color="Color.Primary" Size="Size.Small" />
    </div>
}

<MudDialog Visible="@(_selected is not null)" VisibleChanged="@(v => { if (!v) { _selected = null; } })"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Запись журнала № @_selected?.Record.Id.ToString(CultureInfo.InvariantCulture)</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selected is { } row)
        {
            <MudSimpleTable Dense="true" Elevation="0" Bordered="false">
                <tbody>
                    <tr><td class="mud-text-secondary" style="width:170px;">Время</td><td>@Time(row.Record.OccurredAt)</td></tr>
                    <tr><td class="mud-text-secondary">Кто</td><td>@Who(row.Record)@(row.SubjectLogin is { } l ? $" · {l}" : string.Empty)@(row.Record.SubjectId is { } sid ? $" · № {sid.ToString(CultureInfo.InvariantCulture)}" : string.Empty)</td></tr>
                    <tr><td class="mud-text-secondary">Действие</td><td>@AuditText.Label(row.Record.Action)</td></tr>
                    <tr><td class="mud-text-secondary">Что произошло</td><td>@row.What</td></tr>
                    <tr><td class="mud-text-secondary">Сводка</td><td style="font-family:monospace;word-break:break-all;">@(row.Record.PayloadSensitive ?? "—")</td></tr>
                    <tr><td class="mud-text-secondary">Объект</td><td style="font-family:monospace;word-break:break-all;">@(row.Record.ObjectRef ?? "—")</td></tr>
                    <tr><td class="mud-text-secondary">Гриф</td><td>@ClassificationLevels.Label(row.Record.Classification)</td></tr>
                    <tr><td class="mud-text-secondary">Подразделение</td><td>@(row.DivisionName ?? "—")</td></tr>
                    @* Контекст записи (ТБ-080). У записей до ADR-0066 его нет — так и сказано, а не «успех». *@
                    <tr><td class="mud-text-secondary">Исход</td><td>@AuditText.OutcomeLabel(row.Record.Outcome)</td></tr>
                    <tr><td class="mud-text-secondary">IP-адрес</td><td style="font-family:monospace;">@(row.Record.ClientAddress ?? "—")</td></tr>
                    <tr><td class="mud-text-secondary">Сеанс входа</td><td style="font-family:monospace;word-break:break-all;">@(row.Record.SessionId?.ToString("D", CultureInfo.InvariantCulture) ?? "—")</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                Запись неизменяема: журнал защищён хеш-цепочкой, правка или удаление записи обнаруживаются проверкой.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_selected?.Record.SessionId is { } selectedSession)
        {
            <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link"
                       OnClick="@(() => ShowSessionAsync(selectedSession))">Все действия сеанса</MudButton>
        }
        <MudButton OnClick="@(() => _selected = null)">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int PageSize = 50;

    private enum Period { Today, Week, Month, All, Custom }

    private static readonly (Period Period, string Label)[] Periods =
        [(Period.Today, "Сегодня"), (Period.Week, "7 дней"), (Period.Month, "30 дней"), (Period.All, "Всё время"), (Period.Custom, "Свой период")];

    private IReadOnlyList<AuditJournalRow> _rows = [];
    private IReadOnlyList<AuditSubject> _subjects = [];
    private int _total;
    private int _page = 1;

    private Period _period = Period.Week;
    private DateTime? _from;
    private DateTime? _to;
    private AuditSubject? _subject;
    private AuditAction? _action;
    private AuditOutcome? _outcome;
    private Guid? _sessionId;
    private string? _text;

    private AuditJournalRow? _selected;
    private bool _busy;
    private bool _exporting;
    private string? _error;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // ТБ-030: инициализация идёт дважды (предрендер и интерактив) — иначе каждое открытие давало бы две записи
        // о просмотре журнала (ListAuditRecordsQuery сам аудируется).
        if (!RendererInfo.IsInteractive) { return; }

        if (await Dispatcher.Send(new ListAuditSubjectsQuery()) is { Status: true, Data: { } subjects })
        {
            _subjects = subjects;
        }

        await LoadAsync();
    }

    private Task<IEnumerable<AuditSubject>> SearchSubjectsAsync(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<AuditSubject> found = string.IsNullOrWhiteSpace(text)
            ? _subjects
            : _subjects.Where(s => s.Name.Contains(text.Trim(), StringComparison.CurrentCultureIgnoreCase)
                || s.UserName.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(found);
    }

    private Task SelectPeriodAsync(Period period)
    {
        _period = period;
        return period == Period.Custom ? Task.CompletedTask : SearchAsync();
    }

    private Task OnFromChangedAsync(DateTime? value) { _from = value; return SearchAsync(); }

    private Task OnToChangedAsync(DateTime? value) { _to = value; return SearchAsync(); }

    private Task OnSubjectChangedAsync(AuditSubject? value) { _subject = value; return SearchAsync(); }

    private Task OnActionChangedAsync(AuditAction? value) { _action = value; return SearchAsync(); }

    private Task OnOutcomeChangedAsync(AuditOutcome? value) { _outcome = value; return SearchAsync(); }

    // «Все действия сеанса» (ТБ-080): отбор только по сеансу и за всё время — иначе прежний отбор (период, сотрудник,
    // действие, текст, исход) молча прятал бы часть действий сеанса.
    private Task ShowSessionAsync(Guid sessionId)
    {
        _selected = null;
        _sessionId = sessionId;
        _period = Period.All;
        _subject = null;
        _action = null;
        _outcome = null;
        _text = null;
        return SearchAsync();
    }

    private Task ClearSessionAsync()
    {
        _sessionId = null;
        return SearchAsync();
    }

    private Task SearchAsync()
    {
        // Новый отбор — с первой страницы: иначе после сужения можно остаться на несуществующей странице.
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    // Период — в местном времени пользователя; конец дня включительно: «по 07.08» включает весь день.
    private AuditFilter BuildFilter()
    {
        var today = DateTime.Now.Date;
        var (from, to) = _period switch
        {
            Period.Today => (today, (DateTime?)null),
            Period.Week => (today.AddDays(-6), null),
            Period.Month => (today.AddDays(-29), null),
            Period.Custom => (_from?.Date, _to?.Date.AddDays(1).AddTicks(-1)),
            _ => ((DateTime?)null, (DateTime?)null),
        };

        return new AuditFilter(
            from?.ToUniversalTime(), to?.ToUniversalTime(), _subject?.UserId, _action,
            string.IsNullOrWhiteSpace(_text) ? null : _text.Trim(), _page, PageSize,
            Outcome: _outcome, SessionId: _sessionId);
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new ListAuditRecordsQuery(BuildFilter()));
            if (response is not { Status: true, Data: { } data })
            {
                // Отказ (нет права читать журнал либо нет действующего допуска) — текстом.
                _error = response.StatusMessage;
                _rows = [];
                _total = 0;
                return;
            }

            _rows = data.Rows;
            _total = data.TotalCount;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new ExportAuditJournalQuery(BuildFilter()));
            if (response is not { Status: true, Data: { } file })
            {
                _error = response.StatusMessage;
                return;
            }

            using var stream = new DotNetStreamReference(new MemoryStream(file.Content));
            await JS.InvokeVoidAsync("downloadFileFromStream", file.FileName, stream);
            Snackbar.Add(file.Truncated
                    ? $"Выгружены последние {file.RowCount} записей — это предел одного файла. Сузьте период, чтобы выгрузить остальные."
                    : $"Выгружено записей: {file.RowCount}.",
                file.Truncated ? Severity.Warning : Severity.Success);
        }
        catch (Microsoft.JSInterop.JSException exception)
        {
            _error = "Браузер не сохранил файл: " + exception.Message;
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string Time(DateTime utc) => utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture);

    // Имя берётся из реестра сейчас, а в записи хранится идентификатор (запись неизменяема, ТБ-031).
    private static string Who(AuditRecordRow record) =>
        record.SubjectName ?? (record.SubjectId is { } id ? $"пользователь № {id.ToString(CultureInfo.InvariantCulture)}" : "система");

    private static string? Code(AuditRecordRow record) => record.PayloadSensitive ?? record.ObjectRef;

    // Имя входа и IP-адрес (ТБ-080) одной строкой; нет ни того, ни другого — строки нет.
    private static string? LoginAndAddress(AuditJournalRow row)
    {
        var parts = new[] { row.SubjectLogin, row.Record.ClientAddress }.Where(p => !string.IsNullOrEmpty(p)).ToList();
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private static Color OutcomeColor(AuditOutcome outcome) => outcome switch
    {
        AuditOutcome.Error => Color.Error,
        AuditOutcome.Denied => Color.Warning,
        _ => Color.Default,
    };

    private static Color ActionColor(AuditAction action) => action switch
    {
        AuditAction.Purge => Color.Error,
        AuditAction.Export or AuditAction.Print => Color.Warning,
        AuditAction.Modify or AuditAction.Ingest => Color.Info,
        AuditAction.Login => Color.Success,
        _ => Color.Default,
    };
}
