@namespace ISC.AI.Modules.Media.UI
@* Карточка носителя (ТФ-МЕД-03, ТФ-ПЛ-03): реквизиты, гриф, дело; изображение/видео КАК ЕСТЬ (ТЭ-007) —
   рамки лиц на фото рисуются CSS-оверлеем поверх <img> (в процентах от натурального размера, который
   измеряет JS-модуль пакета), сам файл не меняется; лица носителя — вырезки с пригодностью и баллом
   детектора; у видео — таймкоды с кнопкой «к кадру» (перемотка через ленивый JS-модуль пакета, только
   в OnAfterRenderAsync — предрендер JS не умеет). Контейнеры MKV/AVI/MOV браузер не воспроизводит —
   вместо плеера ссылка на скачивание оригинала, «к кадру» недоступно.
   У каждого лица — «Найти этого человека в других материалах» (проба = лицо носителя, ТФ-ПЛ-03) и
   «Привязать к фигуранту» (ручная привязка создаёт КАНДИДАТА для двойной верификации, ТФ-МЕД-03).
   Допуск проверяет сервер: и запрос карточки, и каждая отдача файла (ТБ-020/021, ТБ-073). *@
@page "/media/assets/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@using System.Globalization
@using ISC.AI.Modules.Media.Application.Features.Assets
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Носитель</PageTitle>

@if (_details is null)
{
    <MudText Typo="Typo.h5">Носитель</MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3">@_error</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
}
else
{
    var asset = _details.Asset;
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <div>
            <MudText Typo="Typo.h5">@asset.OriginalFileName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @asset.Kind.Label() · @MediaLabels.FormatSize(asset.ByteSize) · загружен @asset.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                @if (asset.DurationMs is { } duration)
                {
                    <span> · длительность @MediaLabels.Timecode(duration)</span>
                }
            </MudText>
        </div>
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudChip T="string" Variant="Variant.Text" Color="@asset.IndexStatus.ChipColor()">@asset.IndexStatus.Label()</MudChip>
            <ClassificationChip Classification="@asset.Classification" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="ReindexAsync">Переиндексировать</MudButton>
            <MudTooltip Text="Гарантированное удаление — роли Администратор/Руководитель">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="_busy"
                           OnClick="@(() => _purgeOpen = true)">Удалить</MudButton>
            </MudTooltip>
            @if (_details.CaseId is { } caseId)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@($"/media/cases/{caseId}")">К медиатеке дела</MudButton>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }
    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _notice = null)">@_notice</MudAlert>
    }
    @if (asset.IndexStatus == MediaIndexStatus.Failed && !string.IsNullOrWhiteSpace(asset.IndexError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-3">Ошибка обработки: @asset.IndexError</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 my-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Реквизиты</MudText>
        <div class="d-flex gap-4 flex-wrap">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Дело:
                @if (_details.CaseId is { } linkedCase)
                {
                    <MudLink Href="@($"/media/cases/{linkedCase}")" Typo="Typo.caption">№ @linkedCase</MudLink>
                }
                else
                {
                    <span>не привязан</span>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Тип: @asset.ContentType</MudText>
            @if (asset.CapturedAt is { } captured)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Съёмка: @captured.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(asset.Source))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Источник: @asset.Source</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Подразделение: @asset.DivisionId</MudText>
            @if (asset.IndexedAt is { } indexedAt)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Обработан @indexedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · детектор @asset.DetectorVersion · векторизатор @asset.EmbedderVersion
                </MudText>
            }
        </div>
    </MudPaper>

    @* ================= Само изображение / видео — как есть (ТЭ-007) ================= *@
    <MudPaper Outlined="true" Class="pa-4 my-4 text-center">
        @if (asset.Kind == MediaKind.Video)
        {
            @if (IsBrowserPlayable(asset.ContentType))
            {
                @* Перемотка работает благодаря Range на эндпоинте. Одна выдача файла субъекту — одна запись
                   аудита (правило MediaViewAuditThrottle в слое данных, ТБ-030): продолжения Range-запросов
                   при воспроизведении/перемотке журнал не множат. *@
                <video id="@VideoElementId" controls preload="metadata" src="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)"
                       style="max-width:100%;max-height:70vh;display:block;margin:0 auto;"></video>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Видео воспроизводится без обработки (ТЭ-007); переход к кадру — кнопками у лиц ниже.
                    Если оно не воспроизводится — файла нет либо он вне вашего допуска.
                </MudText>
            }
            else
            {
                @* MKV/AVI/MOV браузер не проигрывает (эндпоинт отдаёт их вложением): честная ссылка вместо мёртвого плеера. *@
                <div class="d-flex flex-column align-center gap-2 py-4">
                    <MudIcon Icon="@Icons.Material.Filled.VideoFile" Size="Size.Large" Class="mud-text-secondary" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                               Href="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)" download="@asset.OriginalFileName">Скачать оригинал</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Браузер не воспроизводит контейнер MKV/AVI/MOV — откройте файл в проигрывателе; переход к кадру недоступен.
                    Оригинал отдаётся без обработки (ТЭ-007); если скачать не удаётся — файла нет либо он вне вашего допуска.
                </MudText>
            }
        }
        else
        {
            @* Рамки лиц — оверлей поверх оригинала (ТФ-МЕД-03), в процентах от натурального размера: файл не
               трогаем (ТЭ-007), рамки держатся при любом масштабе показа. Размер узнаём у JS после загрузки. *@
            <div style="position:relative;display:inline-block;max-width:100%;line-height:0;">
                <img id="@ImageElementId" src="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)" alt="@asset.OriginalFileName"
                     style="max-width:100%;max-height:70vh;display:block;" />
                @if (_imageSize is { } size)
                {
                    @foreach (var face in _details.Faces)
                    {
                        var box = face;
                        <div style="@FaceBoxStyle(box, size)" title="@($"лицо № {box.Id}")">
                            <span style="@FaceBoxLabelStyle(box)">№ @box.Id</span>
                        </div>
                    }
                }
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                Изображение показано без обработки (ТЭ-007); рамки — найденные лица (пригодные — зелёные, непригодные — жёлтые,
                выбранное — синяя). Если оно не отображается — файла нет либо он вне вашего допуска.
            </MudText>
        }
    </MudPaper>

    @* ================= Лица носителя ================= *@
    <MudPaper Outlined="true" Class="pa-4 my-4">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.subtitle1">Лица на носителе: @_details.Faces.Count</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Балл детектора — уверенность, что это лицо; непригодные для сравнения помечены с причиной (ТО-мат-07).
            </MudText>
        </div>
        @if (_details.Faces.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(asset.IndexStatus == MediaIndexStatus.Indexed ? "Лиц не найдено." : "Лица появятся после обработки носителя.")
            </MudText>
        }
        else if (asset.Kind == MediaKind.Video)
        {
            var playable = IsBrowserPlayable(asset.ContentType);
            <MudTable T="FaceRow" Items="_details.Faces" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Вырезка</MudTh><MudTh>Таймкод</MudTh><MudTh>Лицо</MudTh><MudTh>Детектор</MudTh><MudTh>Пригодность</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Вырезка">
                        <FaceCropTile Url="@CropUrl(context)" Size="64" Highlighted="@(HighlightFaceId == context.Id)" />
                    </MudTd>
                    <MudTd DataLabel="Таймкод">
                        @if (context.FrameTimestampMs is { } ms)
                        {
                            @if (playable)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayCircle"
                                           OnClick="@(() => SeekAsync(ms))">@MediaLabels.Timecode(ms)</MudButton>
                            }
                            else
                            {
                                <span>@MediaLabels.Timecode(ms)</span>
                            }
                        }
                    </MudTd>
                    <MudTd DataLabel="Лицо">№ @context.Id@(context.TrackId is { } track ? $" · трек {track}" : string.Empty)</MudTd>
                    <MudTd DataLabel="Детектор">@context.DetectionScore.ToString("0.00")</MudTd>
                    <MudTd DataLabel="Пригодность">
                        @if (context.QualityAcceptable)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">пригодно · качество @context.QualityScore.ToString("0.00")</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">непригодно: @(context.QualityReason ?? "причина не указана")</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <div class="d-flex gap-1 flex-wrap">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonSearch"
                                       Disabled="@(!context.QualityAcceptable)" OnClick="@(() => SearchFace(context.Id))">Найти в других материалах</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Disabled="@(_busy || _details.CaseId is null)" OnClick="@(() => OpenLinkAsync(context))">Привязать к фигуранту</MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <div class="d-flex flex-wrap gap-4">
                @foreach (var face in _details.Faces)
                {
                    var current = face;
                    <FaceCropTile Url="@CropUrl(current)" Size="128" Highlighted="@(HighlightFaceId == current.Id)"
                                  Caption="@($"лицо № {current.Id} · детектор {current.DetectionScore:0.00} · качество {current.QualityScore:0.00}")"
                                  Unusable="@(!current.QualityAcceptable)" UnusableReason="@current.QualityReason">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonSearch" Class="mt-1"
                                   Disabled="@(!current.QualityAcceptable)" OnClick="@(() => SearchFace(current.Id))">Найти в других материалах</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                                   Disabled="@(_busy || _details.CaseId is null)" OnClick="@(() => OpenLinkAsync(current))">Привязать к фигуранту</MudButton>
                    </FaceCropTile>
                }
            </div>
        }
    </MudPaper>
}

@* --- Подтверждение гарантированного удаления (ТБ-064/075, GATE-6) --- *@
<MudDialog @bind-Visible="_purgeOpen" Options="DialogOptionsSmall">
    <TitleContent><MudText Typo="Typo.h6">Удалить носитель?</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            Удаление гарантированное и необратимое: будут уничтожены исходный файл, все найденные лица,
            их вырезки и биометрические шаблоны. Факт удаления записывается в неизменяемый журнал.
            Доступно ролям Администратор/Руководитель.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _purgeOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_busy" OnClick="PurgeAsync">Удалить безвозвратно</MudButton>
    </DialogActions>
</MudDialog>

@* --- Ручная привязка лица к фигуранту (ТФ-МЕД-03): создаётся КАНДИДАТ, не подтверждение --- *@
<MudDialog @bind-Visible="_linkOpen" Options="DialogOptionsSmall">
    <TitleContent><MudText Typo="Typo.h6">Привязать лицо № @_linkFace?.Id к фигуранту</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Привязка создаёт кандидата для двойной верификации (ТБ-073): статус «подтверждён» появится только
            после независимых решений эксперта и верификатора. Основание и фигурант — из дела носителя (ТБ-071).
        </MudText>
        @if (_linkError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_linkError</MudAlert>
        }
        @if (_linkLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-2" />
        }
        <MudSelect T="int?" @bind-Value="_linkAuthorizationId" Label="Основание *" Variant="Variant.Outlined" Dense="true"
                   Placeholder="Выберите основание" Disabled="@(_busy || _linkLoading)">
            @foreach (var a in _linkAuthorizations)
            {
                <MudSelectItem T="int?" Value="@a.AuthorizationId">@a.Reference</MudSelectItem>
            }
        </MudSelect>
        @if (_linkLoaded && _linkAuthorizations.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">У дела нет оснований — добавьте основание в карточке дела.</MudText>
        }
        <MudSelect T="int?" @bind-Value="_linkPersonRef" Label="Фигурант дела *" Variant="Variant.Outlined" Dense="true" Class="mt-2"
                   Placeholder="Выберите фигуранта" Disabled="@(_busy || _linkLoading)">
            @foreach (var p in _linkPersons)
            {
                <MudSelectItem T="int?" Value="@p.PersonId">@p.DisplayName</MudSelectItem>
            }
        </MudSelect>
        @if (_linkLoaded && _linkPersons.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">Фигурантов у дела нет либо они вне вашего допуска — сначала заведите фигуранта.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _linkOpen = false)" Disabled="_busy">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanLink)" OnClick="LinkAsync">
            @(_busy ? "Создаю кандидата…" : "Создать кандидата")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string MediaModulePath = "./_content/ISC.AI.Modules.Media.UI/js/media.js";

    /// <summary>Контейнеры, которые воспроизводит браузерный &lt;video&gt;; остальное из allowlist (MKV/AVI/MOV) — только скачать.</summary>
    private static readonly string[] BrowserPlayableVideoTypes = ["video/mp4", "video/webm"];

    private static readonly DialogOptions DialogOptionsSmall =
        new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Натуральный размер изображения (из JS) — база процентов для рамок лиц.</summary>
    private sealed record ImageSize(int Width, int Height);

    /// <summary>Носитель из маршрута.</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>Лицо, к которому пришли по ссылке (с выдачи поиска / верификации) — подсвечивается рамкой.</summary>
    [SupplyParameterFromQuery(Name = "face")] public int? HighlightFaceId { get; set; }

    private MediaAssetDetails? _details;
    private string? _error;
    private string? _notice;
    private bool _busy;
    private bool _purgeOpen;
    private IJSObjectReference? _module;
    private bool _moduleFailed;
    private ImageSize? _imageSize;
    private bool _measureRequested;

    private bool _linkOpen;
    private bool _linkLoaded;
    private bool _linkLoading;
    private FaceRow? _linkFace;
    private IReadOnlyList<CaseAuthorizationItem> _linkAuthorizations = [];
    private IReadOnlyList<CasePersonItem> _linkPersons = [];
    private int? _linkAuthorizationId;
    private int? _linkPersonRef;
    private string? _linkError;

    private string VideoElementId => $"media-video-{Id}";

    private string ImageElementId => $"media-image-{Id}";

    private bool CanLink => !_busy && !_linkLoading && _linkFace is not null && _linkAuthorizationId is not null && _linkPersonRef is not null;

    private static bool IsBrowserPlayable(string contentType) =>
        BrowserPlayableVideoTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase);

    private static string? CropUrl(FaceRow face) =>
        face.CropStoredFileName is { } crop ? MediaFileUrl.FaceCrop(face.AssetId, crop) : null;

    /// <summary>Рамка лица в процентах от натурального размера (ТФ-МЕД-03): цвет — пригодность, выбранное лицо — Primary.</summary>
    private string FaceBoxStyle(FaceRow face, ImageSize size)
    {
        var left = Percent(face.BoxX, size.Width);
        var top = Percent(face.BoxY, size.Height);
        var width = Percent(face.BoxWidth, size.Width);
        var height = Percent(face.BoxHeight, size.Height);
        var border = HighlightFaceId == face.Id
            ? "3px solid var(--mud-palette-primary)"
            : face.QualityAcceptable ? "2px solid var(--mud-palette-success)" : "2px dashed var(--mud-palette-warning)";
        return $"position:absolute;left:{left}%;top:{top}%;width:{width}%;height:{height}%;box-sizing:border-box;border:{border};pointer-events:none;";
    }

    private string FaceBoxLabelStyle(FaceRow face)
    {
        var background = HighlightFaceId == face.Id
            ? "var(--mud-palette-primary)"
            : face.QualityAcceptable ? "var(--mud-palette-success)" : "var(--mud-palette-warning)";
        return $"position:absolute;left:-2px;top:-1.3em;font-size:11px;line-height:1.2;padding:0 3px;color:#fff;background:{background};white-space:nowrap;";
    }

    private static string Percent(float value, int total) =>
        Math.Clamp(total > 0 ? value / total * 100f : 0f, 0f, 100f).ToString("0.##", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // карточку не грузим — GetMediaAssetQuery аудируется и попадал бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var response = await Dispatcher.Send(new GetMediaAssetQuery(Id));
        if (response is { Status: true, Data: { } details })
        {
            _details = details;
        }
        else
        {
            _details = null;
            _error = response.StatusMessage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS-модуль нужен только после интерактива и только когда есть что мерить/перематывать; грузим лениво
        // и ТОЛЬКО здесь — предрендер JS не умеет.
        if (!RendererInfo.IsInteractive || _details is null)
        {
            return;
        }

        if (_details.Asset.Kind == MediaKind.Image && !_measureRequested)
        {
            _measureRequested = true;
            await MeasureImageAsync();
        }
        else if (_details.Asset.Kind == MediaKind.Video && IsBrowserPlayable(_details.Asset.ContentType))
        {
            await EnsureModuleAsync();
        }
    }

    /// <summary>Ленивая загрузка JS-модуля пакета; после первого сбоя не повторяем (страница живёт без него).</summary>
    private async Task<IJSObjectReference?> EnsureModuleAsync()
    {
        if (_module is not null || _moduleFailed)
        {
            return _module;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", MediaModulePath);
        }
        catch (JSException)
        {
            // Без модуля страница живёт: рамок и «к кадру» не будет — покажем при нажатии.
            _moduleFailed = true;
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт.
            _moduleFailed = true;
        }

        return _module;
    }

    /// <summary>Натуральный размер картинки для рамок; 404 (нет файла ИЛИ вне допуска) — рамок нет, причины не различаем.</summary>
    private async Task MeasureImageAsync()
    {
        var module = await EnsureModuleAsync();
        if (module is null)
        {
            return;
        }

        try
        {
            var size = await module.InvokeAsync<ImageSize?>("measure", ImageElementId);
            if (size is { Width: > 0, Height: > 0 })
            {
                _imageSize = size;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Изображение не измерено — показываем без рамок.
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт — показывать некому.
        }
    }

    /// <summary>«К кадру»: перемотать плеер к таймкоду лица (ничего не обрабатывая, ТЭ-007).</summary>
    private async Task SeekAsync(long milliseconds)
    {
        var module = await EnsureModuleAsync();
        if (module is null)
        {
            _notice = "Модуль плеера не загружен — обновите страницу и попробуйте снова.";
            return;
        }

        try
        {
            var ok = await module.InvokeAsync<bool>("seek", VideoElementId, milliseconds / 1000.0);
            if (!ok)
            {
                _notice = "Плеер не найден на странице — обновите её и попробуйте снова.";
            }
        }
        catch (JSException ex)
        {
            _error = $"Не удалось перемотать видео: {ex.Message}";
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт — показывать некому.
        }
    }

    /// <summary>ТФ-ПЛ-03: проба = лицо носителя; дело — то, к которому привязан носитель.</summary>
    private void SearchFace(int faceId)
    {
        var caseQuery = _details?.CaseId is { } caseId ? $"caseId={caseId}&" : string.Empty;
        Navigation.NavigateTo($"/media/search?{caseQuery}faceId={faceId}");
    }

    /// <summary>Открыть диалог ручной привязки (ТФ-МЕД-03): основания и фигуранты — ДЕЛА носителя (ТБ-071), грузятся один раз.</summary>
    private async Task OpenLinkAsync(FaceRow face)
    {
        if (_details?.CaseId is not { } caseId)
        {
            return;
        }

        _linkFace = face;
        _linkAuthorizationId = null;
        _linkPersonRef = null;
        _linkError = null;
        _linkOpen = true;

        if (!_linkLoaded)
        {
            _linkLoading = true;
            try
            {
                var authorizations = await Dispatcher.Send(new ListCaseAuthorizationsQuery(caseId));
                _linkAuthorizations = authorizations is { Status: true, Data: { } a } ? a : [];
                var persons = await Dispatcher.Send(new ListCasePersonsQuery(caseId));
                _linkPersons = persons is { Status: true, Data: { } p } ? p : [];
                if (authorizations is { Status: false })
                {
                    _linkError = authorizations.StatusMessage;
                }
                else if (persons is { Status: false })
                {
                    _linkError = persons.StatusMessage;
                }

                _linkLoaded = true;
            }
            finally
            {
                _linkLoading = false;
            }
        }

        if (_linkAuthorizations.Count == 1)
        {
            _linkAuthorizationId = _linkAuthorizations[0].AuthorizationId;
        }
    }

    /// <summary>Создать кандидата ручной привязки и перейти к решению эксперта с подсказкой про фигуранта (ТФ-ВЕР-03).</summary>
    private async Task LinkAsync()
    {
        if (_linkFace is not { } face || _linkAuthorizationId is not { } authorizationId || _linkPersonRef is not { } personRef)
        {
            return;
        }

        _busy = true;
        _linkError = null;
        try
        {
            var response = await Dispatcher.Send(new LinkFaceToPersonCommand(face.Id, authorizationId, personRef));
            if (!response.Status)
            {
                _linkError = response.StatusMessage;
                return;
            }

            _linkOpen = false;
            Navigation.NavigateTo($"/media/verification/{response.Data}?stage=Expert&person={personRef}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReindexAsync()
    {
        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var response = await Dispatcher.Send(new ReindexMediaCommand(Id));
            if (response.Status)
            {
                _notice = "Носитель поставлен в очередь на повторную обработку; лица обновятся после её завершения.";
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task PurgeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new PurgeMediaCommand(Id));
            if (!response.Status)
            {
                _error = response.StatusMessage;
                _purgeOpen = false;
                return;
            }

            _purgeOpen = false;
            // После гарантированного удаления карточки больше нет — уходим в медиатеку дела либо к поиску.
            Navigation.NavigateTo(_details?.CaseId is { } caseId ? $"/media/cases/{caseId}" : "/media/search");
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт — освобождать на клиенте нечего.
            }
            catch (JSException)
            {
                // Сбой очистки не должен ронять уход со страницы.
            }
        }
    }
}
