@namespace ISC.AI.Modules.Media.UI
@* Карточка носителя (ТФ-МЕД-03, ТФ-ПЛ-03): реквизиты, гриф, дело; изображение/видео КАК ЕСТЬ (ТЭ-007) —
   рамки лиц на фото рисуются CSS-оверлеем поверх <img> (в процентах от натурального размера, который
   измеряет JS-модуль пакета), сам файл не меняется; лица носителя — вырезки с пригодностью и баллом
   детектора; у видео — таймкоды с кнопкой «к кадру». ВИДЕО показывает VideoFrameViewer (ADR-0028): mp4/webm —
   браузерный <video> с шагом по кадрам в браузере; контейнеры MKV/AVI/MOV/3GP, которые браузер не воспроизводит, —
   кадрами JPEG с сервера (/media/frames/{id}?t=…, та же решётка доступа), «к кадру» работает в обоих режимах.
   «Снимок кадра» — SnapshotFrameCommand: кадр из ОРИГИНАЛА (PNG, ТЭ-007) становится новым фото-носителем того же
   дела с реквизитами происхождения; после снимка карточка НЕ перечитывается (повторный GetMediaAssetQuery —
   вторая запись View в журнале, ТБ-030). У снимка в шапке — ссылка на носитель-источник и момент.
   У каждого лица — «Найти этого человека в других материалах» (проба = лицо носителя, ТФ-ПЛ-03) и
   «Привязать к фигуранту» (ручная привязка создаёт КАНДИДАТА для двойной верификации, ТФ-МЕД-03).
   Допуск проверяет сервер: и запрос карточки, и каждая отдача файла (ТБ-020/021, ТБ-073).
   АУДИО (ADR-0026): встроенный проигрыватель <audio> (AMR/3GPP браузер не играет — ссылка «скачать»); лиц в
   записи нет (MediaIndexStatus.NotApplicable) — блоки лиц, поиска по лицу и переиндексации скрыты. У аудио и
   видео — панель «Расшифровка речи» (TranscriptPanel): фрагменты с таймкодами, щелчок — воспроизведение с места;
   ?t=<мс> (переход из поиска по расшифровкам дела) — перемотка к месту и подсветка фрагмента. *@
@page "/media/assets/{Id:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@using System.Globalization
@using ISC.AI.Modules.Media.Application.Features.Assets
@using ISC.AI.Modules.Media.Application.Features.Assets.Commands.SnapshotFrame
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Носитель</PageTitle>

@if (_details is null)
{
    <MudText Typo="Typo.h5">Носитель</MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3">@_error</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
}
else
{
    var asset = _details.Asset;
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <div>
            <MudText Typo="Typo.h5">@asset.OriginalFileName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @asset.Kind.Label() · @MediaLabels.FormatSize(asset.ByteSize) · загружен @asset.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                @if (asset.DurationMs is { } duration)
                {
                    <span> · длительность @MediaLabels.Timecode(duration)</span>
                }
                @if (asset.Kind == MediaKind.Video && asset.FrameRate is { } frameRate)
                {
                    @* Нативная частота и размер кадра после автоповорота — из пробы ffprobe (ADR-0028); у носителей,
                       загруженных раньше, их нет до «Переиндексировать». *@
                    <span> · @frameRate.ToString("0.###", CultureInfo.InvariantCulture) к/с@(asset.FrameWidth is { } w && asset.FrameHeight is { } h ? $", {w}×{h}" : string.Empty)</span>
                }
            </MudText>
            @if (asset.SourceAssetId is { } sourceAssetId)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Снимок кадра из носителя <MudLink Href="@SourceHref(sourceAssetId, asset.SourceTimestampMs)" Typo="Typo.body2">№ @sourceAssetId</MudLink>@(asset.SourceTimestampMs is { } sourceMs ? $" ({MediaLabels.PreciseTimecode(sourceMs)})" : string.Empty)
                </MudText>
            }
        </div>
        <div class="d-flex align-center gap-2 flex-wrap">
            @if (FacesApplicable(asset))
            {
                <MudChip T="string" Variant="Variant.Text" Color="@asset.IndexStatus.ChipColor()">@asset.IndexStatus.Label()</MudChip>
            }
            <ClassificationChip Classification="@asset.Classification" />
            @if (FacesApplicable(asset))
            {
                @* Переиндексация = повторный поиск лиц; к аудио неприменима (сервер тоже откажет). *@
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="ReindexAsync">Переиндексировать</MudButton>
            }
            <MudTooltip Text="Гарантированное удаление — роли Администратор/Руководитель">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="_busy"
                           OnClick="@(() => _purgeOpen = true)">Удалить</MudButton>
            </MudTooltip>
            @if (_details.CaseId is { } caseId)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@($"/media/cases/{caseId}")">К медиатеке дела</MudButton>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }
    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _notice = null)">@_notice</MudAlert>
    }
    @if (_snapshot is { } snapshot)
    {
        @* Итог «Снимка кадра» (ADR-0028): ссылка на новый носитель и «скачать» его оригинал; при дедупе (ТНД-002)
           новый носитель не создан — сообщаем существующий. *@
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="my-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _snapshot = null)">
            @if (snapshot.Duplicate)
            {
                <span>Такой кадр уже есть в деле — носитель </span>
            }
            else
            {
                <span>@SnapshotCaption(snapshot) сохранён как фото </span>
            }
            <MudLink Href="@($"/media/assets/{snapshot.AssetId.ToString(CultureInfo.InvariantCulture)}")" Typo="Typo.body2">№ @snapshot.AssetId</MudLink>
            <span> · </span>
            <a href="@MediaFileUrl.Originals(snapshot.AssetId, snapshot.StoredFileName)" download>скачать</a>
        </MudAlert>
    }
    @if (FacesApplicable(asset) && asset.IndexStatus == MediaIndexStatus.Failed && !string.IsNullOrWhiteSpace(asset.IndexError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-3">Ошибка обработки: @asset.IndexError</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 my-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Реквизиты</MudText>
        <div class="d-flex gap-4 flex-wrap">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Дело:
                @if (_details.CaseId is { } linkedCase)
                {
                    <MudLink Href="@($"/media/cases/{linkedCase}")" Typo="Typo.caption">№ @linkedCase</MudLink>
                }
                else
                {
                    <span>не привязан</span>
                }
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Тип: @asset.ContentType</MudText>
            @* ТФ-МЕД-17: дату съёмки оператор подтверждает или исправляет; у фото и видео без неё — предупреждение. *@
            <MudText Typo="Typo.caption" Class="@(asset.CapturedAt is null && asset.Kind != MediaKind.Audio ? "mud-error-text" : "mud-text-secondary")">
                Съёмка: @(asset.CapturedAt is { } captured ? captured.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "не указана")
                <MudLink Typo="Typo.caption" Class="ml-1" OnClick="OpenCapturedAt" Disabled="_busy">@(asset.CapturedAt is null ? "указать" : "изменить")</MudLink>
            </MudText>
            @if (!string.IsNullOrWhiteSpace(asset.Source))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Источник: @asset.Source</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Подразделение: @asset.DivisionId</MudText>
            @if (asset.IndexedAt is { } indexedAt)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Обработан @indexedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · детектор @asset.DetectorVersion · векторизатор @asset.EmbedderVersion
                </MudText>
            }
        </div>
    </MudPaper>

    @* Фото — в две колонки: слева снимок по своей ширине, справа лица и сверка с фигурантами; не хватает ширины —
       правая колонка уходит под снимок. Справа от портретного фото иначе оставалось пустое поле. Видео и аудио — как
       прежде, блоками друг под другом (обёртки без стилей ничего не меняют). *@
    var split = asset.Kind == MediaKind.Image;
    <div class="@(split ? "d-flex flex-wrap align-start my-4" : null)" style="@(split ? "gap:16px;" : null)">
    <div style="@(split ? "flex:0 1 auto;max-width:100%;min-width:0;" : null)">
    @* ================= Само изображение / видео / аудио — как есть (ТЭ-007) ================= *@
    <MudPaper Outlined="true" Class="@(split ? "pa-4 text-center" : "pa-4 my-4 text-center")">
        @if (asset.Kind == MediaKind.Audio)
        {
            @if (IsBrowserPlayableAudio(asset.ContentType))
            {
                @* Тот же эндпоинт раздачи, что у видео: допуск и сужение по делам — на каждый запрос, Range для
                   перемотки, одна выдача субъекту — одна запись аудита (MediaViewAuditThrottle, ТБ-030). *@
                <audio id="@AudioElementId" controls preload="metadata" src="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)"
                       style="width:100%;max-width:720px;display:block;margin:0 auto;"></audio>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Запись воспроизводится без обработки (ТЭ-007); переход к месту записи — щелчком по фрагменту расшифровки ниже.
                    Если она не воспроизводится — файла нет либо он вне вашего допуска.
                </MudText>
            }
            else
            {
                @* AMR/3GPP браузер не воспроизводит (эндпоинт отдаёт их вложением): честная ссылка вместо мёртвого плеера. *@
                <div class="d-flex flex-column align-center gap-2 py-4">
                    <MudIcon Icon="@Icons.Material.Filled.AudioFile" Size="Size.Large" Class="mud-text-secondary" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                               Href="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)" download="@asset.OriginalFileName">Скачать оригинал</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Браузер не воспроизводит формат @MediaLabels.FormatName(asset.ContentType) — откройте файл в проигрывателе; переход к месту
                    записи недоступен, таймкоды фрагментов — для сверки. Оригинал отдаётся без обработки (ТЭ-007); если скачать
                    не удаётся — файла нет либо он вне вашего допуска.
                </MudText>
            }
        }
        else if (asset.Kind == MediaKind.Video)
        {
            @* Покадровый просмотр (ADR-0028): mp4/webm — <video> с шагом в браузере, остальные контейнеры — кадры с
               сервера. «Снимок кадра» доступен, когда носитель привязан к делу: снимок сохраняется в это дело. *@
            <VideoFrameViewer @key="asset.Id" @ref="_viewer" AssetId="@asset.Id" StoredFileName="@asset.StoredFileName" OriginalFileName="@asset.OriginalFileName"
                              ContentType="@asset.ContentType" Playable="@IsBrowserPlayable(asset.ContentType)"
                              FrameRate="@asset.FrameRate" DurationMs="@asset.DurationMs" StartMs="@(StartAtMs ?? 0)"
                              CanSnapshot="@(_details.CaseId is not null)" OnSnapshotRequested="SnapshotAsync" />
        }
        else
        {
            @* Рамки лиц — оверлей поверх оригинала (ТФ-МЕД-03), в процентах от натурального размера: файл не
               трогаем (ТЭ-007), рамки держатся при любом масштабе показа. Размер узнаём у JS после загрузки. *@
            <div style="position:relative;display:inline-block;max-width:100%;line-height:0;">
                <img id="@ImageElementId" src="@MediaFileUrl.Originals(asset.Id, asset.StoredFileName)" alt="@asset.OriginalFileName"
                     style="max-width:100%;max-height:70vh;display:block;" />
                @if (_imageSize is { } size)
                {
                    @foreach (var face in _details.Faces)
                    {
                        var box = face;
                        <div style="@FaceBoxStyle(box, size)" title="@($"лицо № {box.Id}")">
                            <span style="@FaceBoxLabelStyle(box)">№ @box.Id</span>
                        </div>
                    }
                }
            </div>
            @* width:0 + min-width:100% — подпись переносится по ширине снимка и не растягивает колонку. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2" Style="width:0;min-width:100%;">
                Изображение показано без обработки (ТЭ-007); рамки — найденные лица (пригодные — зелёные, непригодные — жёлтые,
                выбранное — синяя). Если оно не отображается — файла нет либо он вне вашего допуска.
            </MudText>
        }
    </MudPaper>
    </div>

    @* ================= Расшифровка речи (ADR-0026): аудио и звуковая дорожка видео ================= *@
    @if (asset.Kind is MediaKind.Audio or MediaKind.Video)
    {
        @if (asset.Kind == MediaKind.Video && !IsBrowserPlayable(asset.ContentType))
        {
            @* Видео кадрами с сервера: проигрывателя нет, щелчок по фрагменту показывает кадр (ADR-0028, п. 10). *@
            <TranscriptPanel AssetId="@asset.Id" StartAtMs="@StartAtMs" OnSeekRequested="ShowFrameAsync" />
        }
        else
        {
            @* У видео перемотку по ?t= делает просмотрщик (владелец <video>); у аудио проигрывателем владеет панель. *@
            <TranscriptPanel AssetId="@asset.Id" PlayerElementId="@PlayableElementId(asset)" StartAtMs="@StartAtMs"
                             SeekToStart="@(asset.Kind != MediaKind.Video)" />
        }
    }

    @* ================= Лица носителя (к аудио неприменимо — блок скрыт) ================= *@
    <div style="@(split ? "flex:1 1 380px;min-width:0;" : null)">
    @if (FacesApplicable(asset))
    {
        <MudPaper Outlined="true" Class="@(split ? "pa-4 mb-4" : "pa-4 my-4")">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                <MudText Typo="Typo.subtitle1">Лица на носителе: @_details.Faces.Count</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Балл детектора — уверенность, что это лицо; непригодные для сравнения помечены с причиной (ТО-мат-07).
                </MudText>
            </div>
            @if (_details.Faces.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(asset.IndexStatus == MediaIndexStatus.Indexed ? "Лиц не найдено." : "Лица появятся после обработки носителя.")
                </MudText>
            }
            else if (asset.Kind == MediaKind.Video)
            {
                <MudTable T="FaceRow" Items="_details.Faces" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Вырезка</MudTh><MudTh>Таймкод</MudTh><MudTh>Лицо</MudTh><MudTh>Детектор</MudTh><MudTh>Пригодность</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Вырезка">
                            <FaceCropTile Url="@CropUrl(context)" Size="64" Highlighted="@(HighlightFaceId == context.Id)" />
                        </MudTd>
                        <MudTd DataLabel="Таймкод">
                            @if (context.FrameTimestampMs is { } ms)
                            {
                                @* «К кадру» работает в обоих режимах просмотрщика: перемотка <video> либо кадр с сервера. *@
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayCircle"
                                           OnClick="@(() => ShowFrameAsync(ms))">@MediaLabels.Timecode(ms)</MudButton>
                            }
                        </MudTd>
                        <MudTd DataLabel="Лицо">№ @context.Id@(context.TrackId is { } track ? $" · трек {track}" : string.Empty)</MudTd>
                        <MudTd DataLabel="Детектор">@context.DetectionScore.ToString("0.00")</MudTd>
                        <MudTd DataLabel="Пригодность">
                            @if (context.QualityAcceptable)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">пригодно · качество @context.QualityScore.ToString("0.00")</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">непригодно: @(context.QualityReason ?? "причина не указана")</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <div class="d-flex gap-1 flex-wrap">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonSearch"
                                           Disabled="@(!context.QualityAcceptable)" OnClick="@(() => SearchFace(context.Id))">Найти в других материалах</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Disabled="@(_busy || _details.CaseId is null)" OnClick="@(() => OpenLinkAsync(context))">Привязать к фигуранту</MudButton>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                @* Лицо фото — карточкой: вырезка слева, номер, баллы и действия справа. В узкой плитке подписи кнопок
                   переносились в три строки. *@
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var face in _details.Faces)
                    {
                        var current = face;
                        <MudPaper Outlined="true" Class="pa-2 d-flex gap-3 align-start">
                            <FaceCropTile Url="@CropUrl(current)" Size="128" Highlighted="@(HighlightFaceId == current.Id)"
                                          Unusable="@(!current.QualityAcceptable)" UnusableReason="@current.QualityReason" />
                            <div class="d-flex flex-column gap-1">
                                <MudText Typo="Typo.subtitle2">Лицо № @current.Id</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    детектор @current.DetectionScore.ToString("0.00", CultureInfo.CurrentCulture) · качество @current.QualityScore.ToString("0.00", CultureInfo.CurrentCulture)
                                </MudText>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonSearch" Class="mt-2"
                                           Disabled="@(!current.QualityAcceptable)" OnClick="@(() => SearchFace(current.Id))">Найти в других материалах</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Disabled="@(_busy || _details.CaseId is null)" OnClick="@(() => OpenLinkAsync(current))">Привязать к фигуранту</MudButton>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
        </MudPaper>

        @* ================= Сверка с фигурантами дела (ТФ-ПЕР-09, ADR-0035) ================= *@
        <PersonSuggestionPanel AssetId="@asset.Id" IndexStatus="@asset.IndexStatus" FaceCount="@_details.Faces.Count" />
    }
    </div>
    </div>
}

@* --- Подтверждение гарантированного удаления (ТБ-064/075, GATE-6) --- *@
<MudDialog @bind-Visible="_capturedOpen" Options="DialogOptionsSmall">
    <TitleContent><MudText Typo="Typo.h6">Дата и время съёмки</MudText></TitleContent>
    <DialogContent>
        @if (_capturedError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_capturedError</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mb-2">Местное время. Изменение записывается в журнал аудита.</MudText>
        <div class="d-flex gap-2">
            <div style="width:100%;">
                <MudDatePicker @bind-Date="_capturedDate" Label="Дата *" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
            </div>
            <MudTimePicker @bind-Time="_capturedTime" Label="Время *" Variant="Variant.Outlined" AmPm="false" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _capturedOpen = false)">Отмена</MudButton>
        @if (!_busy && (_capturedDate is null || _capturedTime is null))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mr-2">Укажите и дату, и время съёмки</MudText>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _capturedDate is null || _capturedTime is null)"
                   OnClick="SaveCapturedAtAsync">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_purgeOpen" Options="DialogOptionsSmall">
    <TitleContent><MudText Typo="Typo.h6">Удалить носитель?</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            Удаление гарантированное и необратимое: будут уничтожены исходный файл, расшифровка речи, все найденные лица,
            их вырезки и биометрические шаблоны. Факт удаления записывается в неизменяемый журнал.
            Доступно ролям Администратор/Руководитель.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _purgeOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_busy" OnClick="PurgeAsync">Удалить безвозвратно</MudButton>
    </DialogActions>
</MudDialog>

@* --- Ручная привязка лица к фигуранту (ТФ-МЕД-03): создаётся КАНДИДАТ, не подтверждение --- *@
<MudDialog @bind-Visible="_linkOpen" Options="DialogOptionsSmall">
    <TitleContent><MudText Typo="Typo.h6">Привязать лицо № @_linkFace?.Id к фигуранту</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Привязка создаёт кандидата для двойной верификации (ТБ-073): статус «подтверждён» появится только
            после независимых решений эксперта и верификатора. Основание и фигурант — из дела носителя (ТБ-071).
        </MudText>
        @if (_linkError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_linkError</MudAlert>
        }
        @if (_linkLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-2" />
        }
        <MudSelect T="int?" @bind-Value="_linkAuthorizationId" Label="Основание *" Variant="Variant.Outlined" Dense="true"
                   Placeholder="Выберите основание" Disabled="@(_busy || _linkLoading)">
            @foreach (var a in _linkAuthorizations)
            {
                <MudSelectItem T="int?" Value="@a.AuthorizationId">@a.Reference</MudSelectItem>
            }
        </MudSelect>
        @if (_linkLoaded && _linkAuthorizations.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">У дела нет оснований — добавьте основание в карточке дела.</MudText>
        }
        <MudSelect T="int?" @bind-Value="_linkPersonRef" Label="Фигурант дела *" Variant="Variant.Outlined" Dense="true" Class="mt-2"
                   Placeholder="Выберите фигуранта" Disabled="@(_busy || _linkLoading)">
            @foreach (var p in _linkPersons)
            {
                <MudSelectItem T="int?" Value="@p.PersonId">@p.DisplayName</MudSelectItem>
            }
        </MudSelect>
        @if (_linkLoaded && _linkPersons.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">Фигурантов у дела нет либо они вне вашего допуска — сначала заведите фигуранта.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _linkOpen = false)" Disabled="_busy">Отмена</MudButton>
        @if (!_busy && !_linkLoading && LinkHint is { } linkHint)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mr-2">@linkHint</MudText>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanLink)" OnClick="LinkAsync">
            @(_busy ? "Создаю кандидата…" : "Создать кандидата")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string MediaModulePath = "./_content/ISC.AI.Modules.Media.UI/js/media.js";

    /// <summary>Контейнеры, которые воспроизводит браузерный &lt;video&gt;; остальное из allowlist (MKV/AVI/MOV/3GP) — только скачать.</summary>
    private static readonly string[] BrowserPlayableVideoTypes = ["video/mp4", "video/webm"];

    /// <summary>
    /// Звуковые форматы, которые воспроизводит браузерный &lt;audio&gt; (ADR-0026): весь аудио-allowlist
    /// <c>MediaFileRules</c>, КРОМЕ AMR и 3GPP — их браузеры не играют, для них только «скачать».
    /// Синонимы (<c>audio/x-m4a</c>, <c>audio/x-wav</c>) — потому что браузеры заявляют один файл по-разному.
    /// </summary>
    private static readonly string[] BrowserPlayableAudioTypes =
    [
        "audio/mpeg", "audio/mp4", "audio/x-m4a", "audio/aac", "audio/ogg", "audio/opus",
        "audio/wav", "audio/x-wav", "audio/webm", "audio/flac",
    ];

    private static readonly DialogOptions DialogOptionsSmall =
        new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Натуральный размер изображения (из JS) — база процентов для рамок лиц.</summary>
    private sealed record ImageSize(int Width, int Height);

    /// <summary>Носитель из маршрута.</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>
    /// Параметр <c>?face=</c> как пришёл в адресе — строкой, чтобы нечисловое значение не роняло страницу
    /// (см. <see cref="MediaQueryValues"/>); разбор — <see cref="HighlightFaceId"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "face")] public string? FaceQuery { get; set; }

    /// <summary>
    /// Параметр <c>?t=</c> как пришёл в адресе — строкой по той же причине; разбор — <see cref="StartAtMs"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "t")] public string? StartAtQuery { get; set; }

    /// <summary>Лицо, к которому пришли по ссылке (с выдачи поиска / верификации) — подсвечивается рамкой.</summary>
    private int? HighlightFaceId => MediaQueryValues.ParseInt(FaceQuery);

    /// <summary>
    /// Место записи в миллисекундах, к которому пришли из поиска по расшифровкам дела (ADR-0026):
    /// после загрузки проигрыватель перематывается сюда, фрагмент расшифровки подсвечивается. Нечисловое
    /// значение — как если бы места не было: запись просто открывается с начала.
    /// </summary>
    private long? StartAtMs => MediaQueryValues.ParseLong(StartAtQuery);

    private MediaAssetDetails? _details;
    private int? _loadedId;
    private string? _error;
    private string? _notice;
    private SnapshotFrameResult? _snapshot;
    private VideoFrameViewer? _viewer;
    private bool _busy;
    private bool _purgeOpen;
    private IJSObjectReference? _module;
    private bool _moduleFailed;
    private ImageSize? _imageSize;
    private bool _measureRequested;

    private bool _linkOpen;
    private bool _linkLoaded;
    private bool _linkLoading;
    private FaceRow? _linkFace;
    private IReadOnlyList<CaseAuthorizationItem> _linkAuthorizations = [];
    private IReadOnlyList<CasePersonItem> _linkPersons = [];
    private int? _linkAuthorizationId;
    private int? _linkPersonRef;
    private string? _linkError;

    /// <summary>Id &lt;video&gt; просмотрщика (см. <see cref="VideoFrameViewer.VideoElementId"/>) — для панели расшифровки.</summary>
    private string VideoElementId => $"media-video-{Id}";

    private string AudioElementId => $"media-audio-{Id}";

    private string ImageElementId => $"media-image-{Id}";

    /// <summary>
    /// Лица к носителю применимы: не аудио и не «неприменимо» (ADR-0026). Иначе блоки лиц, поиска по лицу и
    /// переиндексации скрыты — в записи без изображения их нет и быть не может.
    /// </summary>
    private static bool FacesApplicable(MediaAssetRow asset) =>
        asset.Kind != MediaKind.Audio && asset.IndexStatus != MediaIndexStatus.NotApplicable;

    /// <summary>
    /// Id проигрывателя, который браузер воспроизводит (для перехода к месту записи из расшифровки);
    /// <see langword="null"/> — формат браузеру не по силам (AMR/3GPP, MKV/AVI/MOV/3GP), перехода нет.
    /// </summary>
    private string? PlayableElementId(MediaAssetRow asset) => asset.Kind switch
    {
        MediaKind.Audio when IsBrowserPlayableAudio(asset.ContentType) => AudioElementId,
        MediaKind.Video when IsBrowserPlayable(asset.ContentType) => VideoElementId,
        _ => null,
    };

    // Аудиозапись в видеоконтейнере (индексатор перевёл «видео» без видеопотока в аудио — тип файла остаётся
    // video/mp4 или video/webm): звуковую дорожку такого файла <audio> воспроизводит так же, как <video>.
    private static bool IsBrowserPlayableAudio(string contentType) =>
        BrowserPlayableAudioTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase)
        || BrowserPlayableVideoTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase);

    private bool CanLink => !_busy && !_linkLoading && _linkFace is not null && LinkHint is null;

    private string? LinkHint =>
        _linkAuthorizationId is null && _linkPersonRef is null ? "Выберите основание и фигуранта"
        : _linkAuthorizationId is null ? "Выберите основание"
        : _linkPersonRef is null ? "Выберите фигуранта дела"
        : null;

    private static bool IsBrowserPlayable(string contentType) =>
        BrowserPlayableVideoTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase);

    private static string? CropUrl(FaceRow face) =>
        face.CropStoredFileName is { } crop ? MediaFileUrl.FaceCrop(face.AssetId, crop) : null;

    /// <summary>Ссылка на носитель-источник снимка с переходом к моменту кадра (?t=), если он известен.</summary>
    private static string SourceHref(int sourceAssetId, long? sourceTimestampMs)
    {
        var href = "/media/assets/" + sourceAssetId.ToString(CultureInfo.InvariantCulture);
        return sourceTimestampMs is { } ms ? href + "?t=" + ms.ToString(CultureInfo.InvariantCulture) : href;
    }

    /// <summary>«Кадр № N (чч:мм:сс.ммм)»; без частоты кадров у источника — только момент.</summary>
    private static string SnapshotCaption(SnapshotFrameResult snapshot) =>
        snapshot.FrameIndex is { } frame
            ? $"Кадр № {frame.ToString(CultureInfo.InvariantCulture)} ({MediaLabels.PreciseTimecode(snapshot.TimestampMs)})"
            : $"Кадр ({MediaLabels.PreciseTimecode(snapshot.TimestampMs)})";

    /// <summary>Рамка лица в процентах от натурального размера (ТФ-МЕД-03): цвет — пригодность, выбранное лицо — Primary.</summary>
    private string FaceBoxStyle(FaceRow face, ImageSize size)
    {
        var left = Percent(face.BoxX, size.Width);
        var top = Percent(face.BoxY, size.Height);
        var width = Percent(face.BoxWidth, size.Width);
        var height = Percent(face.BoxHeight, size.Height);
        var border = HighlightFaceId == face.Id
            ? "3px solid var(--mud-palette-primary)"
            : face.QualityAcceptable ? "2px solid var(--mud-palette-success)" : "2px dashed var(--mud-palette-warning)";
        return $"position:absolute;left:{left}%;top:{top}%;width:{width}%;height:{height}%;box-sizing:border-box;border:{border};pointer-events:none;";
    }

    private string FaceBoxLabelStyle(FaceRow face)
    {
        var background = HighlightFaceId == face.Id
            ? "var(--mud-palette-primary)"
            : face.QualityAcceptable ? "var(--mud-palette-success)" : "var(--mud-palette-warning)";
        return $"position:absolute;left:-2px;top:-1.3em;font-size:11px;line-height:1.2;padding:0 3px;color:#fff;background:{background};white-space:nowrap;";
    }

    private static string Percent(float value, int total) =>
        Math.Clamp(total > 0 ? value / total * 100f : 0f, 0f, 100f).ToString("0.##", CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // карточку не грузим — GetMediaAssetQuery аудируется и попадал бы в журнал дважды.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        // Переход карточка → карточка (снимок ↔ источник, ADR-0028) переиспользует тот же экземпляр страницы:
        // Router меняет только параметр Id, OnInitialized повторно не вызывается. Защёлка по Id — одна загрузка
        // (и одна запись View) на носитель; смена ?t=/?face= того же носителя карточку не перечитывает.
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        ResetState();
        await ReloadAsync();
    }

    /// <summary>Сброс всего состояния прежнего носителя перед загрузкой нового (реквизиты, сообщения, диалоги, рамки).</summary>
    private void ResetState()
    {
        _details = null;
        _error = null;
        _notice = null;
        _snapshot = null;
        _viewer = null;
        _purgeOpen = false;
        _imageSize = null;
        _measureRequested = false;
        _linkOpen = false;
        _linkLoaded = false;
        _linkLoading = false;
        _linkFace = null;
        _linkAuthorizations = [];
        _linkPersons = [];
        _linkAuthorizationId = null;
        _linkPersonRef = null;
        _linkError = null;
    }

    // --- Дата съёмки (ТФ-МЕД-17) ---
    private bool _capturedOpen;
    private string? _capturedError;
    private DateTime? _capturedDate;
    private TimeSpan? _capturedTime;

    private void OpenCapturedAt()
    {
        var local = _details?.Asset.CapturedAt?.ToLocalTime().DateTime;
        _capturedDate = local?.Date;
        _capturedTime = local is { } t ? new TimeSpan(t.Hour, t.Minute, 0) : null;
        _capturedError = null;
        _capturedOpen = true;
    }

    private async Task SaveCapturedAtAsync()
    {
        if (_capturedDate is not { } date || _capturedTime is not { } time) { return; }
        _busy = true;
        _capturedError = null;
        try
        {
            var local = new DateTimeOffset(DateTime.SpecifyKind(date.Date + time, DateTimeKind.Local));
            var response = await Dispatcher.Send(new SetAssetCapturedAtCommand(Id, local.ToUniversalTime()));
            if (!response.Status)
            {
                _capturedError = response.StatusMessage;
                return;
            }

            _capturedOpen = false;
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var response = await Dispatcher.Send(new GetMediaAssetQuery(Id));
        if (response is { Status: true, Data: { } details })
        {
            _details = details;
        }
        else
        {
            _details = null;
            _error = response.StatusMessage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS-модуль нужен только после интерактива и только когда есть что мерить/перематывать; грузим лениво
        // и ТОЛЬКО здесь — предрендер JS не умеет.
        if (!RendererInfo.IsInteractive || _details is null)
        {
            return;
        }

        // Видео обслуживает VideoFrameViewer со своим экземпляром модуля; здесь модуль нужен только картинке.
        if (_details.Asset.Kind == MediaKind.Image && !_measureRequested)
        {
            _measureRequested = true;
            await MeasureImageAsync();
        }
    }

    /// <summary>Ленивая загрузка JS-модуля пакета; после первого сбоя не повторяем (страница живёт без него).</summary>
    private async Task<IJSObjectReference?> EnsureModuleAsync()
    {
        if (_module is not null || _moduleFailed)
        {
            return _module;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", MediaModulePath);
        }
        catch (JSException)
        {
            // Без модуля страница живёт: рамок и «к кадру» не будет — покажем при нажатии.
            _moduleFailed = true;
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт.
            _moduleFailed = true;
        }

        return _module;
    }

    /// <summary>Натуральный размер картинки для рамок; 404 (нет файла ИЛИ вне допуска) — рамок нет, причины не различаем.</summary>
    private async Task MeasureImageAsync()
    {
        var module = await EnsureModuleAsync();
        if (module is null)
        {
            return;
        }

        try
        {
            var size = await module.InvokeAsync<ImageSize?>("measure", ImageElementId);
            if (size is { Width: > 0, Height: > 0 })
            {
                _imageSize = size;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Изображение не измерено — показываем без рамок.
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт — показывать некому.
        }
    }

    /// <summary>
    /// «К кадру» (таймкод лица, фрагмент расшифровки видео без проигрывателя): показать кадр в просмотрщике —
    /// перемотка &lt;video&gt; либо кадр с сервера; ничего не обрабатывая (ТЭ-007).
    /// </summary>
    private Task ShowFrameAsync(long milliseconds) =>
        _viewer?.ShowMomentAsync(milliseconds) ?? Task.CompletedTask;

    /// <summary>
    /// «Снимок кадра» (ADR-0028): кадр момента <paramref name="milliseconds"/> из оригинала — новый фото-носитель
    /// дела; право, гриф, дело и аудит — на сервере (SnapshotFrameCommand). Карточку после снимка НЕ перечитываем:
    /// источник не изменился, а повторный GetMediaAssetQuery дал бы вторую запись View в журнале (ТБ-030).
    /// </summary>
    private async Task SnapshotAsync(long milliseconds)
    {
        _busy = true;
        _error = null;
        _notice = null;
        _snapshot = null;
        try
        {
            var response = await Dispatcher.Send(new SnapshotFrameCommand(Id, milliseconds));
            if (response is { Status: true, Data: { } result })
            {
                _snapshot = result;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>ТФ-ПЛ-03: проба = лицо носителя; дело — то, к которому привязан носитель.</summary>
    private void SearchFace(int faceId)
    {
        var caseQuery = _details?.CaseId is { } caseId ? $"caseId={caseId}&" : string.Empty;
        Navigation.NavigateTo($"/media/search?{caseQuery}faceId={faceId}");
    }

    /// <summary>Открыть диалог ручной привязки (ТФ-МЕД-03): основания и фигуранты — ДЕЛА носителя (ТБ-071), грузятся один раз.</summary>
    private async Task OpenLinkAsync(FaceRow face)
    {
        if (_details?.CaseId is not { } caseId)
        {
            return;
        }

        _linkFace = face;
        _linkAuthorizationId = null;
        _linkPersonRef = null;
        _linkError = null;
        _linkOpen = true;

        if (!_linkLoaded)
        {
            _linkLoading = true;
            try
            {
                var authorizations = await Dispatcher.Send(new ListCaseAuthorizationsQuery(caseId));
                _linkAuthorizations = authorizations is { Status: true, Data: { } a } ? a : [];
                var persons = await Dispatcher.Send(new ListCasePersonsQuery(caseId));
                _linkPersons = persons is { Status: true, Data: { } p } ? p : [];
                if (authorizations is { Status: false })
                {
                    _linkError = authorizations.StatusMessage;
                }
                else if (persons is { Status: false })
                {
                    _linkError = persons.StatusMessage;
                }

                _linkLoaded = true;
            }
            finally
            {
                _linkLoading = false;
            }
        }

        if (_linkAuthorizations.Count == 1)
        {
            _linkAuthorizationId = _linkAuthorizations[0].AuthorizationId;
        }
    }

    /// <summary>Создать кандидата ручной привязки и перейти к решению эксперта с подсказкой про фигуранта (ТФ-ВЕР-03).</summary>
    private async Task LinkAsync()
    {
        if (_linkFace is not { } face || _linkAuthorizationId is not { } authorizationId || _linkPersonRef is not { } personRef)
        {
            return;
        }

        _busy = true;
        _linkError = null;
        try
        {
            var response = await Dispatcher.Send(new LinkFaceToPersonCommand(face.Id, authorizationId, personRef));
            if (!response.Status)
            {
                _linkError = response.StatusMessage;
                return;
            }

            _linkOpen = false;
            Navigation.NavigateTo($"/media/verification/{response.Data}?stage=Expert&person={personRef}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReindexAsync()
    {
        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var response = await Dispatcher.Send(new ReindexMediaCommand(Id));
            if (response.Status)
            {
                _notice = "Носитель поставлен в очередь на повторную обработку; лица обновятся после её завершения.";
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task PurgeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new PurgeMediaCommand(Id));
            if (!response.Status)
            {
                _error = response.StatusMessage;
                _purgeOpen = false;
                return;
            }

            _purgeOpen = false;
            // После гарантированного удаления карточки больше нет — уходим в медиатеку дела либо к поиску.
            Navigation.NavigateTo(_details?.CaseId is { } caseId ? $"/media/cases/{caseId}" : "/media/search");
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт — освобождать на клиенте нечего.
            }
            catch (JSException)
            {
                // Сбой очистки не должен ронять уход со страницы.
            }
        }
    }
}
