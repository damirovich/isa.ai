@namespace ISC.AI.Modules.Media.UI
@* Решение по кандидату (ТФ-ВЕР-01..03, ТБ-073, GATE-5): пара «проба ↔ кандидат» в РАВНОМ масштабе,
   как есть (ТЭ-007); исход + обязательное обоснование (морфологические признаки по методике).
   Стадия — из query (по умолчанию эксперт). На стадии ЭКСПЕРТА можно привязать фигуранта дела;
   на стадии ВЕРИФИКАТОРА фигурант НЕ показывается и НЕ спрашивается — слепота второй проверки
   (ТФ-ВЕР-02): верификатор судит по изображениям, а не по выводу эксперта. После двух «подтверждён»
   разных сотрудников — не «установлен», а «следственная версия» (ТЭ-005, TwoPersonRule).
   Стадия РУКОВОДИТЕЛЯ (ТФ-ВЕР-02, ADR-0036) — итог по расхождению: видны оба решения с обоснованиями и привязанный
   фигурант; выбор — только «подтверждён» (если кто-то из двоих подтвердил, ТБ-073) или «отклонён». *@
@page "/media/verification/{CandidateId:int}"
@rendermode InteractiveServer
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Application.Features.Verification
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Решение по кандидату</PageTitle>

<div class="d-flex align-center justify-space-between flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h5">Кандидат № @CandidateId · стадия: @Stage.Label()</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Балл схожести — вероятностная оценка, не установление личности (ТЭ-006). Решение — по морфологическим признакам.
        </MudText>
    </div>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/media/verification">К очереди</MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@if (_item is null)
{
    @if (_error is null)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
}
else
{
    var item = _item;
    <MudPaper Outlined="true" Class="pa-4 my-4">
        <CandidatePair Item="@item" Size="256" />
        <div class="d-flex align-center justify-center gap-2 flex-wrap mt-3">
            <SimilarityChip Similarity="@item.Similarity" />
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@item.Status.ChipColor()">@item.Status.Label()</MudChip>
            <ClassificationChip Classification="@item.Classification" />
            @if (item.Origin == SessionOrigin.SystemSuggestion)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Icon="@Icons.Material.Filled.AutoAwesome">предложено системой</MudChip>
            }
        </div>
        <div class="d-flex gap-4 flex-wrap justify-center mt-2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">дело <MudLink Href="@($"/media/cases/{item.CaseId}")" Typo="Typo.caption">№ @item.CaseId</MudLink></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">сессия <MudLink Href="@($"/media/sessions/{item.SessionId}")" Typo="Typo.caption">№ @item.SessionId</MudLink></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">ранг @item.Rank</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">носитель <MudLink Href="@($"/media/assets/{item.AssetId}?face={item.FaceId}")" Typo="Typo.caption">№ @item.AssetId</MudLink>@(item.FrameTimestampMs is { } ms ? $" · кадр {MediaLabels.Timecode(ms)}" : string.Empty)</MudText>
        </div>
        @if (item.Material is { } material)
        {
            @* ТФ-ПЛ-02: когда, откуда и где снят материал кандидата. *@
            <div class="d-flex justify-center mt-1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Event">@material.MaterialLine(withTime: true)</MudChip>
            </div>
        }
    </MudPaper>

    @if (_review is { } review)
    {
        @* Только руководителю (ТФ-ВЕР-02): оба решения, из-за расхождения которых кандидат попал к нему. *@
        <MudPaper Outlined="true" Class="pa-4 my-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Решения сотрудников</MudText>
            @foreach (var decision in review.Decisions)
            {
                <div class="d-flex align-start gap-3 py-2 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@VerdictColor(decision.Verdict)">
                        @decision.Stage.Label(): @decision.Verdict.Label()
                    </MudChip>
                    <div style="flex:1 1 320px;min-width:0;">
                        <MudText Typo="Typo.body2">@decision.Rationale</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            сотрудник № @decision.SubjectId · @decision.DecidedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </div>
                </div>
            }
            <MudText Typo="Typo.body2" Class="mt-1">
                Привязанный фигурант: <b>@(review.LinkedPersonRef is { } linked ? PersonName(linked) : "не привязан")</b>
            </MudText>
        </MudPaper>
    }

    @if (_recordedStatus is { } recorded)
    {
        <MudAlert Severity="@(recorded == CandidateStatus.Confirmed ? Severity.Success : Severity.Info)" Variant="Variant.Outlined" Class="my-3">
            Решение записано. Статус кандидата: <b>@recorded.Label()</b>.
            @if (recorded == CandidateStatus.Confirmed)
            {
                <span> — @TwoPersonRule.ConfirmedMarker.</span>
            }
            <MudLink Href="/media/verification" Class="ml-2">К очереди</MudLink>
        </MudAlert>
    }
    else if (item.OwnDecision is { } own)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-3">
            Ваше решение по этому кандидату уже записано: <b>@own.Verdict.Label()</b>
            (@own.DecidedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")). Обоснование: @own.Rationale
            @if (Stage == VerificationStage.Supervisor && own.Stage != VerificationStage.Supervisor)
            {
                @* ТБ-073: итог по расхождению — третье лицо; эксперт или верификатор этого кандидата его не выносит. *@
                <span> Вы уже решали как @own.Stage.Label() — итог по расхождению выносит другой руководитель (ТБ-073).</span>
            }
        </MudAlert>
    }
    else if (Stage == VerificationStage.Supervisor && _review is null)
    {
        @* Без решений сотрудников итог не выносится; причина — в сообщении об ошибке выше. *@
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4 my-4">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Решение стадии «@Stage.Label()»</MudText>
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_formError</MudAlert>
            }
            <MudRadioGroup T="VerificationVerdict?" @bind-Value="_verdict">
                <MudRadio T="VerificationVerdict?" Value="VerificationVerdict.Confirmed" Color="Color.Success" Disabled="@SupervisorCannotConfirm">подтверждён</MudRadio>
                <MudRadio T="VerificationVerdict?" Value="VerificationVerdict.Rejected" Color="Color.Error">отклонён</MudRadio>
                @if (Stage != VerificationStage.Supervisor)
                {
                    @* Руководитель снимает неопределённость, а не оставляет её (ADR-0036). *@
                    <MudRadio T="VerificationVerdict?" Value="VerificationVerdict.Undetermined" Color="Color.Warning">неопределённо</MudRadio>
                }
            </MudRadioGroup>
            @if (SupervisorCannotConfirm)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">
                    Подтвердить нельзя: ни эксперт, ни верификатор не сказал «подтверждён», а статус требует двух положительных
                    решений разных сотрудников (ТБ-073). Возможен только «отклонён».
                </MudText>
            }
            <MudTextField @bind-Value="_rationale" Label="Обоснование *" Variant="Variant.Outlined" Immediate="true" Lines="5" MaxLength="@RecordVerificationValidator.MaxRationaleLength" Class="mt-2"
                          HelperText="морфологические признаки по методике: форма лица, надбровные дуги, нос, уши, особые приметы; какие признаки сходны, какие различаются" />
            @if (Stage is VerificationStage.Expert or VerificationStage.Supervisor)
            {
                @* Эксперту (ТФ-ВЕР-03) и руководителю; верификатору фигурант не показывается — слепота (ТФ-ВЕР-02).
                   При исходе «подтверждён» фигурант ОБЯЗАТЕЛЕН (валидатор команды требует то же) — иначе после
                   второго «подтверждён» статус был бы без «появления». *@
                <MudSelect T="int?" @bind-Value="_personRef" Label="Фигурант дела (обязателен при «подтверждён»)" Variant="Variant.Outlined" Dense="true"
                           Clearable="true" Class="mt-2" Placeholder="без привязки" Disabled="_busy">
                    @foreach (var person in _persons)
                    {
                        <MudSelectItem T="int?" Value="@person.PersonId">@person.DisplayName@(person.ConfirmedOnFace ? " — это лицо уже подтверждено" : string.Empty)</MudSelectItem>
                    }
                </MudSelect>
                @* Одно появление на пару «фигурант — лицо»: то же лицо, пришедшее из другой сессии поиска, уже подтверждено —
                   повторное «подтверждён» нового появления не создаст. Подсказка только эксперту: верификатор слеп (ТФ-ВЕР-02). *@
                @if (_persons.FirstOrDefault(p => p.PersonId == _personRef) is { ConfirmedOnFace: true } already)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        Это лицо у фигуранта «@already.DisplayName» уже подтверждено (появление есть). Повторное подтверждение
                        нового появления не добавит — кандидата можно отклонить как повтор или подтвердить, запись останется одна.
                    </MudAlert>
                }
                @if (SuggestedPersonRef is { } suggested)
                {
                    <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block mt-1">
                        @(item.Origin == SessionOrigin.SystemSuggestion
                            ? $"Система предложила фигуранта № {suggested}: лицо похоже на его эталон (ТФ-ПЕР-09) —"
                            : $"Кандидат создан ручной привязкой к фигуранту № {suggested} (ТФ-МЕД-03) —")
                        @(_persons.Any(p => p.PersonId == suggested) ? "он подставлен в список; проверьте и при «подтверждён» оставьте его." : "в списке фигурантов дела его нет — выберите фигуранта вручную.")
                    </MudText>
                }
                @if (_persons.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                        Фигурантов у дела нет либо они вне вашего допуска: «подтверждён» записать нельзя (ТФ-ВЕР-03),
                        @(Stage == VerificationStage.Supervisor ? "«отклонён» — можно." : "«отклонён»/«неопределённо» — можно.")
                    </MudText>
                }
            }
            <div class="d-flex align-center gap-3 mt-3 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(!FormValid || _busy)" OnClick="SubmitAsync">@(_busy ? "Записываю…" : "Записать решение")</MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Решение необратимо и записывается в неизменяемый журнал (ТБ-072).</MudText>
            </div>
            @if (!_busy && !PersonMissingForConfirm && FormHint is { } formHint)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">@formHint</MudText>
            }
            @if (PersonMissingForConfirm)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">@RecordVerificationValidator.PersonRequiredMessage</MudText>
            }
        </MudPaper>
    }
}

@code {
    /// <summary>Кандидат из маршрута.</summary>
    [Parameter] public int CandidateId { get; set; }

    /// <summary>Стадия из адресной строки (<c>Expert</c>/<c>Verifier</c>/<c>Supervisor</c>); по умолчанию — эксперт.</summary>
    [SupplyParameterFromQuery(Name = "stage")] public string? StageQuery { get; set; }

    /// <summary>
    /// Параметр <c>?person=</c> как пришёл в адресе — строкой, чтобы нечисловое значение не роняло страницу
    /// (см. <see cref="MediaQueryValues"/>); разбор — <see cref="SuggestedPersonRef"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "person")] public string? PersonQuery { get; set; }

    /// <summary>
    /// Фигурант, указанный при ручной привязке лица (ТФ-МЕД-03) — подсказка эксперту; верификатору не
    /// показывается (ТФ-ВЕР-02). Неразобранное значение — подсказки нет.
    /// </summary>
    private int? SuggestedPersonRef => MediaQueryValues.ParseInt(PersonQuery);

    private VerificationStage Stage =>
        Enum.TryParse<VerificationStage>(StageQuery, ignoreCase: true, out var stage) ? stage : VerificationStage.Expert;

    private VerificationQueueItem? _item;

    /// <summary>Решения сотрудников — только руководителю и только отдельным запросом (ТФ-ВЕР-02, ADR-0036).</summary>
    private SupervisorReview? _review;
    private IReadOnlyList<CasePersonItem> _persons = [];
    private VerificationVerdict? _verdict;
    private string? _rationale;
    private int? _personRef;
    private CandidateStatus? _recordedStatus;
    private bool _busy;
    private string? _error;
    private string? _formError;

    /// <summary>ТФ-ВЕР-03: эксперт при «подтверждён» обязан указать фигуранта — проверяем на клиенте и объясняем причину.</summary>
    private bool PersonMissingForConfirm =>
        Stage is VerificationStage.Expert or VerificationStage.Supervisor
        && _verdict == VerificationVerdict.Confirmed && _personRef is null;

    /// <summary>
    /// ТБ-073, ADR-0036: руководитель подтверждает только вместе с положительным решением эксперта или верификатора.
    /// Форма показывается, лишь когда своего решения по кандидату у руководителя нет, — значит, любое «подтверждён» в
    /// списке принадлежит другому сотруднику. Сервер проверяет то же правило.
    /// </summary>
    private bool SupervisorCannotConfirm =>
        Stage == VerificationStage.Supervisor
        && _review is { } review
        && !review.Decisions.Any(d => d.Stage != VerificationStage.Supervisor && d.Verdict == VerificationVerdict.Confirmed);

    private bool FormValid => FormHint is null && !PersonMissingForConfirm
        && !(SupervisorCannotConfirm && _verdict == VerificationVerdict.Confirmed);

    // Чего не хватает для «Записать решение» (кроме фигуранта — для него отдельное сообщение ниже).
    private string? FormHint =>
        _verdict is null && string.IsNullOrWhiteSpace(_rationale) ? "Выберите решение и заполните обоснование"
        : _verdict is null ? (Stage == VerificationStage.Supervisor
            ? "Выберите итог: подтверждён или отклонён"
            : "Выберите решение: подтверждён, отклонён или неопределённо")
        : string.IsNullOrWhiteSpace(_rationale) ? "Заполните обоснование"
        : null;

    private static Color VerdictColor(VerificationVerdict verdict) => verdict switch
    {
        VerificationVerdict.Confirmed => Color.Success,
        VerificationVerdict.Rejected => Color.Error,
        _ => Color.Warning,
    };

    /// <summary>Имя фигуранта из списка дела; нет в списке (вне допуска) — номер.</summary>
    private string PersonName(int personId) =>
        _persons.FirstOrDefault(p => p.PersonId == personId)?.DisplayName ?? $"№ {personId}";

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // пару не грузим — GetCandidatePairQuery аудируется и попадал бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        var response = await Dispatcher.Send(new GetCandidatePairQuery(CandidateId, Stage));
        if (response is not { Status: true, Data: { } item })
        {
            _error = response.StatusMessage;
            return;
        }

        _item = item;

        // Руководителю — решения эксперта и верификатора: без них итог по расхождению не вынести.
        if (Stage == VerificationStage.Supervisor)
        {
            var review = await Dispatcher.Send(new GetSupervisorReviewQuery(CandidateId));
            if (review is { Status: true, Data: { } data })
            {
                _review = data;
            }
            else
            {
                _error = review.StatusMessage;
            }
        }

        // Фигуранты — эксперту и руководителю: верификатор о привязке не знает (ТФ-ВЕР-02). Руководителю — всегда:
        // по списку подписывается фигурант, которого привязал эксперт.
        if ((Stage == VerificationStage.Expert && item.OwnDecision is null) || Stage == VerificationStage.Supervisor)
        {
            var persons = await Dispatcher.Send(new ListCasePersonsQuery(item.CaseId, item.FaceId));
            if (persons is { Status: true, Data: { } list })
            {
                _persons = list;
            }

            // Подставляется фигурант эксперта (у руководителя), иначе подсказка ручной привязки или системы — и ТОЛЬКО
            // если он есть среди фигурантов дела (ТБ-071).
            var preset = Stage == VerificationStage.Supervisor ? _review?.LinkedPersonRef ?? SuggestedPersonRef : SuggestedPersonRef;
            if (preset is { } suggested && _persons.Any(p => p.PersonId == suggested))
            {
                _personRef = suggested;
            }
        }
    }

    private async Task SubmitAsync()
    {
        if (_verdict is not { } verdict || string.IsNullOrWhiteSpace(_rationale) || PersonMissingForConfirm)
        {
            return;
        }

        _busy = true;
        _formError = null;
        try
        {
            // PersonRef уходит со стадий эксперта и руководителя; для верификатора всегда null (команда и валидатор это тоже проверяют).
            var response = await Dispatcher.Send(new RecordVerificationCommand(
                CandidateId, Stage, verdict, _rationale.Trim(),
                Stage is VerificationStage.Expert or VerificationStage.Supervisor ? _personRef : null));
            if (response is { Status: true, Data: { } status })
            {
                _recordedStatus = status;
            }
            else
            {
                _formError = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
