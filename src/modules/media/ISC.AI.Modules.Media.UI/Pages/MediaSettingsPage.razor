@namespace ISC.AI.Modules.Media.UI
@* Настройки поиска и верификации (ТФ-ВЕР-07, ТФ-ПЛ-08, ТФ-АДМ-03, ADR-0054) и разметка дикторов при расшифровке
   (ADR-0062 v0.3). Меняет Администратор: право проверяет сервер, без права экран — только для чтения с пояснением.
   Режим и пороги — черновиком: правки копятся, панель «Есть изменения» внизу появляется только при отличии от
   сохранённого, «Отменить» возвращает сохранённое, «Сохранить» — одной командой (проверка 1–99 % и «рабочий не ниже
   границы» — на сервере, форма подсказывает тем же правилом). Переключатель дикторов сохраняется сразу — отдельной
   командой. Итог сохранения — всплывающим сообщением; каждое изменение — в журнале с прежними и новыми значениями. *@
@page "/media/settings"
@rendermode InteractiveServer
@using System.Collections.Generic
@using System.Globalization
@using ISC.AI.Modules.Media.Application.Features.Settings
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services
@inject ISnackbar Snackbar

<PageTitle>Настройки поиска и верификации</PageTitle>

<div class="settings">
    <header class="settings-header">
        <div>
            <MudText Typo="Typo.h5">Настройки поиска и верификации</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Правила подтверждения совпадений по лицу, порог схожести и расшифровка речи
            </MudText>
        </div>
        @if (_view is { } header)
        {
            <div class="settings-meta" title="@ChangedHint(header)">
                <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" />
                <span>@ChangedText(header)</span>
            </div>
        }
    </header>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">
            <div class="d-flex align-center gap-3 flex-wrap">
                <span>Настройки не загрузились: @_loadError</span>
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LoadAsync">Повторить</MudButton>
            </div>
        </MudAlert>
    }
    else if (_view is null)
    {
        @* Заготовка на время загрузки — того же размера, что разделы: страница не «прыгает». *@
        @for (var i = 0; i < 3; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="148px" Class="settings-skeleton" />
        }
    }
    else
    {
        var view = _view;
        var readOnly = !view.CanManage;

        @if (readOnly)
        {
            <div class="settings-readonly">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                <span>Значения показаны для сведения: менять их может только Администратор (право «Настройки поиска и верификации»).</span>
            </div>
        }

        <section class="settings-section" aria-labelledby="settings-mode">
            <div class="section-head">
                <span class="section-icon"><MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.subtitle1" id="settings-mode" Class="section-title">Подтверждение совпадения по лицу</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Кто присваивает кандидату статус «подтверждён» (ТБ-073). Автоматического подтверждения нет ни в одном режиме.
                    </MudText>
                </div>
            </div>

            <div class="mode-grid" role="radiogroup" aria-labelledby="settings-mode">
                @foreach (var option in ModeOptions)
                {
                    var selected = _mode == option.Mode;
                    <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")"
                            class="@($"mode-tile{(selected ? " selected" : string.Empty)}")" disabled="@(readOnly || _busy)"
                            @onclick="@(() => _mode = option.Mode)">
                        <span class="tile-icon"><MudIcon Icon="@option.Icon" /></span>
                        <span class="tile-body">
                            <span class="tile-title">@option.Title</span>
                            <span class="tile-text">@option.Text</span>
                        </span>
                        <MudIcon Class="tile-check" Size="Size.Small"
                                 Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" />
                    </button>
                }
            </div>

            <div class="section-note">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                <span>
                    Смена режима не меняет вынесенных решений: разборы, начатые вдвоём, доводятся вдвоём; новый режим действует для
                    кандидатов без решений. «Неопределённо» в любом режиме решает руководитель — другой сотрудник.
                </span>
            </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-threshold">
            <div class="section-head">
                <span class="section-icon"><MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.subtitle1" id="settings-threshold" Class="section-title">Порог схожести</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        С рабочим порогом открывается поиск по лицу; оператор может выбрать любой порог не ниже границы.
                        Кандидаты ниже порога не показываются.
                    </MudText>
                </div>
            </div>

            <div class="threshold-grid">
                <div class="threshold-field">
                    <div class="field-head">
                        <span class="field-label">Рабочий порог</span>
                        <span class="field-value">@_threshold %</span>
                    </div>
                    <MudSlider T="int" Min="@MediaSettings.MinPercent" Max="@MediaSettings.MaxPercent" Step="1" Value="_threshold"
                               ValueChanged="@(value => _threshold = value)" Color="Color.Primary" Disabled="@(readOnly || _busy)"
                               aria-label="Рабочий порог, %" />
                    <div class="field-foot">
                        <MudNumericField T="int" @bind-Value="_threshold" Label="Рабочий порог, %" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="@MediaSettings.MinPercent" Max="@MediaSettings.MaxPercent" Class="field-number"
                                         Disabled="@(readOnly || _busy)" />
                        <span class="field-hint">С ним открывается поиск</span>
                    </div>
                </div>

                <div class="threshold-field">
                    <div class="field-head">
                        <span class="field-label">Нижняя граница</span>
                        <span class="field-value">@(_minThreshold <= MediaSettings.MinPercent ? "нет" : $"{_minThreshold} %")</span>
                    </div>
                    <MudSlider T="int" Min="@MediaSettings.MinPercent" Max="@MediaSettings.MaxPercent" Step="1" Value="_minThreshold"
                               ValueChanged="@(value => _minThreshold = value)" Color="Color.Primary" Disabled="@(readOnly || _busy)"
                               aria-label="Нижняя граница, %" />
                    <div class="field-foot">
                        <MudNumericField T="int" @bind-Value="_minThreshold" Label="Нижняя граница, %" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="@MediaSettings.MinPercent" Max="@MediaSettings.MaxPercent" Class="field-number"
                                         Disabled="@(readOnly || _busy)" />
                        <span class="field-hint">1 % — без ограничения; не выше рабочего</span>
                    </div>
                </div>
            </div>

            @* Шкала 0–100 %: ниже границы — недоступная оператору зона, метка — рабочий порог. *@
            <div class="scale" aria-hidden="true">
                <div class="scale-track">
                    @if (_minThreshold > MediaSettings.MinPercent)
                    {
                        <div class="scale-blocked" style="@($"width:{Percent(_minThreshold)};")"></div>
                    }
                    <div class="@($"scale-marker{(ValidationError is null ? string.Empty : " invalid")}")" style="@($"left:{Percent(_threshold)};")">
                        <span>@_threshold %</span>
                    </div>
                </div>
                <div class="scale-legend">
                    <span>0 %</span>
                    <span class="scale-model">шкала модели: @view.ScaleDescription</span>
                    <span>100 %</span>
                </div>
            </div>

            @if (ValidationError is { } validation)
            {
                <div class="field-error" role="alert">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />
                    <span>@validation</span>
                </div>
            }

            <div class="section-note">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                <span>
                    Проценты — шкала балла модели (@view.ScaleDescription), до калибровки на пилоте. Это вероятностная оценка, а не
                    установление личности (ТЭ-006).
                </span>
            </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-speech">
            <div class="section-head">
                <span class="section-icon"><MudIcon Icon="@Icons.Material.Outlined.RecordVoiceOver" Size="Size.Small" /></span>
                <div>
                    <MudText Typo="Typo.subtitle1" id="settings-speech" Class="section-title">Расшифровка речи</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Как обрабатываются аудио и видео при загрузке в дело.</MudText>
                </div>
            </div>

            <div class="setting-row">
                <div>
                    <div class="row-title">Размечать дикторов</div>
                    <div class="row-text">
                        Реплики подписываются «Диктор 1», «Диктор 2»… При «Расшифровать заново» сотрудник выбирает для записи сам:
                        без дикторов, «авто» или число говорящих. Сохраняется сразу.
                    </div>
                </div>
                <MudSwitch T="bool" Value="@view.TranscriptSpeakers" ValueChanged="SetSpeakersAsync" Color="Color.Primary"
                           Disabled="@(readOnly || _busy)" aria-label="Размечать дикторов при расшифровке загруженных материалов" />
            </div>
        </section>

        @if (!readOnly && Changed)
        {
            <div class="settings-savebar" role="region" aria-label="Несохранённые изменения">
                <div class="savebar-text">
                    <MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" />
                    <span>Есть изменения: @string.Join(", ", ChangedItems)</span>
                </div>
                <div class="savebar-actions">
                    <MudButton Variant="Variant.Text" OnClick="Discard" Disabled="_busy">Отменить</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAsync" Disabled="@(_busy || ValidationError is not null)">
                        @(_busy ? "Сохраняем…" : "Сохранить")
                    </MudButton>
                </div>
            </div>
        }
    }
</div>

@code {
    private sealed record ModeOption(ConfirmationMode Mode, string Icon, string Title, string Text);

    private static readonly ModeOption[] ModeOptions =
    [
        new(ConfirmationMode.SingleOperator, Icons.Material.Outlined.Person, "Один оператор",
            "Решение сотрудника с правом «Верификация — первая подпись» окончательное. Быстрее — для потока материалов."),
        new(ConfirmationMode.TwoPerson, Icons.Material.Outlined.Groups, "Два лица",
            "Эксперт и слепой верификатор; при расхождении итог выносит руководитель. Строже — для ответственных решений."),
    ];

    private MediaSettingsView? _view;
    private ConfirmationMode _mode = MediaSettings.DefaultMode;
    private int _threshold = MediaSettings.DefaultThresholdPercent;
    private int _minThreshold = MediaSettings.DefaultMinThresholdPercent;
    private bool _busy;
    private string? _loadError;

    // Подсказка формы — тем же правилом, что проверяет сервер (MediaSettings.Validate).
    private string? ValidationError => MediaSettings.Validate(_mode, _threshold, _minThreshold);

    private bool Changed => ChangedItems.Count > 0;

    // Что именно поменяли — для панели «Есть изменения».
    private List<string> ChangedItems
    {
        get
        {
            var items = new List<string>();
            if (_view is not { } view)
            {
                return items;
            }

            if (view.Mode != _mode) { items.Add("режим подтверждения"); }
            if (view.ThresholdPercent != _threshold) { items.Add("рабочий порог"); }
            if (view.MinThresholdPercent != _minThreshold) { items.Add("нижняя граница"); }
            return items;
        }
    }

    private static string Percent(int value) => value.ToString(CultureInfo.InvariantCulture) + "%";

    private static string ChangedText(MediaSettingsView view) =>
        view.UpdatedAtUtc is { } at
            ? $"Изменено {at.ToLocalTime():dd.MM.yyyy HH:mm}" + (view.UpdatedByName is { } name ? $" · {name}" : string.Empty)
            : "Не менялись — действуют значения поставки";

    private static string ChangedHint(MediaSettingsView view) =>
        view.UpdatedAtUtc is null
            ? "Один оператор, рабочий порог 70 %, без нижней границы, дикторы размечаются — или значения конфигурации."
            : "Последнее сохранение любой из настроек этой страницы.";

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) { return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        var response = await Dispatcher.Send(new GetMediaSettingsQuery());
        if (response is { Status: true, Data: { } view })
        {
            _view = view;
            (_mode, _threshold, _minThreshold) = (view.Mode, view.ThresholdPercent, view.MinThresholdPercent);
        }
        else
        {
            _loadError = response.StatusMessage;
        }
    }

    private void Discard()
    {
        if (_view is { } view)
        {
            (_mode, _threshold, _minThreshold) = (view.Mode, view.ThresholdPercent, view.MinThresholdPercent);
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new SetMediaSettingsCommand(_mode, _threshold, _minThreshold));
            if (response is { Status: true })
            {
                Snackbar.Add(response.StatusMessage ?? "Настройки сохранены.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(response.StatusMessage ?? "Настройки не сохранены.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // Разметка дикторов (ADR-0062 v0.3) — отдельной командой, без панели сохранения: переключатель сохраняется сразу.
    // Черновик режима и порогов при этом не теряется: перечитывается только сохранённое.
    private async Task SetSpeakersAsync(bool enabled)
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new SetTranscriptSpeakersCommand(enabled));
            if (response is { Status: true })
            {
                var draft = (_mode, _threshold, _minThreshold);
                Snackbar.Add(response.StatusMessage ?? "Сохранено.", Severity.Success);
                await LoadAsync();
                (_mode, _threshold, _minThreshold) = draft;
            }
            else
            {
                Snackbar.Add(response.StatusMessage ?? "Не сохранено.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
