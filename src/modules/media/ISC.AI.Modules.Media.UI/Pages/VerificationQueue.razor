@namespace ISC.AI.Modules.Media.UI
@* Очередь двойной верификации (ТФ-ВЕР-01/02, ТБ-073): вкладки стадий эксперта, верификатора и руководителя
   (итог по расхождению, ADR-0036; ему видны оба решения). Вкладки эксперта и верификатора — СЛЕПЫЕ проекции:
   без чужих решений и без привязанного фигуранта. Кнопки/вкладки по ролям
   не прячем — право проверяет обработчик, отказ показываем текстом (StatusMessage). Мини-пара
   «проба ↔ кандидат» в равном масштабе, балл — с предупреждением (ТЭ-006), формулировки — ТЭ-005.
   Очередь листается ПОСТРАНИЧНО: сервер отдаёт одну страницу и общее число, лицо пробы запрашивается один раз
   на страницу (ProbeFaceCache) — открытие не замедляется с ростом очереди. *@
@page "/media/verification"
@rendermode InteractiveServer
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Application.Features.Verification
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Верификация</PageTitle>

<div class="d-flex align-center justify-space-between flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h5">Верификация кандидатов</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Два независимых решения разных сотрудников; верификатор решения эксперта не видит; при расхождении итог выносит руководитель (ТБ-073, ТФ-ВЕР-02)
        </MudText>
    </div>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@IsLoading(ActiveStage)" OnClick="ReloadAsync">Обновить</MudButton>
</div>

@* ТЭ-006: предупреждение — постоянным текстом над очередью, а не только во всплывающей подсказке чипа. *@
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-3">
    Балл схожести — вероятностная оценка модели, не установление личности (ТЭ-006). Решение — по морфологическим
    признакам; статус «подтверждён» — только после независимых решений двух сотрудников (ТБ-073).
</MudAlert>

@* Отбор очереди (ТФ-ПЛ-02): только сужает очередь на сервере; слепоту не трогает — отбирает по материалу, не по решениям. *@
<MudPaper Outlined="true" Class="pa-3 mt-3">
    <div class="d-flex gap-3 align-end flex-wrap">
        <MudSelect T="double?" Value="_minSimilarity" ValueChanged="OnMinSimilarityChangedAsync" Label="Схожесть"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="Любая" Style="width:170px;">
            @foreach (var level in SimilarityLevels)
            {
                <MudSelectItem T="double?" Value="@level">не ниже @(((level ?? 0) * 100).ToString("0")) %</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Value="_caseId" ValueChanged="OnCaseChangedAsync" Label="Дело" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Clearable="true" Placeholder="Все доступные" Style="min-width:220px;">
            @foreach (var c in _cases)
            {
                <MudSelectItem T="int?" Value="@c.CaseId">№ @c.Number · @c.Title</MudSelectItem>
            }
        </MudSelect>
        @* Ширина календарей — обёрткой: MudBlazor копирует Style пикера на раскрытый календарь. *@
        <div style="width:160px;">
            <MudDatePicker Date="_from" DateChanged="OnFromChangedAsync" Label="Материал с" Variant="Variant.Outlined"
                           Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Clearable="true" />
        </div>
        <div style="width:160px;">
            <MudDatePicker Date="_to" DateChanged="OnToChangedAsync" Label="по" Variant="Variant.Outlined"
                           Margin="Margin.Dense" DateFormat="dd.MM.yyyy" Clearable="true" />
        </div>
        <MudSelect T="VerificationQueueOrder" Value="_order" ValueChanged="OnOrderChangedAsync" Label="Порядок"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:220px;">
            <MudSelectItem T="VerificationQueueOrder" Value="VerificationQueueOrder.BySession">по поискам</MudSelectItem>
            <MudSelectItem T="VerificationQueueOrder" Value="VerificationQueueOrder.MostSimilar">сначала самые похожие</MudSelectItem>
            <MudSelectItem T="VerificationQueueOrder" Value="VerificationQueueOrder.Newest">сначала из новых поисков</MudSelectItem>
        </MudSelect>
        @if (FilterActive)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ResetFilterAsync">Сбросить отбор</MudButton>
        }
    </div>
    @if (_from is { } f && _to is { } t && f > t)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">Начало периода позже конца — поправьте даты.</MudText>
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
        Дата материала — время съёмки, а если оно неизвестно — время загрузки. Отбор действует на все вкладки.
    </MudText>
</MudPaper>

<MudTabs Elevation="0" Border="true" Rounded="true" Class="mt-3" ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChangedAsync">
    <MudTabPanel Text="Эксперт" Icon="@Icons.Material.Filled.Person">
        @RenderQueue(VerificationStage.Expert)
    </MudTabPanel>
    <MudTabPanel Text="Верификатор" Icon="@Icons.Material.Filled.VerifiedUser">
        @RenderQueue(VerificationStage.Verifier)
    </MudTabPanel>
    @* ТФ-ВЕР-02, ADR-0036: «неопределённые» — эксперт и верификатор разошлись; руководитель видит оба решения и выносит итог. *@
    <MudTabPanel Text="Руководитель" Icon="@Icons.Material.Filled.Gavel">
        @RenderQueue(VerificationStage.Supervisor)
    </MudTabPanel>
</MudTabs>

@code {
    /// <summary>Размеры страницы на выбор — кратны 6 (столбцов сетки на широком экране), чтобы ряды были полными; по умолчанию — <see cref="ListVerificationQueueQuery.DefaultPageSize"/>.</summary>
    private static readonly int[] PageSizes = [14, 21, 35, 63, 85];

    // Карточка решения. Эксперту — с фигурантом, которого предложила система (ТФ-ПЕР-09): он подставится в выбор,
    // но решение и привязку делает эксперт. Верификатору фигурант не передаётся — проекция его и не содержит (ТФ-ВЕР-02).
    private static string VerificationHref(VerificationQueueItem item, string stageName)
    {
        var href = "/media/verification/" + item.CandidateId.ToString(System.Globalization.CultureInfo.InvariantCulture) + "?stage=" + stageName;
        return item.SuggestedPersonRef is { } person
            ? href + "&person=" + person.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : href;
    }

    private int _activeTab;
    private int _pageSize = ListVerificationQueueQuery.DefaultPageSize;
    private readonly Dictionary<VerificationStage, IReadOnlyList<VerificationQueueItem>> _items = [];
    private readonly Dictionary<VerificationStage, string?> _denied = [];
    private readonly Dictionary<VerificationStage, int> _pages = [];
    private readonly Dictionary<VerificationStage, int> _totals = [];
    private readonly Dictionary<VerificationStage, ProbeFaceCache> _probeFaces = [];

    // Загрузки стадии могут перекрываться (вкладки не блокируются, Blazor Server обрабатывает события, пока
    // идёт прежний запрос): у каждой стадии свой счётчик запросов, и применяется только ответ на ПОСЛЕДНИЙ —
    // запоздавший ответ другой страницы не подменяет текущую. Признак загрузки — тоже по стадии.
    private readonly Dictionary<VerificationStage, int> _loadSeq = [];
    private readonly HashSet<VerificationStage> _loading = [];

    // Страница и размер, С КОТОРЫМИ получены показанные строки: подпись «показаны …» и переключатель страниц
    // считаются по ним, а не по выбранному в эту секунду.
    private readonly Dictionary<VerificationStage, (int Page, int Size)> _shown = [];

    private VerificationStage ActiveStage => _activeTab switch
    {
        1 => VerificationStage.Verifier,
        2 => VerificationStage.Supervisor,
        _ => VerificationStage.Expert,
    };

    // --- Отбор (ТФ-ПЛ-02) ---
    private static readonly double?[] SimilarityLevels = [0.5, 0.6, 0.7, 0.8, 0.9];
    private IReadOnlyList<CaseScopeItem> _cases = [];
    private double? _minSimilarity;
    private int? _caseId;
    private DateTime? _from;
    private DateTime? _to;
    private VerificationQueueOrder _order = VerificationQueueOrder.BySession;

    private bool FilterActive =>
        _minSimilarity is not null || _caseId is not null || _from is not null || _to is not null || _order != VerificationQueueOrder.BySession;

    // Даты — в местном времени сотрудника; «по» — включительно весь день.
    private VerificationQueueFilter? Filter => FilterActive
        ? new VerificationQueueFilter(
            _minSimilarity,
            _caseId,
            _from?.Date.ToUniversalTime(),
            _to?.Date.AddDays(1).AddTicks(-1).ToUniversalTime(),
            _order)
        : null;

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // очередь не грузим — ListVerificationQueueQuery и GetFaceQuery пар аудируются и попадали бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        // Дела для отбора — те же, что область очереди (дела субъекта, ТБ-071).
        if (await Dispatcher.Send(new ListAccessibleCasesQuery()) is { Status: true, Data: { } cases })
        {
            _cases = cases;
        }

        await LoadAsync(ActiveStage);
    }

    private Task OnMinSimilarityChangedAsync(double? value) { _minSimilarity = value; return ApplyFilterAsync(); }

    private Task OnCaseChangedAsync(int? value) { _caseId = value; return ApplyFilterAsync(); }

    private Task OnFromChangedAsync(DateTime? value) { _from = value; return ApplyFilterAsync(); }

    private Task OnToChangedAsync(DateTime? value) { _to = value; return ApplyFilterAsync(); }

    private Task OnOrderChangedAsync(VerificationQueueOrder value) { _order = value; return ApplyFilterAsync(); }

    private Task ResetFilterAsync()
    {
        (_minSimilarity, _caseId, _from, _to, _order) = (null, null, null, null, VerificationQueueOrder.BySession);
        return ApplyFilterAsync();
    }

    // Новый отбор — с первой страницы на всех стадиях; остальные стадии перечитаются при переходе на их вкладки.
    private Task ApplyFilterAsync()
    {
        if (_from is { } f && _to is { } t && f > t)
        {
            return Task.CompletedTask; // перевёрнутый период — ждём исправления, подсказка под отбором
        }

        _pages.Clear();
        foreach (var stage in Enum.GetValues<VerificationStage>())
        {
            if (stage != ActiveStage)
            {
                _items.Remove(stage);
            }
        }

        return LoadAsync(ActiveStage);
    }

    private Task OnTabChangedAsync(int index)
    {
        _activeTab = index;
        return LoadAsync(ActiveStage);
    }

    private Task ReloadAsync() => LoadAsync(ActiveStage);

    private Task GoToPageAsync(VerificationStage stage, int page)
    {
        _pages[stage] = page;
        return LoadAsync(stage);
    }

    private Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = size;
        // Смена размера меняет границы страниц — начинаем с первой на всех стадиях.
        _pages.Clear();
        return LoadAsync(ActiveStage);
    }

    private int CurrentPage(VerificationStage stage) => _pages.GetValueOrDefault(stage, 1);

    private bool IsLoading(VerificationStage stage) => _loading.Contains(stage);

    private static int PageCount(int total, int size) => Math.Max(1, (int)Math.Ceiling(total / (double)size));

    /// <summary>Страница очереди стадии; отказ по роли/допуску — текстом на вкладке, а не скрытой вкладкой.</summary>
    private async Task LoadAsync(VerificationStage stage)
    {
        var seq = _loadSeq[stage] = _loadSeq.GetValueOrDefault(stage) + 1;
        _loading.Add(stage);
        try
        {
            var page = CurrentPage(stage);
            var size = _pageSize;
            var response = await FetchAsync(stage, page, size);
            if (seq != _loadSeq[stage]) { return; } // пока ждали, запрошена другая страница — ответ устарел

            // Кандидатов разобрали, и текущей страницы больше нет — показываем последнюю существующую
            // (один повтор: общее число уже известно из первого ответа).
            if (response is { Status: true, Data.Count: 0, TotalCount: > 0 } && page > 1)
            {
                page = PageCount(response.TotalCount.Value, size);
                response = await FetchAsync(stage, page, size);
                if (seq != _loadSeq[stage]) { return; }
            }

            // Новый кэш лиц проб на каждую применённую загрузку: допуск мог измениться, открытие аудируется
            // заново (ТБ-030); пары карточек видят смену кэша и запрашивают лицо пробы повторно.
            _probeFaces[stage] = new ProbeFaceCache();
            _pages[stage] = page;
            _shown[stage] = (page, size);
            if (response is { Status: true, Data: { } list })
            {
                _items[stage] = list;
                _totals[stage] = response.TotalCount ?? list.Count;
                _denied[stage] = null;
            }
            else
            {
                _items[stage] = [];
                _totals[stage] = 0;
                _denied[stage] = response.StatusMessage;
            }
        }
        finally
        {
            // Признак снимает только последняя загрузка стадии: завершение устаревшей не разблокирует
            // переключатель страниц, пока идёт актуальная.
            if (seq == _loadSeq[stage])
            {
                _loading.Remove(stage);
            }
        }
    }

    private Task<Abstractions.Application.ResponseDto<IReadOnlyList<VerificationQueueItem>>> FetchAsync(
        VerificationStage stage, int page, int size) =>
        Dispatcher.Send(new ListVerificationQueueQuery(stage, page, size, Filter)).AsTask();

    private RenderFragment RenderQueue(VerificationStage stage) => __builder =>
    {
        var denied = _denied.GetValueOrDefault(stage);
        var items = _items.GetValueOrDefault(stage) ?? [];
        var total = _totals.GetValueOrDefault(stage);
        var (page, size) = _shown.GetValueOrDefault(stage, (1, _pageSize));
        var pageCount = PageCount(total, size);
        var loading = IsLoading(stage);
        var probeFaces = _probeFaces.GetValueOrDefault(stage);
        var stageName = stage.ToString();

        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-3" />
        }
        @if (denied is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-3">@denied</MudAlert>
        }
        else if (items.Count == 0)
        {
            @if (_items.ContainsKey(stage))
            {
                @* Текст НЕ утверждает «пусто»: кандидаты могут быть вне допуска (ТБ-020/021). *@
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                    @(FilterActive ? "По этому отбору кандидатов нет — ослабьте отбор или сбросьте его. " : string.Empty)Очередь пуста: кандидатов, ждущих вашего решения на этой стадии, нет либо они вне вашего допуска.
                </MudText>
            }
        }
        else
        {
            var first = (page - 1) * size + 1;
            var last = first + items.Count - 1;
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 px-2 pt-2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    В очереди: @total · показаны @first–@last
                </MudText>
                <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChangedAsync" Label="На странице"
                           Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px;" Disabled="loading">
                    @foreach (var size in PageSizes)
                    {
                        <MudSelectItem T="int" Value="@size">@size</MudSelectItem>
                    }
                </MudSelect>
            </div>
            @* Сетка: столбцы тянутся на всю ширину (6 на широком экране), на узком — меньше, без горизонтальной прокрутки. *@
            <div class="pa-2" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(228px, 1fr)); gap:12px;">
                @foreach (var item in items)
                {
                    var current = item;
                    <MudPaper @key="current.CandidateId" Outlined="true" Class="pa-2 d-flex flex-column align-center gap-1">
                        <CandidatePair Item="@current" Size="88" ShowLinks="false" ProbeFaces="@probeFaces" />
                        <SimilarityChip Similarity="@current.Similarity" />
                        <div class="d-flex align-center gap-1 flex-wrap justify-center">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@current.Status.ChipColor()">@current.Status.Label()</MudChip>
                            <ClassificationChip Classification="@current.Classification" />
                            @if (current.Origin == SessionOrigin.SystemSuggestion)
                            {
                                @* ТФ-ПЕР-08/09: кандидат предложен системой по эталону фигуранта дела; решает человек. *@
                                <MudTooltip Text="Система сравнила лица нового материала с эталонами фигурантов дела. Подтверждение — только людьми (ТБ-073).">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Icon="@Icons.Material.Filled.AutoAwesome">предложено системой</MudChip>
                                </MudTooltip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary text-center">
                            дело № @current.CaseId · сессия № @current.SessionId · кандидат № @current.Rank
                        </MudText>
                        @if (current.Material is { } material)
                        {
                            @* ТФ-ПЛ-02: когда, откуда и где снят материал — помогает решению, не раскрывая чужих решений. *@
                            <MudText Typo="Typo.caption" Class="text-center" title="@material.MaterialLine(withTime: true)">@material.MaterialLine()</MudText>
                        }
                        @if (current.OwnDecision is { } own)
                        {
                            <MudText Typo="Typo.caption" Class="text-center">ваше решение: @own.Verdict.Label() · @own.DecidedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FactCheck"
                                   Href="@VerificationHref(current, stageName)">
                            @(current.OwnDecision is not null ? "Открыть" : stage == VerificationStage.Supervisor ? "Вынести итог" : "Принять решение")
                        </MudButton>
                    </MudPaper>
                }
            </div>
            @* Навигация — только когда есть что листать. *@
            @if (pageCount > 1)
            {
                <div class="d-flex justify-center pa-2">
                    <MudPagination Count="@pageCount" Selected="page" SelectedChanged="@(p => GoToPageAsync(stage, p))"
                                   Color="Color.Primary" Size="Size.Small" Disabled="loading" />
                </div>
            }
        }
    };
}
