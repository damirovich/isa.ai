@namespace ISC.AI.Modules.Media.UI
@* Поиск по лицу (ТФ-ПЛ-01..06, ТБ-071): дело и ОСНОВАНИЕ обязательны — без основания поиск не запускается;
   область — текущее дело / выбранные / все доступные (ТФ-ПЛ-05); проба — изображение либо лицо носителя
   (faceId из query, ТФ-ПЛ-03). Порог — ползунком в процентах от нижней границы Администратора до 99 %, по умолчанию
   рабочий порог (ТФ-ПЛ-08, ADR-0054); границу проверяет сервер. Выдача — КАНДИДАТ-ЛИСТ (ТЭ-005): никаких
   «совпадений»; статус «подтверждён» — только решением человека (ТБ-073). Балл — с предупреждением (ТЭ-006). *@
@page "/media/search"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ISC.AI.Modules.Media.Application.MediaSearchOptions SearchOptions
@using Microsoft.AspNetCore.Components.Forms
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Application.Features.Search
@using ISC.AI.Modules.Media.Application.Features.Settings
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Поиск по лицу</PageTitle>

<div class="d-flex align-center justify-space-between flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h5">Поиск по лицу</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Кандидат-лист по материалам дел в пределах вашего допуска · поиск доступен ролям Следователь, Эксперт по лицам и Администратор</MudText>
    </div>
</div>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-3">
    Результат — кандидат-лист. @MediaLabels.ConfirmationRule(_settings?.Mode)
    Балл схожести — вероятностная оценка модели, не установление личности (ТЭ-006).
</MudAlert>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Outlined="true" Class="pa-4 my-3">
    @* Форма читается сверху вниз: дело и основание → где искать и порог (две карточки одной высоты) → проба →
       строка действия со сводкой того, что уйдёт в поиск. Тексты ТБ/ТФ — в комментариях, на экране — только смысл. *@
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudSelect T="int?" Value="_caseId" ValueChanged="OnCaseChangedAsync" Label="Дело *" Variant="Variant.Outlined"
                       Placeholder="Выберите дело" Dense="true" Disabled="_busy" AdornmentIcon="@Icons.Material.Outlined.FolderOpen"
                       Adornment="Adornment.Start">
                @foreach (var c in _cases)
                {
                    <MudSelectItem T="int?" Value="@c.CaseId">№ @c.Number · @c.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            @* Основание — ОБЯЗАТЕЛЬНО (ТБ-071): фиксируется в сессии и аудите. *@
            <MudSelect T="int?" @bind-Value="_authorizationId" Label="Основание поиска *" Variant="Variant.Outlined"
                       Placeholder="Выберите основание" Dense="true" Disabled="@(_busy || _caseId is null)"
                       AdornmentIcon="@Icons.Material.Outlined.Gavel" Adornment="Adornment.Start">
                @foreach (var a in _authorizations)
                {
                    <MudSelectItem T="int?" Value="@a.AuthorizationId">@a.Reference</MudSelectItem>
                }
            </MudSelect>
            @if (_caseId is not null && _authorizationsLoaded && _authorizations.Count == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">
                    У дела нет оснований поиска — добавьте основание в карточке дела.
                </MudText>
            }
        </MudItem>

        @* Где искать (ТФ-ПЛ-05): варианты — столбиком, пояснение — к выбранному варианту, а не ко всем сразу. *@
        <MudItem xs="12" md="5">
            <MudPaper Outlined="true" Class="pa-3" Style="height:100%;">
                @SectionTitle(Icons.Material.Outlined.TravelExplore, "Где искать")
                <MudRadioGroup T="SearchScopeKind" @bind-Value="_scope">
                    <div class="d-flex flex-column">
                        <MudRadio T="SearchScopeKind" Value="SearchScopeKind.CurrentCase" Dense="true" Disabled="_busy">Текущее дело</MudRadio>
                        <MudRadio T="SearchScopeKind" Value="SearchScopeKind.SelectedCases" Dense="true" Disabled="_busy">Выбранные дела</MudRadio>
                        <MudRadio T="SearchScopeKind" Value="SearchScopeKind.AllAccessibleCases" Dense="true" Disabled="_busy">Все дела в пределах допуска</MudRadio>
                    </div>
                </MudRadioGroup>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@ScopeHint</MudText>
                @if (_scope == SearchScopeKind.SelectedCases)
                {
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_selectedCaseIds" Label="Дела" Variant="Variant.Outlined"
                               Dense="true" Disabled="_busy" MultiSelectionTextFunc="@SelectedCasesSummary" Class="mt-2">
                        @foreach (var c in _cases)
                        {
                            <MudSelectItem T="int" Value="@c.CaseId">
                                № @c.Number · @c.Title@(c.IsClosed ? " (закрыто)" : string.Empty)
                            </MudSelectItem>
                        }
                    </MudSelect>
                }

                @* Закрытые дела — расширение области, и включает его человек (ТФ-ПЛ-05, ТБ-072). Своё текущее
                   дело искать можно всегда, даже закрытое, поэтому галочка нужна только для остальных. *@
                @if (_scope != SearchScopeKind.CurrentCase)
                {
                    <MudCheckBox T="bool" @bind-Value="_includeClosedCases" Dense="true" Disabled="_busy" Class="mt-1">
                        Искать и по закрытым делам
                    </MudCheckBox>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        Например, чтобы проверить, не проходил ли человек по прежним делам. Включение попадёт в журнал.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            @* Порог и выдача одним блоком: порог — ползунком в процентах шкалы (ТФ-ПЛ-08, ADR-0054) от нижней границы до
               99 %, в расстояние переводит сервер той же шкалой и сам не пускает ниже границы; предустановки — ТФ-ПЛ-06;
               длина кандидат-листа — ТН-008. Длинное пояснение про шкалу и границы — в подсказке, на виду только главное. *@
            <MudPaper Outlined="true" Class="pa-3" Style="height:100%;">
                <div class="d-flex align-start justify-space-between gap-2">
                    <div>
                        @SectionTitle(Icons.Material.Outlined.Tune, "Схожесть не ниже")
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="margin-top:-4px;">
                            Кандидаты ниже порога не показываются
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight:500;line-height:1;" aria-live="polite">@_threshold %</MudText>
                        <MudTooltip Text="@ThresholdHelp" Arrow="true" Placement="Placement.Left">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="mud-text-secondary" />
                        </MudTooltip>
                    </div>
                </div>
                @* Шкала — вся, 1–100 %, и вся доступна оператору (решение Заказчика от 17.10.2026): какой порог выбран, по
                   такому и ищем. Только если Администратор поднял нижнюю границу (по умолчанию её нет), часть ниже неё —
                   затенённый отрезок без ползунка (ТФ-ПЛ-08), сервер проверяет то же; ползунок тогда — от границы до 100 % и
                   занимает свою долю ширины. Ползунок появляется только после чтения настроек: в заранее отрисованной
                   разметке его нет, и браузеру нечего подставлять из прошлого посещения. *@
                @if (_settingsReady)
                {
                    <div class="d-flex align-end mt-3" style="gap:0;">
                        @if (HasBound)
                        {
                        <div style="@($"flex:0 1 {ForbiddenShare}%;min-width:0;")" title="@($"ниже нижней границы {MinThreshold} % — недоступно")">
                            <div style="height:24px;display:flex;align-items:center;">
                                <div style="width:100%;border-top:2px dashed var(--mud-palette-lines-inputs);opacity:.7;"></div>
                            </div>
                            <div class="d-flex justify-space-between gap-1">
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-disabled);">@SliderMin %</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-disabled);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">ниже границы</MudText>
                            </div>
                        </div>
                        }
                        <div style="flex:1 1 0;min-width:72px;">
                            <MudSlider T="int" Min="@MinThreshold" Max="@SliderMax" Step="1" Value="_threshold" ValueChanged="SetThreshold"
                                       Disabled="_busy" Color="Color.Primary" aria-label="Порог схожести, %" autocomplete="off" />
                            <div class="d-flex justify-space-between gap-1">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(HasBound ? $"{MinThreshold} % · граница" : $"{SliderMin} %")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@SliderMax %</MudText>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-5" />
                }
                <MudDivider Class="my-3" />
                <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">Предустановки</MudText>
                        <MudToggleGroup T="int" Value="_threshold" ValueChanged="@(value => _threshold = value)" Color="Color.Primary"
                                        Size="Size.Small" CheckMark="false" Disabled="_busy">
                            @foreach (var preset in Presets)
                            {
                                <MudToggleItem T="int" Value="@preset.Percent" Text="@($"{preset.Label} · {preset.Percent} %")" />
                            }
                        </MudToggleGroup>
                    </div>
                    <MudNumericField T="int" @bind-Value="_topK" Label="Кандидатов в выдаче" Variant="Variant.Outlined" Min="5" Max="50"
                                     Margin="Margin.Dense" Style="max-width:170px;" Disabled="_busy" HelperText="от 5 до 50" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Outlined="true" Class="pa-3">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                    @SectionTitle(Icons.Material.Outlined.Face, "Проба")
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Изображение с лицом до @MediaLabels.FormatSize(SearchByFaceValidator.MaxProbeBytes) · в базу шаблонов не попадает,
                        копия — только в журнале поиска
                    </MudText>
                </div>
                @if (_references.Count > 0 || _referencesMissing > 0)
                {
                    @* Пробы — эталоны фигуранта (ТФ-ПЕР-03, ADR-0046): поиск по всем сразу, кандидаты сводятся по лицу. Непригодный
                       эталон (ТО-мат-07) показан, но в поиск не идёт; эталон вне допуска — только счётчиком (ТБ-020/021). *@
                    <div class="d-flex align-center gap-4 flex-wrap">
                        @foreach (var reference in _references)
                        {
                            var face = reference;
                            <FaceCropTile Url="@(face.CropStoredFileName is { } crop ? MediaFileUrl.FaceCrop(face.AssetId, crop) : null)"
                                          Size="96" Caption="@($"эталон — лицо № {face.Id} · качество {face.QualityScore:0.00}")"
                                          Unusable="@(!face.QualityAcceptable)" UnusableReason="@face.QualityReason">
                                <MudLink Href="@($"/media/assets/{face.AssetId}?face={face.Id}")" Typo="Typo.caption">открыть носитель</MudLink>
                            </FaceCropTile>
                        }
                        <div>
                            <MudText Typo="Typo.body1">Поиск по всем эталонам фигуранта: @UsableReferences.Count из @(_references.Count + _referencesMissing)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                Кандидаты сводятся по лицу: лучшее совпадение, эталон, по которому оно найдено, и у скольких эталонов схожесть
                                в пределах порога. Сами эталоны в кандидаты не попадают.
                            </MudText>
                            @if (_referencesMissing > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block">Недоступно эталонов: @_referencesMissing (нет либо вне вашего допуска).</MudText>
                            }
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="ClearProbe"
                                       Disabled="_busy" Class="mt-1">Сбросить пробу</MudButton>
                        </div>
                    </div>
                }
                else if (_probeFace is { } probeFace)
                {
                    @* Проба — лицо уже проиндексированного носителя (ТФ-ПЛ-03): вектор берётся из базы, изображение не грузится. *@
                    <div class="d-flex align-center gap-4 flex-wrap">
                        <FaceCropTile Url="@(probeFace.CropStoredFileName is { } crop ? MediaFileUrl.FaceCrop(probeFace.AssetId, crop) : null)"
                                      Size="128" Caption="@($"лицо № {probeFace.Id} носителя № {probeFace.AssetId} · качество {probeFace.QualityScore:0.00}")"
                                      Unusable="@(!probeFace.QualityAcceptable)" UnusableReason="@probeFace.QualityReason">
                            <MudLink Href="@($"/media/assets/{probeFace.AssetId}?face={probeFace.Id}")" Typo="Typo.caption">открыть носитель</MudLink>
                        </FaceCropTile>
                        <div>
                            @if (!probeFace.QualityAcceptable)
                            {
                                @* ТО-мат-07: шаблон для непригодного лица не строился — искать по нему нечем; это НЕ отказ по допуску. *@
                                <MudText Typo="Typo.body2" Color="Color.Warning">
                                    Лицо непригодно для поиска (ТО-мат-07)@(string.IsNullOrWhiteSpace(probeFace.QualityReason) ? string.Empty : $": {probeFace.QualityReason}").
                                </MudText>
                            }
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="ClearProbe"
                                       Disabled="_busy">Сбросить пробу</MudButton>
                        </div>
                    </div>
                }
                else if (_probeFaceId is { } missingFaceId)
                {
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <MudText Typo="Typo.body2" Color="Color.Warning">Лицо № @missingFaceId недоступно: его нет либо оно вне вашего допуска.</MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearProbe" Disabled="_busy">Сбросить пробу</MudButton>
                    </div>
                }
                else if (_probeBytes is { } bytes)
                {
                    @* Оператор обязан видеть, ПО КАКОМУ снимку идёт поиск (ТЭ-005/007): миниатюру делает сам браузер
                       (RequestImageFileAsync), поиск при этом идёт по ИСХОДНОМУ файлу — уменьшенная копия только для показа. *@
                    <div class="d-flex align-center gap-4 flex-wrap">
                        @if (_probePreview is { } preview)
                        {
                            <MudPaper Outlined="true" Class="pa-1" Style="line-height:0;">
                                <img src="@preview" alt="пробное изображение" title="@_probeFileName"
                                     style="width:132px;height:132px;object-fit:contain;display:block;background:#0b1220;border-radius:2px;" />
                            </MudPaper>
                        }
                        <div style="min-width:0;">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" Class="mud-text-secondary" />
                                <MudText Typo="Typo.body1" Style="word-break:break-all;">@_probeFileName</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                @MediaLabels.FormatSize(bytes.LongLength)@(_probePreview is not null ? " · показан уменьшенный вид, поиск — по исходному файлу без обработки" : string.Empty)
                            </MudText>
                            <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                                @ProbeUpload("Заменить…", Variant.Outlined)
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="ClearProbe"
                                           Disabled="_busy">Убрать</MudButton>
                            </div>
                            @if (_result is { DetectedFaces: > 1 })
                            {
                                @* Индекс — порядок выдачи детектора (после NMS — по убыванию уверенности), НЕ по размеру; «самое крупное» — только при пустом поле. *@
                                <MudNumericField T="int?" @bind-Value="_probeFaceIndex" Label="Номер лица на пробе" Variant="Variant.Outlined" Min="0"
                                                 Margin="Margin.Dense" Style="max-width:260px;" Disabled="_busy" Clearable="true" Class="mt-2"
                                                 HelperText="номер лица в порядке выдачи детектора (0 — первое); пусто — самое крупное" />
                            }
                        </div>
                    </div>
                }
                else
                {
                    @* Пустая проба — заметная область выбора, а не одинокая кнопка. *@
                    <div class="d-flex align-center gap-4 flex-wrap pa-4"
                         style="border:1px dashed var(--mud-palette-lines-inputs);border-radius:var(--mud-default-borderradius);">
                        <MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" Size="Size.Large" Class="mud-text-secondary" />
                        <div style="flex:1 1 240px;">
                            <MudText Typo="Typo.body1">Выберите изображение с лицом</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                JPG, PNG, BMP или WEBP. Либо откройте носитель дела и нажмите «Найти в других материалах» у нужного лица.
                            </MudText>
                        </div>
                        @ProbeUpload("Выбрать изображение…", Variant.Filled)
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Строка действия: слева — что именно уйдёт в поиск (или чего не хватает), справа — кнопка. *@
    <MudDivider Class="my-4" />
    <div class="d-flex align-center justify-space-between flex-wrap gap-3">
        <div class="d-flex align-center gap-2 flex-wrap">
            @if (!CanSearch && !_busy)
            {
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.body2" Color="Color.Warning">@SearchHint</MudText>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.TravelExplore">@ScopeSummary</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Tune">схожесть от @_threshold %</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.FormatListNumbered">до @_topK кандидатов</MudChip>
            }
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Search"
                   Disabled="@(!CanSearch)" OnClick="SearchAsync" Style="min-width:160px;">@(_busy ? "Ищу…" : "Искать")</MudButton>
    </div>
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
    }
</MudPaper>

@* ================= Выдача: кандидат-лист (ТФ-ПЛ-02) ================= *@
@if (_result is { } result)
{
    <MudPaper Outlined="true" Class="pa-4 my-3">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.subtitle1">Кандидаты: @result.Candidates.Count</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                сессия <MudLink Href="@($"/media/sessions/{result.SessionId}")" Typo="Typo.caption">№ @result.SessionId</MudLink>
                · область: @_scope.Label() (@result.CaseIds.Count дел@(_includeClosedCases && _scope != SearchScopeKind.CurrentCase ? ", включая закрытые" : string.Empty))
                · детектор @result.DetectorVersion · векторизатор @result.EmbedderVersion
                · до @result.TopK кандидатов · @MediaLabels.SimilarityThreshold(SearchOptions.Scale, result.MaxCosineDistance)
            </MudText>
        </div>
        @if (result.DetectedFaces > 1)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                На пробе несколько лиц (@result.DetectedFaces); для поиска
                @(_probeFaceIndex is { } chosen ? $"выбрано лицо № {chosen} (в порядке выдачи детектора)" : "выбрано самое крупное").
                Если нужно другое — укажите номер лица на пробе и повторите поиск.
            </MudAlert>
        }
        @* ПО ЧЕМУ искали — рядом с выдачей (ТЭ-005): проба-изображение показывается миниатюрой, которую
           сделал браузер, проба-лицо носителя — своей вырезкой; хеш пробы даёт сверку с журналом (ТБ-072). *@
        <MudPaper Outlined="true" Class="pa-2 mb-3 d-flex align-center gap-3 flex-wrap">
            @if (result.ProbeFaceIds is { Count: > 1 } searchedReferences)
            {
                @foreach (var referenceId in searchedReferences)
                {
                    var face = _references.FirstOrDefault(f => f.Id == referenceId);
                    <FaceCropTile Url="@(face?.CropStoredFileName is { } referenceCrop ? MediaFileUrl.FaceCrop(face.AssetId, referenceCrop) : null)"
                                  Size="72" Caption="@($"эталон — лицо № {referenceId}")" />
                }
            }
            else if (_probeFace is { } probeFace)
            {
                <FaceCropTile Url="@(probeFace.CropStoredFileName is { } probeCrop ? MediaFileUrl.FaceCrop(probeFace.AssetId, probeCrop) : null)"
                              Size="96" Caption="@($"проба — лицо № {probeFace.Id}")" />
            }
            else if (_probePreview is { } searchedPreview)
            {
                <img src="@searchedPreview" alt="пробное изображение" title="@_probeFileName"
                     style="width:96px;height:96px;object-fit:contain;background:#0b1220;" />
            }
            <div>
                <MudText Typo="Typo.body2">
                    @(result.ProbeFaceIds is { Count: > 1 } references ? $"Искали по {references.Count} эталонам фигуранта" : "Искали по этой пробе")
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    @(result.ProbeFaceIds is { Count: > 1 } ? "кандидаты сведены по лицу" : _probeFileName ?? (_probeFace is { } row ? $"лицо № {row.Id} из носителя № {row.AssetId}" : "проба"))
                    · отпечаток @result.ProbeSha256[..12].ToLowerInvariant()… (по нему проба сверяется с записью в журнале, ТБ-072)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    Сама проба в базу шаблонов не попадает (ТБ-074); копия — только в журнале поиска под грифом дела.
                </MudText>
            </div>
        </MudPaper>
        @if (result.SkippedProbes is { Count: > 0 } skipped)
        {
            @* Эталон без шаблона (качество ТО-мат-07 или регламент закрытого дела ТБ-074) — пропущен, причина видна. *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Пропущены эталоны: @string.Join("; ", skipped)
            </MudAlert>
        }
        @if (result.Candidates.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Кандидатов нет: в области поиска нет похожих лиц либо материалы вне вашего допуска.
            </MudText>
        }
        else
        {
            <div class="d-flex flex-wrap gap-4">
                @foreach (var candidate in result.Candidates)
                {
                    var current = candidate;
                    <MudPaper Outlined="true" Class="pa-2 d-flex flex-column align-center" Style="width:200px;">
                        <FaceCropTile Url="@(current.CropStoredFileName is { } crop ? MediaFileUrl.FaceCrop(current.AssetId, crop) : null)"
                                      Size="128" Caption="@(current.QualityScore is { } quality ? $"кандидат № {current.Rank} · качество лица {quality:0.00}" : $"кандидат № {current.Rank}")" />
                        <div class="d-flex flex-column align-center gap-1 mt-1">
                            <SimilarityChip Similarity="@current.Similarity" />
                            @if (current.ProbeFaceId is { } bestReference && result.ProbeFaceIds is { Count: > 1 } allReferences)
                            {
                                @* Согласие эталонов — подсказка оператору, а не вывод системы (ТЭ-005/006). *@
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Align="Align.Center">
                                    эталон № @bestReference · совпало эталонов: @(current.ProbeMatchCount ?? 1) из @allReferences.Count
                                </MudText>
                            }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@current.Status.ChipColor()">@current.Status.Label()</MudChip>
                            <ClassificationChip Classification="@current.Classification" />
                            <MudLink Href="@($"/media/assets/{current.AssetId}?face={current.FaceId}")" Typo="Typo.caption">
                                носитель № @current.AssetId@(current.FrameTimestampMs is { } ms ? $" · кадр {MediaLabels.Timecode(ms)}" : string.Empty)
                            </MudLink>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FactCheck"
                                       Href="@($"/media/verification/{current.Id}?stage=Expert")">Верификация</MudButton>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </MudPaper>
}

@code {
    /// <summary>
    /// Параметр <c>?caseId=</c> как пришёл в адресе — строкой, чтобы нечисловое значение не роняло страницу
    /// (см. <see cref="MediaQueryValues"/>); разбор — <see cref="QueryCaseId"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "caseId")] public string? CaseIdQuery { get; set; }

    /// <summary>Параметр <c>?faceId=</c> как пришёл в адресе — строкой по той же причине; разбор — <see cref="QueryFaceId"/>.</summary>
    [SupplyParameterFromQuery(Name = "faceId")] public string? FaceIdQuery { get; set; }

    /// <summary>
    /// Параметр <c>?faceIds=1,2,3</c> — эталоны фигуранта (поиск по всем эталонам, ТФ-ПЕР-03, ADR-0046; переход из
    /// карточки фигуранта). Неразобранные значения отбрасываются, не больше <see cref="SearchByFaceQuery.MaxProbeFaces"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "faceIds")] public string? FaceIdsQuery { get; set; }

    /// <summary>
    /// Параметр <c>?authId=</c> — основание поиска (переход «Искать по материалам» из карточки фигуранта). Принимается,
    /// только если это основание выбранного дела (ТБ-071); иначе выбор остаётся за оператором.
    /// </summary>
    [SupplyParameterFromQuery(Name = "authId")] public string? AuthIdQuery { get; set; }

    /// <summary>Параметр <c>?scope=all</c> — область «все доступные дела» (ТФ-ПЛ-05).</summary>
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeQuery { get; set; }

    /// <summary>
    /// Параметр <c>?auto=1</c> — сразу запустить поиск, если форма заполнена полностью (дело, основание, пригодная проба).
    /// Ничего не обходит: запуск — тот же SearchByFaceQuery с проверкой права, основания и аудитом ТБ-072; не хватает
    /// чего-то — форма остаётся открытой с подсказкой, что заполнить.
    /// </summary>
    [SupplyParameterFromQuery(Name = "auto")] public string? AutoQuery { get; set; }

    /// <summary>Дело из адресной строки (переход из медиатеки дела / карточки носителя); неразобранное — нет дела.</summary>
    private int? QueryCaseId => MediaQueryValues.ParseInt(CaseIdQuery);

    /// <summary>Лицо носителя как проба (ТФ-ПЛ-03) из адресной строки; неразобранное — пробы нет.</summary>
    private int? QueryFaceId => MediaQueryValues.ParseInt(FaceIdQuery);

    /// <summary>Эталоны фигуранта из адресной строки (ADR-0046): разобранные, без повторов, не больше предела.</summary>
    private List<int> QueryFaceIds => (FaceIdsQuery ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(MediaQueryValues.ParseInt)
        .OfType<int>()
        .Distinct()
        .Take(SearchByFaceQuery.MaxProbeFaces)
        .ToList();

    private IReadOnlyList<CaseScopeItem> _cases = [];
    private IReadOnlyList<CaseAuthorizationItem> _authorizations = [];
    private bool _authorizationsLoaded;
    private int? _caseId;
    private int? _authorizationId;
    private SearchScopeKind _scope = SearchScopeKind.CurrentCase;

    // Закрытые дела в область поиска по умолчанию не входят: включает их оператор (ТФ-ПЛ-05, аудит ТБ-072).
    private bool _includeClosedCases;
    private IReadOnlyCollection<int> _selectedCaseIds = [];
    /// <summary>Сторона миниатюры пробы, пикселей: показать лицо оператору достаточно, в разметку идёт мало.</summary>
    private const int PreviewSide = 320;

    /// <summary>Предел на миниатюру (после уменьшения браузером она десятки килобайт; предел — страховка).</summary>
    private const long PreviewMaxBytes = 2L * 1024 * 1024;

    private FaceRow? _probeFace;
    private int? _probeFaceId;

    // Эталоны фигуранта (ADR-0046): загруженные лица и сколько не загрузилось (нет либо вне допуска — не различаем).
    private readonly List<FaceRow> _references = [];
    private int _referencesMissing;
    private byte[]? _probeBytes;
    private string? _probeFileName;
    private string? _probePreview;
    private int? _probeFaceIndex;
    private int _topK = 20;

    // Порог (ТФ-ПЛ-08, ADR-0054): настройки Администратора — границы ползунка; пока не прочитаны — умолчания поставки
    // (сервер всё равно применит действующие и поднимет порог до границы).
    private MediaSettingsView? _settings;
    private int _threshold = MediaSettings.DefaultThresholdPercent;
    private int MinThreshold => _settings?.MinThresholdPercent ?? MediaSettings.DefaultMinThresholdPercent;
    private int WorkingThreshold => _settings?.ThresholdPercent ?? MediaSettings.DefaultThresholdPercent;
    private int HighThreshold => MediaLabels.HighThresholdPreset(WorkingThreshold);

    // Шкала ползунка — вся, от 1 до 100 % (решение заказчика 17.10.2026); доступная часть — от нижней границы.
    private const int SliderMin = 1;
    private const int SliderMax = 100;

    // Настройки прочитаны (успешно или нет) — можно показывать ползунок с окончательными границами.
    private bool _settingsReady;

    // Доля ширины затенённого отрезка 1…граница на общей шкале 1–100 %.
    private string ForbiddenShare => (100.0 * (MinThreshold - SliderMin) / (SliderMax - SliderMin))
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Значение ползунка — в пределах [граница, 100]; ниже границы не опускается и на клиенте (сервер проверяет то же).
    private void SetThreshold(int value) => _threshold = Math.Clamp(value, MinThreshold, SliderMax);

    // Предустановки ТФ-ПЛ-06 — значения ползунка вокруг рабочего порога; совпавшие значения показываются один раз.
    private IEnumerable<(string Label, int Percent)> Presets =>
        new[] { ("Низкий", LowThreshold), ("Средний", WorkingThreshold), ("Высокий", HighThreshold) }.DistinctBy(p => p.Item2);

    private int LowThreshold => MediaLabels.LowThresholdPreset(WorkingThreshold, MinThreshold);

    // Администратор поднял нижнюю границу выше начала шкалы — часть шкалы ниже неё недоступна оператору.
    private bool HasBound => MinThreshold > SliderMin;

    // Пояснение к выбранной области поиска (ТФ-ПЛ-05, ADR-0044) — одно, к выбранному варианту.
    private string ScopeHint => _scope switch
    {
        SearchScopeKind.SelectedCases => "Только отмеченные дела из доступных вам.",
        SearchScopeKind.AllAccessibleCases =>
            "Все дела в пределах допуска, включая дела других сотрудников (взаимный поиск ОН и ОУ). "
            + "Материал кандидата из чужого дела открывается только на просмотр.",
        _ => "Только материалы выбранного дела.",
    };

    // Сводка области для строки действия: что именно уйдёт в поиск.
    private string ScopeSummary => _scope switch
    {
        SearchScopeKind.SelectedCases => $"выбрано дел: {_selectedCaseIds.Count}{ClosedSuffix}",
        SearchScopeKind.AllAccessibleCases => $"все дела в пределах допуска{ClosedSuffix}",
        _ => "текущее дело",
    };

    private string ClosedSuffix => _includeClosedCases ? ", с закрытыми" : string.Empty;

    // Заголовок карточки формы: значок и подпись.
    private static RenderFragment SectionTitle(string icon, string title) => __builder =>
    {
        <div class="d-flex align-center gap-2 mb-1">
            <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2">@title</MudText>
        </div>
    };

    // Выбор пробного изображения. Пустой SelectedTemplate: свой список выбранных файлов MudFileUpload не показывает —
    // выбранная проба уже показана миниатюрой с именем и размером (иначе имя файла выводилось дважды).
    private RenderFragment ProbeUpload(string text, Variant variant) => __builder =>
    {
        <MudFileUpload T="IBrowserFile" FilesChanged="OnProbeSelectedAsync" Accept=".jpg,.jpeg,.png,.bmp,.webp" Disabled="_busy">
            <CustomContent Context="upload">
                <MudButton Variant="@variant" Color="Color.Primary" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.AddAPhoto" OnClick="@(() => upload.OpenFilePickerAsync())">@text</MudButton>
            </CustomContent>
            <SelectedTemplate Context="selected"></SelectedTemplate>
        </MudFileUpload>
    };

    private string ThresholdHelp =>
        $"Порог по умолчанию {WorkingThreshold} % задаёт Администратор{(HasBound ? $", ниже {MinThreshold} % опустить нельзя" : "; выбрать можно любой от 1 до 100 %")}. "
        + $"Проценты — шкала балла модели ({SearchOptions.Scale.Describe()}), до калибровки на пилоте; это вероятностная оценка, "
        + "а не установление личности.";
    private FaceSearchResult? _result;
    private bool _busy;
    private string? _error;

    /// <summary>Проба задана и пригодна: лицо носителя — только с шаблоном (ТО-мат-07), либо загруженное изображение.</summary>
    // Почему «Искать» неактивна — конкретно, по первому незаполненному шагу формы.
    private string SearchHint =>
        _probeFace is { QualityAcceptable: false } ? "Проба непригодна для поиска — выберите другое лицо или изображение."
        : _caseId is null ? "Выберите дело."
        : _authorizationId is null ? "Выберите основание поиска (добавляется в карточке дела, вкладка «Основания поиска»)."
        : !HasProbe ? "Выберите изображение с лицом или лицо на носителе (проба)."
        : _scope == SearchScopeKind.SelectedCases && _selectedCaseIds.Count == 0 ? "Отметьте хотя бы одно дело в области поиска."
        : string.Empty;

    private bool HasProbe => _references.Count > 0 || _referencesMissing > 0
        ? UsableReferences.Count > 0
        : _probeFace is { QualityAcceptable: true } || _probeBytes is not null;

    // Эталоны, которые идут в поиск: непригодные по качеству (ТО-мат-07) не отправляются — шаблона у них нет.
    private List<FaceRow> UsableReferences => _references.Where(f => f.QualityAcceptable).ToList();

    private bool CanSearch => !_busy && _caseId is not null && _authorizationId is not null && HasProbe
        && (_scope != SearchScopeKind.SelectedCases || _selectedCaseIds.Count > 0);

    private string SelectedCasesSummary(IReadOnlyList<string> selected) => selected.Count switch
    {
        0 => "не выбрано",
        1 => selected[0],
        _ => $"дел: {selected.Count}",
    };

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // ничего не грузим — GetFaceQuery (проба ?faceId=) аудируется и попадал бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        // Границы ползунка и режим подтверждения (ADR-0054): ползунок открывается на рабочем пороге.
        var settings = await Dispatcher.Send(new GetMediaSettingsQuery());
        if (settings is { Status: true, Data: { } view })
        {
            _settings = view;
            _threshold = view.ThresholdPercent;
        }

        _settingsReady = true;

        var cases = await Dispatcher.Send(new ListAccessibleCasesQuery());
        if (cases is { Status: true, Data: { } list })
        {
            _cases = list;
        }
        else if (cases is { Status: false })
        {
            _error = cases.StatusMessage;
        }

        // Дело из адреса принимается ТОЛЬКО если оно среди доступных (ТБ-071); иначе выбор остаётся пустым.
        if (QueryCaseId is { } queryCase && _cases.Any(c => c.CaseId == queryCase))
        {
            await OnCaseChangedAsync(queryCase);
        }

        // Один эталон в списке — обычная проба-лицо; несколько — поиск по всем эталонам (ADR-0046).
        var referenceIds = QueryFaceIds;
        var singleFaceId = QueryFaceId ?? (referenceIds.Count == 1 ? referenceIds[0] : null);
        if (singleFaceId is { } faceId)
        {
            _probeFaceId = faceId;
            var face = await Dispatcher.Send(new GetFaceQuery(faceId));
            _probeFace = face is { Status: true, Data: { } row } ? row : null;
        }
        else if (referenceIds.Count > 1)
        {
            foreach (var referenceId in referenceIds)
            {
                var face = await Dispatcher.Send(new GetFaceQuery(referenceId));
                if (face is { Status: true, Data: { } row })
                {
                    _references.Add(row);
                }
                else
                {
                    _referencesMissing++;
                }
            }
        }

        // Основание из адреса — только из перечня оснований выбранного дела (ТБ-071).
        if (MediaQueryValues.ParseInt(AuthIdQuery) is { } authId && _authorizations.Any(a => a.AuthorizationId == authId))
        {
            _authorizationId = authId;
        }

        if (string.Equals(ScopeQuery, "all", StringComparison.OrdinalIgnoreCase))
        {
            _scope = SearchScopeKind.AllAccessibleCases;
        }

        if (AutoQuery == "1" && CanSearch)
        {
            await SearchAsync();
        }
    }

    private async Task OnCaseChangedAsync(int? caseId)
    {
        _caseId = caseId;
        _authorizationId = null;
        _authorizations = [];
        _authorizationsLoaded = false;
        if (caseId is not { } id)
        {
            return;
        }

        var response = await Dispatcher.Send(new ListCaseAuthorizationsQuery(id));
        if (response is { Status: true, Data: { } list })
        {
            _authorizations = list;
            if (list.Count == 1)
            {
                _authorizationId = list[0].AuthorizationId;
            }
        }
        else if (response is { Status: false })
        {
            _error = response.StatusMessage;
        }

        _authorizationsLoaded = true;
    }

    private async Task OnProbeSelectedAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _error = null;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(SearchByFaceValidator.MaxProbeBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            _probeBytes = buffer.ToArray();
            _probeFileName = file.Name;
            _probePreview = await BuildPreviewAsync(file);
            _probeFace = null;
            _probeFaceId = null;
            _references.Clear();
            _referencesMissing = 0;
            _probeFaceIndex = null;
            _result = null;
        }
        catch (IOException)
        {
            _error = $"Изображение больше допустимых {MediaLabels.FormatSize(SearchByFaceValidator.MaxProbeBytes)} или не прочитано.";
        }
    }

    /// <summary>
    /// Миниатюра пробы для показа оператору (ТЭ-005: человек должен видеть, ПО КАКОМУ снимку идёт поиск).
    /// Уменьшение делает БРАУЗЕР (<see cref="BrowserFileExtensions.RequestImageFileAsync"/>): оригинал в
    /// 25 МБ нельзя вставить в разметку как data-URL — это утроило бы его в base64 и в памяти circuit'а.
    /// На поиск уходит ИСХОДНЫЙ файл (<c>_probeBytes</c>), миниатюра — только для глаз (ТЭ-007).
    /// Неудача (формат, который браузер не перерисовывает) — не ошибка: показываем без миниатюры.
    /// </summary>
    private static async Task<string?> BuildPreviewAsync(IBrowserFile file)
    {
        try
        {
            var resized = await file.RequestImageFileAsync("image/jpeg", PreviewSide, PreviewSide);
            using var buffer = new MemoryStream();
            await using (var stream = resized.OpenReadStream(PreviewMaxBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            return "data:image/jpeg;base64," + Convert.ToBase64String(buffer.ToArray());
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or JSException)
        {
            return null;
        }
    }

    private void ClearProbe()
    {
        _probeBytes = null;
        _probeFileName = null;
        _probePreview = null;
        _probeFace = null;
        _probeFaceId = null;
        _references.Clear();
        _referencesMissing = 0;
        _probeFaceIndex = null;
        _result = null;
    }

    private async Task SearchAsync()
    {
        if (_caseId is not { } caseId || _authorizationId is not { } authorizationId || !HasProbe)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // Эталоны фигуранта (ADR-0046): два и больше пригодных — поиск по всем; один — обычная проба-лицо.
            var references = _references.Count > 0 ? UsableReferences.Select(f => f.Id).ToList() : [];
            var byReferences = references.Count >= 2;
            var probeFaceId = _references.Count > 0 ? (references.Count == 1 ? references[0] : (int?)null) : _probeFace?.Id;
            var byImage = _references.Count == 0 && _probeFace is null;
            var response = await Dispatcher.Send(new SearchByFaceQuery(
                caseId,
                authorizationId,
                _scope,
                _scope == SearchScopeKind.SelectedCases ? _selectedCaseIds.Distinct().ToList() : null,
                byImage ? _probeBytes : null,
                probeFaceId,
                byImage ? _probeFaceIndex : null,
                _topK,
                Math.Max(_threshold, MinThreshold),
                _includeClosedCases,
                byReferences ? references : null));

            if (response is { Status: true, Data: { } result })
            {
                _result = result;
            }
            else
            {
                _result = null;
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
