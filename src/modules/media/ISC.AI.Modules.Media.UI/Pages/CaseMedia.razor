@namespace ISC.AI.Modules.Media.UI
@* Медиатека дела (ТФ-МЕД-01..03): носители дела, двухшаговая загрузка (выбор → отдельная кнопка
   «Загрузить», как в загрузке корпуса Инспектора), переиндексация и гарантированное удаление.
   Гриф и подразделение носителя наследуются от ДЕЛА (ТБ-070) — оператор их не выбирает.
   Статусы индексации обновляются опросом раз в 5 с, пока есть незавершённые (ТП-004).
   АУДИО (ADR-0026): приём аудиоформатов из MediaFileRules, вид «аудио» в списке, состояние расшифровки речи;
   «Поиск по расшифровкам дела» — слова в расшифровках носителей ЭТОГО дела (SearchTranscriptsQuery: решётка на
   стороне БД, сужение по делу, запрос аудируется, ТБ-020/021/030/071), выдача — фрагменты с переходом к месту
   записи в карточке (?t=<мс>). Найденное выделяется разбиением строки (TranscriptHighlight), НЕ MarkupString:
   текст фрагмента и искомое — пользовательские данные. *@
@page "/media/cases/{CaseId:int}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using ISC.AI.Modules.Media.Application.Features.Assets
@using ISC.AI.Modules.Media.Application.Features.Scope
@using ISC.AI.Modules.Media.Application.Features.Transcripts
@using ISC.AI.Modules.Media.Domain.Model
@using ISC.AI.Modules.Media.Domain.Services

<PageTitle>Медиатека дела</PageTitle>

<div class="d-flex align-center justify-space-between flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h5">Медиатека дела</MudText>
        @if (_case is { } caseItem)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Дело № @caseItem.Number · @caseItem.Title
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Фото, видео и аудио дела · только в пределах допуска</MudText>
        }
    </div>
    <div class="d-flex align-center gap-2 flex-wrap">
        @if (_case is { } c)
        {
            <ClassificationChip Classification="@c.Classification" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonSearch"
                   Href="@($"/media/search?caseId={CaseId}")">Поиск по лицу в этом деле</MudButton>
    </div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@if (_caseChecked && _case is null)
{
    @* Единый текст: недоступное дело неотличимо от несуществующего (ТБ-020/021). *@
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-3">
        Дело недоступно: его нет либо оно вне вашего допуска.
    </MudAlert>
}
else
{
    @* ================= Загрузка носителей (два шага, ТФ-МЕД-01) ================= *@
    <MudPaper Outlined="true" Class="pa-4 my-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Загрузка носителей</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            Доступно ролям Следователь и Администратор. Гриф и подразделение носителя наследуются от дела (ТБ-070). Повтор того же файла в том же
            подразделении не создаёт дубля. Обработка — поиск лиц (фото, видео) и расшифровка речи (аудио, звуковая дорожка
            видео) — выполняется фоном после загрузки.
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                @* Пределы длин — из валидатора команды, не дублируются числом (иначе клиент пропускает, сервер отбивает). *@
                <MudTextField @bind-Value="_source" Label="Источник" Variant="Variant.Outlined" MaxLength="@UploadMediaValidator.MaxSourceLength"
                              HelperText="откуда получена запись — общее для всех выбранных файлов" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_place" Label="Место" Variant="Variant.Outlined" MaxLength="@UploadMediaValidator.MaxPlaceLength" />
            </MudItem>
        </MudGrid>

        <div class="mt-3 d-flex align-center gap-3 flex-wrap">
            @* ДВА ШАГА: выбор лишь наполняет список, загрузку запускает отдельная кнопка — случайно
               выбранный файл не должен улетать в дело сам. MudBlazor 9.5: своя кнопка — через
               CustomContent + OpenFilePickerAsync. *@
            @* Фильтр выбора — из MediaUploadTypes: аудио MIME-типами MediaFileRules плюс расширениями (см. там). *@
            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesSelected"
                           Accept="@MediaUploadTypes.Accept"
                           MaximumFileCount="20" Disabled="_busy">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               OnClick="@(() => upload.OpenFilePickerAsync())">
                        Выбрать файлы…
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Фото: .jpg, .png, .bmp, .webp (TIFF/HEIC конвейер пока не читает — см. ADR-0020). Видео: .mp4, .webm, .mkv, .mov, .avi, .3gp
                (в браузере воспроизводятся только .mp4/.webm; остальные — скачать в проигрыватель; голосовые .3gp без картинки
                распознаются как аудио автоматически).
                Аудио: @MediaUploadTypes.AudioExtensionsHint (AMR браузер не воспроизводит — только скачать; расшифровываются все).
                До 20 файлов за раз, каждый не более @MediaLabels.FormatSize(MediaFileRules.MaxFileBytes).
            </MudText>
        </div>

        @if (_pendingFiles.Count > 0)
        {
            @* ТФ-МЕД-17: у фото и видео дата и время съёмки обязательны. Значение из метаданных файла подставлено
               заранее — оператор его проверяет; если в файле даты нет — вводит. Загрузка — только когда у всех
               фото и видео дата и время заполнены. Время — местное, в базе хранится в UTC. *@
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-2">
                <thead>
                    <tr><th>Файл</th><th style="width:170px;">Дата съёмки</th><th style="width:130px;">Время</th><th>Откуда дата</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var file in _pendingFiles)
                    {
                        var pending = file; // копия для замыканий
                        <tr>
                            <td>@pending.File.Name · @MediaLabels.FormatSize(pending.File.Size)</td>
                            <td>
                                <div style="width:100%;">
                                    <MudDatePicker @bind-Date="pending.Date" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   DateFormat="dd.MM.yyyy" Disabled="_busy" Clearable="@(!pending.Required)"
                                                   Error="@(pending.Required && pending.Date is null)" Placeholder="дд.мм.гггг" />
                                </div>
                            </td>
                            <td>
                                <MudTimePicker @bind-Time="pending.Time" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="false"
                                               Disabled="_busy" Error="@(pending.Required && pending.Time is null)" Placeholder="чч:мм" />
                            </td>
                            <td>
                                <MudText Typo="Typo.caption" Class="@(pending.FromMetadata ? "mud-text-secondary" : (pending.Required ? "mud-error-text" : "mud-text-secondary"))">
                                    @(pending.FromMetadata
                                        ? "из метаданных файла — проверьте"
                                        : pending.Required ? "в файле даты нет — укажите" : "для аудио — по желанию")
                                </MudText>
                            </td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="_busy"
                                               OnClick="@(() => _pendingFiles.Remove(pending))" aria-label="Убрать из списка" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div class="mt-2 d-flex align-center gap-3 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || MissingCaptureTime > 0)"
                           StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="UploadFilesAsync">
                    @(_busy ? "Загружаю…" : $"Загрузить {FileCountLabel(_pendingFiles.Count)}")
                </MudButton>
                @if (MissingCaptureTime > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-error-text">Укажите дату и время съёмки у фото и видео (без них: @MissingCaptureTime).</MudText>
                }
                <MudButton Variant="Variant.Text" OnClick="@(() => _pendingFiles.Clear())" Disabled="_busy">Очистить список</MudButton>
            </div>
        }

        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
        }

        @if (_uploadResults.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">Результаты загрузки</MudText>
            @foreach (var result in _uploadResults)
            {
                <div class="d-flex align-center gap-2 mb-1">
                    <MudChip T="string" Size="Size.Small" Color="@(result.Ok ? (result.Duplicate ? Color.Info : Color.Success) : Color.Error)">
                        @(result.Ok ? (result.Duplicate ? "уже есть" : "принят") : "отклонён")
                    </MudChip>
                    <MudText Typo="Typo.body2">@result.FileName</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@result.Message</MudText>
                    @if (result.AssetId is { } assetId)
                    {
                        <MudLink Href="@($"/media/assets/{assetId}")" Typo="Typo.caption">открыть</MudLink>
                    }
                </div>
            }
        }
    </MudPaper>

    @* ================= Поиск по расшифровкам дела (ADR-0026) ================= *@
    <MudPaper Outlined="true" Class="pa-4 my-4">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Поиск по расшифровкам дела</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            Ищет слова в автоматических расшифровках аудио и звуковых дорожек видео этого дела — как подстроку, без учёта регистра:
            по основе слова находятся и его формы («үй» → «үйдө», «үйгө»). Расшифровка — дословный текст модели без знаков препинания,
            требует проверки. Поиск записывается в журнал вместе с искомым текстом.
        </MudText>
        <div class="d-flex gap-3 align-center flex-wrap">
            @* Пределы длины — из сценария поиска (SearchTranscriptsQuery), не дублируются числом. *@
            <MudTextField @bind-Value="_searchText" Label="Слова для поиска" Variant="Variant.Outlined"
                          Immediate="true" MaxLength="@SearchTranscriptsQuery.MaxTextLength" Disabled="_searching"
                          HelperText="@($"не короче {SearchTranscriptsQuery.MinTextLength} символов")"
                          Style="min-width:260px;" Class="flex-grow-1"
                          OnKeyDown="@(async e => { if (e.Key == "Enter") { await SearchTranscriptsAsync(); } })" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       Disabled="@(!CanSearchTranscripts)" OnClick="SearchTranscriptsAsync">Найти</MudButton>
        </div>

        @if (_searching)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
        }
        @if (_searchError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3"
                      ShowCloseIcon="true" CloseIconClicked="@(() => _searchError = null)">@_searchError</MudAlert>
        }

        @if (_hits is { } hits && !_searching)
        {
            @if (hits.Count == 0)
            {
                @* Не утверждаем «слова нет»: недоступное неотличимо от несуществующего (ТБ-020/021). *@
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                    Совпадений нет: слов нет в готовых расшифровках дела либо материалы вне вашего допуска.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3 mb-1">
                    Найдено фрагментов: @hits.Count@(hits.Count >= SearchTranscriptsQuery.MaxHits ? $" — показаны первые {SearchTranscriptsQuery.MaxHits}, уточните запрос" : string.Empty).
                    Щелчок по месту записи открывает карточку носителя и перематывает запись к фрагменту.
                </MudText>
                <MudTable T="TranscriptHit" Items="hits" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Файл</MudTh><MudTh>Вид</MudTh><MudTh>Место</MudTh><MudTh>Фрагмент</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Файл">@context.AssetFileName</MudTd>
                        <MudTd DataLabel="Вид">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@context.Kind.Icon()" Size="Size.Small" Class="mud-text-secondary" />
                                <span>@context.Kind.Label()</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Место">
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayCircle"
                                       Href="@HitUrl(context)">[@MediaLabels.ClockTimecode(context.StartMs)]</MudButton>
                        </MudTd>
                        <MudTd DataLabel="Фрагмент">
                            @* Выделение — разбиением строки; каждый кусок Razor выводит как текст (экранирует). *@
                            @foreach (var part in TranscriptHighlight.Split(context.Text, _searchedText))
                            {
                                @if (part.IsMatch)
                                {
                                    <mark style="padding:0;">@part.Text</mark>
                                }
                                else
                                {
                                    <span>@part.Text</span>
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudPaper>

    @* ================= Носители дела ================= *@
    <MudTable T="MediaAssetRow" Items="_rows" Hover="true" Dense="true" Outlined="true" Loading="_loading"
              LoadingProgressColor="Color.Primary" OnRowClick="@(row => Open(row.Item!))" RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>Дата</MudTh>
            <MudTh>Файл</MudTh>
            <MudTh>Вид</MudTh>
            <MudTh>Обработка</MudTh>
            <MudTh>Лиц</MudTh>
            <MudTh>Гриф</MudTh>
            <MudTh Style="width:1%;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Дата">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Файл">
                @context.OriginalFileName
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    @MediaLabels.FormatSize(context.ByteSize)@(context.CapturedAt is { } captured ? $" · съёмка {captured.ToLocalTime():dd.MM.yyyy HH:mm}" : " · дата съёмки не указана")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Вид">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@context.Kind.Icon()" Size="Size.Small" Class="mud-text-secondary" />
                    <span>@context.Kind.Label()</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Обработка">
                @if (FacesApplicable(context))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@context.IndexStatus.ChipColor()">@context.IndexStatus.Label()</MudChip>
                    @if (context.IndexStatus == MediaIndexStatus.Failed && !string.IsNullOrWhiteSpace(context.IndexError))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">@context.IndexError</MudText>
                    }
                }
                @if (context.TranscriptStatus != TranscriptStatus.NotApplicable)
                {
                    @* Состояние расшифровки — на момент загрузки списка; ход и причину сбоя показывает карточка. *@
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@context.TranscriptStatus.ChipColor()">@context.TranscriptStatus.Label()</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Лиц">@(FacesApplicable(context) ? context.FaceCount.ToString(CultureInfo.InvariantCulture) : "—")</MudTd>
            <MudTd DataLabel="Гриф"><ClassificationChip Classification="@context.Classification" /></MudTd>
            <MudTd>
                <div class="d-flex gap-1" @onclick:stopPropagation="true">
                    <MudTooltip Text="Открыть карточку">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="@(() => Open(context))" />
                    </MudTooltip>
                    @if (FacesApplicable(context))
                    {
                        <MudTooltip Text="Переиндексировать (повторно найти лица)">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Disabled="_busy"
                                           OnClick="@(() => ReindexAsync(context.Id))" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="Удалить носитель и все производные">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error" Disabled="_busy"
                                       OnClick="@(() => AskPurge(context))" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @* Текст НЕ утверждает «пусто»: недоступное неотличимо от несуществующего (ТБ-020/021). *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Здесь пусто: носителей нет либо они вне вашего допуска.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@* --- Подтверждение гарантированного удаления (ТБ-064/075, GATE-6) --- *@
<MudDialog @bind-Visible="_purgeOpen" Options="PurgeDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Удалить носитель?</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">@_purgeTarget?.OriginalFileName</MudText>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            Удаление гарантированное и необратимое: будут уничтожены исходный файл, расшифровка речи, все найденные лица,
            их вырезки и биометрические шаблоны. Факт удаления записывается в неизменяемый журнал.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _purgeOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_busy" OnClick="PurgeAsync">Удалить безвозвратно</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Дело из маршрута.</summary>
    [Parameter] public int CaseId { get; set; }

    private static readonly DialogOptions PurgeDialogOptions =
        new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Итог приёма одного файла для списка результатов.</summary>
    private sealed record UploadOutcome(string FileName, bool Ok, bool Duplicate, string Message, int? AssetId);

    private readonly List<MediaAssetRow> _rows = [];
    private readonly List<PendingUpload> _pendingFiles = [];
    private readonly List<UploadOutcome> _uploadResults = [];
    private readonly ComponentPoller _poller = new(TimeSpan.FromSeconds(5));

    private CaseScopeItem? _case;
    private bool _caseChecked;
    private bool _busy;
    private bool _loading;
    private string? _error;
    private string? _source;
    private string? _place;
    private bool _purgeOpen;
    private MediaAssetRow? _purgeTarget;

    private string? _searchText;
    private string _searchedText = string.Empty;
    private bool _searching;
    private string? _searchError;
    private IReadOnlyList<TranscriptHit>? _hits;

    /// <summary>Искомое достаточной длины (правило сценария, после обрезки пробелов) и поиск не идёт.</summary>
    private bool CanSearchTranscripts =>
        !_searching && (_searchText?.Trim().Length ?? 0) >= SearchTranscriptsQuery.MinTextLength;

    /// <summary>Лица к носителю применимы (не аудио, ADR-0026): иначе ни статуса индексации, ни переиндексации.</summary>
    private static bool FacesApplicable(MediaAssetRow asset) =>
        asset.Kind != MediaKind.Audio && asset.IndexStatus != MediaIndexStatus.NotApplicable;

    /// <summary>Переход из выдачи к месту записи: карточка носителя с ?t=&lt;начало фрагмента, мс&gt;.</summary>
    private static string HitUrl(TranscriptHit hit) =>
        $"/media/assets/{hit.AssetId.ToString(CultureInfo.InvariantCulture)}?t={hit.StartMs.ToString(CultureInfo.InvariantCulture)}";

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // медиатеку не грузим — ListCaseMediaQuery аудируется и попадал бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        // Подпись дела — из доступных субъекту (ТБ-071): чужое дело в списке не появится.
        var cases = await Dispatcher.Send(new ListAccessibleCasesQuery());
        if (cases is { Status: true, Data: { } list })
        {
            _case = list.FirstOrDefault(c => c.CaseId == CaseId);
        }
        else if (cases is { Status: false })
        {
            _error = cases.StatusMessage;
        }

        _caseChecked = true;
        if (_case is null)
        {
            return;
        }

        await ReloadAsync();

        // Опрос статусов индексации: тик перезапрашивает список, только пока есть незавершённые.
        _poller.Start(() => InvokeAsync(async () =>
        {
            if (_busy || !_rows.Any(r => r.IndexStatus.IsInProgress()))
            {
                return;
            }

            await ReloadAsync();
            StateHasChanged();
        }));
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var response = await Dispatcher.Send(new ListCaseMediaQuery(CaseId));
            _rows.Clear();
            if (response is { Status: true, Data: { } data })
            {
                _rows.AddRange(data);
            }
            else if (response is { Status: false })
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Выбранный файл и его дата/время съёмки (ТФ-МЕД-17).</summary>
    private sealed class PendingUpload(IBrowserFile file, bool required)
    {
        public IBrowserFile File { get; } = file;

        /// <summary>Фото или видео: дата и время обязательны.</summary>
        public bool Required { get; } = required;

        /// <summary>Дата и время подставлены из метаданных файла.</summary>
        public bool FromMetadata { get; set; }

        public DateTime? Date { get; set; }

        public TimeSpan? Time { get; set; }

        /// <summary>Местные дата и время → UTC; не заполнено — <see langword="null"/>.</summary>
        public DateTimeOffset? CapturedAtUtc =>
            Date is { } date && Time is { } time
                ? new DateTimeOffset(DateTime.SpecifyKind(date.Date + time, DateTimeKind.Local)).ToUniversalTime()
                : null;
    }

    /// <summary>Сколько фото и видео в списке ещё без даты или времени съёмки.</summary>
    private int MissingCaptureTime => _pendingFiles.Count(p => p.Required && p.CapturedAtUtc is null);

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is null)
        {
            return;
        }

        foreach (var file in files)
        {
            if (_pendingFiles.Any(p => p.File.Name == file.Name && p.File.Size == file.Size))
            {
                continue;
            }

            var kind = MediaFileRules.KindOf(MediaUploadTypes.Resolve(file.Name, file.ContentType));
            var pending = new PendingUpload(file, kind is MediaKind.Image or MediaKind.Video);
            if (pending.Required && await ReadCaptureTimeAsync(file) is { } found)
            {
                var local = found.ToLocalTime().DateTime;
                pending.Date = local.Date;
                pending.Time = new TimeSpan(local.Hour, local.Minute, 0);
                pending.FromMetadata = true;
            }

            _pendingFiles.Add(pending);
        }
    }

    /// <summary>
    /// Дата съёмки из метаданных — по началу файла (EXIF фото, заголовок MP4/MOV), без чтения всего файла.
    /// Нечитаемый файл — «даты нет»: оператор введёт вручную, загрузка скажет о проблеме сама.
    /// </summary>
    private static async Task<DateTimeOffset?> ReadCaptureTimeAsync(IBrowserFile file)
    {
        try
        {
            var head = new byte[(int)Math.Min(CaptureTimeProbe.HeadBytes, file.Size)];
            await using var stream = file.OpenReadStream(MediaFileRules.MaxFileBytes);
            var read = await stream.ReadAtLeastAsync(head, head.Length, throwOnEndOfStream: false);
            return CaptureTimeProbe.TryRead(head.AsSpan(0, read), TimeZoneInfo.Local, DateTimeOffset.UtcNow);
        }
        catch (IOException)
        {
            return null;
        }
    }

    /// <summary>Счётчик с русским склонением: 1 файл, 2 файла, 5 файлов (и 11–14 — «файлов»).</summary>
    private static string FileCountLabel(int count) => (count % 100 is >= 11 and <= 14 ? 0 : count % 10) switch
    {
        1 => $"{count} файл",
        2 or 3 or 4 => $"{count} файла",
        _ => $"{count} файлов",
    };

    /// <summary>Шаг 2: загрузка каждого выбранного файла отдельной командой; результат — по строкам.</summary>
    private async Task UploadFilesAsync()
    {
        if (_pendingFiles.Count == 0)
        {
            return;
        }

        _busy = true;
        _error = null;
        _uploadResults.Clear();
        try
        {
            foreach (var pending in _pendingFiles.ToList())
            {
                var file = pending.File;
                // Столбец captured_at — timestamptz: Npgsql принимает DateTimeOffset ТОЛЬКО со смещением 0 —
                // местные дата и время переводятся в UTC (PendingUpload.CapturedAtUtc), показ — ToLocalTime.
                var capturedAt = pending.CapturedAtUtc;
                try
                {
                    // Предел размера — из правил пакета; OpenReadStream без maxAllowedSize ограничен 512 КБ.
                    byte[] content;
                    using (var buffer = new MemoryStream())
                    {
                        await using var stream = file.OpenReadStream(MediaFileRules.MaxFileBytes);
                        await stream.CopyToAsync(buffer);
                        content = buffer.ToArray();
                    }

                    // Тип — от браузера; если он пуст или не из allowlist (голосовые .amr, .3gp без типа) — тип по
                    // расширению (MediaUploadTypes: звук; .3gp — видео, голосовой 3GP без картинки индексатор сам
                    // переведёт в аудио). Семейство файла сервер всё равно проверяет по байтам (ТС-010).
                    var response = await Dispatcher.Send(new UploadMediaCommand(
                        CaseId, file.Name, MediaUploadTypes.Resolve(file.Name, file.ContentType), content,
                        string.IsNullOrWhiteSpace(_source) ? null : _source, capturedAt,
                        string.IsNullOrWhiteSpace(_place) ? null : _place));

                    if (response is { Status: true, Data: { } receipt })
                    {
                        _uploadResults.Add(new UploadOutcome(file.Name, true, receipt.Duplicate,
                            receipt.Duplicate ? "такой файл уже есть в деле" : "поставлен в обработку", receipt.AssetId));
                        _pendingFiles.Remove(pending);
                    }
                    else
                    {
                        _uploadResults.Add(new UploadOutcome(file.Name, false, false, response.StatusMessage, null));
                    }
                }
                catch (IOException)
                {
                    // Blazor бросает IOException при превышении maxAllowedSize — говорим человеку, а не «поток».
                    _uploadResults.Add(new UploadOutcome(file.Name, false, false,
                        $"файл больше допустимых {MediaLabels.FormatSize(MediaFileRules.MaxFileBytes)} или не прочитан", null));
                }
            }
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task ReindexAsync(int assetId)
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new ReindexMediaCommand(assetId));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    /// <summary>
    /// Поиск по расшифровкам дела (ADR-0026). Только по действию оператора — не в жизненном цикле страницы:
    /// запрос аудируется (ТБ-030), и на предрендере он не выполняется вовсе. Решётку и сужение по делу
    /// применяет сценарий на сервере; интерфейс показывает только то, что вернулось.
    /// </summary>
    private async Task SearchTranscriptsAsync()
    {
        if (!CanSearchTranscripts)
        {
            return;
        }

        var text = _searchText!.Trim();
        _searching = true;
        _searchError = null;
        try
        {
            var response = await Dispatcher.Send(new SearchTranscriptsQuery(CaseId, text));
            if (response is { Status: true, Data: { } hits })
            {
                _hits = hits;
                _searchedText = text;
            }
            else
            {
                _hits = null;
                _searchError = response.StatusMessage;
            }
        }
        finally
        {
            _searching = false;
        }
    }

    private void AskPurge(MediaAssetRow asset)
    {
        _purgeTarget = asset;
        _purgeOpen = true;
    }

    private async Task PurgeAsync()
    {
        if (_purgeTarget is not { } target)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new PurgeMediaCommand(target.Id));
            if (!response.Status)
            {
                _error = response.StatusMessage;
            }

            _purgeOpen = false;
            _purgeTarget = null;
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private void Open(MediaAssetRow asset) => Navigation.NavigateTo($"/media/assets/{asset.Id}");

    public ValueTask DisposeAsync() => _poller.DisposeAsync();
}
