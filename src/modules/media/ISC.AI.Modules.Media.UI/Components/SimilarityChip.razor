@namespace ISC.AI.Modules.Media.UI
@* Балл схожести (ТЭ-006): ВСЕГДА с предупреждением о вероятностной природе — число само по себе
   не говорит «это он», оно лишь упорядочивает кандидатов. Цвет — только градация близости, не вердикт.
   Проценты — шкалой SimilarityScale (ADR-0054), с округлением вниз: тем же числом, что и порог поиска. *@
@inject ISC.AI.Modules.Media.Application.MediaSearchOptions SearchOptions

<MudTooltip Text="Вероятностная оценка схожести по модели, не установление личности (ТЭ-006). Проценты — шкала балла модели до калибровки на пилоте. Итог — только решение человека (ТБ-073).">
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ChipColor" Icon="@Icons.Material.Filled.Percent">
        схожесть @Percent%
    </MudChip>
</MudTooltip>

@code {
    /// <summary>Косинусная схожесть 0..1 (1 − расстояние).</summary>
    [Parameter, EditorRequired] public double Similarity { get; set; }

    private int Percent => SearchOptions.Scale.DisplayPercent(Similarity);

    // Градация по процентам шкалы: 85 % и выше — рабочий порог по умолчанию, 70 % и выше — порог модели.
    private Color ChipColor => Percent switch
    {
        >= 85 => Color.Primary,
        >= 70 => Color.Info,
        _ => Color.Default,
    };
}
