<Project Sdk="Microsoft.NET.Sdk">

  <!-- Манифест пакета модулей «Медиа» (ADR-0017, ДОК-13 §5): собирает Domain, Application, Data, UI и
       интеграции распознавания лиц (Vision.Onnx) и речи (Speech, ADR-0026) и отдаёт профилю точки
       регистрации и реестр страниц (ЭС3-02). Процесс-распознаватель ISC.AI.Speech.Worker сюда НЕ
       подключается: он запускается отдельным процессом (свой onnxruntime sherpa-onnx), и его сборка
       в процессе хоста — ровно то, от чего ADR-0026 уводит. -->
  <ItemGroup>
    <ProjectReference Include="..\ISC.AI.Modules.Media.Domain\ISC.AI.Modules.Media.Domain.csproj" />
    <ProjectReference Include="..\ISC.AI.Modules.Media.Application\ISC.AI.Modules.Media.Application.csproj" />
    <ProjectReference Include="..\ISC.AI.Modules.Media.Data\ISC.AI.Modules.Media.Data.csproj" />
    <ProjectReference Include="..\ISC.AI.Modules.Media.UI\ISC.AI.Modules.Media.UI.csproj" />
    <ProjectReference Include="..\..\..\integrations\ISC.AI.Vision.Onnx\ISC.AI.Vision.Onnx.csproj" />
    <ProjectReference Include="..\..\..\integrations\ISC.AI.Speech\ISC.AI.Speech.csproj" />
  </ItemGroup>

  <!-- MapEndpoints делегирует в Data (см. её csproj) — сигнатура несёт IEndpointRouteBuilder. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
