@namespace ISC.AI.Profile.Investigation.UI
@page "/persons/{Id:int}"
@rendermode InteractiveServer
@using System.Globalization
@using ISC.AI.Abstractions.Application
@using ISC.AI.Abstractions.Security
@using ISC.AI.Profile.Investigation.Application.Features.Directory
@using ISC.AI.Profile.Investigation.Application.Features.Persons
@using ISC.AI.Profile.Investigation.Application.Features.References
@using ISC.AI.Profile.Investigation.Domain.Enums
@using ISC.AI.Profile.Investigation.Domain.Services
@inject NavigationManager Navigation

@* Карточка фигуранта (ТФ-ПЕР-01/02): реквизиты, подтверждённые появления и эталоны. Появление —
   ВСЕГДА «следственная версия» (ТФ-ВЕР-03): система не утверждает тождество личности, а балл схожести
   показывается с предупреждением о его вероятностной природе (ТЭ-006); слова «идентифицирован» и т.п.
   в интерфейсе не используются (ТЭ-005). Эталоны при замене не удаляются — прежний помечается заменённым
   (ТБ-077). Носители и сессии пакета «Медиа» — по URL (/media/...). Гриф и подразделение фигуранта —
   с дела (решётка ТБ-020: недоступный фигурант неотличим от несуществующего). Связи объекта (ТФ-ПЕР-06) —
   фигуранты того же дела с ролью «связь»; адреса и автотранспорт — отдельные строки под той же решёткой,
   по их нормализованным значениям (ТО-мат-11) ищутся пересечения (ТФ-ПЕР-07). *@

@if (_person is null)
{
    <PageHeader Title="Фигурант" Icon="@Icons.Material.Filled.Person" />
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_error</MudAlert>
        <MudButton Href="/cases" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">К списку дел</MudButton>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
    }
}
else
{
    <PageHeader Title="@_person.DisplayName" Subtitle="@Subtitle(_person)"
                Icon="@Icons.Material.Filled.Person">
        @if (_person.IsUnidentified)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">личность не установлена</MudChip>
        }
        <ClassificationChip Value="@_person.Classification" Prefix="гриф " />
        <MudButton Href="@($"/cases/{_person.CaseId}")" Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ArrowBack">К делу</MudButton>
    </PageHeader>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.subtitle1">Реквизиты</MudText>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="OpenEdit" Disabled="_busy">Изменить</MudButton>
        </div>
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td class="mud-text-secondary">ФИО</td><td>@_person.DisplayName</td></tr>
                @if (_person.UnidentifiedNumber is { } number)
                {
                    <tr><td class="mud-text-secondary">Номер неустановленного лица</td><td>№ @number</td></tr>
                }
                <tr><td class="mud-text-secondary">Роль в деле</td><td>@_person.Role.Label()@(_person.RoleInCase is { } roleText ? $" · {roleText}" : string.Empty)</td></tr>
                @if (_person.Role == PersonRole.Link)
                {
                    <tr>
                        <td class="mud-text-secondary">Связь с</td>
                        <td>
                            @if (_person.LinkedToPersonId is { } linkedId)
                            {
                                <MudLink Href="@($"/persons/{linkedId}")">@PersonName(linkedId)</MudLink>
                            }
                            else
                            {
                                <span>—</span>
                            }
                            @if (_person.LinkTypeId is not null)
                            {
                                <span class="mud-text-secondary"> · @ReferenceLookup.Name(_references, _person.LinkTypeId)</span>
                            }
                        </td>
                    </tr>
                }
                @* Анкета (ТФ-ПЕР-05). Фотография объекта — актуальный эталон на вкладке «Эталоны» (ТБ-077). *@
                <tr><td class="mud-text-secondary">Псевдоним</td><td>@QuestionnaireLabels.OrDash(Q.Alias)</td></tr>
                <tr><td class="mud-text-secondary">Пол</td><td>@(Q.Sex?.Label() ?? "—")</td></tr>
                <tr><td class="mud-text-secondary">Дата (год) рождения</td><td>@QuestionnaireLabels.Birth(Q)</td></tr>
                <tr><td class="mud-text-secondary">Место рождения</td><td>@QuestionnaireLabels.OrDash(Q.BirthPlace)</td></tr>
                <tr><td class="mud-text-secondary">Место работы</td><td>@QuestionnaireLabels.OrDash(Q.WorkPlace)</td></tr>
                <tr><td class="mud-text-secondary">Место жительства</td><td>@QuestionnaireLabels.OrDash(Q.Residence)</td></tr>
                <tr><td class="mud-text-secondary">Примечания</td><td style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(_person.Notes) ? "—" : _person.Notes)</td></tr>
                <tr><td class="mud-text-secondary">Эталонов / появлений</td><td>@_person.ReferencePhotoCount / @_person.AppearanceCount</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudTabs Elevation="0" Border="true" Rounded="true">
    @* --- Связи (ТФ-ПЕР-06): фигуранты этого дела, чьей связью указан этот фигурант --- *@
    <MudTabPanel Text="Связи" Icon="@Icons.Material.Filled.Hub" BadgeData="@Links.Count()" BadgeColor="Color.Default">
        <div class="pt-3">
            <div class="d-flex justify-end mb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="OpenAddLink" Disabled="_busy">Добавить связь</MudButton>
            </div>
            @if (_casePersonsError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_casePersonsError</MudAlert>
            }
            <MudTable T="PersonRow" Items="Links" Hover="true" Dense="true" Outlined="true" Loading="_busy"
                      OnRowClick="@(row => Navigation.NavigateTo($"/persons/{row.Item!.Id}"))" RowClass="cursor-pointer">
                <HeaderContent>
                    <MudTh>Связь</MudTh>
                    <MudTh>Кем приходится</MudTh>
                    <MudTh>Рождение</MudTh>
                    <MudTh Style="text-align:right;">Эталонов</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Связь">
                        @context.DisplayName
                        @if (context.Questionnaire?.Alias is { } alias)
                        {
                            <span class="mud-text-secondary"> «@alias»</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Кем приходится">
                        @ReferenceLookup.Name(_references, context.LinkTypeId)@(context.RoleInCase is { } roleText ? $" · {roleText}" : string.Empty)
                    </MudTd>
                    <MudTd DataLabel="Рождение">@QuestionnaireLabels.Birth(context.Questionnaire)</MudTd>
                    <MudTd DataLabel="Эталонов" Style="text-align:right;">@context.ReferencePhotoCount</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                        Связей нет либо они вне вашего допуска. Связь — отдельный фигурант дела со своей карточкой.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>

    @* --- Адреса и автотранспорт (ТФ-ПЕР-06): по нормализованным значениям ищутся пересечения (ТФ-ПЕР-07) --- *@
    <MudTabPanel Text="Адреса и транспорт" Icon="@Icons.Material.Filled.DirectionsCar"
                 BadgeData="@(_addresses.Count + _vehicles.Count)" BadgeColor="Color.Default">
        <div class="pt-3">
            @if (_requisitesError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                          ShowCloseIcon="true" CloseIconClicked="@(() => _requisitesError = null)">@_requisitesError</MudAlert>
            }
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2">Адреса</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddLocationAlt"
                           OnClick="@(() => OpenAddress(null))" Disabled="_busy">Добавить адрес</MudButton>
            </div>
            <MudTable T="PersonAddressRow" Items="_addresses" Hover="true" Dense="true" Outlined="true" Loading="_busy" Class="mb-4">
                <HeaderContent>
                    <MudTh>Вид</MudTh>
                    <MudTh>Адрес</MudTh>
                    <MudTh>Примечание</MudTh>
                    <MudTh Style="width:200px;">Действия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Вид">@context.Kind.Label()</MudTd>
                    <MudTd DataLabel="Адрес">@context.Text</MudTd>
                    <MudTd DataLabel="Примечание">@(context.Notes ?? "—")</MudTd>
                    <MudTd DataLabel="Действия">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => OpenAddress(context))">Изменить</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy"
                                   OnClick="@(() => DeleteAddressAsync(context))">Удалить</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Адресов нет. Место жительства из анкеты показано в реквизитах.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2">Автотранспорт</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.DirectionsCar"
                           OnClick="@(() => OpenVehicle(null))" Disabled="_busy">Добавить транспорт</MudButton>
            </div>
            <MudTable T="PersonVehicleRow" Items="_vehicles" Hover="true" Dense="true" Outlined="true" Loading="_busy">
                <HeaderContent>
                    <MudTh>Госномер</MudTh>
                    <MudTh>Марка и модель</MudTh>
                    <MudTh>Цвет</MudTh>
                    <MudTh>Примечание</MudTh>
                    <MudTh Style="width:200px;">Действия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Госномер">@(context.PlateNumber ?? "неизвестен")</MudTd>
                    <MudTd DataLabel="Марка и модель">@VehicleName(context)</MudTd>
                    <MudTd DataLabel="Цвет">@(context.Color ?? "—")</MudTd>
                    <MudTd DataLabel="Примечание">@(context.Notes ?? "—")</MudTd>
                    <MudTd DataLabel="Действия">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_busy" OnClick="@(() => OpenVehicle(context))">Изменить</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy"
                                   OnClick="@(() => DeleteVehicleAsync(context))">Удалить</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Автотранспорта нет.</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>

    @* --- Появления: только подтверждённые двумя лицами (ТБ-073), всегда «следственная версия» --- *@
    <MudTabPanel Text="Появления" Icon="@Icons.Material.Filled.Visibility" BadgeData="@_appearances.Count" BadgeColor="Color.Default">
        <div class="pt-3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Балл схожести — вероятностная оценка алгоритма, а не установление личности. Каждое появление —
                <b>следственная версия</b>, подтверждённая экспертом и верификатором; процессуальная проверка
                остаётся за следствием.
            </MudAlert>
            @if (_appearancesError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_appearancesError</MudAlert>
            }
            <MudTable T="AppearanceRow" Items="_appearances" Hover="true" Dense="true" Outlined="true" Loading="_busy">
                <HeaderContent>
                    <MudTh>Носитель</MudTh>
                    <MudTh>Момент</MudTh>
                    <MudTh>Схожесть</MudTh>
                    <MudTh>Статус</MudTh>
                    <MudTh>Эксперт</MudTh>
                    <MudTh>Верификатор</MudTh>
                    <MudTh>Подтверждено</MudTh>
                    <MudTh>Сессия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @* Соглашение навигации пакета «Медиа»: ?face= подсвечивает лицо на карточке носителя (ТФ-ПЕР-02 «переход к кадру»). *@
                    <MudTd DataLabel="Носитель"><MudLink Href="@($"/media/assets/{context.MediaAssetId}?face={context.MediaFaceId}")">носитель № @context.MediaAssetId · лицо № @context.MediaFaceId</MudLink></MudTd>
                    <MudTd DataLabel="Момент">@Moment(context)</MudTd>
                    <MudTd DataLabel="Схожесть">
                        <MudTooltip Text="Вероятностная оценка алгоритма; не является подтверждением личности (ТЭ-006)">
                            <span>@Percent(context.Similarity)</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Статус">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">следственная версия</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Эксперт">@UserName(context.ExpertUserId)</MudTd>
                    <MudTd DataLabel="Верификатор">@UserName(context.VerifierUserId)</MudTd>
                    <MudTd DataLabel="Подтверждено">@context.ConfirmedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Сессия"><MudLink Href="@($"/media/sessions/{context.SearchSessionId}")">№ @context.SearchSessionId</MudLink></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                        Здесь пусто: подтверждённых появлений нет либо они вне вашего допуска.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>

    @* --- Эталоны (ТБ-077): история хранится, замена — новой записью с указанием заменяемой --- *@
    <MudTabPanel Text="Эталоны" Icon="@Icons.Material.Filled.PhotoLibrary" BadgeData="@_photos.Count" BadgeColor="Color.Default">
        <div class="pt-3">
            <div class="d-flex justify-end mb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                           OnClick="OpenAddPhoto" Disabled="_busy">Добавить эталон</MudButton>
            </div>
            @if (_photosError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_photosError</MudAlert>
            }
            <MudTable T="ReferencePhotoRow" Items="_photos" Hover="true" Dense="true" Outlined="true" Loading="_busy">
                <HeaderContent>
                    <MudTh>№</MudTh>
                    <MudTh>Носитель</MudTh>
                    <MudTh>Качество</MudTh>
                    <MudTh>Источник</MudTh>
                    <MudTh>Законное основание</MudTh>
                    <MudTh>Пересмотр до</MudTh>
                    <MudTh>Добавил</MudTh>
                    <MudTh>Состояние</MudTh>
                    <MudTh>Добавлен</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="№">@context.Id</MudTd>
                    <MudTd DataLabel="Носитель">
                        <MudLink Href="@(context.MediaFaceId is { } faceId ? $"/media/assets/{context.MediaAssetId}?face={faceId}" : $"/media/assets/{context.MediaAssetId}")">
                            носитель № @context.MediaAssetId@(context.MediaFaceId is { } face ? $" · лицо № {face}" : string.Empty)
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Качество">@(context.QualityScore is { } q ? q.ToString("0.00", CultureInfo.InvariantCulture) : "—")</MudTd>
                    <MudTd DataLabel="Источник">@(context.Source ?? "—")</MudTd>
                    <MudTd DataLabel="Законное основание">@(context.LegalBasis ?? "—")</MudTd>
                    <MudTd DataLabel="Пересмотр до">
                        @if (context.ReviewDueAt is { } due)
                        {
                            <span class="@(due < DateOnly.FromDateTime(DateTime.Today) ? "mud-error-text" : null)">@due.ToString("dd.MM.yyyy")</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Добавил">@UserName(context.AddedByUserId)</MudTd>
                    <MudTd DataLabel="Состояние">
                        @if (context.SupersededById is { } by)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">заменён эталоном № @by</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">актуален</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Добавлен">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                        Здесь пусто: эталонов нет либо они вне вашего допуска.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudTabPanel>
    </MudTabs>
}

@* --- Правка реквизитов (UpdatePersonCommand); номер неустановленного лица при установлении личности сохраняется --- *@
<MudDialog @bind-Visible="_editOpen" Options="FormDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Изменить фигуранта</MudText></TitleContent>
    <DialogContent>
        @if (_editError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_editError</MudAlert>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_editUnidentified" Label="Личность не установлена" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editName" Label="@(_editUnidentified ? "ФИО (необязательно)" : "ФИО *")" Variant="Variant.Outlined" MaxLength="300" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="PersonRole" @bind-Value="_editKind" Label="Роль *" Variant="Variant.Outlined" Dense="true">
                    @foreach (var role in Enum.GetValues<PersonRole>())
                    {
                        <MudSelectItem T="PersonRole" Value="@role">@role.Label()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editRole" Label="Уточнение роли" Variant="Variant.Outlined" MaxLength="200" />
            </MudItem>
        </MudGrid>
        @if (_editKind == PersonRole.Link)
        {
            <PersonLinkFields Persons="_casePersons" ExcludePersonId="Id" References="_references"
                              @bind-LinkedToPersonId="_editLinkedTo" @bind-LinkTypeId="_editLinkType"
                              InitialLinkTypeId="_person?.LinkTypeId" />
        }
        <PersonQuestionnaireFields Model="_editQuestionnaire" />
        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12">
                <MudTextField @bind-Value="_editNotes" Label="Примечания" Variant="Variant.Outlined" Lines="3" MaxLength="4000" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!EditValid || _busy)" OnClick="SaveEditAsync">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@* --- Новый эталон (AddReferencePhotoCommand): носитель и лицо — идентификаторы пакета «Медиа»
       (берутся со страницы носителя /media/assets/{id}); прежний эталон не удаляется (ТБ-077) --- *@
<MudDialog @bind-Visible="_photoOpen" Options="FormDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Новый эталон</MudText></TitleContent>
    <DialogContent>
        @if (_photoError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_photoError</MudAlert>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="_photoAssetId" Label="Носитель № *" Variant="Variant.Outlined" Min="1"
                                 HelperText="Идентификатор фото или видео из медиатеки дела (аудиозапись эталоном быть не может)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="_photoFaceId" Label="Лицо №" Variant="Variant.Outlined" Min="1"
                                 HelperText="Идентификатор лица на носителе (если выбрано)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_photoSource" Label="Источник" Variant="Variant.Outlined" MaxLength="300" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_photoLegalBasis" Label="Законное основание" Variant="Variant.Outlined" MaxLength="300" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <div>
                    <MudDatePicker @bind-Date="_photoReviewDueAt" Label="Дата пересмотра" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" Clearable="true" />
