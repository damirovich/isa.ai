@code {
    private static readonly DialogOptions FormDialogOptions =
        new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Идентификатор фигуранта из маршрута.</summary>
    [Parameter] public int Id { get; set; }

    private PersonRow? _person;
    private readonly List<AppearanceRow> _appearances = [];
    private readonly List<ReferencePhotoRow> _photos = [];
    private readonly List<UserAccountRow> _accounts = [];
    private bool _busy;
    private string? _error;
    private string? _appearancesError;
    private string? _photosError;

    // --- Правка ---
    private bool _editOpen;
    private string? _editError;
    private string? _editName;
    private bool _editUnidentified;
    private string? _editRole;
    private PersonRole _editKind = PersonRole.Other;
    private PersonQuestionnaireForm _editQuestionnaire = new();
    private string? _editNotes;
    private bool EditValid => _editUnidentified || !string.IsNullOrWhiteSpace(_editName);

    // Анкета фигуранта для показа (пустая, если строка пришла без неё).
    private PersonQuestionnaire Q => _person?.Questionnaire ?? PersonQuestionnaire.Empty;

    // --- Связи, адреса, транспорт (ТФ-ПЕР-06) ---
    private readonly List<PersonRow> _casePersons = [];
    private readonly List<ReferenceItemRow> _references = [];
    private readonly List<PersonAddressRow> _addresses = [];
    private readonly List<PersonVehicleRow> _vehicles = [];
    private string? _casePersonsError;
    private string? _requisitesError;
    private int? _editLinkedTo;
    private int? _editLinkType;

    // Связи этого фигуранта — фигуранты дела, у которых он указан как «чья связь».
    private IEnumerable<PersonRow> Links => _casePersons.Where(p => p.LinkedToPersonId == Id);

    // --- Новая связь ---
    private bool _linkOpen;
    private string? _linkError;
    private bool _linkUnidentified;
    private string? _linkName;
    private int? _linkType;
    private string? _linkRoleText;
    private string? _linkNotes;

    // --- Адрес ---
    private bool _addressOpen;
    private string? _addressError;
    private int? _addressId;
    private AddressKind _addressKind = AddressKind.Residence;
    private string? _addressText;
    private string? _addressNotes;

    // --- Автотранспорт ---
    private bool _vehicleOpen;
    private string? _vehicleError;
    private int? _vehicleId;
    private string? _vehiclePlate;
    private string? _vehicleMake;
    private string? _vehicleModel;
    private string? _vehicleColor;
    private string? _vehicleNotes;

    // --- Новый эталон ---
    private bool _photoOpen;
    private string? _photoError;
    private int? _photoAssetId;
    private int? _photoFaceId;
    private string? _photoSource;
    private string? _photoLegalBasis;
    private DateTime? _photoReviewDueAt;
    private int? _photoSupersedesId;
    private bool PhotoValid => _photoAssetId is > 0;

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // карточку не грузим — иначе GetPersonQuery/ListAppearancesQuery попадали бы в журнал дважды.
        // До интерактива страница показывает индикатор загрузки (_person is null && _error is null).
        if (!RendererInfo.IsInteractive) { return; }

        var accounts = await Dispatcher.Send(new ListUserDirectoryQuery());
        if (accounts is { Status: true, Data: { } rows })
        {
            _accounts.AddRange(rows);
        }

        // Справочники профиля (ТФ-АДМ-07) — имена типов связей; отказ не мешает карточке.
        var references = await Dispatcher.Send(new ListReferenceItemsQuery());
        if (references is { Status: true, Data: { } items })
        {
            _references.AddRange(items);
        }

        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере не грузим (см. OnInitializedAsync).
        if (!RendererInfo.IsInteractive) { return; }

        if (_person is { } current && current.Id != Id)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new GetPersonQuery(Id));
            if (response is not { Status: true, Data: { } person })
            {
                _person = null;
                _error = response.StatusMessage;
                return;
            }

            _person = person;

            _appearancesError = null;
            var appearances = await Dispatcher.Send(new ListAppearancesQuery(Id));
            _appearances.Clear();
            if (appearances is { Status: true, Data: { } a }) { _appearances.AddRange(a); }
            else { _appearancesError = appearances.StatusMessage; }

            _photosError = null;
            var photos = await Dispatcher.Send(new ListReferencePhotosQuery(Id));
            _photos.Clear();
            if (photos is { Status: true, Data: { } p }) { _photos.AddRange(p); }
            else { _photosError = photos.StatusMessage; }

            // Фигуранты дела — для вкладки «Связи», имени «Связь с» и выбора «чья связь» (ТФ-ПЕР-06).
            _casePersonsError = null;
            var casePersons = await Dispatcher.Send(new ListPersonsQuery(person.CaseId));
            _casePersons.Clear();
            if (casePersons is { Status: true, Data: { } list }) { _casePersons.AddRange(list); }
            else { _casePersonsError = casePersons.StatusMessage; }

            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadRequisitesAsync()
    {
        _requisitesError = null;
        var requisites = await Dispatcher.Send(new GetPersonRequisitesQuery(Id));
        _addresses.Clear();
        _vehicles.Clear();
        if (requisites is { Status: true, Data: { } r })
        {
            _addresses.AddRange(r.Addresses);
            _vehicles.AddRange(r.Vehicles);
        }
        else
        {
            _requisitesError = requisites.StatusMessage;
        }
    }

    // --- Новая связь ---
    private void OpenAddLink()
    {
        _linkError = null;
        _linkUnidentified = false;
        _linkName = null;
        _linkType = null;
        _linkRoleText = null;
        _linkNotes = null;
        _linkOpen = true;
    }

    private async Task SaveLinkAsync()
    {
        if (_person is not { } person) { return; }
        _busy = true;
        _linkError = null;
        try
        {
            var response = await Dispatcher.Send(new CreatePersonCommand(
                person.CaseId,
                string.IsNullOrWhiteSpace(_linkName) ? null : _linkName.Trim(),
                _linkUnidentified,
                string.IsNullOrWhiteSpace(_linkRoleText) ? null : _linkRoleText.Trim(),
                _linkNotes,
                PersonRole.Link,
                Questionnaire: null,
                LinkedToPersonId: Id,
                LinkTypeId: _linkType));
            if (!response.Status)
            {
                _linkError = response.StatusMessage;
                return;
            }

            _linkOpen = false;
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    // --- Адреса ---
    private void OpenAddress(PersonAddressRow? row)
    {
        _addressError = null;
        _addressId = row?.Id;
        _addressKind = row?.Kind ?? AddressKind.Residence;
        _addressText = row?.Text;
        _addressNotes = row?.Notes;
        _addressOpen = true;
    }

    private async Task SaveAddressAsync()
    {
        if (string.IsNullOrWhiteSpace(_addressText)) { return; }
        _busy = true;
        _addressError = null;
        try
        {
            var response = await Dispatcher.Send(new SavePersonAddressCommand(Id, _addressId, _addressKind, _addressText, _addressNotes));
            if (!response.Status)
            {
                _addressError = response.StatusMessage;
                return;
            }

            _addressOpen = false;
            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAddressAsync(PersonAddressRow row)
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new DeletePersonAddressCommand(row.Id));
            if (!response.Status)
            {
                _requisitesError = response.StatusMessage;
                return;
            }

            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // --- Автотранспорт ---
    private void OpenVehicle(PersonVehicleRow? row)
    {
        _vehicleError = null;
        _vehicleId = row?.Id;
        _vehiclePlate = row?.PlateNumber;
        _vehicleMake = row?.Make;
        _vehicleModel = row?.Model;
        _vehicleColor = row?.Color;
        _vehicleNotes = row?.Notes;
        _vehicleOpen = true;
    }

    private async Task SaveVehicleAsync()
    {
        _busy = true;
        _vehicleError = null;
        try
        {
            var response = await Dispatcher.Send(new SavePersonVehicleCommand(
                Id, _vehicleId, _vehiclePlate, _vehicleMake, _vehicleModel, _vehicleColor, _vehicleNotes));
            if (!response.Status)
            {
                _vehicleError = response.StatusMessage;
                return;
            }

            _vehicleOpen = false;
            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteVehicleAsync(PersonVehicleRow row)
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new DeletePersonVehicleCommand(row.Id));
            if (!response.Status)
            {
                _requisitesError = response.StatusMessage;
                return;
            }

            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenEdit()
    {
        if (_person is not { } p) { return; }
        _editError = null;
        _editName = p.IsUnidentified ? null : p.DisplayName;
        _editUnidentified = p.IsUnidentified;
        _editRole = p.RoleInCase;
        _editKind = p.Role;
        _editQuestionnaire = PersonQuestionnaireForm.From(p.Questionnaire);
        _editLinkedTo = p.LinkedToPersonId;
        _editLinkType = p.LinkTypeId;
        _editNotes = p.Notes;
        _editOpen = true;
    }

    private async Task SaveEditAsync()
    {
        _busy = true;
        _editError = null;
        try
        {
            var response = await Dispatcher.Send(new UpdatePersonCommand(
                Id, string.IsNullOrWhiteSpace(_editName) ? null : _editName.Trim(), _editUnidentified,
                _editKind, _editQuestionnaire.ToQuestionnaire(),
                // Поля связи — только у роли «связь» (ТФ-ПЕР-06): при смене роли они очищаются.
                _editKind == PersonRole.Link ? _editLinkedTo : null,
                _editKind == PersonRole.Link ? _editLinkType : null,
                string.IsNullOrWhiteSpace(_editRole) ? null : _editRole.Trim(), _editNotes));
            if (!response.Status)
            {
                _editError = response.StatusMessage;
                return;
            }

            _editOpen = false;
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private void OpenAddPhoto()
    {
        _photoError = null;
        _photoAssetId = null;
        _photoFaceId = null;
        _photoSource = null;
        _photoLegalBasis = null;
        _photoReviewDueAt = null;
        _photoSupersedesId = null;
        _photoOpen = true;
    }

    private async Task SavePhotoAsync()
    {
        if (_photoAssetId is not { } assetId) { return; }
        _busy = true;
        _photoError = null;
        try
        {
            // Оценка качества (QualityScore) — от пакета «Медиа»; здесь её нет, передаём null.
            var response = await Dispatcher.Send(new AddReferencePhotoCommand(
                Id, assetId, _photoFaceId,
                string.IsNullOrWhiteSpace(_photoSource) ? null : _photoSource.Trim(),
                string.IsNullOrWhiteSpace(_photoLegalBasis) ? null : _photoLegalBasis.Trim(),
                _photoReviewDueAt is { } due ? DateOnly.FromDateTime(due) : null,
                _photoSupersedesId));
            if (!response.Status)
            {
                _photoError = response.StatusMessage;
                return;
            }

            _photoOpen = false;
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    // --- Подписи ---

    // Имя фигуранта этого дела по идентификатору (для «Связь с»); недоступный — «№ id».
    private string PersonName(int id) => _casePersons.FirstOrDefault(p => p.Id == id)?.DisplayName ?? $"фигурант № {id}";

    // «Toyota Camry», «Toyota», «—».
    private static string VehicleName(PersonVehicleRow row) =>
        string.Join(' ', new[] { row.Make, row.Model }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } name ? name : "—";

    // «Объект · «Шторм»» — роль по перечню и псевдоним, если есть.
    private static string Subtitle(PersonRow person) =>
        person.Questionnaire?.Alias is { } alias
            ? $"{person.Role.Label()} · «{alias}»"
            : $"Фигурант дела · {person.Role.Label()}";

    private string UserName(int? id)
    {
        if (id is not { } userId) { return "—"; }
        var account = _accounts.FirstOrDefault(a => a.UserId == userId);
        if (account is null) { return $"пользователь № {userId}"; }
        return string.IsNullOrWhiteSpace(account.DisplayName) ? account.UserName : account.DisplayName;
    }

    // Балл схожести — в процентах, с зажимом в 0..100: показ вероятностный (ТЭ-006), не «совпало/нет».
    private static string Percent(double similarity)
    {
        var percent = Math.Clamp(similarity * 100, 0, 100);
        return percent.ToString("0", CultureInfo.InvariantCulture) + " %";
    }

    // Момент появления: для видео — таймкод кадра, для фото — «на фото».
    private static string Moment(AppearanceRow row)
    {
        if (row.FrameTimestampMs is { } ms)
        {
            var t = TimeSpan.FromMilliseconds(ms);
            return t.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
                + (row.FrameIndex is { } frame ? $" (кадр {frame})" : string.Empty);
        }

        return row.FrameIndex is { } f ? $"кадр {f}" : "на фото";
    }
}
