    // --- Подписи ---

    // Имя фигуранта этого дела по идентификатору (для «Связь с»); недоступный — «№ id».
    private string PersonName(int id) => _casePersons.FirstOrDefault(p => p.Id == id)?.DisplayName ?? $"фигурант № {id}";

    // «Toyota Camry», «Toyota», «—».
    private static string VehicleName(PersonVehicleRow row) =>
        string.Join(' ', new[] { row.Make, row.Model }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } name ? name : "—";

    // «Объект · «Шторм»» — роль по перечню и псевдоним, если есть.
    private static string Subtitle(PersonRow person) =>
        person.Questionnaire?.Alias is { } alias
            ? $"{person.Role.Label()} · «{alias}»"
            : $"Фигурант дела · {person.Role.Label()}";

    private string UserName(int? id)
    {
        if (id is not { } userId) { return "—"; }
        var account = _accounts.FirstOrDefault(a => a.UserId == userId);
        if (account is null) { return $"пользователь № {userId}"; }
        return string.IsNullOrWhiteSpace(account.DisplayName) ? account.UserName : account.DisplayName;
    }

    // Балл схожести — в процентах, с зажимом в 0..100: показ вероятностный (ТЭ-006), не «совпало/нет».
    private static string Percent(double similarity)
    {
        var percent = Math.Clamp(similarity * 100, 0, 100);
        return percent.ToString("0", CultureInfo.InvariantCulture) + " %";
    }

    private static string Clock(long milliseconds) =>
        TimeSpan.FromMilliseconds(milliseconds).ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture);

    // Длина отрезка появления: кадры выборки и примерная длительность; один кадр — так и пишем.
    private static string SpanText(long startMs, long endMs, int? frames)
    {
        if (endMs <= startMs)
        {
            return "один кадр выборки";
        }

        var seconds = Math.Max(1, (int)Math.Round((endMs - startMs) / 1000.0));
        return $"в кадре ≈ {seconds.ToString(CultureInfo.InvariantCulture)} с"
            + (frames is { } count ? $" ({count.ToString(CultureInfo.InvariantCulture)} {FramesWord(count)} выборки)" : string.Empty);
    }

    // Склонение: 1 кадр, 2–4 кадра, 5–20 кадров, 21 кадр…
    private static string FramesWord(int count)
    {
        var lastTwo = count % 100;
        var last = count % 10;
        return last == 1 && lastTwo != 11 ? "кадр"
            : last is >= 2 and <= 4 && lastTwo is < 12 or > 14 ? "кадра"
            : "кадров";
    }

    // Момент появления: для видео — таймкод кадра, для фото — «на фото».
    private static string Moment(AppearanceRow row)
    {
        if (row.FrameTimestampMs is { } ms)
        {
            var t = TimeSpan.FromMilliseconds(ms);
            return t.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
                + (row.FrameIndex is { } frame ? $" (кадр {frame})" : string.Empty);
        }

        return row.FrameIndex is { } f ? $"кадр {f}" : "на фото";
    }
