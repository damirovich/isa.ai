    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // карточку не грузим — иначе GetPersonQuery/ListAppearancesQuery попадали бы в журнал дважды.
        // До интерактива страница показывает индикатор загрузки (_person is null && _error is null).
        if (!RendererInfo.IsInteractive) { return; }

        var accounts = await Dispatcher.Send(new ListUserDirectoryQuery());
        if (accounts is { Status: true, Data: { } rows })
        {
            _accounts.AddRange(rows);
        }

        // Справочники профиля (ТФ-АДМ-07) — имена типов связей; отказ не мешает карточке.
        var references = await Dispatcher.Send(new ListReferenceItemsQuery());
        if (references is { Status: true, Data: { } items })
        {
            _references.AddRange(items);
        }

        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере не грузим (см. OnInitializedAsync).
        if (!RendererInfo.IsInteractive) { return; }

        if (_person is { } current && current.Id != Id)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(new GetPersonQuery(Id));
            if (response is not { Status: true, Data: { } person })
            {
                _person = null;
                _error = response.StatusMessage;
                return;
            }

            _person = person;

            _appearancesError = null;
            if (await Dispatcher.Send(new GetAppearanceRevokeRightQuery()) is { Status: true, Data: { } right }) { _revokeRight = right; }
            var appearances = await Dispatcher.Send(new ListAppearancesQuery(Id));
            _appearances.Clear();
            if (appearances is { Status: true, Data: { } a }) { _appearances.AddRange(a); }
            else { _appearancesError = appearances.StatusMessage; }

            _photosError = null;
            var photos = await Dispatcher.Send(new ListReferencePhotosQuery(Id));
            _photos.Clear();
            if (photos is { Status: true, Data: { } p }) { _photos.AddRange(p); }
            else { _photosError = photos.StatusMessage; }
            await LoadHeaderPhotoAsync();

            if (await Dispatcher.Send(new GetPersonSearchContextQuery(person.CaseId)) is { Status: true, Data: { } searchContext })
            {
                _searchContext = searchContext;
            }

            // Фигуранты дела — для вкладки «Связи», имени «Связь с» и выбора «чья связь» (ТФ-ПЕР-06).
            _casePersonsError = null;
            var casePersons = await Dispatcher.Send(new ListPersonsQuery(person.CaseId));
            _casePersons.Clear();
            if (casePersons is { Status: true, Data: { } list }) { _casePersons.AddRange(list); }
            else { _casePersonsError = casePersons.StatusMessage; }

            await LoadRequisitesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadRequisitesAsync()
    {
        _requisitesError = null;
        var requisites = await Dispatcher.Send(new GetPersonRequisitesQuery(Id));
        _addresses.Clear();
        _vehicles.Clear();
        if (requisites is { Status: true, Data: { } r })
        {
            _addresses.AddRange(r.Addresses);
            _vehicles.AddRange(r.Vehicles);
        }
        else
        {
            _requisitesError = requisites.StatusMessage;
        }

        // Пересечения пересчитываются после каждой правки реквизитов (ТФ-ПЕР-07 «при сохранении связи»).
        await LoadIntersectionsAsync();
    }

    private async Task LoadIntersectionsAsync()
    {
        _intersectionsError = null;
        var intersections = await Dispatcher.Send(new GetPersonIntersectionsQuery(Id));
        _intersections.Clear();
        if (intersections is { Status: true, Data: { } rows })
        {
            _intersections.AddRange(rows);
        }
        else
        {
            _intersectionsError = intersections.StatusMessage;
        }
    }

    private async Task ReviewIntersectionAsync(IntersectionRow row, IntersectionDecision decision)
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new ReviewIntersectionCommand(Id, row.Kind, row.Key, row.OtherCaseId, decision));
            if (!response.Status)
            {
                _intersectionsError = response.StatusMessage;
                return;
            }

            await LoadIntersectionsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

