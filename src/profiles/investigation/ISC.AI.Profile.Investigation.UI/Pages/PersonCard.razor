@code {
    private static readonly DialogOptions FormDialogOptions =
        new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Идентификатор фигуранта из маршрута.</summary>
    [Parameter] public int Id { get; set; }

    private PersonRow? _person;
    private readonly List<AppearanceRow> _appearances = [];
    private readonly List<ReferencePhotoRow> _photos = [];
    private readonly List<UserAccountRow> _accounts = [];
    private bool _busy;
    private string? _error;
    private string? _appearancesError;
    private string? _photosError;

    // --- Поиск по фигуранту одной кнопкой ---
    private PersonSearchContext? _searchContext;

    private PersonSearchPlan SearchPlan => _person is null
        ? new PersonSearchPlan(null, null, null)
        : PersonSearchRules.Plan(_person.CaseId, _photos, _appearances, _searchContext);

    // --- Отзыв появления (ADR-0034) ---
    private AppearanceRevokeRight? _revokeRight;
    private bool _revokeOpen;
    private AppearanceRow? _revokeTarget;
    private string? _revokeReason;
    private string? _revokeError;

    private string? RevokeHint => (_revokeReason?.Trim().Length ?? 0) < 10 ? "Укажите причину — не короче 10 знаков" : null;

    // Почему отозвать нельзя — подпись у неактивной кнопки; сервер проверяет то же самое.
    private string? RevokeBlocked(AppearanceRow row) => _revokeRight switch
    {
        null => "Проверяю права…",
        { CanRevoke: false } => "Отзыв закрыт для вашей роли (матрица доступа)",
        { UserId: { } me } when me == row.ExpertUserId || me == row.VerifierUserId => "Вы подтверждали — отзывает другой сотрудник",
        _ => null,
    };

    // Эталон с лица, появление на котором отозвано, и ни одного действующего появления на этом лице.
    private bool FromRevokedAppearance(ReferencePhotoRow photo) =>
        photo.MediaFaceId is { } face
        && _appearances.Any(a => a.IsRevoked && a.MediaFaceId == face)
        && !_appearances.Any(a => !a.IsRevoked && a.MediaFaceId == face);

    private void OpenRevoke(AppearanceRow row)
    {
        _revokeTarget = row;
        _revokeReason = null;
        _revokeError = null;
        _revokeOpen = true;
    }

    private async Task RevokeAsync()
    {
        if (_revokeTarget is not { } target) { return; }

        _busy = true;
        _revokeError = null;
        try
        {
            var response = await Dispatcher.Send(new RevokeAppearanceCommand(target.Id, _revokeReason ?? string.Empty));
            if (!response.Status)
            {
                _revokeError = response.StatusMessage;
                return;
            }

            _revokeOpen = false;
            Snackbar.Add("Появление отозвано. Пересечения пересчитаны.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }

        // Отозванное появление уходит из пересечений — перечитываем и их (ADR-0029/0034).
        await ReloadAsync();
        await LoadIntersectionsAsync();
    }

    // --- Правка ---
    private bool _editOpen;
    private string? _editError;
    private string? _editName;
    private bool _editUnidentified;
