@namespace ISC.AI.Profile.Investigation.UI
@page "/persons/{PersonId:int}/graph"
@page "/cases/{CaseId:int}/graph"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Point = Blazor.Diagrams.Core.Geometry.Point
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Options
@using ISC.AI.Abstractions.Security
@using ISC.AI.Profile.Investigation.Application.Features.Directory
@using ISC.AI.Profile.Investigation.Application.Features.RelationGraph
@inject ISnackbar Snackbar

@* Граф связей фигуранта или дела (ТФ-ПЕР-10, ADR-0045) — по образцу «Графа связей» АСИО-10, с анализом связей v0.2.
   Граф строит сервер одним запросом (обход вширь на выбранную глубину, до 300 узлов) — из тех же хранилищ и под той
   же решёткой, что карточки: здесь не видно ничего, чего не видно на карточках (ТБ-020/021). Чужое дело — как в
   пересечениях (ТБ-084): номер, вид, статус, ведущий; не раскрывается. Щелчок по узлу с «?» — тот же запрос с
   глубиной 1 от узла (сервер заново проверяет доступ); по раскрытому — сворачивает ветку, показанную через него.
   Раскладка — силовая, единственная (п. 8–9: «веером» заказчик убрал 14.10.2026); фильтры видов узлов — только
   показ (п. 13); «Как связан с…» — цепочка до выбранного фигуранта (п. 12); «Скачать» — картинка с грифом после
   записи в журнал (п. 14). Каждое построение, раскрытие, поиск и выгрузка — запись в журнале (ТБ-030). Скрипт
   библиотеки диаграмм подключает модуль relationGraph.js — холст рисуется только после его загрузки. *@

<PageHeader Title="Граф связей" Subtitle="@_centerCaption" Icon="@Icons.Material.Filled.AccountTree">
    <MudButton Href="@BackHref" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack">@BackLabel</MudButton>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_error</MudAlert>
}

@* Панель: глубина и перестроение · раскладка · «как связан с…» · выгрузка. *@
<div class="d-flex align-center gap-2 flex-wrap mb-2">
    <MudNumericField T="int" @bind-Value="_depth" Label="Глубина" Min="@GetRelationGraphQuery.MinDepth" Max="@GetRelationGraphQuery.MaxDepth"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:100px;" Disabled="@_loading" />
    <MudTooltip Text="Перестроить граф с выбранной глубиной">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="BuildAsync" Disabled="@(_loading || !_libraryReady)"
                       aria-label="Перестроить" />
    </MudTooltip>

    <MudTooltip Text="Расставить узлы заново (после перетаскивания)">
        <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh" OnClick="Relayout" Disabled="@(_nodes.Count == 0)" aria-label="Расставить заново" />
    </MudTooltip>
    <MudTooltip Text="Вписать граф в окно">
        <MudIconButton Icon="@Icons.Material.Filled.FitScreen" OnClick="FitToView" Disabled="@(_nodes.Count == 0)" aria-label="Вписать в окно" />
    </MudTooltip>

    @* «Как связаны» (п. 12): поиск по ФИО или псевдониму среди доступных фигурантов, выбор строит цепочку от центра. *@
    <MudAutocomplete T="RelationNode" Value="_pathTarget" ValueChanged="FindPathAsync" Label="Как связан с…"
                     Placeholder="ФИО или псевдоним" SearchFunc="SearchPersonsAsync" ToStringFunc="@(n => n?.Title ?? string.Empty)"
                     MinCharacters="2" DebounceInterval="400" MaxItems="@SearchRelationPersonsQuery.MaxResults"
                     Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                     Disabled="@(_loading || !_libraryReady)" Style="min-width:260px;">
        <ItemTemplate Context="hit">
            <MudText Typo="Typo.body2">@hit.Title</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@hit.Subtitle</MudText>
        </ItemTemplate>
    </MudAutocomplete>

    <MudSpacer />
    <MudMenu Label="Скачать" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Size="Size.Small"
             Dense="true" Disabled="@(_nodes.Count == 0 || _loading)">
        <MudMenuItem OnClick="@(() => ExportAsync(RelationGraphExportFormat.Png))">Картинка PNG — для справки</MudMenuItem>
        <MudMenuItem OnClick="@(() => ExportAsync(RelationGraphExportFormat.Svg))">Картинка SVG — для печати</MudMenuItem>
    </MudMenu>
</div>

@if (_pathCaption is not null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
        <div class="d-flex align-center gap-3 flex-wrap">
            <span>@_pathCaption</span>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="BuildAsync">К графу</MudButton>
        </div>
    </MudAlert>
}

@* Легенда и фильтр (п. 13): чип вида узла скрывает или показывает узлы этого вида вместе с их рёбрами. *@
<div class="d-flex align-center gap-1 flex-wrap mb-2">
    @foreach (var item in KindLegend)
    {
        var hidden = _hiddenKinds.Contains(item.Kind);
        var kind = item.Kind;
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@item.Icon" IconColor="@item.IconColor"
                 Style="@(hidden ? "opacity:.45;text-decoration:line-through;" : null)"
                 title="@(hidden ? $"Показать: {item.Label.ToLowerInvariant()}" : $"Скрыть: {item.Label.ToLowerInvariant()}")"
                 OnClick="@(() => ToggleKind(kind))">@item.Label</MudChip>
    }
    <span class="rgraph-legend">
        <svg width="26" height="10" aria-hidden="true"><line x1="0" y1="5" x2="26" y2="5" stroke="@RelationGraphSvg.EdgeColor" stroke-width="2" /></svg> связь, реквизит
        <svg width="26" height="10" aria-hidden="true"><line x1="0" y1="5" x2="26" y2="5" stroke="@RelationGraphSvg.IntersectionColor" stroke-width="2" /></svg> пересечение
        <svg width="26" height="10" aria-hidden="true"><line x1="0" y1="5" x2="26" y2="5" stroke="@RelationGraphSvg.CoAppearanceColor" stroke-width="2" /></svg> вместе на материалах
        · стрелка — «кем приходится», к делу пересечения
    </span>
</div>

<div class="d-flex align-center gap-3 flex-wrap mb-2">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Узлов: @_nodes.Count@(CollapsedCount > 0 ? $" · свёрнуто: {CollapsedCount}" : string.Empty)@(HiddenCount > 0 ? $" · скрыто фильтром: {HiddenCount}" : string.Empty)
    </MudText>
    @if (_truncated)
    {
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-warning);">
            Граф урезан: больше @GetRelationGraphQuery.MaxNodes узлов не показывается — часть узлов осталась свёрнутой («?»).
        </MudText>
    }
    <MudSpacer />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Щелчок по узлу с «?» — показать его связи, по раскрытому — свернуть ветку. Узлы перетаскиваются, колесо мыши — масштаб.
    </MudText>
</div>

<div class="rgraph-canvas-wrap">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="position:absolute;top:0;left:0;right:0;z-index:2;" />
    }
    @if (_libraryReady)
    {
        <CascadingValue Value="_diagram">
            <DiagramCanvas />
        </CascadingValue>
    }
</div>

@code {
    /// <summary>Модуль страницы: подключает скрипт и стили библиотеки диаграмм и сохраняет картинки (ADR-0045 п. 7, 14).</summary>
    public const string ModulePath = "./_content/ISC.AI.Profile.Investigation.UI/js/relationGraph.js";

    // Чипы легенды и фильтра: вид узла, подпись, значок и цвет (те же, что у карточек).
    private static readonly (RelationNodeKind Kind, string Label, string Icon, Color IconColor)[] KindLegend =
    [
        (RelationNodeKind.Person, "Фигуранты", Icons.Material.Filled.Person, Color.Primary),
        (RelationNodeKind.Case, "Дела", Icons.Material.Filled.FolderOpen, Color.Info),
        (RelationNodeKind.ForeignCase, "Чужие дела", Icons.Material.Filled.FolderShared, Color.Warning),
        (RelationNodeKind.Vehicle, "Автотранспорт", Icons.Material.Filled.DirectionsCar, Color.Secondary),
        (RelationNodeKind.Address, "Адреса", Icons.Material.Filled.Place, Color.Success),
        (RelationNodeKind.Phone, "Телефоны", Icons.Material.Filled.Phone, Color.Tertiary),
    ];

    /// <summary>Центр — фигурант (маршрут <c>/persons/{id}/graph</c>).</summary>
    [Parameter] public int? PersonId { get; set; }

    /// <summary>Центр — дело (маршрут <c>/cases/{id}/graph</c>).</summary>
    [Parameter] public int? CaseId { get; set; }

    private readonly BlazorDiagram _diagram = CreateDiagram();
    private readonly Dictionary<string, RelationGraphNodeModel> _nodes = new(StringComparer.Ordinal);

    // Рёбра: ключ → (ребро холста, ребро графа) и узел → ключи его рёбер — чтобы убрать рёбра вместе с узлом.
    private readonly Dictionary<string, (LinkModel Link, RelationEdge Edge)> _links = new(StringComparer.Ordinal);
    private readonly Dictionary<string, HashSet<string>> _nodeLinks = new(StringComparer.Ordinal);

    // «Дерево показа»: какие узлы впервые появились при раскрытии узла — их убирает сворачивание.
    private readonly Dictionary<string, List<string>> _children = new(StringComparer.Ordinal);

    private readonly HashSet<RelationNodeKind> _hiddenKinds = [];
    private readonly List<UserAccountRow> _accounts = [];
    private IJSObjectReference? _module;
    private bool _libraryReady;
    private bool _loading;
    private bool _truncated;
    private bool _fitPending;
    private string? _error;
    private string? _centerCaption;
    private string? _builtFor;
    private string? _centerNodeKey;
    private string? _pathCaption;
    private RelationNode? _pathTarget;
    private int _depth = GetRelationGraphQuery.DefaultDepth;

    private RelationNodeKind CenterKind => CaseId is not null ? RelationNodeKind.Case : RelationNodeKind.Person;
    private int CenterId => CaseId ?? PersonId ?? 0;
    private string CenterRouteKey => string.Create(CultureInfo.InvariantCulture, $"{CenterKind}:{CenterId}");
    private string BackHref => CaseId is { } caseId ? $"/cases/{caseId}" : $"/persons/{PersonId}";
    private string BackLabel => CaseId is not null ? "К делу" : "К фигуранту";
    private int CollapsedCount => _nodes.Values.Count(n => !n.IsCenter && n.Node.Expandable && !n.Expanded);
    private int HiddenCount => _nodes.Values.Count(n => !n.Visible);

    private static BlazorDiagram CreateDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = false,
            Zoom = { Enabled = true },
            Links = { DefaultColor = RelationGraphSvg.EdgeColor }, // портов у узлов нет — рёбра только программные
        };

        // Клавиша Delete не убирает узлы и рёбра: граф — картинка сведений, а не редактор.
        options.Constraints.ShouldDeleteNode = _ => ValueTask.FromResult(false);
        options.Constraints.ShouldDeleteLink = _ => ValueTask.FromResult(false);

        var diagram = new BlazorDiagram(options);
        diagram.RegisterComponent<RelationGraphNodeModel, RelationGraphWidget>();

        // Своя подпись ребра: у подписи библиотеки текст рвётся по словам и обрезается (ADR-0045 п. 5).
        diagram.RegisterComponent<LinkLabelModel, RelationLinkLabelWidget>();
        return diagram;
    }

    protected override void OnInitialized()
    {
        // Холст узнаёт свой размер после первого рисования — тогда и вписываем граф, если вписывание ждёт.
        _diagram.ContainerChanged += TryFit;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Только после подключения circuit'а (на предрендере OnAfterRender не вызывается): граф и журнал — один раз
        // на открытие (ТБ-030), скрипт библиотеки — до первого рисования холста.
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("ensureLoaded");
            _libraryReady = true;
        }
        catch (JSException ex)
        {
            _error = "Не удалось загрузить библиотеку графа: " + ex.Message;
            StateHasChanged();
            return;
        }
        catch (JSDisconnectedException)
        {
            return; // circuit уже закрыт
        }

        // Имена ведущих дел («ведёт …»); отказ справочника графу не мешает — останется номер сотрудника.
        var accounts = await Dispatcher.Send(new ListUserDirectoryQuery());
        if (accounts is { Status: true, Data: { } rows })
        {
            _accounts.AddRange(rows);
        }

        await BuildAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Переход между графами без ухода со страницы (другой фигурант или дело) — перестроить.
        if (_libraryReady && _builtFor is not null && _builtFor != CenterRouteKey)
        {
            await BuildAsync();
        }
    }

    private async Task BuildAsync()
    {
        _loading = true;
        _error = null;
        _truncated = false;
        _pathCaption = null;
        _pathTarget = null;
        Clear();
        StateHasChanged();

        var response = await Dispatcher.Send(new GetRelationGraphQuery(CenterKind, CenterId, _depth));
        _builtFor = CenterRouteKey;
        _loading = false;
        if (response is not { Status: true, Data: { } graph })
        {
            _error = response.StatusMessage;
            _centerCaption = null;
            StateHasChanged();
            return;
        }

        var center = graph.Nodes[0];
        _centerCaption = string.IsNullOrWhiteSpace(center.Subtitle) ? center.Title : $"{center.Title} · {center.Subtitle}";
        ShowGraph(graph, node => RelationGraphLayout.RingRadius(node.Level));
        _truncated = graph.Truncated;
        StateHasChanged();
    }

    // Показать граф с нуля: центр в середине, остальное — начальным веером, затем силовая раскладка, фильтры и
    // вписывание в окно.
    private void ShowGraph(RelationGraph graph, Func<RelationNode, double> radius)
    {
        var center = graph.Nodes[0];
        _centerNodeKey = center.Key;
        AddNode(center, RelationGraphLayout.Center, isCenter: true);
        Merge(graph, radius);
        ArrangeAll();
        ApplyFilters();
        RequestFit();
    }

    // Добавить на холст узлы и рёбра ответа: узлы — начальным веером вокруг узла, при раскрытии которого они появились
    // (порядок ответа — обход вширь: родитель раньше детей), дальше их расставляет силовая раскладка; уже показанные
    // узлы не дублируются.
    private List<string> Merge(RelationGraph graph, Func<RelationNode, double> radius)
    {
        var added = new List<string>();
        var children = graph.Nodes
            .Where(n => n.ParentKey is not null)
            .GroupBy(n => n.ParentKey!, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.Ordinal);

        foreach (var node in graph.Nodes)
        {
            if (!_nodes.TryGetValue(node.Key, out var anchor))
            {
                continue;
            }

            if (node.Expanded)
            {
                anchor.Expanded = true;
            }

            if (!children.TryGetValue(node.Key, out var kids))
            {
                continue;
            }

            var fresh = kids.Where(k => !_nodes.ContainsKey(k.Key)).ToList();
            if (fresh.Count == 0)
            {
                continue;
            }

            var points = RelationGraphLayout.Place(anchor.Position, anchor.IsCenter, fresh.Count, radius(node));
            if (!_children.TryGetValue(node.Key, out var shown))
            {
                shown = [];
                _children[node.Key] = shown;
            }

            for (var i = 0; i < fresh.Count; i++)
            {
                AddNode(fresh[i], points[i], isCenter: false);
                shown.Add(fresh[i].Key);
                added.Add(fresh[i].Key);
            }
        }

        foreach (var edge in graph.Edges)
        {
            AddLink(edge);
        }

        return added;
    }

    private void AddNode(RelationNode node, Point position, bool isCenter)
    {
        var responsible = node.ResponsibleUserId is { } userId ? UserName(userId) : null;
        var model = new RelationGraphNodeModel(node, position, responsible)
        {
            IsCenter = isCenter,
            OnToggleRequested = ToggleAsync,
        };
        _nodes[node.Key] = model;
        _diagram.Nodes.Add(model);
    }

    private void AddLink(RelationEdge edge)
    {
        if (_links.ContainsKey(edge.Key)
            || !_nodes.TryGetValue(edge.FromKey, out var from)
            || !_nodes.TryGetValue(edge.ToKey, out var to))
        {
            return;
        }

        // Стрелка — где направление что-то значит: связь (кто чьей связью является) и пересечение (к делу). Цвет —
        // значением, а не переменной палитры: библиотека пишет его атрибутом SVG, а там var() не работает.
        var link = new LinkModel(from, to);
        if (edge.Kind is RelationEdgeKind.PersonLink or RelationEdgeKind.Intersection)
        {
            link.TargetMarker = LinkMarker.Arrow;
        }

        if (edge.Kind is RelationEdgeKind.Intersection or RelationEdgeKind.CoAppearance)
        {
            link.Color = RelationGraphSvg.Color(edge.Kind);
        }

        link.Labels.Add(new RelationLinkLabelModel(link, edge.Label, edge.Kind));
        _diagram.Links.Add(link);
        _links[edge.Key] = (link, edge);
        NodeLinks(edge.FromKey).Add(edge.Key);
        NodeLinks(edge.ToKey).Add(edge.Key);
    }

    private HashSet<string> NodeLinks(string nodeKey)
    {
        if (!_nodeLinks.TryGetValue(nodeKey, out var set))
        {
            set = new HashSet<string>(StringComparer.Ordinal);
            _nodeLinks[nodeKey] = set;
        }

        return set;
    }

    // Щелчок по узлу: свёрнутый — раскрыть, раскрытый — свернуть ветку (как в АСИО-10).
    private async Task ToggleAsync(RelationGraphNodeModel node)
    {
        if (!node.Clickable || _loading)
        {
            return;
        }

        if (node.Expanded)
        {
            Collapse(node);
        }
        else
        {
            await ExpandAsync(node);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExpandAsync(RelationGraphNodeModel node)
    {
        if (node.Node.EntityId is not { } entityId)
        {
            return;
        }

        node.Loading = true;
        node.Refresh();
        await InvokeAsync(StateHasChanged);

        // Сервер заново читает узел под решёткой (ADR-0045 п. 3, 10): ключ узла с холста ничего не разрешает — у
        // автотранспорта, адреса и телефона он лишь называет реквизит, который сервер ищет у названного фигуранта.
        var key = node.Node.Kind is RelationNodeKind.Vehicle or RelationNodeKind.Address or RelationNodeKind.Phone ? node.Node.Key : null;
        var response = await Dispatcher.Send(new GetRelationGraphQuery(node.Node.Kind, entityId, Depth: 1, key));
        node.Loading = false;

        if (response is { Status: true, Data: { } graph })
        {
            var fresh = graph.Nodes.Count(n => !_nodes.ContainsKey(n.Key));
            if (_nodes.Count + fresh > GetRelationGraphQuery.MaxNodes)
            {
                Snackbar.Add($"На графе уже {_nodes.Count} узлов — предел {GetRelationGraphQuery.MaxNodes}. Сверните часть веток.", Severity.Warning);
            }
            else
            {
                var added = Merge(graph, _ => RelationGraphLayout.ClickRadius);
                node.Expanded = true;
                ArrangeAdded(added);
                ApplyFilters();
            }
        }
        else
        {
            Snackbar.Add(response.StatusMessage, Severity.Warning);
        }

        node.Refresh();
    }

    // Свернуть ветку: убрать узлы, впервые показанные через этот узел (и их ветки), с рёбрами; узел снова «?».
    private void Collapse(RelationGraphNodeModel node)
    {
        var stack = new Stack<string>(_children.TryGetValue(node.Node.Key, out var kids) ? kids : []);
        var seen = new HashSet<string>(StringComparer.Ordinal);
        while (stack.Count > 0)
        {
            var key = stack.Pop();
            if (!seen.Add(key))
            {
                continue;
            }

            if (_children.TryGetValue(key, out var grandKids))
            {
                foreach (var grandKid in grandKids)
                {
                    stack.Push(grandKid);
                }
            }

            RemoveNode(key);
        }

        _children.Remove(node.Node.Key);
        node.Expanded = false;
        node.Refresh();
    }

    private void RemoveNode(string key)
    {
        if (!_nodes.TryGetValue(key, out var model))
        {
            return;
        }

        if (_nodeLinks.TryGetValue(key, out var linkKeys))
        {
            foreach (var linkKey in linkKeys.ToList())
            {
                if (_links.Remove(linkKey, out var info))
                {
                    _diagram.Links.Remove(info.Link);
                    var other = string.Equals(info.Edge.FromKey, key, StringComparison.Ordinal) ? info.Edge.ToKey : info.Edge.FromKey;
                    if (_nodeLinks.TryGetValue(other, out var otherLinks))
                    {
                        otherLinks.Remove(linkKey);
                    }
                }
            }

            _nodeLinks.Remove(key);
        }

        _diagram.Nodes.Remove(model);
        _nodes.Remove(key);
        _children.Remove(key);
    }

    private void Clear()
    {
        _diagram.Links.Clear();
        _diagram.Nodes.Clear();
        _nodes.Clear();
        _links.Clear();
        _nodeLinks.Clear();
        _children.Clear();
        _centerNodeKey = null;
    }

    // --- Раскладка (ADR-0045 п. 8–9) ---

    // «Расставить заново» (например, после перетаскивания): силовая раскладка всего графа и вписывание в окно.
    private void Relayout()
    {
        ArrangeAll();
        RequestFit();
    }

    // Силовая раскладка всего графа; центр графа закреплён.
    private void ArrangeAll() =>
        MoveTo(RelationGraphLayout.Arrange(Boxes(), Edges(), _centerNodeKey is { } center ? new HashSet<string>(StringComparer.Ordinal) { center } : []));

    // После раскрытия щелчком двигаются только новые узлы — рассматриваемое не «уплывает».
    private void ArrangeAdded(IReadOnlyCollection<string> added)
    {
        if (added.Count == 0)
        {
            return;
        }

        var fresh = added.ToHashSet(StringComparer.Ordinal);
        var fixedKeys = _nodes.Keys.Where(key => !fresh.Contains(key)).ToHashSet(StringComparer.Ordinal);
        MoveTo(RelationGraphLayout.Arrange(Boxes(), Edges(), fixedKeys, iterations: 150));
    }

    private void MoveTo(IReadOnlyDictionary<string, Point> positions) =>
        _diagram.Batch(() =>
        {
            foreach (var (key, point) in positions)
            {
                if (_nodes.TryGetValue(key, out var model))
                {
                    model.SetPosition(point.X, point.Y);
                }
            }
        });

    private List<LayoutBox> Boxes(bool visibleOnly = false) =>
        _nodes.Values
            .Where(model => !visibleOnly || model.Visible)
            .Select(model => new LayoutBox(model.Node.Key, model.Position.X, model.Position.Y,
                model.Size?.Width ?? RelationGraphNodeModel.Width, model.Size?.Height ?? 60))
            .ToList();

    private List<(string From, string To)> Edges() =>
        _links.Values.Select(link => (link.Edge.FromKey, link.Edge.ToKey)).ToList();

    private void RequestFit()
    {
        _fitPending = true;
        TryFit();
    }

    private void FitToView() => RequestFit();

    // Вписать видимые карточки в окно; холст ещё без размера — вписывание дождётся ContainerChanged.
    private void TryFit()
    {
        if (!_fitPending || _diagram.Container is not { Width: > 0, Height: > 0 } container)
        {
            return;
        }

        _fitPending = false;
        var (zoom, panX, panY) = RelationGraphLayout.Fit(Boxes(visibleOnly: true), container.Width, container.Height);
        _diagram.SetZoom(zoom);
        _diagram.SetPan(panX, panY);
    }

    // --- Фильтры (ADR-0045 п. 13): только показ, данные не перечитываются ---

    private void ToggleKind(RelationNodeKind kind)
    {
        if (!_hiddenKinds.Remove(kind))
        {
            _hiddenKinds.Add(kind);
        }

        ApplyFilters();
    }

    private void ApplyFilters() =>
        _diagram.Batch(() =>
        {
            foreach (var model in _nodes.Values)
            {
                var visible = model.IsCenter || !_hiddenKinds.Contains(model.Node.Kind);
                if (model.Visible != visible)
                {
                    model.Visible = visible;
                }
            }

            foreach (var (link, edge) in _links.Values)
            {
                var visible = _nodes[edge.FromKey].Visible && _nodes[edge.ToKey].Visible;
                if (link.Visible != visible)
                {
                    link.Visible = visible;
                }
            }
        });

    // --- «Как связаны» (ADR-0045 п. 12) ---

    private async Task<IEnumerable<RelationNode>> SearchPersonsAsync(string? text, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Trim().Length < 2)
        {
            return [];
        }

        var response = await Dispatcher.Send(new SearchRelationPersonsQuery(text.Trim()), cancellationToken);
        return response is { Status: true, Data: { } hits } ? hits : [];
    }

    private async Task FindPathAsync(RelationNode? target)
    {
        _pathTarget = target;
        if (target?.EntityId is not { } personId)
        {
            return;
        }

        _loading = true;
        StateHasChanged();
        var response = await Dispatcher.Send(new FindRelationPathQuery(CenterKind, CenterId, personId));
        _loading = false;

        if (response is not { Status: true, Data: { } path })
        {
            Snackbar.Add(response.StatusMessage, Severity.Info);
            _pathTarget = null;
            StateHasChanged();
            return;
        }

        _truncated = false;
        Clear();
        ShowGraph(path, _ => RelationGraphLayout.ClickRadius);
        _pathCaption = path.Edges.Count == 0
            ? $"«{target.Title}» — это центр графа."
            : $"Цепочка до «{target.Title}»: {path.Edges.Count} {Steps(path.Edges.Count)}. Узлы раскрываются щелчком, как обычно.";
        StateHasChanged();
    }

    private static string Steps(int count) =>
        (count % 100) is >= 11 and <= 14 ? "шагов"
        : (count % 10) switch { 1 => "шаг", 2 or 3 or 4 => "шага", _ => "шагов" };

    // --- Выгрузка (ADR-0045 п. 14): сначала запись в журнал, затем файл ---

    private async Task ExportAsync(RelationGraphExportFormat format)
    {
        if (_module is null)
        {
            return;
        }

        var visible = _nodes.Values.Where(n => n.Visible).ToList();
        if (visible.Count == 0)
        {
            return;
        }

        // Гриф картинки — наибольший из грифов её узлов; о чужом деле гриф не раскрывается и в расчёт не входит.
        var classification = ClassificationLevels.Normalize(visible.Max(n => n.Node.Classification ?? ClassificationLevels.Unclassified));
        var response = await Dispatcher.Send(new ExportRelationGraphCommand(CenterKind, CenterId, format, visible.Count, classification));
        if (response is not { Status: true, Data: { } author })
        {
            Snackbar.Add(response.StatusMessage, Severity.Error);
            return;
        }

        var keys = visible.Select(n => n.Node.Key).ToHashSet(StringComparer.Ordinal);
        var nodes = visible
            .Select(n => new SvgNode(n.Node.Key, n.Node.Kind, n.Node.Title, n.Lines, n.Position.X, n.Position.Y,
                n.Size?.Width ?? RelationGraphNodeModel.Width, n.Size?.Height ?? 60, n.IsCenter))
            .ToList();
        var edges = _links.Values
            .Where(l => keys.Contains(l.Edge.FromKey) && keys.Contains(l.Edge.ToKey))
            .Select(l => new SvgEdge(l.Edge.FromKey, l.Edge.ToKey, l.Edge.Kind, l.Edge.Label))
            .ToList();
        var now = DateTime.Now;
        var title = "Граф связей: " + _centerCaption + (_pathCaption is null ? string.Empty : " — " + _pathCaption);
        var footer = string.Create(CultureInfo.InvariantCulture, $"Сформировал: {author} · {now:dd.MM.yyyy HH:mm} · узлов: {visible.Count}");
        var svg = RelationGraphSvg.Render(nodes, edges, title, footer, ClassificationLevels.Marking(classification));
        var fileName = string.Create(CultureInfo.InvariantCulture,
            $"Граф связей {now:yyyy-MM-dd HH-mm}.{(format == RelationGraphExportFormat.Png ? "png" : "svg")}");

        try
        {
            await _module.InvokeVoidAsync(format == RelationGraphExportFormat.Png ? "downloadPng" : "downloadSvg", fileName, svg);
        }
        catch (JSException ex)
        {
            Snackbar.Add("Не удалось сохранить картинку: " + ex.Message, Severity.Error);
        }
        catch (JSDisconnectedException)
        {
            // Circuit уже закрыт — сохранять некуда.
        }
    }

    private string UserName(int userId)
    {
        var account = _accounts.FirstOrDefault(a => a.UserId == userId);
        if (account is null)
        {
            return string.Create(CultureInfo.InvariantCulture, $"сотрудник № {userId}");
        }

        return string.IsNullOrWhiteSpace(account.DisplayName) ? account.UserName : account.DisplayName;
    }

    public async ValueTask DisposeAsync()
    {
        _diagram.ContainerChanged -= TryFit;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit уже закрыт — освобождать на клиенте нечего.
            }
        }
    }
}
