@namespace ISC.AI.Profile.Investigation.UI
@* Справочник подразделений профиля (ТФ-АДМ-01) деревом любой глубины: идентификаторы — словарь допусков ядра
   (ТБ-011), поэтому подразделение не удаляется, а выключается — номер в допусках и делах должен оставаться
   разрешимым. Ведёт роль с правом «Подразделения и справочники» (матрица доступа, ADR-0032; режим первичной
   настройки — любой вошедший); право проверяет обработчик, отказ показывается. Родитель задаётся при создании
   («Добавить дочернее» на строке) и не меняется. Выключение — с подтверждением: видно, у скольких сотрудников
   подразделение в допуске. *@
@page "/admin/divisions"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using System.Net
@using ISC.AI.Abstractions.Application
@using ISC.AI.Profile.Investigation.Application.Features.Divisions
@using ISC.AI.Profile.Investigation.Domain.Services

<PageHeader Title="Подразделения" Subtitle="Иерархия подразделений — определяет, какие дела и документы видит сотрудник по допуску"
            Icon="@Icons.Material.Filled.AccountTree">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenCreate(null))" Disabled="_busy">Новое подразделение</MudButton>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<div class="d-flex gap-3 align-center flex-wrap mb-3">
    <MudTextField T="string" @bind-Value="_search" Placeholder="Найти по наименованию или коду" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="250" Clearable="true" Style="min-width:280px;" Class="flex-grow-1" />
    <MudSwitch T="bool" @bind-Value="_showInactive" Color="Color.Primary" Label="Показывать выключенные" />
    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="ExpandAll"
               Disabled="@(_collapsed.Count == 0)">Раскрыть всё</MudButton>
    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAll">Свернуть всё</MudButton>
</div>

<MudPaper Outlined="true">
    @if (_busy && _nodes.Count == 0)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    @foreach (var row in Rows)
    {
        var current = row;
        <div class="d-flex align-center gap-2 px-3 py-1" style="@($"padding-left:{12 + current.Depth * 24}px !important;border-bottom:1px solid var(--mud-palette-lines-default);")">
            @if (current.HasChildren)
            {
                <MudIconButton Size="Size.Small" Icon="@(current.Expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                               OnClick="@(() => Toggle(current.Node.Id))" aria-label="@(current.Expanded ? "Свернуть" : "Раскрыть")"
                               Disabled="@(!string.IsNullOrWhiteSpace(_search))" />
            }
            else
            {
                <span style="width:34px;display:inline-block;"></span>
            }
            <div class="flex-grow-1" style="min-width:0;">
                <MudText Typo="Typo.body2" Class="@(current.Node.IsActive ? null : "mud-text-secondary")" Style="font-weight:500;">
                    @current.Node.Name@(current.Node.Code is { } code ? $" · {code}" : string.Empty)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(current.Node.Users == 0 ? "ни у кого нет в допуске" : $"в допуске у сотрудников: {current.Node.Users}")
                </MudText>
            </div>
            @if (!current.Node.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">выключено</MudChip>
            }
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Disabled="_busy" aria-label="Действия">
                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenRename(current.Node))">Переименовать</MudMenuItem>
                @if (current.Node.IsActive)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.SubdirectoryArrowRight" OnClick="@(() => OpenCreate(current.Node))">Добавить дочернее</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="@(() => SetActiveAsync(current.Node, false))">Выключить…</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" OnClick="@(() => SetActiveAsync(current.Node, true))">Включить</MudMenuItem>
                }
            </MudMenu>
        </div>
    }
    @if (!_busy && Rows.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
            @(_nodes.Count == 0
                ? "Справочник пуст — добавьте первое подразделение. Без него не выдать допуск по подразделениям."
                : "По этому отбору подразделений нет.")
        </MudText>
    }
    <div class="d-flex justify-space-between flex-wrap gap-2 px-3 py-2">
        <MudText Typo="Typo.caption">Подразделений: @_nodes.Count, действующих: @_nodes.Count(n => n.IsActive)</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Выключенное подразделение остаётся в истории и допусках, но новые дела в него не заводятся.
        </MudText>
    </div>
</MudPaper>

@* Одна форма на создание и переименование (_formId is null → создание); родитель — только при создании. *@
<MudDialog @bind-Visible="_formOpen" Options="FormDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">@(_formId is null ? "Новое подразделение" : "Переименовать подразделение")</MudText></TitleContent>
    <DialogContent>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_formError</MudAlert>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_formName" Label="Наименование *" Variant="Variant.Outlined" MaxLength="300" Immediate="true" AutoFocus="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_formCode" Label="Код" Variant="Variant.Outlined" MaxLength="50" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int?" @bind-Value="_formParentId" Label="Входит в" Variant="Variant.Outlined" Dense="true"
                           Clearable="true" Placeholder="Верхний уровень" Disabled="_formId is not null"
                           HelperText="@(_formId is not null ? "Родитель задаётся при создании и не меняется" : null)">
                    @foreach (var option in ParentOptions)
                    {
                        <MudSelectItem T="int?" Value="@option.Node.Id">@option.Path</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (!_busy && string.IsNullOrWhiteSpace(_formName))
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mr-auto ml-2">Заполните: наименование</MudText>
        }
        <MudButton OnClick="@(() => _formOpen = false)">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_formName) || _busy)" OnClick="SaveAsync">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions FormDialogOptions =
        new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private readonly List<DivisionNode> _nodes = [];
    private readonly HashSet<int> _collapsed = [];
    private string? _search;
    private bool _showInactive = true;
    private bool _busy = true; // «загрузка…» до первой интерактивной загрузки (предрендер данных не грузит)
    private string? _error;

    private bool _formOpen;
    private string? _formError;
    private int? _formId;
    private string? _formName;
    private string? _formCode;
    private int? _formParentId;

    private IReadOnlyList<DivisionTreeRow> Rows => DivisionTree.Build(_nodes, _collapsed, _search, _showInactive);

    // Родитель — из действующих, с полным путём: одноимённые отделы разных управлений различимы.
    private IEnumerable<DivisionTreeRow> ParentOptions =>
        DivisionTree.Build(_nodes, new HashSet<int>(), null, showInactive: false);

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере справочник не грузим.
        if (!RendererInfo.IsInteractive) { return; }

        await ReloadAsync();
    }

    private void Toggle(int id)
    {
        if (!_collapsed.Add(id)) { _collapsed.Remove(id); }
    }

    private void ExpandAll() => _collapsed.Clear();

    private void CollapseAll()
    {
        _collapsed.Clear();
        foreach (var node in _nodes.Where(n => _nodes.Any(c => c.ParentId == n.Id)))
        {
            _collapsed.Add(node.Id);
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new ListDivisionsQuery());
            _nodes.Clear();
            if (response is { Status: true, Data: { } list })
            {
                _nodes.AddRange(list);
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenCreate(DivisionNode? parent)
    {
        _formId = null;
        _formName = null;
        _formCode = null;
        _formParentId = parent?.Id;
        _formError = null;
        _formOpen = true;
    }

    private void OpenRename(DivisionNode node)
    {
        _formId = node.Id;
        _formName = node.Name;
        _formCode = node.Code;
        _formParentId = node.ParentId;
        _formError = null;
        _formOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formName)) { return; }
        _busy = true;
        _formError = null;
        try
        {
            var name = _formName.Trim();
            var code = string.IsNullOrWhiteSpace(_formCode) ? null : _formCode.Trim();
            IResponseDto response = _formId is { } id
                ? await Dispatcher.Send(new RenameDivisionCommand(id, name, code))
                : await Dispatcher.Send(new CreateDivisionCommand(name, code, _formParentId));
            if (!response.Status)
            {
                _formError = response.StatusMessage;
                return;
            }

            _formOpen = false;
            Snackbar.Add(_formId is null ? $"Подразделение «{name}» добавлено." : "Изменения сохранены.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }

    private async Task SetActiveAsync(DivisionNode node, bool isActive)
    {
        if (!isActive)
        {
            // Выключение — с подтверждением и последствиями: сколько сотрудников держат подразделение в допуске.
            var users = node.Users == 0
                ? "Ни у кого из сотрудников это подразделение не выдано в допуске."
                : $"Подразделение выдано в допуске сотрудникам: {node.Users}. Допуски не изменятся — выданное остаётся действовать.";
            var html = $"<p>«{WebUtility.HtmlEncode(node.Name)}» перестанет предлагаться для новых дел и допусков. Старые дела и история останутся.</p>"
                + $"<p class=\"mud-text-secondary\">{WebUtility.HtmlEncode(users)}</p>";
            var answer = await DialogService.ShowMessageBoxAsync("Выключить подразделение?", (MarkupString)html,
                yesText: "Выключить", cancelText: "Отмена", options: FormDialogOptions);
            if (answer != true) { return; }
        }

        _error = null;
        var response = await Dispatcher.Send(new SetDivisionActiveCommand(node.Id, isActive));
        if (!response.Status)
        {
            _error = response.StatusMessage;
        }
        else
        {
            Snackbar.Add(isActive ? $"«{node.Name}» снова действует." : $"«{node.Name}» выключено.", Severity.Success);
        }

        await ReloadAsync();
    }
}
