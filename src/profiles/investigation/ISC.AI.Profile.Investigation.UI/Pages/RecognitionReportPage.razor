@namespace ISC.AI.Profile.Investigation.UI
@page "/reports/recognition"
@rendermode InteractiveServer
@inject TimeProvider Clock
@using System.Globalization
@using System.IO
@using ISC.AI.Modules.DocFlow.Domain.Services
@using ISC.AI.Profile.Investigation.Application.Features.Statistics

@* Сводный отчёт результативности биометрической идентификации (ТФ-ОТЧ-07, [АИС 6.5], ADR-0061): за период и по
   подразделениям — обработано фото и видео, найдено лиц, отбраковано по качеству (доля), поисков, совпадений выше
   порога, подтверждено и отклонено сотрудниками. Счёт делает сервер по первичным записям, под решёткой допуска; без ИИ.
   Построение — запись в журнале; выгрузка Excel/Word/PDF — с маркировкой грифа, запись «Выгрузка» до выдачи файла.
   Право — «Статистические отчёты» матрицы доступа: отказ показывается текстом. *@

<PageHeader Title="Результативность распознавания" Subtitle="Сводный отчёт работы распознавания лиц по подразделениям за период"
            Icon="@Icons.Material.Filled.QueryStats">
    @if (_report is { } shown)
    {
        <ClassificationChip Value="@shown.MaxClassification" Prefix="гриф отчёта " />
    }
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="d-flex gap-3 align-center flex-wrap">
        @* Ширина календарей — обёрткой, не Style: MudBlazor копирует Style пикера на раскрытый календарь. *@
        <div style="width:160px;">
            <MudDatePicker @bind-Date="_from" Label="С" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
        </div>
        <div style="width:160px;">
            <MudDatePicker @bind-Date="_to" Label="По" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
        </div>
        <div style="width:360px;max-width:100%;">
            <MudSelect T="int?" @bind-Value="_divisionId" Label="Подразделение" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">Все в пределах допуска</MudSelectItem>
                @foreach (var option in _divisions)
                {
                    <MudSelectItem T="int?" Value="@((int?)option.Id)">@option.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(_busy || !PeriodValid)" OnClick="LoadAsync">Сформировать</MudButton>
        <MudSpacer />
        @foreach (var (format, label) in Formats)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_busy || _report is null)"
                       OnClick="@(() => ExportAsync(format))">@label</MudButton>
        }
    </div>
    @if (!PeriodValid)
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1">Укажите период: дата «с» не позже даты «по».</MudText>
    }
</MudPaper>

@if (_busy && _report is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-3" />
}
else if (_report is { } report)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Период: @Date(report.From) — @Date(report.To). Носители и лица — по подразделению носителя, поиски и их исходы — по
        подразделению того, кто искал; исходы — на момент построения. Учтены только записи в пределах вашего допуска.
    </MudText>
    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="overflow-x:auto;">
        <thead>
            <tr>
                @foreach (var column in RecognitionReportBuilder.Columns)
                {
                    <th>@column</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (report.Rows.Count == 0)
            {
                <tr>
                    @* Пусто — не «нет данных вообще»: записи могут быть вне допуска (ТБ-020/021). *@
                    <td colspan="@RecognitionReportBuilder.Columns.Count" class="mud-text-secondary">
                        За период в пределах вашего допуска ни носителей, ни поисков нет.
                    </td>
                </tr>
            }
            @foreach (var row in report.Rows)
            {
                <tr>
                    <td>@row.Division</td>
                    @foreach (var cell in RecognitionReportBuilder.Cells(row.Counters))
                    {
                        <td style="text-align:right;">@cell</td>
                    }
                </tr>
            }
            @if (report.Rows.Count > 1)
            {
                <tr style="font-weight:600;">
                    <td>Итого</td>
                    @foreach (var cell in RecognitionReportBuilder.Cells(report.Total))
                    {
                        <td style="text-align:right;">@cell</td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        «Отбраковано» — лица, непригодные для сравнения по качеству (мало, размыто, обрезано), доля — от найденных.
        «Совпадений выше порога» — кандидаты выдачи поиска: в неё попадают только лица, прошедшие порог схожести.
        В скобках у поисков — сколько из них автосверок.
    </MudText>
}

@code {
    private static readonly (ReportFormat Format, string Label)[] Formats =
        [(ReportFormat.Excel, "Excel"), (ReportFormat.Word, "Word"), (ReportFormat.Pdf, "PDF")];

    private DateTime? _from;
    private DateTime? _to;
    private int? _divisionId;
    private IReadOnlyList<ReportDivisionOption> _divisions = [];
    private RecognitionReport? _report;
    private bool _busy = true; // «загрузка…» до первой интерактивной загрузки
    private string? _error;

    private bool PeriodValid => _from is { } from && _to is { } to && from.Date <= to.Date;

    protected override async Task OnInitializedAsync()
    {
        // По умолчанию — текущий месяц по местному времени.
        var today = TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone).Date;
        _from = new DateTime(today.Year, today.Month, 1, 0, 0, 0, DateTimeKind.Unspecified);
        _to = today;

        // ТБ-030 «одно открытие — одна запись»: на предрендере отчёт не строится.
        if (!RendererInfo.IsInteractive) { return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_from is not { } from || _to is not { } to)
        {
            return;
        }

        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new RecognitionReportQuery(DateOnly.FromDateTime(from), DateOnly.FromDateTime(to), _divisionId));
            if (response is { Status: true, Data: { } report })
            {
                _report = report;
                _divisions = report.Divisions;
                _error = null;
            }
            else
            {
                _report = null;
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync(ReportFormat format)
    {
        if (_report is not { } report)
        {
            return;
        }

        _busy = true;
        try
        {
            // Выгружается ровно построенный отчёт (его период и отбор): сервер считает заново и пишет запись в журнал.
            var response = await Dispatcher.Send(new ExportRecognitionReportCommand(report.From, report.To, report.DivisionId, format));
            if (response is not { Status: true, Data: { } file })
            {
                _error = response.StatusMessage;
                return;
            }

            using var stream = new DotNetStreamReference(new MemoryStream(file.Content));
            await JS.InvokeVoidAsync("downloadFileFromStream", file.FileName, stream);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Date(DateOnly date) => date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
}
