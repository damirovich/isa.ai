@namespace ISC.AI.Profile.Investigation.UI
@* Допуски пользователей (ТБ-011/020/021): максимальный гриф и разрешённые подразделения — словарь
   решётки ядра, общий для дел, фигурантов, носителей и документов. Как и страница ролей, видна всем
   (claim'а под роль нет), но обработчики сами решают, вправе ли вызывающий: Администратор — всегда;
   любой вошедший — ТОЛЬКО пока Администратора нет (режим первичной настройки). На «кнопку не покажем»
   не полагаемся. Отзыв допуска пишется в журнал и действует немедленно. *@
@page "/admin/clearances"
@rendermode InteractiveServer
@using ISC.AI.Abstractions.Application
@using ISC.AI.Profile.Investigation.Application.Features.Clearances

<PageHeader Title="Допуски пользователей"
            Subtitle="Максимальный гриф и разрешённые подразделения (ТБ-011/020/021) · ведёт Администратор"
            Icon="@Icons.Material.Filled.Key" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@if (_saved is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _saved = null)">@_saved</MudAlert>
}

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
    <MudText Typo="Typo.body2">
        Дело, фигурант или носитель виден, если <b>его гриф не выше допуска</b> И <b>его подразделение есть в
        списке</b>; сверх этого роль сужает дела (следователь — свои). Пустой список подразделений — это
        «ни одного», а не «все»: такой пользователь не увидит ничего и не заведёт дело.
    </MudText>
</MudAlert>

@* Расхождение словарей — тихая поломка: номер в допуске есть, подразделения с таким номером нет. *@
@if (_unknownTotal > 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
        <MudText Typo="Typo.body2">
            <b>В допусках есть номера подразделений, которых нет в справочнике (@_unknownTotal).</b>
        </MudText>
        <MudText Typo="Typo.body2">
            Такой номер не даёт доступа ни к чему — ни сейчас, ни в будущем. Уберите лишние номера или
            заведите подразделение в разделе «Подразделения».
        </MudText>
    </MudAlert>
}

<MudTable T="UserClearanceRow" Items="_rows" Hover="true" Dense="true" Outlined="true" Loading="_busy">
    <HeaderContent>
        <MudTh>Пользователь</MudTh>
        <MudTh Style="width:170px;">Максимальный гриф</MudTh>
        <MudTh>Разрешённые подразделения</MudTh>
        <MudTh Style="width:180px;">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Пользователь">
            @context.DisplayName
            @if (!context.HasClearance)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                         Class="ml-2">без допуска</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Максимальный гриф">
            <MudSelect T="short?" Value="@Draft(context).MaxClassification"
                       ValueChanged="@(value => { Draft(context).MaxClassification = value; })"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                       Placeholder="Не выдан" Style="min-width:140px;">
                @for (short level = 0; level <= SetUserClearanceValidator.MaxClassification; level++)
                {
                    var value = level;
                    <MudSelectItem T="short?" Value="@value">@(value == 0 ? "0 — открытый" : value.ToString())</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="Разрешённые подразделения">
            <MudSelect T="int" MultiSelection="true" SelectedValues="@Draft(context).Divisions"
                       SelectedValuesChanged="@(values => { Draft(context).Divisions = [.. values]; })"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                       Style="min-width:280px;" Placeholder="Ни одного"
                       MultiSelectionTextFunc="@Summary">
                @foreach (var division in _divisions)
                {
                    <MudSelectItem T="int" Value="@division.Id">@division.Name</MudSelectItem>
                }
            </MudSelect>
            @if (context.UnknownDivisionIds.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">
                    Нет в справочнике: @string.Join(", ", context.UnknownDivisionIds).
                    Сохранение уберёт эти номера.
                </MudText>
            }
        </MudTd>
        <MudTd DataLabel="Действия">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       OnClick="@(() => SaveAsync(context))">Сохранить</MudButton>
            @if (context.HasClearance)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy"
                           OnClick="@(() => RevokeAsync(context))">Отозвать</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Активных пользователей нет либо реестр вам недоступен.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>Правки строки до нажатия «Сохранить» (таблица не редактирует модель ответа напрямую).</summary>
    private sealed class ClearanceDraft
    {
        public short? MaxClassification { get; set; }

        public HashSet<int> Divisions { get; set; } = [];
    }

    private readonly List<UserClearanceRow> _rows = [];
    private readonly List<ClearanceDivision> _divisions = [];
    private readonly Dictionary<int, ClearanceDraft> _drafts = [];

    private bool _busy = true; // «загрузка…» до первой интерактивной загрузки (предрендер данных не грузит)
    private string? _error;
    private string? _saved;
    private int _unknownTotal;

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030 «одно открытие — одна запись»: на предрендере (статический SSR до подключения circuit'а)
        // допуски не грузим — иначе аудируемые запросы попадали бы в журнал дважды.
        if (!RendererInfo.IsInteractive) { return; }

        await ReloadAsync();
    }

    private ClearanceDraft Draft(UserClearanceRow row)
    {
        if (!_drafts.TryGetValue(row.UserId, out var draft))
        {
            // Незнакомые справочнику номера в черновик НЕ попадают: выбрать их в списке всё равно
            // нельзя, а тихо сохранить обратно — значит увековечить поломку. Об удалении предупреждаем.
            draft = new ClearanceDraft
            {
                MaxClassification = row.MaxClassification,
                Divisions = [.. row.Divisions.Where(d => d.IsKnown).Select(d => d.Id)],
            };
            _drafts[row.UserId] = draft;
        }

        return draft;
    }

    // MudSelect отдаёт сюда ТЕКСТЫ выбранных пунктов, а не значения — показываем счётчик.
    private static string Summary(IReadOnlyList<string> selectedTexts) =>
        selectedTexts.Count == 0 ? "Ни одного" : $"Выбрано: {selectedTexts.Count}";

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            var divisions = await Dispatcher.Send(new ListClearanceDivisionsQuery());
            _divisions.Clear();
            if (divisions is { Status: true, Data: { } divisionList })
            {
                _divisions.AddRange(divisionList);
            }

            var response = await Dispatcher.Send(new ListUserClearancesQuery());
            _rows.Clear();
            _drafts.Clear();
            if (response is { Status: true, Data: { } list })
            {
                _rows.AddRange(list);
                _unknownTotal = list.Sum(r => r.UnknownDivisionIds.Count);
            }
            else
            {
                _unknownTotal = 0;
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync(UserClearanceRow row)
    {
        _error = null;
        _saved = null;

        var draft = Draft(row);
        if (draft.MaxClassification is not { } maxClassification)
        {
            _error = "Укажите максимальный гриф — без него допуск не выдаётся.";
            return;
        }

        var response = await Dispatcher.Send(new SetUserClearanceCommand(
            row.UserId, maxClassification, [.. draft.Divisions]));

        if (response.Status)
        {
            _saved = $"Допуск сохранён: {row.DisplayName}.";
        }
        else
        {
            _error = response.StatusMessage;
        }

        await ReloadAsync();
    }

    private async Task RevokeAsync(UserClearanceRow row)
    {
        _error = null;
        _saved = null;

        var response = await Dispatcher.Send(new RevokeUserClearanceCommand(row.UserId));
        if (response.Status)
        {
            _saved = $"Допуск отозван: {row.DisplayName}. Отзыв действует немедленно.";
        }
        else
        {
            _error = response.StatusMessage;
        }

        await ReloadAsync();
    }
}
