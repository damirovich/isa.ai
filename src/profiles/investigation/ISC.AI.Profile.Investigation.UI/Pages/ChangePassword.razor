@namespace ISC.AI.Profile.Investigation.UI
@* Смена СВОЕГО пароля. Обычный путь — ДИАЛОГ из шапки (AccountWidget); эта страница нужна для
   ПРИНУДИТЕЛЬНОЙ смены временного пароля: хост (RequirePasswordChange) запирает сюда пользователя
   с MustChangePassword. Маршрут /account/password обязан существовать в любом профиле — менять нельзя. *@
@page "/account/password"
@rendermode InteractiveServer

<div class="d-flex justify-center mt-12">
    <MudPaper Outlined="true" Class="pa-6" Style="width:100%; max-width:440px;">
        <div class="d-flex align-center gap-2 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Смена пароля</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Пароль меняете только вы — администратор его не видит.
        </MudText>
        <ChangePasswordForm />
    </MudPaper>
</div>
