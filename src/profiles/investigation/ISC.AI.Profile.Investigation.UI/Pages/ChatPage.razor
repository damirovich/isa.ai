@namespace ISC.AI.Profile.Investigation.UI
@page "/chat"
@rendermode InteractiveServer
@using System.Globalization
@using ISC.AI.Profile.Investigation.Application.Features.CaseChat
@using ISC.AI.Profile.Investigation.Domain.Services
@inject NavigationManager Navigation

@* Чат по материалам (ТФ-ДДЛ-02/03, ADR-0051): пункт меню. Где искать — «Все мои дела» (по умолчанию) или одно дело из
   доступных; выбор — в адресе (?case=N), «Назад» возвращает ту же область. Сам чат — CaseChatPanel, тот же, что во
   вкладке дела: материалы области — документы дел, расшифровки записей, сводки и справки, сведения дел. Область и
   решётку применяет сервер; список дел здесь — только для выбора. *@

<PageHeader Title="Чат по материалам" Subtitle="Вопросы к документам, расшифровкам, сводкам и сведениям ваших дел — ответ только по найденному, со ссылками"
            Icon="@Icons.Material.Filled.QuestionAnswer" />

@if (_error is not null)
{
    <MudAlert Severity="@(_noRight ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_error</MudAlert>
}
else if (_scopes is null)
{
    <MudProgressLinear Indeterminate="true" Class="my-2" />
}
else
{
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <div class="d-flex align-center gap-3 flex-wrap">
            <MudSelect T="int" Value="_selected" ValueChanged="SelectAsync" Label="Где искать" Variant="Variant.Outlined" Dense="true"
                       Style="min-width:320px; max-width:640px;" AnchorOrigin="Origin.BottomLeft">
                <MudSelectItem T="int" Value="0">@AllLabel</MudSelectItem>
                @foreach (var scope in _scopes)
                {
                    <MudSelectItem T="int" Value="@scope.CaseId">@CaseLabel(scope)</MudSelectItem>
                }
            </MudSelect>
            @if (_selected != 0)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen"
                           Href="@($"/cases/{_selected}")">Карточка дела</MudButton>
            }
        </div>
    </MudPaper>

    @* Высота — до низа окна (как у чат-ассистента «ИнспектораAI»): шапка страницы и выбор области — сверху. *@
    <CaseChatPanel @key="_selected" CaseId="@(_selected == 0 ? null : _selected)" Height="calc(100vh - 330px)" />
}

@code {
    /// <summary>Выбранное дело из адреса (?case=N); нет — все доступные дела.</summary>
    [SupplyParameterFromQuery(Name = "case")] public int? Case { get; set; }

    private IReadOnlyList<CaseChatScope>? _scopes;
    private int _selected;
    private string? _error;
    private bool _noRight;

    private string AllLabel => string.Create(CultureInfo.InvariantCulture, $"Все мои дела ({_scopes?.Count ?? 0})");

    protected override async Task OnInitializedAsync()
    {
        // ТБ-030: на предрендере ничего не читается.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var response = await Dispatcher.Send(new ListChatScopesQuery());
        if (response is { Status: true, Data: { } scopes })
        {
            _scopes = scopes;
        }
        else
        {
            _noRight = response?.StatusMessage == CaseChatMessages.NoRight;
            _error = response?.StatusMessage ?? CaseChatMessages.NotFound;
        }
    }

    protected override void OnParametersSet()
    {
        // Дело из адреса — только если оно среди доступных; иначе — все дела (чужой номер ничего не открывает).
        _selected = Case is { } id && (_scopes is null || _scopes.Any(s => s.CaseId == id)) ? id : 0;
    }

    private Task SelectAsync(int caseId)
    {
        _selected = caseId;
        Navigation.NavigateTo(caseId == 0 ? "/chat" : $"/chat?case={caseId}", replace: true);
        return Task.CompletedTask;
    }

    private static string CaseLabel(CaseChatScope scope) =>
        "№ " + scope.Number + (string.IsNullOrWhiteSpace(scope.Title) ? string.Empty : " — " + scope.Title);
}
