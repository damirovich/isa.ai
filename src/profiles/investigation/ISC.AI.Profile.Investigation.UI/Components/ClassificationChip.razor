@namespace ISC.AI.Profile.Investigation.UI
@using ISC.AI.Abstractions.Security

@* Маркировка грифа на карточках и в строках (ТБ-024): название уровня единой шкалы платформы (ADR-0030)
   с пояснением в подсказке. Гриф показывается ВСЕГДА, включая «без грифа»: пользователь должен видеть, с
   каким материалом работает. Цвет растёт с уровнем: ДСП — синий, «Секретно» — жёлтый, выше — красный. *@

@if (ClassificationLevels.Normalize(Value) > ClassificationLevels.Unclassified)
{
    <MudTooltip Text="@ClassificationLevels.Description(Value)">
        <MudChip T="string" Size="Size.Small" Color="@ChipColor" Variant="@ChipVariant">
            @(Prefix)@ClassificationLevels.Label(Value)
        </MudChip>
    </MudTooltip>
}
else
{
    <MudTooltip Text="@ClassificationLevels.Description(Value)">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(Prefix)@ClassificationLevels.Label(Value)</MudText>
    </MudTooltip>
}

@code {
    /// <summary>Уровень грифа по шкале платформы (0 — без грифа … 4 — особой важности).</summary>
    [Parameter, EditorRequired] public short Value { get; set; }

    /// <summary>Подпись перед значением (например, «гриф »); по умолчанию — пусто.</summary>
    [Parameter] public string Prefix { get; set; } = string.Empty;

    private Color ChipColor => ClassificationLevels.Normalize(Value) switch
    {
        ClassificationLevels.ForOfficialUse => Color.Info,
        ClassificationLevels.Secret => Color.Warning,
        _ => Color.Error,
    };

    // «Особой важности» — залитый чип: высший уровень должен бросаться в глаза.
    private Variant ChipVariant =>
        ClassificationLevels.Normalize(Value) == ClassificationLevels.SpecialImportance ? Variant.Filled : Variant.Text;
}
