@namespace ISC.AI.Profile.Inspector.UI
@* Модуль «Генератор» (Э4-03, ТФ-ГЕН-01): формирует черновик справки через RAG-оркестратор ядра.
   Форма (тип → подразделение → нарушения) собирает структурированный запрос; генерация НАСТОЯЩАЯ:
   извлечение с фильтром доступа → модель → грунтовка (ТБ-040) → черновик (HITL, ТБ-042) → экспорт .docx.
   Подразделения — из ЖИВОГО справочника (§4.2), демо-список снят. *@
@page "/generator"
@rendermode InteractiveServer
@using ISC.AI.Abstractions.Application
@using ISC.AI.Abstractions.Grounding
@using ISC.AI.Profile.Inspector.Application.Features.Divisions
@using ISC.AI.Profile.Inspector.Application.Features.Generation
@using ISC.AI.Profile.Inspector.Domain.Services

<PageHeader Title="Генератор документов" Subtitle="Справки, акты, заключения"
            Icon="@Icons.Material.Filled.AutoAwesome" />

@* --- Шаги заполнения --- *@
<div class="d-flex gap-2 mb-4 flex-wrap">
    <MudChip T="string" Variant="@StepVariant(true)" Color="Color.Primary" Icon="@Icons.Material.Filled.LooksOne">
        Тип документа
    </MudChip>
    <MudChip T="string" Variant="@StepVariant(_division is not null)" Color="Color.Primary" Icon="@Icons.Material.Filled.LooksTwo">
        Подразделение
    </MudChip>
    <MudChip T="string" Variant="@StepVariant(!string.IsNullOrWhiteSpace(_violations))" Color="Color.Primary" Icon="@Icons.Material.Filled.Looks3">
        Нарушения
    </MudChip>
</div>

<MudGrid>
    @* ================= Левая колонка: параметры ================= *@
    <MudItem xs="12" md="7">
        @* --- Тип документа --- *@
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <SectionCaption Text="Тип документа" />
            <MudSelect T="string" @bind-Value="_docType" Variant="Variant.Outlined" Dense="true">
                @foreach (var type in DocumentTypes)
                {
                    <MudSelectItem T="string" Value="@type.Title" Disabled="@(!type.Implemented)">
                        @(type.Implemented ? type.Title : $"{type.Title} — скоро")
                    </MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                Первый реализуемый тип — справка (§5.2.1.1); остальные подключаются prompt-каркасом, без правок ядра.
            </MudText>
        </MudPaper>

        @* --- Подразделение --- *@
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <SectionCaption Text="Подразделение" />

            @* Живой справочник (§4.2): карточками — действующие корневые подразделения (ТУ и линейные),
               подчинённые РО показываются числом. Пустой справочник — подсказка вместо тупика. *@
            @if (RootDivisions.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Справочник подразделений пуст — заполните его на странице «Подразделения».
                </MudText>
            }
            <MudGrid Spacing="2">
                @foreach (var division in RootDivisions)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-3 cursor-pointer" Outlined="true" Style="@DivisionStyle(division)"
                                  @onclick="@(() => _division = division)">
                            <MudText Typo="Typo.body2"><b>@division.Name</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @(division.Code ?? "без кода")@(division.Children > 0 ? $" · {division.Children} РО" : string.Empty)
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_date" Label="Дата" Variant="Variant.Outlined" Editable="true"
                                   DateFormat="dd.MM.yyyy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_period" Label="Период" Variant="Variant.Outlined" Placeholder="2024 г." />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* --- Нарушения --- *@
        <MudPaper Class="pa-4" Outlined="true">
            <SectionCaption Text="Нарушения" />
            <MudTextField @bind-Value="_violations" Variant="Variant.Outlined" Lines="5" Immediate="true"
                          Disabled="_busy"
                          Placeholder="Опишите нарушения в произвольной форме:&#10;— отсутствие контакта с конфидентами&#10;— формальный подход к АОД" />

            <div class="d-flex gap-2 flex-wrap my-2">
                @foreach (var hint in ViolationHints)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                             OnClick="@(() => AddHint(hint))">@hint</MudChip>
                }
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="GenerateAsync" Disabled="@(_busy || !CanGenerate)">
                @(_busy ? "Формирую…" : "Сформировать документ")
            </MudButton>
        </MudPaper>
    </MudItem>

    @* ================= Правая колонка: результат ================= *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Извлекаю нормы по допуску, формирую черновик и проверяю ссылки грунтовкой…
                </MudText>
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (Result is null)
            {
                <EmptyState Icon="@Icons.Material.Filled.Description" MinHeight="280">
                    Заполните параметры слева<br />и нажмите «Сформировать»
                </EmptyState>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3">
                    ЧЕРНОВИК — требует проверки человеком (HITL, ТБ-042). Гриф результата: @Result.ResultClassification.
                </MudAlert>

                @if (!Result.AllCitationsConfirmed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        Не все ссылки подтверждены извлечёнными нормами — вывод НЕ считается готовым (GATE-2).
                    </MudAlert>
                }

                <MudButton Class="mb-3" Color="Color.Secondary" Variant="Variant.Filled" FullWidth="true"
                           OnClick="ExportAsync" Disabled="_exporting" StartIcon="@Icons.Material.Filled.Download">
                    @(_exporting ? "Экспорт…" : "Экспорт в .docx")
                </MudButton>

                <SectionCaption Text="Текст" Class="mb-1" />
                <MudPaper Class="pa-3 mb-3" Outlined="true">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Result.DraftText</MudText>
                </MudPaper>

                @if (Result.Citations.Count > 0)
                {
                    <SectionCaption Text="Ссылки (грунтовка)" Class="mb-1" />
                    @foreach (var citation in Result.Citations)
                    {
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(citation.Status)">
                                @StatusLabel(citation.Status)
                            </MudChip>
                            <MudText Typo="Typo.body2">@citation.Citation</MudText>
                        </div>
                    }
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Типы документов §5.2.1.1. Реализована пока только справка; остальные — новый prompt-каркас без правок ядра.
    private sealed record DocType(string Title, bool Implemented);

    private static readonly DocType[] DocumentTypes =
    [
        new("Справка об итогах проверки", true),
        new("Акт проверки", false),
        new("Рапорт", false),
        new("Докладная записка", false),
        new("Заключение", false),
        new("Проект приказа", false),
    ];

    private static readonly string[] ViolationHints = ["Агентурная", "АОД", "Нацменьшинства", "Соц. напряжённость"];

    private string _docType = "Справка об итогах проверки";
    private readonly List<DivisionNode> _divisions = [];
    private DivisionNode? _division;
    private DateTime? _date = DateTime.Today;
    private string _period = "2024 г.";
    private string _violations = string.Empty;

    private bool _busy;
    private bool _exporting;
    private string? _error;
    private ResponseDto<GenerateReferenceResult>? _response;

    private GenerateReferenceResult? Result => _response?.Data;

    private bool CanGenerate => _division is not null && !string.IsNullOrWhiteSpace(_violations);

    private IReadOnlyList<DivisionNode> RootDivisions =>
        [.. _divisions.Where(d => d.ParentId is null && d.IsActive)];

    protected override async Task OnInitializedAsync()
    {
        var response = await Dispatcher.Send(new ListDivisionTreeQuery());
        if (response is { Status: true, Data: { } list })
        {
            _divisions.AddRange(list);
        }
    }

    private static Variant StepVariant(bool filled) => filled ? Variant.Filled : Variant.Outlined;

    private string DivisionStyle(DivisionNode division) =>
        ReferenceEquals(_division, division)
            ? "border-color: var(--mud-palette-primary); border-left: 3px solid var(--mud-palette-primary);"
            : string.Empty;

    private void AddHint(string hint) =>
        _violations = string.IsNullOrWhiteSpace(_violations) ? $"— {hint}: " : $"{_violations}\n— {hint}: ";

    // Параметры формы собираются в структурированный запрос для RAG-оркестратора (задачный промпт — в профиле).
    private string BuildTopic() =>
        $"{_docType}. Подразделение: {_division?.Name}"
        + $"{(_division?.Code is { } code ? $" (код {code})" : string.Empty)}. "
        + $"Период: {_period}. Дата: {_date:dd.MM.yyyy}. Выявленные нарушения: {_violations}";

    private async Task GenerateAsync()
    {
        _busy = true;
        _error = null;
        _response = null;
        try
        {
            var response = await Dispatcher.Send(new GenerateReferenceCommand(BuildTopic()));
            if (response.Status)
            {
                _response = response;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка генерации: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (Result is null)
        {
            return;
        }

        _exporting = true;
        _error = null;
        try
        {
            var response = await Dispatcher.Send(
                new ExportReferenceCommand(_docType, Result.DraftText, Result.ResultClassification));

            if (response is { Status: true, Data: { } file })
            {
                using var streamReference = new DotNetStreamReference(new MemoryStream(file.Content));
                await JS.InvokeVoidAsync("downloadFileFromStream", file.FileName, streamReference);
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка экспорта: {ex.Message}";
        }
        finally
        {
            _exporting = false;
        }
    }

    private static Color StatusColor(CitationStatus status) => status switch
    {
        CitationStatus.Confirmed => Color.Success,
        CitationStatus.Superseded => Color.Warning,
        _ => Color.Error,
    };

    private static string StatusLabel(CitationStatus status) => status switch
    {
        CitationStatus.Confirmed => "подтверждена",
        CitationStatus.Superseded => "УТРАТИЛА СИЛУ",
        _ => "не подтверждена",
    };
}
