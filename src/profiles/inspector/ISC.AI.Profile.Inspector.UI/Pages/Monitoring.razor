@namespace ISC.AI.Profile.Inspector.UI
@page "/monitoring"
@rendermode InteractiveServer
@using ISC.AI.Profile.Inspector.Application.Features.Monitoring
@using ISC.AI.Profile.Inspector.Domain.Enums
@using ISC.AI.Profile.Inspector.Domain.Services

@* Модуль «Мониторинг» (§5.2.6) на ЖИВОМ учёте нарушений (Э5-01) — демо снято. Прогресс устранения —
   детерминированная свёртка статусов (устранено=100, частично=50, на контроле=25, просрочено=0):
   отдельного поля «процент» в учёте нет, статус ведёт человек. *@

<PageHeader Title="Мониторинг нарушений"
            Subtitle="Система контроля устранения нарушений и эффективности подразделений"
            Icon="@Icons.Material.Filled.MonitorHeart">
    <MudSelect T="int" Value="_periodDays" ValueChanged="ChangePeriodAsync" Label="Период"
               Variant="Variant.Outlined" Dense="true" Style="width:180px;">
        <MudSelectItem T="int" Value="30">30 дней</MudSelectItem>
        <MudSelectItem T="int" Value="90">90 дней</MudSelectItem>
        <MudSelectItem T="int" Value="180">Полгода</MudSelectItem>
        <MudSelectItem T="int" Value="365">Год</MudSelectItem>
    </MudSelect>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@* --- Показатели: все считаются из живой сводки, ни одна цифра не вписана --- *@
<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@Total" Label="Нарушений на мониторинге" Accent="var(--mud-palette-info)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@Resolved" Label="Устранено" Accent="@StatusColor(RemediationStatus.Resolved)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@Overdue" Label="Просрочено" Accent="@StatusColor(RemediationStatus.Overdue)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@($"{AverageProgress}%")" Label="Средний прогресс устранения"
                  Accent="var(--mud-palette-warning)" />
    </MudItem>
</MudGrid>

<MudGrid>
    @* ================= Мониторинг устранения ================= *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Мониторинг устранения нарушений" />

            <FilterChipRow TValue="RemediationStatus" AllCount="@Rows.Count"
                           Items="@FilterItems" Selected="@_filter"
                           SelectedChanged="@((RemediationStatus? v) => _filter = v)" />

            @if (Rows.Count == 0 && !_busy)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                    За период нарушений не занесено — контролировать нечего. Карточки наполняются
                    из модуля «Учёт нарушений».
                </MudText>
            }
            @foreach (var item in Filtered)
            {
                <AccentRow Accent="@StatusColor(item.RemediationStatus)">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body1" Class="flex-grow-1"><b>@item.DivisionName</b></MudText>
                        <TintedChip Color="@SeverityHex(item.Severity)">@item.Severity.Label()</TintedChip>
                        <TintedChip Color="@StatusColor(item.RemediationStatus)">
                            @item.RemediationStatus.Label()
                        </TintedChip>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@item.CategoryName</MudText>
                    <div class="mt-1 d-flex align-center gap-3 flex-wrap">
                        <IconCaption Icon="@Icons.Material.Filled.CalendarMonth">
                            Выявлено: @item.DetectedAt.ToString("dd.MM.yyyy")
                        </IconCaption>
                        @if (item.RemediationDeadline is { } deadline)
                        {
                            <IconCaption Icon="@Icons.Material.Filled.Schedule">
                                Срок: @deadline.ToString("dd.MM.yyyy")
                            </IconCaption>
                        }
                    </div>
                    <ColorBar Percent="@Progress(item.RemediationStatus)" Color="@StatusColor(item.RemediationStatus)" />
                    @if (item.Recommendation is { } recommendation)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@recommendation</MudText>
                    }
                </AccentRow>
            }
        </MudPaper>
    </MudItem>

    @* ================= Аналитика эффективности ================= *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Аналитика эффективности" Class="mb-3" />

            @if (Divisions.Count == 0 && !_busy)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Появится, когда по подразделениям будут занесены нарушения.
                </MudText>
            }
            @foreach (var division in Divisions)
            {
                <ProgressStat Label="@division.DivisionName" Percent="@DivisionProgress(division)"
                              Color="@ProgressColor(DivisionProgress(division))" />
            }

            <ActionHintButton Text="Аналитический отчёт для руководства" Class="mt-4">
                <Hint>
                    Отчёт будет формироваться Генератором через grounded-конвейер: цифры берутся из БД
                    (детерминированно), ИИ пишет только текст, ссылки на НПА проходят грунтовку,
                    результат — черновик для проверки человеком.
                </Hint>
            </ActionHintButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Порядок фильтров — по остроте: просроченные важнее устранённых.
    private static readonly RemediationStatus[] FilterStatuses =
        [RemediationStatus.Overdue, RemediationStatus.Partial, RemediationStatus.UnderControl, RemediationStatus.Resolved];

    private RemediationSummary? _summary;
    private int _periodDays = 90;
    private RemediationStatus? _filter;
    private bool _busy;
    private string? _error;

    private IReadOnlyList<RemediationRow> Rows => _summary?.Rows ?? [];

    private IReadOnlyList<DivisionRemediationRow> Divisions => _summary?.Divisions ?? [];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ChangePeriodAsync(int days)
    {
        _periodDays = days;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new GetRemediationQuery(_periodDays));
            if (response is { Status: true, Data: { } summary })
            {
                _summary = summary;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<RemediationRow> Filtered =>
        _filter is null ? Rows : Rows.Where(r => r.RemediationStatus == _filter);

    // Чипы фильтра статусов: подпись, цвет и количество считаются из живой сводки при каждом рендере.
    private IReadOnlyList<FilterChipItem<RemediationStatus>> FilterItems =>
        [.. FilterStatuses.Select(s => new FilterChipItem<RemediationStatus>(s, s.Label(), StatusColor(s), CountOf(s)))];

    private int CountOf(RemediationStatus status) => Rows.Count(r => r.RemediationStatus == status);

    // Счётчики шапки — по подразделениям (полные), а не по карточкам (срез до 100).
    private int Total => Divisions.Sum(d => d.Total);

    private int Resolved => Divisions.Sum(d => d.Resolved);

    private int Overdue => Divisions.Sum(d => d.Overdue);

    // Прогресс — детерминированная свёртка статусов: устранено=100, частично=50, на контроле=25, просрочено=0.
    private static int Progress(RemediationStatus status) => status switch
    {
        RemediationStatus.Resolved => 100,
        RemediationStatus.Partial => 50,
        RemediationStatus.UnderControl => 25,
        _ => 0,
    };

    private static int DivisionProgress(DivisionRemediationRow division) =>
        division.Total == 0 ? 0 : (int)Math.Round(
            (division.Resolved * 100.0 + division.Partial * 50.0 + division.UnderControl * 25.0) / division.Total);

    private int AverageProgress =>
        Total == 0 ? 0 : (int)Math.Round(
            (Resolved * 100.0 + Divisions.Sum(d => d.Partial) * 50.0 + Divisions.Sum(d => d.UnderControl) * 25.0) / Total);

    private static string StatusColor(RemediationStatus status) => status switch
    {
        RemediationStatus.Resolved => "#22c55e",
        RemediationStatus.UnderControl => "#3b82f6",
        RemediationStatus.Partial => "#eab308",
        _ => "#ef4444",
    };

    // Оттенки тяжести согласованы с реестром нарушений (низкая — нейтральный серый).
    private static string SeverityHex(ViolationSeverity severity) => severity switch
    {
        ViolationSeverity.Low => "#6b7280",
        ViolationSeverity.Medium => "#3b82f6",
        ViolationSeverity.High => "#f97316",
        _ => "#ef4444",
    };

    // Цвет полосы прогресса — по величине, а не по статусу (видно «слабых» и «сильных» на глаз).
    private static string ProgressColor(int progress) =>
        progress >= 100 ? "#22c55e" : progress >= 60 ? "#3b82f6" : progress >= 30 ? "#eab308" : "#ef4444";
}
