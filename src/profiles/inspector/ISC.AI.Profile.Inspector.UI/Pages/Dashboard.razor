@namespace ISC.AI.Profile.Inspector.UI
@page "/dashboard"
@rendermode InteractiveServer

@* Модуль «Дашборд» (ТФ-ДШ-01/02). ВНИМАНИЕ: данные ПОКАЗАТЕЛЬНЫЕ (демо) — реальных записей ещё нет,
   домен «Нарушение» создан, но пуст. Демо-маркер обязан быть виден (плашка ниже + чип в оболочке).
   Цвет светофора — свёртка 4 уровней риска в 3 цвета (Приложение §2), считает код, не ИИ. *@

<PageHeader Title="Дашборд" Subtitle="Сводная картина по подразделениям — обзор"
            Icon="@Icons.Material.Filled.Dashboard" />

<DemoAlert>@InspectorDemoData.Notice</DemoAlert>

@* --- Показатели --- *@
<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@InspectorDemoData.TotalChecks" Label="Всего проверок" Accent="var(--mud-palette-info)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@InspectorDemoData.CriticalViolations" Label="Критических нарушений" Accent="var(--mud-palette-error)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@InspectorDemoData.NotRemediated" Label="Не устранено" Accent="var(--mud-palette-warning)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@InspectorDemoData.Remediated" Label="Устранено" Accent="var(--mud-palette-success)" />
    </MudItem>
</MudGrid>

<MudGrid Class="mb-2">
    @* --- Последние проверки --- *@
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Последние проверки" Class="mb-3" />
            @foreach (var check in InspectorDemoData.RecentChecks)
            {
                <AccentRow Class="pa-3 mb-2 d-flex align-center gap-3">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1"><b>@check.Title</b></MudText>
                        <div class="d-flex align-center gap-3 mt-1">
                            <IconCaption Icon="@Icons.Material.Filled.CalendarMonth">@check.Date</IconCaption>
                            <IconCaption Icon="@Icons.Material.Filled.Place">@check.Location</IconCaption>
                        </div>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(check.Status)">
                        @check.Status
                    </MudChip>
                </AccentRow>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        @* --- Статус устранения --- *@
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <SectionCaption Text="Статус устранения" Class="mb-3" />
            @foreach (var stat in InspectorDemoData.Remediation)
            {
                <ProgressStat Label="@stat.Label" Percent="@stat.Percent"
                              Value="@stat.Count.ToString()" Color="@StatusCss(stat.Label)" />
            }
        </MudPaper>

        @* --- Быстрый старт --- *@
        <MudPaper Class="pa-4" Outlined="true">
            <SectionCaption Text="Быстрый старт" Class="mb-3" />
            <MudStack Spacing="2">
                <MudButton Href="/generator" Variant="Variant.Outlined" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.AutoAwesome" Class="justify-start">
                    Генератор документов
                </MudButton>
                <MudButton Href="/npa" Variant="Variant.Outlined" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Gavel" Class="justify-start">
                    Поиск по НПА
                </MudButton>
                <MudButton Href="/archive" Variant="Variant.Outlined" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Inventory2" Class="justify-start">
                    Архив проверок
                </MudButton>
                <MudButton Href="/collegium" Variant="Variant.Outlined" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Groups" Class="justify-start">
                    Подготовка к коллегии
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@* --- Подразделения --- *@
<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Территориальные управления" />
            <DivisionsTable Rows="@InspectorDemoData.Territorial" NoteAsColumn="true" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Линейные подразделения" />
            <DivisionsTable Rows="@InspectorDemoData.Linear" />
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Цвет статуса устранения: согласован со свёрткой уровней риска в 3 цвета (Приложение §2).
    private static Color StatusColor(string status) => status switch
    {
        "Устранено" => Color.Success,
        "Частично устранено" => Color.Warning,
        "На контроле" => Color.Info,
        _ => Color.Error,
    };

    // Тот же маппинг статусов, но в CSS-цвета палитры — для полос ProgressStat (ColorBar красится CSS-цветом).
    private static string StatusCss(string status) => status switch
    {
        "Устранено" => "var(--mud-palette-success)",
        "Частично устранено" => "var(--mud-palette-warning)",
        "На контроле" => "var(--mud-palette-info)",
        _ => "var(--mud-palette-error)",
    };
}
