@namespace ISC.AI.Profile.Inspector.UI
@page "/collegium"
@rendermode InteractiveServer
@using ISC.AI.Abstractions.Application
@using ISC.AI.Abstractions.Grounding
@using ISC.AI.Profile.Inspector.Application.Features.Collegium
@using ISC.AI.Profile.Inspector.Application.Features.Generation
@using Microsoft.JSInterop
@inject EditorDraftHandoff EditorHandoff
@inject NavigationManager Navigation

@* Модуль «Коллегия» (§5.2.8, ТФ-КОЛ-01/02) — заглушка снята. Три вида материалов к заседанию/совещанию
   (доклад, проект решения, материалы руководству) на ОДНОМ факт-блоке с отчётом руководству:
   все числа считает код из живого учёта, ИИ быстрой ролью пишет только текст под структуру вида.
   Судьба материала — экспорт/Редактор/регистрация, как у всех ИИ-документов. *@

<PageHeader Title="Коллегия"
            Subtitle="Доклад, проект решения и материалы к совещанию — на данных системы"
            Icon="@Icons.Material.Filled.Groups" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <SectionCaption Text="Что готовим" Class="mb-2" />
    <div class="d-flex gap-3 align-end flex-wrap">
        <MudSelect T="CollegiumMaterialKind" @bind-Value="_kind" Label="Вид материала"
                   Variant="Variant.Outlined" Dense="true" Style="min-width:320px;">
            <MudSelectItem T="CollegiumMaterialKind" Value="CollegiumMaterialKind.Report">
                Доклад на заседание коллегии
            </MudSelectItem>
            <MudSelectItem T="CollegiumMaterialKind" Value="CollegiumMaterialKind.DraftDecision">
                Проект решения коллегии
            </MudSelectItem>
            <MudSelectItem T="CollegiumMaterialKind" Value="CollegiumMaterialKind.Briefing">
                Материалы к совещанию руководства
            </MudSelectItem>
        </MudSelect>
        <MudSelect T="int" @bind-Value="_periodDays" Label="Период" Variant="Variant.Outlined"
                   Dense="true" Style="width:180px;">
            <MudSelectItem T="int" Value="30">30 дней</MudSelectItem>
            <MudSelectItem T="int" Value="90">90 дней</MudSelectItem>
            <MudSelectItem T="int" Value="180">Полгода</MudSelectItem>
            <MudSelectItem T="int" Value="365">Год</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateAsync"
                   Disabled="_busy" StartIcon="@Icons.Material.Filled.AutoAwesome">
            @(_busy ? "Формирую…" : "Сформировать")
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
        Числа в материале — детерминированный расчёт системы (те же, что на экранах Рисков
        и Мониторинга); ИИ пишет только связующий текст. Сроки в проекте решения ИИ не назначает —
        оставляет место для заполнения человеком.
    </MudText>
</MudPaper>

@if (Result is { } result)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3">
        ПРОЕКТ — подписывает человек (ТБ-042). Гриф: @result.ResultClassification.
        Числа материала — детерминированный расчёт системы, ИИ писал только текст.
    </MudAlert>
    @if (_registeredId is { } registeredId)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Зарегистрировано в документообороте (№ записи @registeredId) — модуль «Документы».
        </MudAlert>
    }

    <div style="max-height:60vh; overflow-y:auto;" class="mb-3">
        <DocumentSheet Title="@KindTitle(_generatedKind)"
                       Subtitle="@($"за последние {_generatedPeriodDays} дней")"
                       Body="@result.DraftText" EmblemUrl="@NpaDocument.EmblemUrl" />
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <MudButton OnClick="ExportAsync" Disabled="_exporting" Variant="Variant.Outlined">
            Экспорт .docx
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.EditNote" Variant="Variant.Outlined"
                   OnClick="OpenInEditor">
            Доработать в Редакторе
        </MudButton>
        @if (_registeredId is null)
        {
            <MudTooltip Text="@(result.AllCitationsConfirmed ? string.Empty : "Есть неподтверждённые ссылки (GATE-2) — доработайте в Редакторе.")">
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="@(() => _registerOpen = true)"
                           Disabled="@(!result.AllCitationsConfirmed)">
                    Зарегистрировать
                </MudButton>
            </MudTooltip>
        }
    </div>
}

<RegisterGeneratedDialog @bind-Visible="_registerOpen" Origin="Коллегия"
                         DefaultTitle="@($"{KindTitle(_generatedKind)} за {_generatedPeriodDays} дней")"
                         Body="@(Result?.DraftText ?? string.Empty)"
                         Classification="@(Result?.ResultClassification ?? 0)"
                         Citations="@(Result?.Citations ?? [])"
                         OnRegistered="@(id => _registeredId = id)" />

@code {
    private CollegiumMaterialKind _kind = CollegiumMaterialKind.Report;
    private int _periodDays = 90;

    // Что именно сформировано: заголовок листа не должен меняться от того, что пользователь
    // перещёлкнул селекты ПОСЛЕ генерации.
    private CollegiumMaterialKind _generatedKind = CollegiumMaterialKind.Report;
    private int _generatedPeriodDays = 90;

    private bool _busy;
    private bool _exporting;
    private bool _registerOpen;
    private int? _registeredId;
    private string? _error;
    private ResponseDto<GenerateReferenceResult>? _response;

    private GenerateReferenceResult? Result => _response?.Data;

    private async Task GenerateAsync()
    {
        _busy = true;
        _error = null;
        _response = null;
        _registeredId = null;
        try
        {
            var response = await Dispatcher.Send(new GenerateCollegiumMaterialCommand(_kind, _periodDays));
            if (response.Status)
            {
                _response = response;
                _generatedKind = _kind;
                _generatedPeriodDays = _periodDays;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка формирования: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (Result is not { } result)
        {
            return;
        }

        _exporting = true;
        try
        {
            var response = await Dispatcher.Send(new ExportReferenceCommand(
                $"{KindTitle(_generatedKind)} за {_generatedPeriodDays} дней",
                result.DraftText, result.ResultClassification));
            if (response is { Status: true, Data: { } file })
            {
                using var streamReference = new DotNetStreamReference(new MemoryStream(file.Content));
                await JS.InvokeVoidAsync("downloadFileFromStream", file.FileName, streamReference);
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _exporting = false;
        }
    }

    private void OpenInEditor()
    {
        if (Result is { } result)
        {
            EditorHandoff.Put(result.DraftText, null);
            Navigation.NavigateTo("/editor");
        }
    }

    private static string KindTitle(CollegiumMaterialKind kind) => kind switch
    {
        CollegiumMaterialKind.Report => "Доклад на заседание коллегии",
        CollegiumMaterialKind.DraftDecision => "Проект решения коллегии",
        _ => "Материалы к совещанию руководства",
    };
}
