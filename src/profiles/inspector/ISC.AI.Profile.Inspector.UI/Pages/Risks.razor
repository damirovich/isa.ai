@namespace ISC.AI.Profile.Inspector.UI
@page "/risks"
@rendermode InteractiveServer
@using ISC.AI.Abstractions.Application
@using ISC.AI.Abstractions.Grounding
@using ISC.AI.Profile.Inspector.Application.Features.Generation
@using ISC.AI.Profile.Inspector.Application.Features.Methods
@using ISC.AI.Profile.Inspector.Application.Features.Risks
@using ISC.AI.Profile.Inspector.Domain.Enums
@using ISC.AI.Profile.Inspector.Domain.Services
@using Microsoft.JSInterop
@inject EditorDraftHandoff EditorHandoff
@inject NavigationManager Navigation

@* Модуль «Риски и внутренний контроль» (§5.2.5.1) на ЖИВОМ учёте нарушений (Э5-01) — демо снято.
   Балл каждого подразделения считает RiskScoreCalculator по формуле Приложения §2 (детерминированно,
   код, не ИИ); здесь сигналы формулы показываются по отдельности — виден разбор, а не только итог.
   ТФ-РСК-02: проект правил/критериев оценки формирует ИИ ролью Draft из показателей, которые
   система реально считает (ControlRulesFacts) — вкладка «Правила контроля». *@

<PageHeader Title="Риски и внутренний контроль"
            Subtitle="Выявление рисков, правила и процедуры контроля"
            Icon="@Icons.Material.Filled.Warning">
    <MudSelect T="int" Value="_periodDays" ValueChanged="ChangePeriodAsync" Label="Период"
               Variant="Variant.Outlined" Dense="true" Style="width:180px;">
        <MudSelectItem T="int" Value="30">30 дней</MudSelectItem>
        <MudSelectItem T="int" Value="90">90 дней</MudSelectItem>
        <MudSelectItem T="int" Value="180">Полгода</MudSelectItem>
        <MudSelectItem T="int" Value="365">Год</MudSelectItem>
    </MudSelect>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@* --- Показатели --- *@
<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@_risks.Count" Label="Подразделений с нарушениями" Accent="var(--mud-palette-info)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Critical, RiskLevel.High)" Label="Критичных / высоких"
                  Accent="@LevelColor(RiskLevel.Critical)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Medium)" Label="Средних рисков" Accent="@LevelColor(RiskLevel.Medium)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Low)" Label="Низких рисков" Accent="@LevelColor(RiskLevel.Low)" />
    </MudItem>
</MudGrid>

<MudGrid>
    @* ================= Реестр ================= *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Реестр рисков подразделений" />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-1">
                <MudTabPanel Text="Реестр рисков" Icon="@Icons.Material.Filled.Warning">
                    @* --- Фильтр по уровню --- *@
                    <FilterChipRow TValue="RiskLevel" Label="Уровень:" AllCount="@_risks.Count"
                                   Items="@FilterItems" Selected="@_filter"
                                   SelectedChanged="@((RiskLevel? v) => _filter = v)" />

                    @if (_risks.Count == 0 && !_busy)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">
                            За период нарушений не занесено — рисков нет. Реестр наполняется
                            из модуля «Учёт нарушений».
                        </MudText>
                    }
                    @foreach (var item in Filtered)
                    {
                        <AccentRow Accent="@LevelColor(item.Assessment.Level)"
                                   Selected="@ReferenceEquals(_selected, item)"
                                   OnClick="@(() => _selected = item)">
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.body1" Class="flex-grow-1">
                                    <b>@item.DivisionName</b>
                                </MudText>
                                <TintedChip Color="@LevelColor(item.Assessment.Level)">
                                    @item.Assessment.Level.Label()
                                </TintedChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                Нарушений за период: @item.ViolationCount, из них открытых: @item.OpenCount ·
                                @string.Join(" · ", item.TopSpheres)
                            </MudText>
                            @if (item.LastRecommendation is { } recommendation)
                            {
                                <MudText Typo="Typo.caption" Style="@($"color:{LevelColor(RiskLevel.Low)};")" Class="mt-1 d-block">
                                    → @recommendation
                                </MudText>
                            }
                        </AccentRow>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Правила контроля" Icon="@Icons.Material.Filled.Rule">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary my-3">
                        Показатели оценки работы подразделения — детерминированные, каждый трассируется к полю
                        источника (§5.2.5.2). Оценка «как работает» отлична от уровня риска.
                    </MudText>
                    @foreach (var rule in InspectorDemoData.ControlRules)
                    {
                        <MudPaper Class="pa-3 mb-2" Outlined="true">
                            <MudText Typo="Typo.body2"><b>@rule.Title</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@rule.Note</MudText>
                        </MudPaper>
                    }

                    @* --- ТФ-РСК-02: проект правил и критериев из показателей системы --- *@
                    <MudDivider Class="my-3" />
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateRulesAsync"
                                   Disabled="_rulesBusy" StartIcon="@Icons.Material.Filled.AutoAwesome">
                            @(_rulesBusy ? "Формирую…" : "Проект правил и критериев (ИИ)")
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="max-width:420px;">
                            Показатели — только те, что система реально считает; пороги ИИ не назначает,
                            их утверждает человек. Период — как выбран на странице.
                        </MudText>
                    </div>

                    @if (Rules is { } rules)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="my-3">
                            ПРОЕКТ — утверждает человек (ТБ-042). Гриф: @rules.ResultClassification.
                        </MudAlert>
                        @if (_savedMethodId is { } savedId)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                Сохранено в реестр методик (№ @savedId) — страница «Методики проверок».
                            </MudAlert>
                        }
                        <div style="max-height:55vh; overflow-y:auto;" class="mb-3">
                            <DocumentSheet Title="Проект правил внутреннего контроля и критериев оценки"
                                           Subtitle="@($"по показателям за последние {_rulesGeneratedDays} дней")"
                                           Body="@rules.DraftText" EmblemUrl="@NpaDocument.EmblemUrl" />
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (_savedMethodId is null)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveRulesToRegistryAsync" Disabled="_savingRules">
                                    Сохранить в реестр методик
                                </MudButton>
                            }
                            <MudButton OnClick="ExportRulesAsync" Disabled="_exportingRules" Variant="Variant.Outlined">
                                Экспорт .docx
                            </MudButton>
                            <MudButton StartIcon="@Icons.Material.Filled.EditNote" Variant="Variant.Outlined"
                                       OnClick="OpenRulesInEditor">
                                Доработать в Редакторе
                            </MudButton>
                            <MudButton OnClick="@(() => _rulesResponse = null)">Скрыть</MudButton>
                        </div>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Генерация документов" Icon="@Icons.Material.Filled.AutoAwesome">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-3">
                        Аналитическая записка по рискам формируется тем же grounded-конвейером Генератора:
                        ссылки на НПА проходят грунтовку, результат — черновик для проверки человеком.
                        Сам балл риска при этом остаётся детерминированным — ИИ пишет только текст.
                    </MudAlert>
                    <MudButton Href="/generator" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome">Перейти в Генератор</MudButton>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>

    @* ================= Детали ================= *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            @if (_selected is null)
            {
                <EmptyState Icon="@Icons.Material.Filled.Warning">
                    Выберите подразделение из реестра —<br />покажу, из чего сложился его балл
                </EmptyState>
            }
            else
            {
                <SectionCaption Text="Риск" />
                <MudText Typo="Typo.h6">@_selected.DivisionName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Нарушений за период: @_selected.ViolationCount
                </MudText>

                <div class="d-flex align-center gap-2 mb-3">
                    <TintedChip Color="@LevelColor(_selected.Assessment.Level)">
                        @_selected.Assessment.Level.Label()
                    </TintedChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                        балл @_selected.Assessment.Score.ToString("0.#")
                    </MudChip>
                </div>

                <SectionCaption Text="Болевые точки (сферы)" Class="" />
                <MudText Typo="Typo.body2" Class="mb-3">@string.Join(" · ", _selected.TopSpheres)</MudText>

                @if (_selected.LastRecommendation is { } recommendation)
                {
                    <SectionCaption Text="Последняя рекомендация" Class="" />
                    <MudText Typo="Typo.body2" Class="mb-3">@recommendation</MudText>
                }

                @* Разбор балла — показывает, что уровень получен формулой, а не назначен вручную. *@
                <SectionCaption Text="Из чего сложился балл" Class="mb-1" />
                <KeyValueTable Rows="@ScoreRows" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    Веса и пороги — конфигурируемы, калибруются на этапе Э1 (см. методику расчёта риска).
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly RiskLevel[] AllLevels =
        [RiskLevel.Critical, RiskLevel.High, RiskLevel.Medium, RiskLevel.Low];

    private readonly List<DivisionRiskDetail> _risks = [];
    private int _periodDays = 90;
    private RiskLevel? _filter;
    private DivisionRiskDetail? _selected;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ChangePeriodAsync(int days)
    {
        _periodDays = days;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            var response = await Dispatcher.Send(new GetDivisionRisksQuery(_periodDays));
            _risks.Clear();
            _selected = null;
            if (response is { Status: true, Data: { } list })
            {
                _risks.AddRange(list);
            }
            else if (response is { Status: false })
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<DivisionRiskDetail> Filtered =>
        _filter is null ? _risks : _risks.Where(r => r.Assessment.Level == _filter);

    /// <summary>Чипы фильтра по уровню: подпись, цвет и количество записей на каждый уровень.</summary>
    private IReadOnlyList<FilterChipItem<RiskLevel>> FilterItems =>
        [.. AllLevels.Select(l => new FilterChipItem<RiskLevel>(l, l.Label(), LevelColor(l), CountOf(l)))];

    /// <summary>Строки «Из чего сложился балл» — сигналы формулы Приложения §2 из живого учёта.</summary>
    private IReadOnlyList<(string Label, string Value)> ScoreRows => _selected is null ? [] :
    [
        ("Открытых нарушений (объём×тяжесть)", _selected.OpenCount.ToString()),
        ("Повторяемость", _selected.RepeatCount.ToString()),
        ("Просроченных устранений", _selected.OverdueCount.ToString()),
        ("Тренд к пред. периоду", _selected.TrendDelta.ToString()),
    ];

    private int CountOf(params RiskLevel[] levels) => _risks.Count(r => levels.Contains(r.Assessment.Level));

    // --- ТФ-РСК-02: проект правил и критериев оценки ---
    private int _rulesGeneratedDays = 90; // период на момент генерации: смена периода после — не меняет лист
    private bool _rulesBusy;
    private bool _exportingRules;
    private bool _savingRules;
    private int? _savedMethodId;
    private ResponseDto<GenerateReferenceResult>? _rulesResponse;

    private GenerateReferenceResult? Rules => _rulesResponse?.Data;

    private async Task GenerateRulesAsync()
    {
        _rulesBusy = true;
        _error = null;
        _rulesResponse = null;
        _savedMethodId = null;
        try
        {
            var response = await Dispatcher.Send(new GenerateControlRulesCommand(_periodDays));
            if (response.Status)
            {
                _rulesResponse = response;
                _rulesGeneratedDays = _periodDays;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка формирования: {ex.Message}";
        }
        finally
        {
            _rulesBusy = false;
        }
    }

    // Правила — методический документ (Ц-03): судьба та же, что у методик, — реестр с утверждением.
    private async Task SaveRulesToRegistryAsync()
    {
        if (Rules is not { } rules)
        {
            return;
        }

        _savingRules = true;
        try
        {
            var response = await Dispatcher.Send(new SaveMethodDocumentCommand(
                "Правила контроля", "Внутренний контроль",
                $"критерии оценки подразделений (по показателям за {_rulesGeneratedDays} дней)",
                rules.DraftText, rules.Citations, rules.AllCitationsConfirmed, rules.ResultClassification));
            if (response is { Status: true, Data: var savedId })
            {
                _savedMethodId = savedId;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _savingRules = false;
        }
    }

    private async Task ExportRulesAsync()
    {
        if (Rules is not { } rules)
        {
            return;
        }

        _exportingRules = true;
        try
        {
            var response = await Dispatcher.Send(new ExportReferenceCommand(
                "Проект правил внутреннего контроля и критериев оценки",
                rules.DraftText, rules.ResultClassification));
            if (response is { Status: true, Data: { } file })
            {
                using var streamReference = new DotNetStreamReference(new MemoryStream(file.Content));
                await JS.InvokeVoidAsync("downloadFileFromStream", file.FileName, streamReference);
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        finally
        {
            _exportingRules = false;
        }
    }

    private void OpenRulesInEditor()
    {
        if (Rules is { } rules)
        {
            EditorHandoff.Put(rules.DraftText, null);
            Navigation.NavigateTo("/editor");
        }
    }

    // 4 уровня — 4 оттенка (на дашборде они сворачиваются в 3 цвета светофора, Приложение §2).
    private static string LevelColor(RiskLevel level) => level switch
    {
        RiskLevel.Critical => "#ef4444",
        RiskLevel.High => "#f97316",
        RiskLevel.Medium => "#eab308",
        _ => "#22c55e",
    };
}
