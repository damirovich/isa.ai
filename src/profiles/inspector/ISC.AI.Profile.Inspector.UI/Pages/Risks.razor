@namespace ISC.AI.Profile.Inspector.UI
@page "/risks"
@rendermode InteractiveServer
@using ISC.AI.Profile.Inspector.Domain.Enums
@using ISC.AI.Profile.Inspector.Domain.Risk
@inject RiskScoreCalculator Calculator

@* Модуль «Риски и внутренний контроль» (§5.2.5.1). ВАЖНО: уровень риска на экране НЕ нарисован — его
   считает настоящий RiskScoreCalculator по формуле Приложения §2 (детерминированно, код, не ИИ).
   ДЕМО — только исходные сигналы (нарушения/повторы/просрочки/тренд), пока inspector.violation пуст. *@

<PageHeader Title="Риски и внутренний контроль"
            Subtitle="Выявление рисков, правила и процедуры контроля"
            Icon="@Icons.Material.Filled.Warning" />

<DemoAlert>
    Исходные данные показательные (ДЕМО) — <c>inspector.violation</c> ещё не наполнен. Но сам <b>уровень риска
    вычисляет настоящая детерминированная формула</b> (Приложение §2), а не константа: балл = w1·Σтяжесть +
    w2·повторы + w3·просрочки + w4·тренд. ИИ здесь не участвует.
</DemoAlert>

@* --- Показатели --- *@
<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@_assessed.Count" Label="Выявленных рисков" Accent="var(--mud-palette-info)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Critical, RiskLevel.High)" Label="Критичных / высоких"
                  Accent="@LevelColor(RiskLevel.Critical)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Medium)" Label="Средних рисков" Accent="@LevelColor(RiskLevel.Medium)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Value="@CountOf(RiskLevel.Low)" Label="Низких рисков" Accent="@LevelColor(RiskLevel.Low)" />
    </MudItem>
</MudGrid>

<MudGrid>
    @* ================= Реестр ================= *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Реестр рисков подразделений" />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-1">
                <MudTabPanel Text="Реестр рисков" Icon="@Icons.Material.Filled.Warning">
                    @* --- Фильтр по уровню --- *@
                    <FilterChipRow TValue="RiskLevel" Label="Уровень:" AllCount="@_assessed.Count"
                                   Items="@FilterItems" Selected="@_filter"
                                   SelectedChanged="@((RiskLevel? v) => _filter = v)" />

                    @foreach (var item in Filtered)
                    {
                        <AccentRow Accent="@LevelColor(item.Assessment.Level)"
                                   Selected="@ReferenceEquals(_selected, item)"
                                   OnClick="@(() => _selected = item)">
                            <div class="d-flex align-center gap-2">
                                <MudText Typo="Typo.body1" Class="flex-grow-1">
                                    <b>@item.Entry.Division — @item.Entry.Area</b>
                                </MudText>
                                <TintedChip Color="@LevelColor(item.Assessment.Level)">
                                    @LevelLabel(item.Assessment.Level)
                                </TintedChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@item.Entry.Description</MudText>
                            <MudText Typo="Typo.caption" Style="@($"color:{LevelColor(RiskLevel.Low)};")" Class="mt-1 d-block">
                                → @item.Entry.Recommendation
                            </MudText>
                        </AccentRow>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Правила контроля" Icon="@Icons.Material.Filled.Rule">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary my-3">
                        Показатели оценки работы подразделения — детерминированные, каждый трассируется к полю
                        источника (§5.2.5.2). Оценка «как работает» отлична от уровня риска.
                    </MudText>
                    @foreach (var rule in InspectorDemoData.ControlRules)
                    {
                        <MudPaper Class="pa-3 mb-2" Outlined="true">
                            <MudText Typo="Typo.body2"><b>@rule.Title</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@rule.Note</MudText>
                        </MudPaper>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Генерация документов" Icon="@Icons.Material.Filled.AutoAwesome">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-3">
                        Аналитическая записка по рискам формируется тем же grounded-конвейером Генератора:
                        ссылки на НПА проходят грунтовку, результат — черновик для проверки человеком.
                        Сам балл риска при этом остаётся детерминированным — ИИ пишет только текст.
                    </MudAlert>
                    <MudButton Href="/generator" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome">Перейти в Генератор</MudButton>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>

    @* ================= Детали ================= *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            @if (_selected is null)
            {
                <EmptyState Icon="@Icons.Material.Filled.Warning">
                    Выберите риск из реестра<br />для работы с ним и правилами контроля
                </EmptyState>
            }
            else
            {
                <SectionCaption Text="Риск" />
                <MudText Typo="Typo.h6">@_selected.Entry.Division</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@_selected.Entry.Area</MudText>

                <div class="d-flex align-center gap-2 mb-3">
                    <TintedChip Color="@LevelColor(_selected.Assessment.Level)">
                        @LevelLabel(_selected.Assessment.Level)
                    </TintedChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                        балл @_selected.Assessment.Score.ToString("0.#")
                    </MudChip>
                </div>

                <SectionCaption Text="Существо" Class="" />
                <MudText Typo="Typo.body2" Class="mb-3">@_selected.Entry.Description</MudText>

                <SectionCaption Text="Рекомендация" Class="" />
                <MudText Typo="Typo.body2" Class="mb-3">@_selected.Entry.Recommendation</MudText>

                @* Разбор балла — показывает, что уровень получен формулой, а не назначен вручную. *@
                <SectionCaption Text="Из чего сложился балл" Class="mb-1" />
                <KeyValueTable Rows="@ScoreRows" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    Веса и пороги — конфигурируемы, калибруются на этапе Э1 (см. методику расчёта риска).
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly RiskLevel[] AllLevels =
        [RiskLevel.Critical, RiskLevel.High, RiskLevel.Medium, RiskLevel.Low];

    /// <summary>Запись реестра вместе с ВЫЧИСЛЕННОЙ оценкой (формула, не константа).</summary>
    private sealed record AssessedRisk(InspectorDemoData.RiskEntry Entry, RiskAssessment Assessment);

    private List<AssessedRisk> _assessed = [];
    private RiskLevel? _filter;
    private AssessedRisk? _selected;

    protected override void OnInitialized() =>
        // Уровень каждого риска считает НАСТОЯЩИЙ калькулятор по демо-сигналам (Приложение §2).
        _assessed = [.. InspectorDemoData.Risks.Select(r => new AssessedRisk(r, Calculator.Assess(r.Signals)))];

    private IEnumerable<AssessedRisk> Filtered =>
        _filter is null ? _assessed : _assessed.Where(r => r.Assessment.Level == _filter);

    /// <summary>Чипы фильтра по уровню: подпись, цвет и количество записей на каждый уровень.</summary>
    private IReadOnlyList<FilterChipItem<RiskLevel>> FilterItems =>
        [.. AllLevels.Select(l => new FilterChipItem<RiskLevel>(l, LevelLabel(l), LevelColor(l), CountOf(l)))];

    /// <summary>Строки «Из чего сложился балл» выбранного риска — сигналы формулы Приложения §2.</summary>
    private IReadOnlyList<(string Label, string Value)> ScoreRows => _selected is null ? [] :
    [
        ("Открытых нарушений (объём×тяжесть)", _selected.Entry.Signals.OpenSeverities.Count.ToString()),
        ("Повторяемость", _selected.Entry.Signals.RepeatCount.ToString()),
        ("Просроченных устранений", _selected.Entry.Signals.OverdueCount.ToString()),
        ("Тренд к пред. периоду", _selected.Entry.Signals.TrendDelta.ToString()),
    ];

    private int CountOf(params RiskLevel[] levels) => _assessed.Count(r => levels.Contains(r.Assessment.Level));

    // 4 уровня — 4 оттенка (на дашборде они сворачиваются в 3 цвета светофора, Приложение §2).
    private static string LevelColor(RiskLevel level) => level switch
    {
        RiskLevel.Critical => "#ef4444",
        RiskLevel.High => "#f97316",
        RiskLevel.Medium => "#eab308",
        _ => "#22c55e",
    };

    private static string LevelLabel(RiskLevel level) => level switch
    {
        RiskLevel.Critical => "Критичный",
        RiskLevel.High => "Высокий",
        RiskLevel.Medium => "Средний",
        _ => "Низкий",
    };
}
