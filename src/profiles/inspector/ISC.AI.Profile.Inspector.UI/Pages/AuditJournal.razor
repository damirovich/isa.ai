@namespace ISC.AI.Profile.Inspector.UI
@* Журнал аудита (ТБ-030/032). Журнал ПИСАЛСЯ с самого начала и защищён от изменения хеш-цепочкой,
   но посмотреть его из интерфейса было нельзя — только запросом к БД. Экран это закрывает.
   Как страницы ролей, допусков и учёток: видна всем, право решает обработчик. *@
@page "/admin/audit"
@rendermode InteractiveServer
@using ISC.AI.Abstractions.Application
@using ISC.AI.Abstractions.Audit
@using ISC.AI.Profile.Inspector.Application.Audit

<PageHeader Title="Журнал аудита"
            Subtitle="Неизменяемая история обращений и действий · смотрит Администратор"
            Icon="@Icons.Material.Filled.History" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Outlined="true" Class="pa-3 mb-4">
    <div class="d-flex gap-3 align-end flex-wrap">
        <MudDatePicker @bind-Date="_from" Label="С" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"
                       Clearable="true" Style="width:170px;" />
        <MudDatePicker @bind-Date="_to" Label="По" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"
                       Clearable="true" Style="width:170px;" />
        <MudSelect T="AuditAction?" @bind-Value="_action" Label="Действие" Variant="Variant.Outlined"
                   Clearable="true" Style="width:200px;">
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <MudSelectItem T="AuditAction?" Value="@action">@Label(action)</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int?" @bind-Value="_subjectId" Label="Пользователь (Id)" Variant="Variant.Outlined"
                         Clearable="true" Style="width:170px;" />
        <MudTextField @bind-Value="_objectRef" Label="Объект содержит" Variant="Variant.Outlined"
                      Style="min-width:220px;" Class="flex-grow-1"
                      OnKeyDown="@(async e => { if (e.Key == "Enter") { await SearchAsync(); } })" />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search"
                   OnClick="SearchAsync" Disabled="_busy">Найти</MudButton>
    </div>
</MudPaper>

<MudTable T="AuditRecordRow" Items="_rows" Dense="true" Hover="true" Outlined="true" Loading="_busy"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>Время</MudTh>
        <MudTh>Кто</MudTh>
        <MudTh>Действие</MudTh>
        <MudTh>Объект</MudTh>
        <MudTh>Гриф</MudTh>
        <MudTh>Подразделение</MudTh>
        <MudTh>Подробности</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Время">
            @context.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss",
                System.Globalization.CultureInfo.InvariantCulture)
        </MudTd>
        <MudTd DataLabel="Кто">
            @* Имя берётся из реестра сейчас, а в записи хранится идентификатор: запись неизменяема
               (ТБ-031), а человек может смениться местами или быть переименован. *@
            @(context.SubjectName ?? (context.SubjectId is { } id
                ? $"пользователь №{id.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
                : "—"))
        </MudTd>
        <MudTd DataLabel="Действие">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ActionColor(context.Action)"
                     Class="ma-0">@Label(context.Action)</MudChip>
        </MudTd>
        <MudTd DataLabel="Объект" Style="max-width:280px;">
            <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                @(context.ObjectRef ?? "—")
            </MudText>
        </MudTd>
        <MudTd DataLabel="Гриф">
            @(context.Classification == 0 ? "открыто" : $"ДСП · {context.Classification}")
        </MudTd>
        <MudTd DataLabel="Подразделение">@(context.DivisionId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</MudTd>
        <MudTd DataLabel="Подробности" Style="max-width:320px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary"
                     Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                @(context.PayloadSensitive ?? "—")
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Записей по этому отбору нет.</MudText>
    </NoRecordsContent>
</MudTable>

@if (_total > 0)
{
    <div class="d-flex align-center justify-space-between mt-3 flex-wrap gap-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Записей: @_total · страница @_page из @PageCount
        </MudText>
        <MudPagination Count="@PageCount" Selected="_page" SelectedChanged="GoToPageAsync"
                       Color="Color.Primary" Size="Size.Small" />
    </div>
}

<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3">
    Показаны только записи в пределах вашего допуска: журнал не должен становиться обходным каналом
    к тому, что скрыто грифом.
</MudText>

@code {
    private const int PageSize = 50;

    private IReadOnlyList<AuditRecordRow> _rows = [];
    private int _total;
    private int _page = 1;

    private DateTime? _from;
    private DateTime? _to;
    private int? _subjectId;
    private AuditAction? _action;
    private string? _objectRef;

    private bool _busy;
    private string? _error;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync()
    {
        // Новый отбор всегда начинается с первой страницы: иначе после сужения фильтра пользователь
        // остаётся на несуществующей странице и видит пустоту вместо результатов.
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Конец периода — включительно по ДЕНЬ: пользователь выбирает дату, а не момент времени,
            // и «по 07.08» обязано включать события этого дня целиком.
            var to = _to?.Date.AddDays(1).AddTicks(-1);

            var response = await Dispatcher.Send(new ListAuditRecordsQuery(new AuditFilter(
                _from?.Date.ToUniversalTime(),
                to?.ToUniversalTime(),
                _subjectId,
                _action,
                _objectRef,
                _page,
                PageSize)));

            if (!response.Status || response.Data is null)
            {
                _error = response.StatusMessage;
                _rows = [];
                _total = 0;
                return;
            }

            _rows = response.Data.Rows;
            _total = response.Data.TotalCount;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Label(AuditAction action) => action switch
    {
        AuditAction.Login => "Вход",
        AuditAction.View => "Просмотр",
        AuditAction.Search => "Поиск",
        AuditAction.Generate => "Генерация",
        AuditAction.Export => "Выгрузка",
        AuditAction.Print => "Печать",
        AuditAction.Ingest => "Загрузка в корпус",
        AuditAction.Purge => "Удаление из корпуса",
        AuditAction.Modify => "Изменение",
        _ => action.ToString(),
    };

    private static Color ActionColor(AuditAction action) => action switch
    {
        AuditAction.Purge => Color.Error,
        AuditAction.Export or AuditAction.Print => Color.Warning,
        AuditAction.Modify or AuditAction.Ingest => Color.Info,
        AuditAction.Login => Color.Success,
        _ => Color.Default,
    };
}
