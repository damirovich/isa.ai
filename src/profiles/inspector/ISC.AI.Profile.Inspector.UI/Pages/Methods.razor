@namespace ISC.AI.Profile.Inspector.UI
@page "/methods"

@* Модуль «Методики проверок» (§5.2.9, P1). ВНИМАНИЕ: содержимое ПОКАЗАТЕЛЬНОЕ (демо) — реальные методики
   генерируются grounded-конвейером Генератора (промпт-каркас: цель, объект, вопросы, чек-лист, критерии) и
   опционально хранятся как объект «методика». Сейчас экран показывает вид и состав, генерация не подключена. *@

<PageHeader Title="Методики проверок"
            Subtitle="Программы, методики, учебные и методические материалы"
            Icon="@Icons.Material.Filled.MenuBook">
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">в разработке</MudChip>
</PageHeader>

<DemoAlert>
    Показательные данные (ДЕМО). Реальные программы и чек-листы будут формироваться grounded-конвейером
    Генератора (§5.2.9): ссылки на НПА проходят грунтовку, результат — черновик для проверки человеком.
</DemoAlert>

<MudGrid>
    @* --- Список программ / материалов / чек-листов --- *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            <SectionCaption Text="Программы и методики проверок" />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-1">
                <MudTabPanel Text="Программы проверок" Icon="@Icons.Material.Filled.Article">
                    @foreach (var program in InspectorDemoData.Programs)
                    {
                        <AccentRow Selected="@ReferenceEquals(_selected, program)" OnClick="@(() => Select(program))">
                            <MudText Typo="Typo.body1"><b>@program.Title</b></MudText>
                            <div class="d-flex align-center gap-4 mt-1">
                                <IconCaption Icon="@Icons.Material.Filled.Place">@program.Scope</IconCaption>
                                <IconCaption Icon="@Icons.Material.Filled.Schedule">@program.Duration</IconCaption>
                            </div>
                        </AccentRow>
                    }

                    <ActionHintButton Text="Создать новую программу (ДЕМО)"
                                      Icon="@Icons.Material.Filled.Add" Class="mt-2">
                        <Hint>
                            В рабочей версии программа формируется Генератором через grounded-конвейер
                            (промпт-каркас: цель, объект, вопросы, чек-лист, критерии) и сохраняется как черновик.
                        </Hint>
                    </ActionHintButton>
                </MudTabPanel>

                <MudTabPanel Text="Методические материалы" Icon="@Icons.Material.Filled.School">
                    @foreach (var material in InspectorDemoData.Materials)
                    {
                        <AccentRow>
                            <MudText Typo="Typo.body1"><b>@material.Title</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@material.Note</MudText>
                        </AccentRow>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Чек-листы" Icon="@Icons.Material.Filled.Checklist">
                    @foreach (var checklist in InspectorDemoData.Checklists)
                    {
                        <AccentRow Class="pa-3 mb-2 d-flex align-center">
                            <MudText Typo="Typo.body1" Class="flex-grow-1"><b>@checklist.Title</b></MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                                @checklist.Points пунктов
                            </MudChip>
                        </AccentRow>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>

    @* --- Панель деталей: пусто, пока программа не выбрана --- *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 h-100" Outlined="true">
            @if (_selected is null)
            {
                <EmptyState Icon="@Icons.Material.Filled.MenuBook">
                    Выберите программу из списка<br />или создайте новую
                </EmptyState>
            }
            else
            {
                <SectionCaption Text="Программа проверки" />
                <MudText Typo="Typo.h6" GutterBottom="true">@_selected.Title</MudText>

                <div class="d-flex align-center gap-4 mb-3">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             Icon="@Icons.Material.Filled.Place">@_selected.Scope</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                             Icon="@Icons.Material.Filled.Schedule">@_selected.Duration</MudChip>
                </div>

                <SectionCaption Text="Цель" Class="" />
                <MudText Typo="Typo.body2" Class="mb-3">@_selected.Purpose</MudText>

                <SectionCaption Text="Перечень вопросов" Class="mb-1" />
                <MudList T="string" Dense="true">
                    @foreach (var question in _selected.Questions)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                            <MudText Typo="Typo.body2">@question</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private InspectorDemoData.InspectionProgram? _selected;

    private void Select(InspectorDemoData.InspectionProgram program) => _selected = program;
}
