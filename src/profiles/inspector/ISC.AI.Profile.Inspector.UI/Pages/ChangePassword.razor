@namespace ISC.AI.Profile.Inspector.UI
@* Смена СВОЕГО пароля (Э4-35 §6.5). Обычный путь — ДИАЛОГ из шапки (AccountWidget, с любого
   экрана); эта страница осталась ради ПРИНУДИТЕЛЬНОЙ смены временного пароля: хост
   (RequirePasswordChange) запирает сюда пользователя с MustChangePassword, и диалог тут
   неуместен — пока пароль не сменён, другой работы нет. Маршрут менять нельзя. *@
@page "/account/password"
@rendermode InteractiveServer

<div class="d-flex justify-center mt-12">
    <MudPaper Outlined="true" Class="pa-6" Style="width:100%; max-width:440px;">
        <div class="d-flex align-center gap-2 mb-1">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Смена пароля</MudText>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Пароль меняете только вы — администратор его не видит.
        </MudText>
        <ChangePasswordForm />
    </MudPaper>
</div>
