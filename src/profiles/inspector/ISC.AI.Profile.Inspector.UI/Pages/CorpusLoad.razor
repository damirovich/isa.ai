@namespace ISC.AI.Profile.Inspector.UI
@* Загрузка корпуса (Э4-01): файлы (.txt/.docx) → IFileIngestor; импорт пакета Harvester → IBundleImporter.
   Гриф/подразделение ДЕКЛАРИРУЕТ оператор; fail-closed и дедуп — в порту. *@
@page "/load"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using ISC.AI.Abstractions.Ingestion
@using ISC.AI.Profile.Inspector.Application.Features.Divisions
@using ISC.AI.Profile.Inspector.Application.Features.Loading
@using ISC.AI.Profile.Inspector.Domain.Services

<PageTitle>Загрузка корпуса — ИнспекторAI</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Загрузка корпуса</MudText>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Гриф и подразделение задаёт оператор. Без них загрузка отклоняется (fail-closed, ТБ-024); повтор того же
    содержимого не создаёт дублей. На обезличенных/тестовых данных — гриф 0 (открыто).
</MudAlert>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="_docType" Label="Тип документа" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="6" sm="4"><MudNumericField @bind-Value="_classification" Label="Гриф (Classification)" Variant="Variant.Outlined" Min="0" /></MudItem>
        <MudItem xs="6" sm="4">
            @* Подразделение — ТОЛЬКО из справочника. Раньше вводилось числом, и пакет ЦБД лёг под
               несуществующее «10»: 100 НПА не видел никто (решётка отсекала у каждого). *@
            <MudSelect T="int?" @bind-Value="_divisionId" Label="Подразделение *" Variant="Variant.Outlined">
                @foreach (var division in _divisions)
                {
                    <MudSelectItem T="int?" Value="@division.Id">@division.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <div class="mt-2">
        <MudNumericField T="int?" @bind-Value="_supersedesId" Label="Заменяет документ # (новая версия — необязательно)"
                         Variant="Variant.Outlined" Min="1" Clearable="true" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Укажите ID прежней версии — её фрагменты будут погашены, в поиск/ИИ пойдёт только новая (Э4-14).
        </MudText>
    </div>

    <div class="mt-3">
        <MudText Typo="Typo.body2" Class="mb-1">Файлы (.txt, .docx) — выбор сразу запускает загрузку:</MudText>
        <InputFile OnChange="UploadFilesAsync" accept=".txt,.docx,.pdf" multiple disabled="@(_busy || _divisionId is null)" />
    </div>
</MudPaper>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2">@_error</MudAlert>
}

@if (_fileResults.Count > 0)
{
    <MudText Typo="Typo.h6" GutterBottom="true">Результаты загрузки</MudText>
    @foreach (var result in _fileResults)
    {
        <div class="d-flex align-center gap-2 mb-1">
            <MudChip T="string" Size="Size.Small" Color="@ResultColor(result)">@ResultLabel(result)</MudChip>
            <MudText Typo="Typo.body2">@result.FileName</MudText>
            <MudText Typo="Typo.caption">
                @(result.Accepted ? (result.IsDuplicate ? "уже в корпусе" : $"чанков: {result.ChunkCount}") : result.Reason)
            </MudText>
            @if (result.SupersededDocumentId is { } supersededId)
            {
                <MudText Typo="Typo.caption" Color="Color.Info">· заменил документ #@supersededId</MudText>
            }
        </div>
    }
}

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Импорт пакета сборщика (Harvester)</MudText>
    <MudTextField @bind-Value="_manifestPath" Label="Путь к manifest.json пакета" Variant="Variant.Outlined" />
    <MudSelect T="int?" @bind-Value="_bundleDivisionId" Label="Подразделение для всего пакета *"
               Variant="Variant.Outlined" Class="mt-2">
        @foreach (var division in _divisions)
        {
            <MudSelectItem T="int?" Value="@division.Id">@division.Name</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
        Перекрывает подразделение, записанное в пакете: сборщик работает вне контура и справочника
        не видит. Для общих НПА (законы, кодексы) — обычно «Главная инспекция».
    </MudText>
    <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Secondary"
               OnClick="ImportBundleAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_manifestPath) || _bundleDivisionId is null)">
        Импортировать пакет
    </MudButton>
    @if (_bundleStatus is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2">@_bundleStatus</MudAlert>
    }
</MudPaper>

@code {
    private string _docType = "положение";
    private int _classification;
    private int? _divisionId;
    private int? _bundleDivisionId;
    private int? _supersedesId;

    /// <summary>Действующие подразделения из справочника — единственный допустимый выбор.</summary>
    private IReadOnlyList<DivisionNode> _divisions = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await Dispatcher.Send(new ListDivisionTreeQuery());
        if (response is { Status: true, Data: { } list })
        {
            _divisions = [.. list.Where(d => d.IsActive)];
            // Одно подразделение в справочнике — выбираем его сразу, чтобы не заставлять кликать.
            if (_divisions.Count == 1)
            {
                _divisionId = _bundleDivisionId = _divisions[0].Id;
            }
        }
        else if (response is { Status: false })
        {
            _error = response.StatusMessage;
        }
    }

    private bool _busy;
    private string? _error;
    private readonly List<IngestFileResult> _fileResults = [];

    private string _manifestPath = string.Empty;
    private string? _bundleStatus;

    private async Task UploadFilesAsync(InputFileChangeEventArgs args)
    {
        if (_divisionId is null)
        {
            _error = "Выберите подразделение из справочника.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            foreach (var file in args.GetMultipleFiles(maximumFileCount: 50))
            {
                using var buffer = new MemoryStream();
                await using (var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
                {
                    await stream.CopyToAsync(buffer);
                }

                var response = await Dispatcher.Send(
                    new IngestFileCommand(buffer.ToArray(), file.Name, _docType, (short)_classification, _divisionId!.Value, _supersedesId));

                if (response is { Status: true, Data: { } result })
                {
                    _fileResults.Insert(0, result);
                }
                else
                {
                    _error = response.StatusMessage;
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportBundleAsync()
    {
        if (_bundleDivisionId is not { } bundleDivisionId)
        {
            _error = "Выберите подразделение для пакета.";
            return;
        }

        _busy = true;
        _error = null;
        _bundleStatus = null;
        try
        {
            var response = await Dispatcher.Send(new ImportBundleCommand(_manifestPath, bundleDivisionId));
            if (response.Status)
            {
                _bundleStatus = response.StatusMessage;
            }
            else
            {
                _error = response.StatusMessage;
            }
        }
        catch (Exception ex)
        {
            _error = $"Ошибка импорта: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color ResultColor(IngestFileResult result) =>
        !result.Accepted ? Color.Error : result.IsDuplicate ? Color.Default : Color.Success;

    private static string ResultLabel(IngestFileResult result) =>
        !result.Accepted ? "отклонён" : result.IsDuplicate ? "дубликат" : "загружен";
}
