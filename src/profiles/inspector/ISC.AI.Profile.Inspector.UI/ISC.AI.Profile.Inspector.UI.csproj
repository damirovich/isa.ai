<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Страницы модулей (Razor Class Library), монтируемые хостом. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\ISC.AI.Abstractions\ISC.AI.Abstractions.csproj" />
    <ProjectReference Include="..\ISC.AI.Profile.Inspector.Application\ISC.AI.Profile.Inspector.Application.csproj" />
    <ProjectReference Include="..\ISC.AI.Profile.Inspector.Domain\ISC.AI.Profile.Inspector.Domain.csproj" />
    <!-- Профиль → docflow (направление разрешено, ADR-0017): страницы профиля шлют команды модуля
         (регистрация ИИ-документов) через общий Mediator. Обратной ссылки docflow на профиль нет. -->
    <ProjectReference Include="..\..\..\modules\docflow\ISC.AI.Modules.DocFlow.Application\ISC.AI.Modules.DocFlow.Application.csproj" />
    <!-- Сводка документооборота (DocFlowSummary) — вкладка общего дашборда (решение 2026-08-27).
         Направление допустимое: профиль знает модуль, модуль профиля — никогда (ADR-0017). -->
    <ProjectReference Include="..\..\..\modules\docflow\ISC.AI.Modules.DocFlow.UI\ISC.AI.Modules.DocFlow.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

</Project>
