<Project Sdk="Microsoft.NET.Sdk">

  <!-- InspectorDbContext (схема inspector) и миграции. Единственное место профиля,
       ссылающееся на конкретный проект ядра (Persistence) ради общего EF-слоя. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\ISC.AI.Abstractions\ISC.AI.Abstractions.csproj" />
    <ProjectReference Include="..\ISC.AI.Profile.Inspector.Domain\ISC.AI.Profile.Inspector.Domain.csproj" />
    <ProjectReference Include="..\..\..\core\ISC.AI.Persistence\ISC.AI.Persistence.csproj" />
