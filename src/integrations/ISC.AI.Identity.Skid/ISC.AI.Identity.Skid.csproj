<Project Sdk="Microsoft.NET.Sdk">

  <!-- Адаптер внешней системы идентификации СКИД (Э3-08): read-only чтение пользователей/подразделений
       из БД СКИД и проверка Argon2id-хешей паролей. Реализует нейтральный порт ядра
       IExternalIdentityProvider; ядро о СКИД не знает — проект подключает только хост. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\ISC.AI.Abstractions\ISC.AI.Abstractions.csproj" />
    <!-- Одноразовый перенос учёток в core.app_user (Э4-35 §6.5): адаптеру нужен контекст ядра как
         ПРИЁМНИК. Ссылка появляется только ради переноса и уходит вместе с проектом, когда
         адаптер будет выведен из решения. -->
    <ProjectReference Include="..\..\core\ISC.AI.Persistence\ISC.AI.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Sodium.Core (MIT; нативный libsodium — лицензия ISC): та же библиотека, которой СКИД
         хеширует пароли, — гарантирует совместимость проверки Argon2id PHC-строк. -->
    <PackageReference Include="Sodium.Core" />
  </ItemGroup>

</Project>
