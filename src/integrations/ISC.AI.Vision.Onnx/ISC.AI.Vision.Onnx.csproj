<Project Sdk="Microsoft.NET.Sdk">

  <!-- Интеграция распознавания лиц (ДОК-13 §5, §10; ADR-0020): реализации портов пакета «Медиа» —
       детектор YuNet и векторизатор SFace через ONNX Runtime (в процессе, CPU), раскадровка видео
       внешним ffmpeg через FFMpegCore, декодирование изображений SkiaSharp. Зависит от Abstractions и
       ДОМЕНА модуля «Медиа» (реализует его порты); на профиль и хост не ссылается. Ядро об этом
       проекте не знает (ТС-011). Все зависимости — MIT/Apache; ffmpeg — только LGPL-сборка, внешний
       процесс, без линковки (ТСТ-004). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="FFMpegCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\ISC.AI.Abstractions\ISC.AI.Abstractions.csproj" />
    <ProjectReference Include="..\..\modules\media\ISC.AI.Modules.Media.Domain\ISC.AI.Modules.Media.Domain.csproj" />
  </ItemGroup>

</Project>
