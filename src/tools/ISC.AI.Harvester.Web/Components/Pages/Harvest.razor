@* Консоль оператора (Э4-08): выбор источника → сбор → курирование → выгрузка пакета. Вне контура. *@
@page "/"
@using ISC.AI.Abstractions.Harvesting
@using ISC.AI.Harvester.Engine
@using EngineRenderMode = ISC.AI.Harvester.Engine.RenderMode @* однозначность: есть ещё Blazor RenderMode *@
@inject IEnumerable<ISourceConnector> Connectors
@inject IBundleWriter BundleWriter

<PageTitle>Сборщик корпуса</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Сбор корпуса из источника</MudText>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Инструмент работает ВНЕ изолированного контура. Собираются только открытые материалы; на выходе —
    пакет для контролируемого переноса и импорта в контур.
</MudAlert>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12">
            <MudSelect T="string" Value="_preset" ValueChanged="ApplyPreset" Label="Готовый пресет источника" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@(string.Empty)">— без пресета (ручная настройка) —</MudSelectItem>
                @foreach (var preset in SitePresets.All)
                {
                    <MudSelectItem Value="@preset.Name">@preset.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="_connectorId" Label="Источник" Variant="Variant.Outlined">
                @foreach (var connector in Connectors)
                {
                    <MudSelectItem Value="@connector.Id">@connector.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_seedUrl" Label="URL (страница или список)" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_docType" Label="Тип документа" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudNumericField @bind-Value="_divisionId" Label="Подразделение (DivisionId)" Variant="Variant.Outlined" Min="0" />
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudNumericField @bind-Value="_maxDocuments" Label="Максимум документов" Variant="Variant.Outlined" Min="1" />
        </MudItem>
    </MudGrid>

    @if (_connectorId == "configurable-site")
    {
        <MudText Typo="Typo.subtitle2" Class="mt-3">Правила (CSS-селекторы) для «сайт по правилам»</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_itemLinkSelector" Label="Ссылки списка" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_titleSelector" Label="Заголовок карточки" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_bodySelector" Label="Текст карточки" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="EngineRenderMode" @bind-Value="_renderMode" Label="Режим загрузки" Variant="Variant.Outlined">
                    <MudSelectItem Value="@(EngineRenderMode.Static)">Статический HTML (быстро)</MudSelectItem>
                    <MudSelectItem Value="@(EngineRenderMode.Headless)">Headless-браузер (для JS-сайтов/SPA)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_readySelector" Label="Селектор готовности (headless, необязательно)" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        @if (_renderMode == EngineRenderMode.Headless)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                Headless требует браузер: один раз выполните <code>playwright install chromium</code>.
                Селекторы пресета — предварительные; сверьте с реальной страницей (DevTools).
            </MudAlert>
        }
    }

    <MudButton Class="mt-3" Color="Color.Primary" Variant="Variant.Filled"
               OnClick="RunAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_seedUrl))">
        @(_busy ? "Сбор…" : "Собрать")
    </MudButton>
</MudPaper>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
}
@if (_status is not null)
{
    <MudText Typo="Typo.body2" Class="mb-2">@_status</MudText>
}

@if (_rows.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.h6">Собрано: @_rows.Count (выбрано: @_rows.Count(r => r.Include))</MudText>
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="ExportAsync" Disabled="_busy">
                Выгрузить пакет
            </MudButton>
        </div>

        @foreach (var row in _rows)
        {
            <div class="d-flex align-center gap-2 mb-1">
                <MudCheckBox @bind-Value="row.Include" T="bool" Dense="true" />
                <div>
                    <MudText Typo="Typo.body2"><b>@row.Doc.Title</b></MudText>
                    <MudText Typo="Typo.caption">@row.Doc.SourceUrl · символов: @row.Doc.Text.Length</MudText>
                </div>
            </div>
        }
    </MudPaper>
}

@if (_bundlePath is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
        Пакет записан: <code>@_bundlePath</code>. Перенесите его в контур контролируемо и импортируйте.
    </MudAlert>
}

@code {
    private string _connectorId = string.Empty;
    private string _seedUrl = string.Empty;
    private string _docType = "положение";
    private int _divisionId = 1;
    private int _maxDocuments = 20;
    private const short OpenClassification = 0; // вне контура — только открытые материалы

    private string _itemLinkSelector = string.Empty;
    private string _titleSelector = string.Empty;
    private string _bodySelector = string.Empty;
    private EngineRenderMode _renderMode = EngineRenderMode.Static;
    private string _readySelector = string.Empty;

    private bool _busy;
    private string? _status;
    private string? _bundlePath;
    private readonly List<Row> _rows = [];

    private string _preset = string.Empty;

    protected override void OnInitialized() =>
        _connectorId = Connectors.FirstOrDefault()?.Id ?? string.Empty;

    private void ApplyPreset(string name)
    {
        _preset = name ?? string.Empty;
        var preset = SitePresets.All.FirstOrDefault(p => p.Name == _preset);
        if (preset is null)
        {
            return;
        }

        // Пресет — это конфиг: заполняем поля; оператор может поправить селекторы вручную.
        _connectorId = "configurable-site";
        _seedUrl = preset.SuggestedSeedUrl;
        _docType = preset.DocType;
        _itemLinkSelector = preset.Rules.ItemLinkSelector;
        _titleSelector = preset.Rules.TitleSelector ?? string.Empty;
        _bodySelector = preset.Rules.BodySelector ?? string.Empty;
        _renderMode = preset.Rules.RenderMode; // важно: SPA-пресет несёт headless-режим (Э4-15)
        _readySelector = preset.Rules.ReadySelector ?? string.Empty;
    }

    private async Task RunAsync()
    {
        _busy = true;
        _status = "Сбор…";
        _bundlePath = null;
        _rows.Clear();
        try
        {
            var connector = Connectors.First(c => c.Id == _connectorId);
            SiteRules? rules = string.IsNullOrWhiteSpace(_itemLinkSelector)
                ? null
                : new SiteRules(_itemLinkSelector, NullIfEmpty(_titleSelector), NullIfEmpty(_bodySelector),
                    RenderMode: _renderMode, ReadySelector: NullIfEmpty(_readySelector));
            var config = new SourceConfig(_seedUrl, _docType, OpenClassification, _divisionId, _maxDocuments, Rules: rules);

            await foreach (var doc in connector.HarvestAsync(config))
            {
                _rows.Add(new Row(doc));
                _status = $"Собрано: {_rows.Count}";
                StateHasChanged();
            }

            _status = $"Готово. Собрано: {_rows.Count}";
        }
        catch (Exception ex)
        {
            _status = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        var included = _rows.Where(r => r.Include).Select(r => r.Doc).ToList();
        if (included.Count == 0)
        {
            _status = "Нет выбранных документов для выгрузки.";
            return;
        }

        var directory = Path.Combine(AppContext.BaseDirectory, "bundles", "bundle-" + DateTime.Now.ToString("yyyyMMdd-HHmmss"));
        _bundlePath = await BundleWriter.WriteAsync(directory, included);
        _status = $"Выгружено документов: {included.Count}";
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private sealed class Row(HarvestedDocument doc)
    {
        public HarvestedDocument Doc { get; } = doc;
        public bool Include { get; set; } = true;
    }
}
