<Project Sdk="Microsoft.NET.Sdk">

  <!-- Одноразовый перенос учёток из БД СКИД в core.app_user (Э4-35 §6.5, шаг 2). Отдельная консольная
       команда, а не экран: операция разовая, выполняется при переходе, и её место — регламент
       развёртывания, а не повседневный интерфейс. Уходит из решения вместе с адаптером СКИД. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ISC.AI.Identity.Import</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\integrations\ISC.AI.Identity.Skid\ISC.AI.Identity.Skid.csproj" />
    <ProjectReference Include="..\..\core\ISC.AI.Persistence\ISC.AI.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

</Project>
