# Секреты ISC.AI («ИнспекторAI») для службы isc-ai (ТБ-013, Э4-10). Файл /etc/isc-ai/isc-ai.env, права root:root 0600:
# читает только systemd при запуске службы (и account.sh под root). В appsettings*.json секретов быть не должно.
# Формат systemd: КЛЮЧ=значение — без пробелов вокруг «=»; кавычки не нужны (если поставить — снимутся).

# Пароль пользователя БД из строк подключения ConnectionStrings:Core / Inspector / DocFlow. ОБЯЗАТЕЛЕН.
Database__Password=

# Учётка по умолчанию «admin» с паролем из репозитория заводится при первом запуске на ПУСТОМ реестре пользователей.
# Пусто (так и оставить) — засев отключён: в контуре первую учётку заводят командой «sudo bash account.sh <логин>»,
# которая выдаёт случайный временный пароль. Известный всем пароль из репозитория на боевом контуре недопустим.
Auth__DefaultAccount__Password=

# Ключи доступа к серверам модели, если llama-server запущен с ключом API (ТБ-044: доступ к модели — только от хоста).
# Пусто — без ключа.
Llm__Models__Draft__ApiKey=
Llm__Models__Analysis__ApiKey=
Llm__Models__Embeddings__ApiKey=
