# Служба веб-хоста ISC.AI («ИнспекторAI» или «Следствие AI» — профиль в /opt/isc-ai/current/VERSION) — автозапуск и
# перезапуск после сбоя (ТНД-005). Ставится install.sh в /etc/systemd/system/. Свои изменения (другой каталог носителя
# резервных копий, каталог архива, зависимость от локального PostgreSQL и т. п.) — ТОЛЬКО через «systemctl edit isc-ai»:
# этот файл install.sh перезаписывает при обновлении.
[Unit]
Description=ISC.AI — веб-хост
Wants=network-online.target
After=network-online.target
# Если PostgreSQL на этом же сервере — в «systemctl edit isc-ai» добавить: After=postgresql.service

[Service]
Type=exec
User=iscai
Group=iscai
WorkingDirectory=/opt/isc-ai/current/app
ExecStart=/opt/isc-ai/current/app/ISC.AI.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
# Временные копии материалов (видео, звук, сканы) — на томе данных: видео в гигабайты не помещается в /tmp системного
# раздела. Каталог создаёт install.sh; его же видят распознаватель речи и ffmpeg (наследуют окружение службы).
Environment=TMPDIR=/var/lib/isc-ai/tmp
# Телеметрия ONNX Runtime (распознавание лиц) выключена: с версии 1.30 библиотека под Linux сама обращается к серверу
# Microsoft (ТБ-043, ТБ-052). Читается только из окружения процесса, из программы её не выключить; без переменной
# программа модели лиц не загружает. Не удалять через systemctl edit.
Environment=ORT_DISABLE_TELEMETRY=1
# Секреты (пароль БД и т. п.) — только здесь, файл root:root 0600 (ТБ-013, Э4-10).
EnvironmentFile=/etc/isc-ai/isc-ai.env

Restart=on-failure
RestartSec=10
# Хост штатно завершает фоновые задачи (в т. ч. резервное копирование) по SIGTERM — даём на это время.
TimeoutStopSec=90

# HTTPS на 443 без прав root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Песочница: программа и системные каталоги — только чтение; писать можно лишь в каталог данных, на носитель
# резервных копий и на носитель обмена между офисами, ADR-0068 (приставка «-» — каталога может не быть, пока носитель
# не подключён). MemoryDenyWriteExecute не включать: .NET компилирует код на лету (JIT).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/isc-ai
ReadWritePaths=-/mnt/isc-backup
ReadWritePaths=-/mnt/isc-exchange
UMask=0077
LimitNOFILE=65536
SyslogIdentifier=isc-ai

[Install]
WantedBy=multi-user.target
