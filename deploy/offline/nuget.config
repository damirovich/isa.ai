<?xml version="1.0" encoding="utf-8"?>
<!-- Источники пакетов ИЗОЛИРОВАННОГО контура (ТБ-050): ЕДИНСТВЕННЫЙ источник — локальный
     офлайн-фид (папка feed рядом с этим файлом, наполняется export-packages.ps1 и проверяется
     verify-packages.ps1 по манифесту — ТБ-051). Никаких внешних адресов.
     Использование: dotnet restore ISC.AI.Offline.slnf с ключом configfile, указывающим на этот файл
     (deploy/offline/nuget.config), — NuGet видит ТОЛЬКО его (иерархия конфигов не применяется).
     Именно фильтр ISC.AI.Offline.slnf, а не ISC.AI.slnx: процесса-распознавателя речи ISC.AI.Speech.Worker
     и его тестов в фильтре нет, а их пакетов sherpa-onnx (нативные библиотеки с eSpeak NG, GPL-3.0) нет
     и в фиде (ADR-0026, п. 7) — восстановление всего решения здесь упадёт на этих пакетах.
     Сам ключ здесь записан без двух дефисов перед ним намеренно: XML запрещает двойной дефис
     внутри комментария, и NuGet из-за этого отвергал весь файл как недопустимый XML. -->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-feed" value="feed" />
  </packageSources>
</configuration>
