<?xml version="1.0" encoding="utf-8"?>
<!-- Источники пакетов ДЕВ-контура (машина с интернетом): единственный явный источник nuget.org,
     унаследованные машинные источники отсекаются (clear). Версии пинует ТОЛЬКО CPM
     (Directory.Packages.props), лицензии — только MIT/Apache (CLAUDE.md).
     В ИЗОЛИРОВАННОМ контуре этот файл не действует: восстановление идёт из офлайн-фида
     по deploy/offline/nuget.config (ТБ-050) — см. регламент docs/reference/офлайн-поставка.md. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
